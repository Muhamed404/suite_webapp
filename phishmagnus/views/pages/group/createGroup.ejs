<div class="flex flex-col p-6 gap">
  <div class="flex flex-col gap-2 mb-4 border-b border-gray-100 pb-4">
    <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0" aria-label="Breadcrumb">
      <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
      <span class="text-gray-400">›</span>
      <a id="groupCreateOrgLink" href="/organization/profile/<%= typeof organization !== 'undefined' ? organization : '' %>" class="hover:text-gray-700 transition">
        <span id="groupCreateOrgName"><%= typeof organizationName !== 'undefined' && organizationName ? organizationName : __("breadcrumbs.organization") %></span>
      </a>
      <span class="text-gray-400">›</span>
      <a id="groupListLink" href="/group/list" class="hover:text-gray-700 transition"><%= __("breadcrumbs.group") %></a>
      <span class="text-gray-400">›</span>
      <span class="font-semibold text-gray-900"><%= __("breadcrumbs.groupCreate") %></span>
    </nav>
    <h3 class="text-3xl font-medium text-gray-900">
      <%= __("breadcrumbs.groupCreate") %>
    </h3>
  </div>
</div>

<div class="flex flex-col h-[75vh] gap-4 mt-3 rounded-3xl bg-white">

  <div class="bg-white  w-full mt-3 p-8">



    <!--  Title -->
    <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10">
      <%= __("Add-Department") %>
    </h1>

    <!-- Main Form -->
    <form action="/group/create" method="post" class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Group name -->
      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">
          Group Name
        </label>
        <input type="text" placeholder="Enter Group Name" id="name" name="name"
          class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50" />
      </div>

   

      <!-- Description -->
      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">
          Group Description
        </label>
        <input type="text" placeholder="Enter Description" id="description" name="description"
          class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50" />
      </div>
      <!-- Buttons -->
      <div class="flex justify-end gap-4 mt-10">
        <button type="submit"
          class="px-8 py-2 rounded-lg bg-teal-500 text-white font-semibold hover:bg-teal-600 transition">
          <%= __("Submit") %>
        </button>
      </div>
    </form>



  </div>
</div>

<script>
  (function () {
    const params = new URLSearchParams(window.location.search);
    const orgName = params.get('On');
    const orgId = params.get('orgId');
    const orgLink = document.getElementById('groupCreateOrgLink');
    const orgNameEl = document.getElementById('groupCreateOrgName');
    const listLink = document.getElementById('groupListLink');

    if (orgName && orgNameEl) {
      orgNameEl.textContent = orgName;
    }

    if (orgId) {
      if (orgLink) {
        orgLink.href = `/organization/profile/${orgId}`;
      }
      if (listLink) {
        const listUrl = `/group/list/${orgId}${orgName ? `?On=${encodeURIComponent(orgName)}` : ''}`;
        listLink.href = listUrl;
      }
    }
  })();
</script>