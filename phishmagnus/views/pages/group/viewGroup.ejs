
<div class="flex flex-col p-6 gap pb-0">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div class="flex-1">
      <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0 mb-2" aria-label="Breadcrumb">
        <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
        <span class="text-gray-400">›</span>
        <a id="groupOrgBreadcrumbLink" href="/organization/profile/<%= typeof subscriptionOrganization !== 'undefined' ? subscriptionOrganization : '' %>" class="hover:text-gray-700 transition">
          <span id="groupOrgBreadcrumbName"><%= typeof organizationName !== 'undefined' && organizationName ? organizationName : __("breadcrumbs.organization") %></span>
        </a>
        <span class="text-gray-400">›</span>
        <span class="font-semibold text-gray-900"><%= __("breadcrumbs.group") %></span>
      </nav>
      <h3 class="text-3xl font-medium">
        <%= __("group.labelGroupManagement") %>
      </h3>
    </div>
    <div class="lg:order-3">
      <a id="createGroupBtn" href="/group/create" class="flex items-center justify-center gap-3 px-9 py-3 rounded-full 
        border border-[var(--teal)] transition-all duration-300 bg-[var(--teal)] text-white">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <%= __("btn-Create") %>
      </a>
    </div>
  </div>
  <div class="flex flex-col  p-6 pt-0">
    <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white">
      <!-- Search & Filter -->
      <div class="flex flex-col items-center justify-between gap-3 px-5 pt-5">


        <table id="filter-table" class="min-w-full border-none  text-sm text-left text-gray-700" data-placeholder="<%= __('generic_label.search_here') %>" data-per-page="<%= __('entries per page') %>" data-info="<%= __('generic_label.showing') %> {start} to {end} <%= __('generic_label.of') %> {rows} <%= __('entries') %>" data-no-rows="<%= __('generic_label.no_entries_found') %>">
          <thead class="bg-gray-50 text-gray-600  text-xs">
            <tr>


              <th class="px-4 py-5 text-sm font-normal">
               <%= __("group.labelGroupName") %>
                  <img src="/securemagnus_2025/images/package_management/sort.svg" alt="" class="size-3.5 ml-3 inline">
              </th>
              <th class="px-4 py-5">
                <img src="/securemagnus_2025/images/package_management/Package_Management_Type.svg" alt="Type"
                  class=" inline">
                <%= __("group.labelGroupDescription") %>

                  <span></span><img src="/securemagnus_2025/images/package_management/sort.svg" alt="License Cost"
                    class="size-3.5 ml-3 inline">
              </th>
             
          

                  <th class="px-4 py-5">
                    <img src="/securemagnus_2025/images/package_management/package_management_user_range_form.svg"
                      alt="User From" class=" inline">
                    <%= __("group.labelViewUsers") %>

                  </th>


            </tr>
          </thead>
          <tbody>
            <% if (typeof groups !=='undefined' ){ groups.forEach((group,index)=> { %>

              <tr class="bg-white border-b hover:bg-gray-50">


                <td class="px-6 py-6 whitespace-nowrap  ">
                  <%= group.name %>

                </td>
                <td class="px-6 py-6 whitespace-nowrap  ">
                  <%= group.description %>

                </td>

               
        
                    <td class="px-6 py-6 whitespace-nowrap  ">

                      <button data-group-id="<%=group.id%>"
                        class="open-modal px-6 py-3 bg-teal-500 text-white font-semibold rounded-lg hover:bg-teal-600 transition">
                        <%= __("group.viewDetails") %>
                      </button>
                    </td>


              </tr>

              <% });}%>
          </tbody>
        </table>

      </div>
    </div>
  </div>
</div>



<!-- Modal -->
<div id="popup" class="fixed inset-0 hidden bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-2xl  w-[950px] max-h-[90vh] flex flex-col">

    <!-- Header -->
    <div class="flex justify-between items-center p-5 border-b bg-gradient-to-r rounded-t-2xl">
      <h2 class="text-xl font-bold"><%= __("group.selectedServices") %></h2>
      <button onclick="closeModal()" class=" text-2xl hover:text-red-400">&times;</button>
    </div>

    <!-- Body -->
    <div class="flex gap-6 p-6 flex-1 overflow-y-auto">

      <!-- Enrolled -->
      <div class="flex-1 border rounded-xl p-4   bg-white flex flex-col">
        <input type="text" id="enrolledSearch" onkeyup="filterTable('enrolledSearch','enrolledTable')"
          placeholder="<%= __("group.searchEnrolled") %>"
          class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-400 mb-4 text-sm">
        <h3 class="text-lg font-semibold text-gray-800 mb-3"><%= __("group.enrolled") %></h3>

        <!-- Modern Table -->
        <div class="overflow-hidden rounded-lg flex-1 flex flex-col border">
          <div class="overflow-y-auto max-h-64">
            <table class="w-full text-sm text-left border-collapse" id="enrolledTable">
              <thead class="bg-gray-100 sticky top-0 z-10 text-gray-700">
                <tr>
                  <th class="px-4 py-2 border text-center w-12">
                    <input type="checkbox" onclick="toggleAll(this,'enrolledCheckbox')">
                  </th>
                  <th class="px-4 py-2 border"><%= __("group.firstName") %></th>
                  <th class="px-4 py-2 border"><%= __("group.lastName") %></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
               
              </tbody>
            </table>
          </div>
        </div>

        <button onclick="moveToUnenrolled()"
          class="mt-4 px-4 py-2 bg-red-100 text-red-700 border border-red-300 rounded-lg hover:bg-red-200 transition">
          <%= __("group.moveToUnenrolled") %>
        </button>
      </div>

      <!-- Unenrolled -->
      <div class="flex-1 border rounded-xl p-4   bg-white flex flex-col">
        <input type="text" id="unenrolledSearch" onkeyup="filterTable('unenrolledSearch','unenrolledTable')"
          placeholder="<%= __("group.searchUnenrolled") %>"
          class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-400 mb-4 text-sm">
        <h3 class="text-lg font-semibold text-gray-800 mb-3"><%= __("group.unenrolled") %></h3>

        <div class="overflow-hidden rounded-lg   flex-1 flex flex-col border">
          <div class="overflow-y-auto max-h-64">
            <table class="w-full text-sm text-left border-collapse" id="unenrolledTable">
              <thead class="bg-gray-100 sticky top-0 z-10 text-gray-700">
                <tr>
                  <th class="px-4 py-2 border text-center w-12">
                    <input type="checkbox" onclick="toggleAll(this,'unenrolledCheckbox')">
                  </th>
                  <th class="px-4 py-2 border"><%= __("group.firstName") %></th>
                  <th class="px-4 py-2 border"><%= __("group.lastName") %></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                 
              </tbody>
            </table>
          </div>
        </div>

        <button onclick="moveToEnrolled()"
          class="mt-4 px-4 py-2 bg-green-100 text-green-700 border border-green-300 rounded-lg hover:bg-green-200 transition">
          <%= __("group.moveToEnrolled") %>
        </button>
      </div>
    </div>

    <div class="p-5 border-t bg-gray-50 flex justify-center">
      <button onclick="closeModal()"
        class="px-8 py-3 bg-teal-500  text-white font-semibold rounded-full   hover:opacity-90 transition">
        <%= __("group.done") %>
      </button>
    </div>
  </div>
</div>



<script src="/securemagnus_2025/js/multiselect-encrollment-users.js"></script>
<script src="/securemagnus_2025/js/custom_script/group-multiselect-jquery.js"></script>

<script>
  (function () {
    const params = new URLSearchParams(window.location.search);
    const orgName = params.get('On');
    const orgIdFromQuery = params.get('orgId');
    const pathMatch = window.location.pathname.match(/\/group\/(?:list|create)\/(\d+)/);
    const orgIdFromPath = pathMatch ? pathMatch[1] : null;
    const orgId = orgIdFromPath || orgIdFromQuery;

    const orgLink = document.getElementById('groupOrgBreadcrumbLink');
    const orgNameEl = document.getElementById('groupOrgBreadcrumbName');
    if (orgName && orgNameEl) {
      orgNameEl.textContent = orgName;
    }
    if (orgId && orgLink) {
      orgLink.href = `/organization/profile/${orgId}`;
    }

    const createBtn = document.getElementById('createGroupBtn');
    if (createBtn) {
      const searchParams = new URLSearchParams();
      if (orgId) searchParams.set('orgId', orgId);
      if (orgName) searchParams.set('On', orgName);
      if ([...searchParams.keys()].length) {
        createBtn.href = `/group/create?${searchParams.toString()}`;
      }
    }
  })();
</script>
