<script>
// Show import field when 'link' is selected, hide otherwise
document.addEventListener('DOMContentLoaded', function() {
    const linkRadio = document.getElementById('landing_option_link');
    const customRadio = document.getElementById('landing_option_custom');
    const importContainer = document.getElementById('import-html-url-container');
    const fetchBtn = document.getElementById('fetch-html-template');
    // const urlInput = document.getElementById('import-html-url');
    // const errorDiv = document.getElementById('import-html-url-error');
    const landingPageContent = document.getElementById('landing_page_content');

    function toggleImportField() {
        if (linkRadio && linkRadio.checked) {
            importContainer.style.display = '';
        } else {
            importContainer.style.display = 'none';
            errorDiv.style.display = 'none';
        }
    }
    if (linkRadio && customRadio) {
        linkRadio.addEventListener('change', toggleImportField);
        customRadio.addEventListener('change', toggleImportField);
        // On page load
        toggleImportField();
    }

    // Fetch HTML from URL using backend proxy and insert into landing_page_content
    if (fetchBtn && urlInput && landingPageContent) {
        fetchBtn.addEventListener('click', async function() {
            const url = urlInput.value.trim();
            errorDiv.style.display = 'none';
            if (!url) {
                errorDiv.textContent = window.i18n.__('system_template.create.validationEnterValidUrl');
                errorDiv.style.display = '';
                return;
            }
            try {
                fetchBtn.disabled = true;
                fetchBtn.textContent = '<%= __("system_template.create.fetchingButtonText") %>';
                const response = await fetch('/template/api/fetch-html', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url })
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || 'Failed to fetch HTML.');
                const html = result.html;
                landingPageContent.value = html;
                if (window.CKEDITOR && CKEDITOR.instances['landing_page_content']) {
                    CKEDITOR.instances['landing_page_content'].setData(html);
                }
                fetchBtn.textContent = '<%= __("system_template.create.fetchButtonText") %>';
                fetchBtn.disabled = false;
            } catch (err) {
                errorDiv.textContent = 'Error: ' + err.message;
                errorDiv.style.display = '';
                fetchBtn.textContent = '<%= __("system_template.create.fetchButtonText") %>';
                fetchBtn.disabled = false;
            }
        });
    }
});
</script>
<script>
// Character counter for SMS
const smsContent = document.getElementById('sms_content');
const charCount = document.getElementById('sms-char-count');

if (smsContent && charCount) {
  smsContent.addEventListener('input', function() {
    charCount.textContent = this.value.length;
  });
}

// Phishing SMTP dropdown: load and pre-select saved value if phishType is email
(function () {
    var smtpContainer = document.getElementById('phishing-smtp-container');
    var smtpSelect = document.getElementById('phishing_smtp');
    var smtpError = document.getElementById('phishing-smtp-error');
    var senderEmailInput = document.getElementById('sender_email');
    var savedSmtpId = '<%= template?.phishing_smtp != null ? template.phishing_smtp : "" %>';

    var selectedPhish = document.querySelector('input[name="phishType"]:checked');
    if (selectedPhish && selectedPhish.value === 'email') {
        smtpContainer.classList.remove('hidden');
        smtpSelect.required = true;
        if (senderEmailInput) {
          senderEmailInput.readOnly = true;
          senderEmailInput.classList.add('cursor-not-allowed', 'bg-gray-100');
        }
        fetch('/phm/phishing-smtp/name')
            .then(function (res) { return res.json(); })
            .then(function (data) {
                var list = Array.isArray(data) ? data : (data.smtpList || data.data || data.message || []);
                smtpSelect.innerHTML = '<option value="">' + (window.i18n && window.i18n.__ ? window.i18n.__('system_template.create.selectPhishingSmtp') : '-- Select Email Domain --') + '</option>';

                var matched = savedSmtpId
                    ? list.some(function (item) { return String(item.id) === String(savedSmtpId); })
                    : true;

                if (savedSmtpId && !matched) {
                    var errOpt = document.createElement('option');
                    errOpt.value = '';
                    errOpt.disabled = true;
                    errOpt.selected = true;
                    errOpt.textContent = 'Error: Saved SMTP (ID: ' + savedSmtpId + ') is no longer active or available';
                    smtpSelect.appendChild(errOpt);
                    smtpSelect.classList.add('border-red-400', 'text-red-500');
                } else {
                    list.forEach(function (item) {
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.dataset.senderEmail = item.sender_email || '';
                        opt.textContent = '#' + item.organization_name + ' - ' + item.sender_email;
                        if (String(item.id) === String(savedSmtpId)) {
                            opt.selected = true;
                        }
                        smtpSelect.appendChild(opt);
                    });

                    var selectedOption = smtpSelect.options[smtpSelect.selectedIndex];
                    if (senderEmailInput) {
                      senderEmailInput.value = (selectedOption && selectedOption.dataset ? selectedOption.dataset.senderEmail : '') || '';
                    }

                    smtpSelect.addEventListener('change', function () {
                      var selected = this.options[this.selectedIndex];
                      if (senderEmailInput) {
                        senderEmailInput.value = (selected && selected.dataset ? selected.dataset.senderEmail : '') || '';
                      }
                    });
                }
            })
            .catch(function () {
                smtpError.classList.remove('hidden');
            });
    }
})();

// Insert placeholder into SMS textarea
function insertSMSPlaceholder(placeholder) {
  const textarea = document.getElementById('sms_content');
  if (!textarea) return;
  const start = textarea.selectionStart;
  const end = textarea.selectionEnd;
  const text = textarea.value;
  const placeholderText = '<' + '%=' + placeholder + '%' + '>';
  textarea.value = text.substring(0, start) + placeholderText + text.substring(end);
  textarea.focus();
  textarea.selectionStart = textarea.selectionEnd = start + placeholderText.length;
  document.getElementById('sms-char-count').textContent = textarea.value.length;
}
</script>
