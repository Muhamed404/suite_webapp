<script>
    // Character counter for SMS
    const smsContent = document.getElementById('sms_content');
    const charCount = document.getElementById('sms-char-count');

    if (smsContent && charCount) {
        smsContent.addEventListener('input', function () {
            charCount.textContent = this.value.length;
        });
    }

    // Phishing SMTP dropdown: show when Email is selected, populate via AJAX
    (function () {
        var smtpContainer = document.getElementById('phishing-smtp-container');
        var smtpSelect = document.getElementById('phishing_smtp');
        var smtpError = document.getElementById('phishing-smtp-error');
        var smtpLoaded = false;

        function loadPhishingSmtp() {
            if (smtpLoaded) return;
            console.log('[PhishingSMTP] Fetching from /phm/phishing-smtp/name');
            fetch('/phm/phishing-smtp/name')
                .then(function (res) {
                    // console.log('[PhishingSMTP] HTTP status:', res.status);
                    return res.json();
                })
                .then(function (data) {
                    // console.log('[PhishingSMTP] Raw response:', data);
                    smtpLoaded = true;
                    var list = Array.isArray(data) ? data : (data.smtpList || data.data || data.message || []);
                    // console.log('[PhishingSMTP] Parsed list:', list);
                    smtpSelect.innerHTML = '<option value="">' + (window.i18n.validation_messages.selectPhishingSmtp || '-- Select Phishing SMTP --') + '</option>';
                    list.forEach(function (item) {
                        // console.log('[PhishingSMTP] Adding option:', item);
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.dataset.senderEmail = item.sender_email || '';
                        opt.textContent = '#' + item.organization_name + ' - ' + item.sender_email;
                        smtpSelect.appendChild(opt);
                    });

                    smtpSelect.addEventListener('change', function () {
                        var selected = this.options[this.selectedIndex];
                        document.getElementById('sender_email').value = selected.dataset.senderEmail || '';
                    });
                })
                .catch(function (err) {
                    console.error('[PhishingSMTP] Fetch error:', err);
                    smtpError.classList.remove('hidden');
                });
        }

        function onPhishTypeChange() {
            var selected = document.querySelector('input[name="phishType"]:checked');
            if (selected && selected.value === 'email') {
                smtpContainer.classList.remove('hidden');
                loadPhishingSmtp();
            } else {
                smtpContainer.classList.add('hidden');
            }
        }

        document.querySelectorAll('input[name="phishType"]').forEach(function (radio) {
            radio.addEventListener('change', onPhishTypeChange);
        });
    })();

    // Insert placeholder into SMS textarea
    function insertSMSPlaceholder(placeholder) {
        const textarea = document.getElementById('sms_content');
        if (!textarea) return;

        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const text = textarea.value;
        // Use template literal with escaped characters
        const placeholderText = '<' + '%=' + placeholder + '%' + '>'; // This prevents EJS from parsing it

        textarea.value = text.substring(0, start) + placeholderText + text.substring(end);
        textarea.focus();
        textarea.selectionStart = textarea.selectionEnd = start + placeholderText.length;

        // Update character count
        document.getElementById('sms-char-count').textContent = textarea.value.length;
    }
</script>
