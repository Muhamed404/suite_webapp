<div class="flex flex-col p-6 gap pb-0">
    <div class="flex flex-col gap-2 mb-4 pb-4">
        <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0 mb-2" aria-label="Breadcrumb">
            <a href="/phm/index" class="hover:text-gray-700 transition">
                <%= __("menu.phishmagnus.dashboard") %>
            </a>
            <span class="text-gray-400">›</span>
            <a href="/template/list" class="hover:text-gray-700 transition">
                <%= __("breadcrumbs.systemTemplate") %>
            </a>
            <span class="text-gray-400">›</span>
            <span class="font-semibold text-gray-900">
                <%= __("system_template.create.title") %>
            </span>
        </nav>
        <div>
            <%- include('../../partials/back-button') %>
        </div>
        <h3 class="text-3xl font-medium text-gray-900">
            <%= __("system_template.create.title") %>
        </h3>
    </div>
</div>

<div class="flex flex-col p-6 pt-0">
    <!-- first section  -->
    <div class="flex flex-col p-8 gap-4 mt-3 rounded-3xl bg-white border border-gray-100 shadow-sm">
        <!-- Progress Bar -->
        <div class="overflow-x-auto mb-6">
            <div id="progress" class="flex items-center min-w-max"></div>
        </div>
        <form class="space-y-6" id="templateCreationForm" name="templateCreationForm" method="post"
            action="<%=typeof postMethodUrl !== 'undefined' ? postMethodUrl : '/template/' %>">
            <!-- Steps -->
            <!-- Steps -->
            <div class="step hidden w-full lg:w-3/4">
                <!-- Page Heading -->
                <h1 class="text-3xl font-bold mb-2">
                    <%= __("system_template.create.labelDetails") %>
                </h1>
                <p class="text-gray-600 mb-8">
                    <%= __("system_template.create.labelDescription") %>
                </p>

                <!-- Template Name -->
                <div class="mb-6">
                    <label class="block text-lg font-medium mb-2">
                        <%= __("system_template.create.labelName") %>
                    </label>
                    <input type="text" id="name" name="name"
                        class="w-full border border-gray-300 rounded-lg p-4 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                </div>

                <!-- Purpose -->
                <div class="mb-6">
                    <label class="block text-lg font-medium mb-2">
                        <%= __("system_template.create.labelPurpose") %>
                    </label>
                    <input type="text" name="description_purpose" id="description_purpose"
                        class="w-full border border-gray-300 rounded-lg p-4 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                </div>

                <!-- Language Dropdown -->
                <div class="mb-6 relative">
                    <label class="block text-lg font-medium mb-2">
                        <%= __("system_template.create.labelLanguage") %>
                    </label>
                    <div class="relative">
                        <select name="language" id="language"
                            class="appearance-none w-full border border-gray-300 rounded-lg pl-4 pr-12 py-3 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                            <option value="en">English</option>
                            <option value="ar">Arabic</option>
                        </select>
                        <!-- Custom Dropdown Icon -->

                    </div>
                </div>
                <!-- Phishing Type -->
                <div class="mb-6">
                    <label class="block text-lg font-medium mb-4">
                        <%= __("system_template.create.labelPhishType") %>
                    </label>
                    <div class="flex flex-wrap gap-4">
                        <label class="cursor-pointer">
                            <input type="radio" name="phishType" value="email" class="hidden peer">
                            <div
                                class="px-6 py-2 border rounded-lg peer-checked:border-teal-500 peer-checked:bg-teal-50">
                                Email</div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="phishType" value="nfc" class="hidden peer">
                            <div
                                class="px-6 py-2 border rounded-lg peer-checked:border-teal-500 peer-checked:bg-teal-50">
                                NFC</div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="phishType" value="qr" class="hidden peer">
                            <div
                                class="px-6 py-2 border rounded-lg peer-checked:border-teal-500 peer-checked:bg-teal-50">
                                QR
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="phishType" value="sms" class="hidden peer">
                            <div
                                class="px-6 py-2 border rounded-lg peer-checked:border-teal-500 peer-checked:bg-teal-50">
                                SMS</div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="phishType" value="whatsapp" class="hidden peer">
                            <div
                                class="px-6 py-2 border rounded-lg peer-checked:border-teal-500 peer-checked:bg-teal-50">
                                WhatsApp</div>
                        </label>


                    </div>
                </div>

            </div>
            <div class="step hidden">
                <h2 class="text-2xl font-bold mb-2" id="step-heading">
                    <%= __("system_template.create.labelTrackingDetails") %>
                </h2>
                <p class="text-gray-500 mb-4  w-full lg:w-3/4" id="step-subheading">
                    <%= __("system_template.create.labelTrackingDescription") %>
                </p>
                <div id="checkbox-options" class="space-y-4">
                    <!-- Dynamic options will be injected here -->
                </div>
            </div>
            <div class="step hidden">
                <h2 class="text-2xl font-bold mb-2" id="step-heading">
                    <%= __("system_template.create.labelDetails_level2_title") %>
                </h2>
                <p class="text-gray-500 mb-6">
                    <%= __("system_template.create.labelDetails_level2_Description") %>
                </p>

                <!-- Dropdown -->
                <div class="mb-6 relative  w-full lg:w-3/4">
                    <label class="block text-lg font-medium mb-2">
                        <%= __("system_template.create.labelDetails_level2_FileExtension") %>
                    </label>
                    <div class="relative">
                        <select name="file_extension" id="file_extension"
                            class="appearance-none w-full border border-gray-300 rounded-lg pl-4 pr-12 py-3 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                            <option value="pdf">PDF</option>
                            <option value="docx">DOCX</option>
                            <option value="xlsx">XLSX</option>
                            <option value="exe">EXE</option>

                        </select>

                    </div>
                </div>


                <!-- Input -->
                <div>
                    <label class="block text-base font-semibold mb-2">
                        <%= __("system_template.create.labelDetails_level2_FileName") %>
                    </label>
                    <input type="text" name="file_name"
                        class="w-full lg:w-3/4 px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-600 placeholder-gray-400 focus:outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500 transition">
                </div>
            </div>
            <div class="step hidden">
                <h2 class="text-2xl font-bold mb-2">
                    <%= __("system_template.create.labelDetails_level1_title") %>
                </h2>



                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 auto-rows-max">
                    <!-- Email Subject -->
                    <div id="email-content">
                        <label class="block text-base font-semibold mb-2">
                            <%= __("system_template.create.labelDetails_level1_Subject") %>
                        </label>
                        <input type="text" name="subject"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-600 placeholder-gray-400 focus:outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500 transition">
                    </div>

                    <!-- Phishing SMTP (Email only) -->
                    <div id="phishing-smtp-container" class="mb-6 hidden">
                        <label class="block text-base font-semibold mb-2">
                            <%= __("system_template.create.email_domain") %>
                        </label>
                        <div class="relative">
                            <select name="phishing_smtp" id="phishing_smtp"
                                class="appearance-none w-full border border-gray-300 rounded-lg pl-4 pr-12 py-3 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                <option value=""><%= __("system_template.create.select_email_domain") %></option>
                            </select>
                        </div>
                        <p id="phishing-smtp-error" class="text-red-500 text-sm mt-1 hidden"><%= __("system_template.create.failed_to_load_smtp_configurations") %></p>
                    </div>

                    <!-- Sender Email -->
                    <div id="divSenderEmail">
                        <label class="block text-base font-semibold mb-2">
                            <%= __("system_template.create.labelDetails_level1_SenderEmail") %>
                        </label>
                        <input type="text" name="sender_email" id="sender_email"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-600 placeholder-gray-400 focus:outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500 transition">
                    </div>

                    <!-- Sender Name -->
                    <div>
                        <label class="block text-base font-semibold mb-2">
                            <%= __("system_template.create.labelDetails_level1_SenderName") %>
                        </label>
                        <input type="text" name="sender_display_name" id="sender_display_name"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-600 placeholder-gray-400 focus:outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500 transition">
                    </div>

                    <!-- Simulated Company Name -->
                    <div>
                        <label class="block text-base font-semibold mb-2">
                            <%= __("system_template.create.labelDetails_level1_CompanyName") %>
                        </label>
                        <input type="text" name="company_name" id="companyName"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-600 placeholder-gray-400 focus:outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500 transition">
                    </div>

                                    <!-- Company Domain -->
                <div>
                    <label class="block text-base font-semibold mb-2">
                        <%= __("system_template.create.labelDetails_level1_CompanyDomain") %>
                    </label>
                    <input type="text" name="company_domain" id="companyDomain"
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-600 placeholder-gray-400 focus:outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500 transition">
                </div>
                </div>


                <!-- Email Message with CKEditor -->
                <div>
                    <label class="block text-base font-semibold mb-2">
                        <%= __("system_template.create.labelDetails_level1_Content") %>
                    </label>
                    <textarea name="phishing_content" id="phishing_content" rows="10" cols="80"></textarea>
                    <div id="placeholder_buttons_phishing_content" class="flex flex-wrap gap-3 mt-4">
                        <button type="button" id="tag_first_name"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('first_name')">
                            <%= __("system_template.placeHolder_firstName") %>
                        </button>
                        <button type="button" id="tag_last_name"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('last_name')">
                            <%= __("system_template.placeHolder_lastName") %>
                        </button>
                        <button type="button" id="tag_email"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('email')">
                            <%= __("system_template.placeHolder_email") %>
                        </button>
                        <button type="button" id="tag_current_date"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('current_date')">
                            <%= __("system_template.placeHolder_currentDate") %>
                        </button>
                        <button type="button" id="tag_current_time"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('current_time')">
                            <%= __("system_template.placeHolder_currentTime") %>
                        </button>
                        <button type="button" id="tag_phishing_url"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('phishing_url')">
                            <%= __("system_template.placeHolder_phishingLink") %>
                        </button>
                        <button type="button" id="tag_phishing_file"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('phishing_file')">
                            <%= __("system_template.placeHolder_phishingFile") %>
                        </button>
                        <button type="button" id="tag_sender"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('sender')">
                            <%= __("system_template.placeHolder_sender") %>
                        </button>
                        <button type="button" id="tag_company"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('company')">
                            <%= __("system_template.placeHolder_company") %>
                        </button>
                        <button type="button" id="tag_company_domain"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('company_domain')">
                            <%= __("system_template.placeHolder_companyDomain") %>
                        </button>
                    </div>
                </div>


            </div>
            <div class="step hidden">
                <!-- Heading -->
                <h2 class="text-2xl font-bold mb-2">
                    <%= __("system_template.create.labelDetails_level3_title") %>
                </h2>
                <p class="text-gray-500 mb-6">
                    <%= __("system_template.create.labelDetails_level3_Description") %>
                </p>

                <!-- Options -->
                <div class="flex flex-col gap-6">

                    <!-- Option 1 -->
                    <label class="flex items-start gap-4 custom-radio">
                        <input type="radio" name="phish_option" value="simple">
                        <span class="radio-circle"></span>
                        <span class="text-lg font-medium">
                            <%= __("system_template.create.labelDetails_level3_radioOption1") %>
                        </span>
                    </label>

                    <!-- Option 2 -->
                    <label class="flex items-start gap-4 custom-radio">
                        <input type="radio" name="phish_option" value="data-entry">
                        <span class="radio-circle"></span>
                        <span class="text-lg font-medium">
                            <%= __("system_template.create.labelDetails_level3_radioOption2") %>
                        </span>
                    </label>

                    <!-- Option 3 hide it temporary -->
                    <label style="display: none;" class="flex items-start gap-4 custom-radio">
                        <input type="radio" name="phish_option" value="custom-url">
                        <span class="radio-circle"></span>
                        <span class="text-lg font-medium">
                            <%= __("system_template.create.labelDetails_level3_radioOption3") %>
                        </span>
                    </label>
                </div>

                <!-- Conditional Input -->
                <div id="custom-url-input" class="mt-6 hidden">
                    <label for="website" class="block text-sm text-gray-700 mb-2">
                        <%= __("system_template.create.labelDetails_level3_CustomPhishPageURL") %>
                    </label>
                    <input type="text" id="website" name="phish_url"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-400">
                </div>
            </div>
            <div class="step hidden">
                <!-- Heading -->
                <h1 class="text-2xl font-semibold mb-1">
                    <%= __("system_template.create.labelDetails_level3_radioOption1_Content") %>
                </h1>
                <p class="text-gray-500 mb-6">
                    <%= __("system_template.create.labelDetails_level3_Description") %>
                </p>

                <!-- CKEditor container -->
                <div>
                    <label class="block text-base font-semibold mb-2">
                        <%= __("system_template.create.labelPhishingWebContentEditor") %>
                    </label>
                    <textarea name="phishing_page_content" id="phishing_page_content" rows="10" cols="80"></textarea>
                    <div id="placeholder-buttons" class="flex flex-wrap gap-3 mt-4" style="display:none;">
                        <button type="button" id="tag_first_name"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('first_name')">
                            <%= __("system_template.placeHolder_firstName") %>
                        </button>
                        <button type="button" id="tag_last_name"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('last_name')">
                            <%= __("system_template.placeHolder_lastName") %>
                        </button>
                        <button type="button" id="tag_email"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('email')">
                            <%= __("system_template.placeHolder_email") %>
                        </button>
                        <button type="button" id="tag_current_date"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('current_date')">
                            <%= __("system_template.placeHolder_currentDate") %>
                        </button>
                        <button type="button" id="tag_current_time"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('current_time')">
                            <%= __("system_template.placeHolder_currentTime") %>
                        </button>
                        <button type="button" id="tag_phishing_url" style="display:none;"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('phishing_url')">
                            <%= __("system_template.placeHolder_phishingLink") %>
                        </button>
                        <button type="button" id="tag_phishing_file"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('phishing_file')">
                            <%= __("system_template.placeHolder_phishingFile") %>
                        </button>
                        <button type="button" id="tag_sender"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('sender')">
                            <%= __("system_template.placeHolder_sender") %>
                        </button>
                        <button type="button" id="tag_company"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('company')">
                            <%= __("system_template.placeHolder_company") %>
                        </button>
                        <button type="button" id="tag_company_domain"
                            class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                            onclick="insertPlaceholder('company_domain')">
                            <%= __("system_template.placeHolder_companyDomain") %>
                        </button>
                    </div>
                </div>
            </div>
            <div class="step hidden">
                <!-- Heading -->
                <h1 class="text-2xl font-semibold mb-1">
                    <%= __("system_template.create.labelLandingPage_Title") %>
                </h1>
                <p class="text-gray-500 mb-6">
                    <%= __("system_template.create.labelDetails_level3_Description") %>
                </p>

                <!-- Radio Buttons -->

                <div class="space-y-4 mb-6">
                    <!-- <label class="flex items-center custom-radio cursor-pointer">
                        <input type="radio" name="landing_option" value="link" id="landing_option_link">
                        <span class="radio-circle"></span>
                        <span class="text-gray-700">
                            <%= __("system_template.create.labelLandingPage_radioOption1") %>
                        </span>
                    </label> -->
                    <label class="flex items-center custom-radio cursor-pointer">
                        <input type="radio" name="landing_option" value="custom" id="landing_option_custom">
                        <span class="radio-circle"></span>
                        <span class="text-gray-700">
                            <%= __("system_template.create.labelLandingPage_radioOption2") %>
                        </span>
                    </label>
                </div>
                <!-- Import field for link option -->
                <!-- <div id="import-html-url-container" class="mb-6" style="display:none;">
                    <label for="import-html-url" class="block text-gray-700 font-medium mb-2">
                        <%= __('system_template.create.labelImportHtmlUrl') || 'Import HTML Template from URL' %>
                    </label>
                    <div class="flex gap-2">
                        <input type="url" id="import-html-url" name="import_html_url"
                            placeholder="https://example.com/template.html"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-400">
                        <button type="button" id="fetch-html-template"
                            class="bg-teal-400 text-white px-4 py-2 rounded-lg hover:bg-teal-500 transition">Fetch</button>
                    </div>
                    <div id="import-html-url-error" class="text-red-500 text-sm mt-2" style="display:none;"></div>
                </div> -->


                <!-- Custom Page Setting (hidden initially) -->
                <div id="editor-container">
                    <label for="editor" style="display: none;" class="block text-gray-700 font-medium mb-2">Custom Page
                        Setting</label>
                    <div>
                        <label class="block text-base font-semibold mb-2">
                            <%= __("system_template.create.labelLandingPageContentEditor") %>
                        </label>
                        <textarea name="landing_page_content" id="landing_page_content" rows="10" cols="80"></textarea>
                        <!-- Dynamic Placeholder Buttons (only for this step) -->
                        <div id="placeholder_buttons_landing_page_content" class="flex flex-wrap gap-3 mt-4"
                            style="display:none;">
                            <button type="button" id="tag_first_name"
                                class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-50"
                                onclick="insertPlaceholder('first_name')">
                                <%= __("system_template.placeHolder_firstName") %>
                            </button>
                            <button type="button" id="tag_last_name"
                                class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-200 transition"
                                onclick="insertPlaceholder('last_name')">
                                <%= __("system_template.placeHolder_lastName") %>
                            </button>
                            <button type="button" id="tag_email"
                                class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-200 transition"
                                onclick="insertPlaceholder('email')">
                                <%= __("system_template.placeHolder_email") %>
                            </button>
                            <button type="button" id="tag_current_date"
                                class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-200 transition"
                                onclick="insertPlaceholder('current_date')">
                                <%= __("system_template.placeHolder_currentDate") %>
                            </button>
                            <button type="button" id="tag_current_time"
                                class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-200 transition"
                                onclick="insertPlaceholder('current_time')">
                                <%= __("system_template.placeHolder_currentTime") %>
                            </button>
                            <button type="button" id="tag_phishing_url"
                                class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-200 transition"
                                onclick="insertPlaceholder('phishing_url')">
                                <%= __("system_template.placeHolder_phishingLink") %>
                            </button>
                            <button type="button" id="tag_phishing_file"
                                class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-200 transition"
                                onclick="insertPlaceholder('phishing_file')">
                                <%= __("system_template.placeHolder_phishingFile") %>
                            </button>
                            <button type="button" id="tag_sender"
                                class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-200 transition"
                                onclick="insertPlaceholder('sender')">
                                <%= __("system_template.placeHolder_sender") %>
                            </button>
                            <button type="button" id="tag_company"
                                class="px-4 py-2 text-teal-500 border border-teal-500 rounded-full hover:bg-teal-200 transition"
                                onclick="insertPlaceholder('company')">
                                <%= __("system_template.placeHolder_company") %>
                            </button>
