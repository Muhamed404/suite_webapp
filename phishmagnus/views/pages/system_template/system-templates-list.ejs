<div class="flex flex-col p-6 gap">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div class="flex-1">
      <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0 mb-2" aria-label="Breadcrumb">
        <a href="/phm/index" class="hover:text-gray-700 transition">
          <%= __("menu.phishmagnus.dashboard") %>
        </a>
        <span class="text-gray-400">›</span>
        <span class="font-semibold text-gray-900">
          <%= __(breadcrumbs) %>
        </span>
      </nav>
      <h3 class="text-3xl font-medium">
        <%= __(breadcrumbs) %>
      </h3>
    </div>
    <div>
      <%if(!disableOption.disableCreateTemplate) { %>
        <a href="<%= typeof organization !== 'undefined' ? '/phm/template/create' : '/template/create' %>"
          class="flex items-center justify-center gap-2 px-5 py-2 rounded-full bg-teal-600 text-white font-semibold shadow hover:bg-teal-700 transition-all duration-200 border border-teal-600 hover:border-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-400 lg:order-2"
          title="<%= __('system_template.homescreen.btnCreateTemplate') %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none" />
            <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              d="M12 8v8m-4-4h8" />
          </svg>
          <span class="hidden sm:inline"><%= __('system_template.homescreen.btnCreateTemplate') %></span>
        </a>
      <%}%>
    </div>
  </div>
</div>

<div class="flex flex-col p-6 pt-0">
  <div class="flex flex-col rounded-3xl bg-white border border-gray-100 shadow-sm">
    <div class="px-6 pt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-start">
      <select id="templatePhishTypeFilter"
        class="px-6 py-3 rounded-full border border-gray-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[var(--teal)]">
        <option value="all" <%= selectedPhishType.key === 'all' ? 'selected' : '' %>><%= __("all_campaigns.filterAll") %></option>
        <% (typeOptions || []).forEach(type => { %>
          <option value="<%= type.key %>" <%= selectedPhishType.key === type.key ? 'selected' : '' %>><%= type.label %></option>
        <% }) %>
      </select>
    </div>

    <div class="p-6">
      <table id="filter-table" class="min-w-full border-none text-sm text-left text-gray-700" data-placeholder="<%= __('generic_label.search_here') %>" data-per-page="<%= __('entries per page') %>" data-info="<%= __('generic_label.showing') %> {start} <%= __('generic_label.to') %> {end} <%= __('generic_label.of') %> {rows} <%= __('entries') %>" data-no-rows="<%= __('generic_label.no_entries_found') %>">
        <thead class="bg-gray-50 text-gray-600 text-xs">
          <tr>
            <th class="px-4 py-3 text-sm font-normal">
              <img src="/securemagnus_2025/images/package_management/sort.svg" alt="Sort" class="size-3.5 ml-3 inline">
              <%= __("system_template.homescreen.labelTemplateName") %>
            </th>
            <th class="px-4 py-3 text-sm font-normal">
              <img src="/securemagnus_2025/images/package_management/sort.svg" alt="Sort" class="size-3.5 ml-3 inline">
              <%= __("system_template.homescreen.labelPhishType") %>
            </th>
            <th class="px-4 py-3 text-sm font-normal">
              <img src="/securemagnus_2025/images/package_management/sort.svg" alt="Sort" class="size-3.5 ml-3 inline">
              <%= __("system_template.homescreen.labelSubject") %>
            </th>
            <th class="px-4 py-3 text-sm font-normal">
              <%= __("system_template.homescreen.labelLanguage") %>
            </th>
            <th class="px-4 py-3 text-sm font-normal">
              <%= __("system_template.homescreen.labelCategory") %>
            </th>
            <th class="px-4 py-3 text-sm font-normal">
              <%= __("system_template.homescreen.labelAction") %>
            </th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof templates !=='undefined' ) { templates.forEach(tpl=> { %>
            <tr class="bg-white border-b hover:bg-gray-50">
              <td class="px-6 py-3">
                <%= tpl.name %>
              </td>
              <td class="px-6 py-3 whitespace-nowrap">
                <%= tpl.PhishingCampaignType.name %>
              </td>
              <td class="px-6 py-3 whitespace-nowrap">
                <%= tpl.subject %>
              </td>
              <td class="px-6 py-3 whitespace-nowrap">
                <%= tpl.language==='en' ? 'English' : tpl.language==='ar' ? 'Arabic' : tpl.language %>
              </td>
              <td class="px-6 py-3 whitespace-nowrap">
                <%= tpl.PhishingCategory ? tpl.PhishingCategory.name : __('Unknown') %>
              </td>
              <td class="px-6 py-3 whitespace-nowrap text-left">
                <div class="flex items-center gap-2" dir="ltr">
                  <!-- Edit -->
                  <%if(!disableOption.disableEdit) {%>
                    <a href="<%= typeof organization === 'undefined' ? '/template/view/' + tpl.id : '/phm/template/view/' + tpl.id %>"
                      class="inline-flex items-center justify-center w-9 h-9 rounded-md bg-blue-600 hover:bg-blue-700 text-white transition"
                      role="button" data-toggle="tooltip" data-placement="left"
                      title="<%= __('system_template.homescreen.btnEditTemplate') %>">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5h6M4 21l7-7 9-9-4-4-9 9-7 7z">
                        </path>
                      </svg>
                    </a>
                    <%}%>
                      <%if (!disableOption.disableDelete) {%>
<% const deleteUrl = typeof organization === 'undefined' ? '/template/delete/' + tpl.id : '/phm/template/delete/' + tpl.id; %>

                        <!-- Delete -->
                        <button type="button"
                          data-url="<%= deleteUrl %>"
                          data-name="<%= tpl.name %>"
                          class="inline-flex items-center justify-center w-9 h-9 rounded-md bg-amber-500 hover:bg-amber-600 text-white transition"
                          role="button" data-toggle="tooltip" data-placement="left"
                          title="<%= __('system_template.homescreen.btnDeleteTemplate') %>">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                              d="M19 7L5 7M10 11v6M14 11v6M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2">
                            </path>
                          </svg>
                        </button>
                        <%}%>
                          <!-- Clone Template Only visible in System Templates -->
                          <%if (!disableOption.disableCloneOption) {%>
                            <a href="<%= '/template/duplicate/' + tpl.id%>"
                              class="inline-flex items-center justify-center w-9 h-9 rounded-md bg-green-600 hover:bg-green-700 text-white transition"
                              role="button" data-toggle="tooltip" data-placement="left"
                              title="<%= __('tooltp-Template-Duplicate') %>">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"
                                viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
                                focusable="false">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M8 7H6a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-2"></path>
                                <rect x="9" y="3" width="11" height="11" rx="2" ry="2" stroke-linecap="round"
                                  stroke-linejoin="round"></rect>
                              </svg>
                            </a>
                            <%}%>
                </div>
              </td>
            </tr>
            <% }); } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

  <div id="deleteConfirmModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-40 hidden">
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-sm">
      <h2 class="text-lg font-semibold mb-4">Delete</h2>
      <p class="mb-6" id="deleteConfirmText">Are you sure you want to delete this item?</p>
      <div class="flex justify-end gap-3">
        <button id="cancelDeleteConfirm" class="px-4 py-2 rounded bg-gray-200 hover:bg-gray-300">Cancel</button>
        <button id="confirmDeleteBtn" class="px-4 py-2 rounded bg-red-600 text-white hover:bg-red-700">Delete</button>
      </div>
    </div>
  </div>

  <script>
document.addEventListener('DOMContentLoaded', function() {
  const typeFilter = document.getElementById('templatePhishTypeFilter');
  if (typeFilter) {
    typeFilter.addEventListener('change', function() {
      const url = new URL(window.location.href);
      const selectedValue = this.value || 'all';

      if (selectedValue === 'all') {
        url.searchParams.delete('phishType');
      } else {
        url.searchParams.set('phishType', selectedValue);
      }

      window.location.href = url.toString();
    });
  }

  let deleteConfirmInfo = { url: null, name: '' };

  function showDeleteConfirm(url, name) {
    deleteConfirmInfo = { url, name };
    const modal = document.getElementById('deleteConfirmModal');
    if (!modal) return;
    const header = modal.querySelector('h2');
    const textEl = modal.querySelector('#deleteConfirmText');
    if (header) header.textContent = window.__ ? window.__('system_template.homescreen.confirmDeleteTitle') || 'Delete' : 'Delete';
    if (textEl) textEl.innerHTML = window.__ ? (window.__('system_template.homescreen.confirmDelete') || `Delete "${name}"?`) : `Delete "${name}"?`;
    modal.classList.remove('hidden');
  }

  document.addEventListener('click', function(event) {
    const btn = event.target.closest('button[data-url]');
    if (!btn) return;
    event.preventDefault();
    event.stopPropagation();

    const url = btn.getAttribute('data-url');
    const name = btn.getAttribute('data-name') || '';

    showDeleteConfirm(url, name);
  });

  const modal = document.getElementById('deleteConfirmModal');
  const cancelBtn = document.getElementById('cancelDeleteConfirm');
  const confirmBtn = document.getElementById('confirmDeleteBtn');
  if (cancelBtn) cancelBtn.onclick = function() { if (modal) modal.classList.add('hidden'); };
  if (confirmBtn) confirmBtn.onclick = function() {
    if (modal) modal.classList.add('hidden');
    if (deleteConfirmInfo.url) deleteTemplate(deleteConfirmInfo.url, deleteConfirmInfo.name);
  };
});

function deleteTemplate(url, templateName) {
  fetch(url, {
    method: 'DELETE',
    credentials: 'same-origin',
    headers: {
      'Content-Type': 'application/json',
      'X-Requested-With': 'XMLHttpRequest'
    },
    body: JSON.stringify({ name: templateName })
  })
    .then(response => {
      if (!response.ok) console.warn('[Delete] non-ok response', response.status);
      setTimeout(() => window.location.reload(), 500);
    })
    .catch(error => {
      console.error('Error:', error);
      setTimeout(() => window.location.reload(), 1000);
    });
}
</script>

