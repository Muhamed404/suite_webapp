<div class="container mx-auto px-4 py-8">
  <div class="bg-white rounded-2xl shadow-lg max-w-2xl mx-auto">
    <div class="border-b px-8 py-4 rounded-t-2xl bg-blue-600">
      <h3 class="text-xl font-semibold text-white"><%= __("CS-Add") %></h3>
    </div>
    <div class="px-8 py-6">
      <% if (typeof message !== 'undefined' && message) { %>
        <div class="mb-4 p-4 rounded <%= alertType === 'error' ? 'bg-red-100 border border-red-400 text-red-700' : 'bg-green-100 border border-green-400 text-green-700' %>">
          <%= message %>
        </div>
      <% } %>

      <form
        id="cybersecurityCategoriesForm"
        method="POST"
        action="/cybersecurity/categories/"
        class="space-y-6"
        novalidate
      >
        <div>
          <label for="name" class="block text-sm font-medium mb-1">
            <%= __("CS-Name") %> *
          </label>
          <input
            class="form-control w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
            id="name"
            name="name"
            type="text"
            value="<%= formData?.name || '' %>"
            required
            minlength="3"
          />
          <p class="text-xs text-gray-500 mt-1">Minimum 3 characters</p>
        </div>
        <div>
          <label for="code" class="block text-sm font-medium mb-1">
            <%= __("CS-Code") %> *
          </label>
          <input
            class="form-control w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
            id="code"
            name="code"
            type="text"
            value="<%= formData?.code || '' %>"
            required
            minlength="3"
            maxlength="3"
            placeholder="e.g., ABC"
          />
          <p class="text-xs text-gray-500 mt-1">Must be exactly 3 characters</p>
        </div>
        <div>
          <label for="description" class="block text-sm font-medium mb-1">
            <%= __("CS-Description") %> *
          </label>
          <input
            class="form-control w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
            id="description"
            name="description"
            type="text"
            value="<%= formData?.description || '' %>"
            required
          />
        </div>
        <div class="flex justify-start gap-3 pt-2">
          <button class="px-6 py-2 rounded bg-green-600 text-white hover:bg-green-700 transition" type="submit">
            <%= __("btn-CS-Save") %>
          </button>
          <a href="/cybersecurity/categories/list" class="px-6 py-2 rounded bg-gray-200 text-gray-700 hover:bg-gray-300 transition inline-block text-center">
            <%= __("btn-CS-Cancel") %>
          </a>
        </div>
      </form>
    </div>
  </div>
</div>


