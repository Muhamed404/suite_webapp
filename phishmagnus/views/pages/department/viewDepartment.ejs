<div class="flex flex-col p-6 gap">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div class="flex-1">
      <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0 mb-2" aria-label="Breadcrumb">
        <a href="/home" class="hover:text-gray-700 transition">
          <%= __("breadcrumbs.home") %>
        </a>
        <span class="text-gray-400">›</span>
        <span class="font-semibold text-gray-900">
          <%= __("breadcrumbs.department") %>
        </span>
      </nav>
      <h3 class="text-3xl font-medium">
        <%= __("department.labelDepartmentManagement") %>

      </h3>
    </div>
    <div class="p-0 text-sm lg:order-3">
      <ul class="flex items-center gap-2">
        <!-- You can add tab/filter items here if needed -->
      </ul>
    </div>
    <a id="createDepartmentBtn" href="/department"
      class="flex items-center justify-center gap-2 px-5 py-2 rounded-full bg-teal-600 text-white font-semibold shadow hover:bg-teal-700 transition-all duration-200 border border-teal-600 hover:border-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-400 lg:order-2"
      title="<%= __(" generic_label.create") %>">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none" />
        <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          d="M12 8v8m-4-4h8" />
      </svg>
    </a>
  </div>
</div>

<div class="flex flex-col  py-6 pt-0">
  <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white">
    <!-- Search & Filter -->
    <div class="flex flex-col items-center justify-between gap-3 px-5 pt-5">


      <table id="filter-table" class="min-w-full border-none  text-sm text-left text-gray-700" data-placeholder="<%= __('generic_label.search_here') %>" data-per-page="<%= __('entries per page') %>" data-info="<%= __('generic_label.showing') %> {start} <%= __('generic_label.to') %> {end} <%= __('generic_label.of') %> {rows} <%= __('entries') %>" data-no-rows="<%= __('generic_label.no_entries_found') %>">
        <thead class="bg-gray-50 text-gray-600  text-xs">
          <tr>


            <th class="px-4 py-5 text-sm font-normal">
              <%= __("department.labelDepartmentName") %>


                <img src="/securemagnus_2025/images/package_management/sort.svg" alt="" class="size-3.5 ml-3 inline">
            </th>
            <th class="px-4 py-5">
              <img src="/securemagnus_2025/images/package_management/Package_Management_Type.svg" alt="Type"
                class=" inline">
              <%= __("department.labelDescription") %>

                <span></span><img src="/securemagnus_2025/images/package_management/sort.svg" alt="License Cost"
                  class="size-3.5 ml-3 inline">
            </th>
            <th class="px-4 py-5">
              <img src="/securemagnus_2025/images/package_management/Package_Management_Type.svg" alt="Type"
                class=" inline">
              <%= __("department.labelUserEnroll") %>


                <span></span><img src="/securemagnus_2025/images/package_management/sort.svg" alt="License Cost"
                  class="size-3.5 ml-3 inline">
            </th>

            <th class="px-4 py-5">
              <img src="/securemagnus_2025/images/package_management/package_management_user_range_form.svg"
                alt="User From" class=" inline">
              <%= __("department.labelViewUser") %>


            </th>
            <th class="px-4 py-5"><%= __("generic_label.actions") %></th>

          </tr>
        </thead>
        <tbody>
          <% if (typeof departments !=='undefined' ){ departments.forEach((dept,index)=> { %>

            <tr class="bg-white border-b hover:bg-gray-50">


              <td class="px-6 py-6 whitespace-nowrap  ">
                <%= dept.name %>

              </td>
              <td class="px-6 py-6 whitespace-nowrap  ">
                <%= dept.description %>

              </td>

              <td class="px-6 py-6 whitespace-nowrap  ">
                <%= dept.user_count %>

              </td>

              <td class="px-6 py-6 whitespace-nowrap  ">

                <button data-department-id="<%=dept.id%>" data-organization-id="<%=organization%>"
                  class="open-modal px-6 py-3 bg-teal-500 text-white font-semibold rounded-lg hover:bg-teal-600 transition">
                  <%= __("department.labelViewUser") %>

                </button>
              </td>
              <td class="px-6 py-6 whitespace-nowrap">
                <button type="button"
                  data-url="/department/delete/<%=dept.id%>"
                  data-name="<%= dept.name %>"
                  class="delete-dept-btn inline-flex items-center justify-center w-9 h-9 rounded-md bg-amber-500 hover:bg-amber-600 text-white transition"
                  role="button" data-toggle="tooltip" data-placement="left"
                  title="<%= __('department.action_delete') %>">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M19 7L5 7M10 11v6M14 11v6M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2">
                    </path>
                  </svg>
                </button>
              </td>

            </tr>

            <% });}%>
        </tbody>
      </table>

    </div>
  </div>
</div>




<!-- Modal -->
<div id="popup" class="fixed inset-0 hidden bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-2xl  w-[950px] max-h-[90vh] flex flex-col">

    <!-- Header -->
    <div class="flex justify-between items-center p-5 border-b bg-gradient-to-r rounded-t-2xl">
      <h2 class="text-xl font-bold"><%= __("department.selectedUsers") %></h2>
      <button onclick="closeModal()" class=" text-2xl hover:text-red-400">&times;</button>
    </div>

    <!-- Body -->
    <div class="flex gap-6 p-6 flex-1 overflow-y-auto">

      <!-- Enrolled -->
      <div class="flex-1 border rounded-xl p-4   bg-white flex flex-col">
        <input type="text" id="enrolledSearch" onkeyup="filterTable('enrolledSearch','enrolledTable')"
          placeholder="<%= __("department.searchEnrolled") %>"
          class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-400 mb-4 text-sm">
        <h3 class="text-lg font-semibold text-gray-800 mb-3"><%= __("department.enrolled") %></h3>

        <!-- Modern Table -->
        <div class="overflow-hidden rounded-lg flex-1 flex flex-col border">
          <div class="overflow-y-auto max-h-64">
            <table class="w-full text-sm text-left border-collapse" id="enrolledTable">
              <thead class="bg-gray-100 sticky top-0 z-10 text-gray-700">
                <tr>
                  <th class="px-4 py-2 border text-center w-12">
                    <input type="checkbox" onclick="toggleAll(this,'enrolledCheckbox')">
                  </th>
                  <th class="px-4 py-2 border"><%= __("department.firstName") %></th>
                  <th class="px-4 py-2 border"><%= __("department.lastName") %></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">

              </tbody>
            </table>
          </div>
        </div>

        <button onclick="moveToUnenrolled()"
          class="mt-4 px-4 py-2 bg-red-100 text-red-700 border border-red-300 rounded-lg hover:bg-red-200 transition">
          <%= __("department.moveToUnenrolled") %>
        </button>
      </div>

      <!-- Unenrolled -->
      <div class="flex-1 border rounded-xl p-4   bg-white flex flex-col">
        <input type="text" id="unenrolledSearch" onkeyup="filterTable('unenrolledSearch','unenrolledTable')"
          placeholder="<%= __("department.searchUnenrolled") %>"
          class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-teal-400 mb-4 text-sm">
        <h3 class="text-lg font-semibold text-gray-800 mb-3"><%= __("department.unenrolled") %></h3>

        <!-- Modern Table -->
        <div class="overflow-hidden rounded-lg   flex-1 flex flex-col border">
          <div class="overflow-y-auto max-h-64">
            <table class="w-full text-sm text-left border-collapse" id="unenrolledTable">
              <thead class="bg-gray-100 sticky top-0 z-10 text-gray-700">
                <tr>
                  <th class="px-4 py-2 border text-center w-12">
                    <input type="checkbox" onclick="toggleAll(this,'unenrolledCheckbox')">
                  </th>
                  <th class="px-4 py-2 border"><%= __("department.firstName") %></th>
                  <th class="px-4 py-2 border"><%= __("department.lastName") %></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">

              </tbody>
            </table>
          </div>
        </div>

        <button onclick="moveToEnrolled()"
          class="mt-4 px-4 py-2 bg-green-100 text-green-700 border border-green-300 rounded-lg hover:bg-green-200 transition">
          <%= __("department.moveToEnrolled") %>
        </button>
      </div>
    </div>

    <!-- Footer -->
    <div class="p-5 border-t bg-gray-50 flex justify-center">
      <button onclick="closeModal()"
        class="px-8 py-3 bg-teal-500  text-white font-semibold rounded-full   hover:opacity-90 transition">
        <%= __("department.done") %>
      </button>
    </div>
  </div>
</div>

<div id="deleteConfirmModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-40 hidden">
  <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-sm">
    <h2 class="text-lg font-semibold mb-4"><%= __('department.delete_confirm_title') %></h2>
    <p class="mb-6" id="deleteConfirmText" dir="auto"><%= __('department.delete_confirm_message') %></p>
    <div class="flex justify-end gap-3">
      <button id="cancelDeleteConfirm" class="px-4 py-2 rounded bg-gray-200 hover:bg-gray-300"><%= __('department.btn_cancel') %></button>
      <button id="confirmDeleteBtn" class="px-4 py-2 rounded bg-red-600 text-white hover:bg-red-700"><%= __('department.btn_delete') %></button>
    </div>
  </div>
</div>

<script>
  window.departmentTranslations = {
    noEnrolledUsers: '<%= __("department.noEnrolledUsers") %>',
    noUnenrolledUsers: '<%= __("department.noUnenrolledUsers") %>'
  };
</script>
<script src="/securemagnus_2025/js/multiselect-encrollment-users.js"></script>
<script src="/securemagnus_2025/js/custom_script/department-multiselect-jquery.js"></script>
<script>
  (function () {
    const params = new URLSearchParams(window.location.search);
    const orgName = params.get('On');
    const createBtn = document.getElementById('createDepartmentBtn');
    const orgId = '<%= typeof organization !== "undefined" ? organization : "" %>';

    if (createBtn) {
      const searchParams = new URLSearchParams();
      if (orgId) searchParams.set('orgId', orgId);
      if (orgName) searchParams.set('On', orgName);
      if ([...searchParams.keys()].length) {
        createBtn.href = `/department?${searchParams.toString()}`;
      }
    }
  })();

  // Localization for JavaScript
  window.departmentTranslations = {
    noUnenrolledUsers: '<%= __("department.noUnenrolledUsers") %>'
  };

  document.addEventListener('DOMContentLoaded', function() {
    let deleteConfirmInfo = { url: null, name: '' };
    const modal = document.getElementById('deleteConfirmModal');
    const modalCard = modal ? modal.querySelector('.bg-white') : null;
    const cancelBtn = document.getElementById('cancelDeleteConfirm');
    const confirmBtn = document.getElementById('confirmDeleteBtn');
    const textEl = document.getElementById('deleteConfirmText');
    const deleteConfirmBaseText = '<%= __('department.delete_confirm_message') %>';
    const isRtl = document.documentElement.getAttribute('dir') === 'rtl' || (document.documentElement.getAttribute('lang') || '').toLowerCase().startsWith('ar');

    if (modalCard) {
      modalCard.setAttribute('dir', isRtl ? 'rtl' : 'ltr');
      modalCard.classList.add(isRtl ? 'text-right' : 'text-left');
    }

    function showDeleteConfirm(url, name) {
      deleteConfirmInfo = { url, name };
      if (textEl) {
        textEl.textContent = name ? `${deleteConfirmBaseText} "${name}"` : deleteConfirmBaseText;
        textEl.setAttribute('dir', 'auto');
      }
      if (modal) modal.classList.remove('hidden');
    }

    function hideDeleteConfirm() {
      if (modal) modal.classList.add('hidden');
    }

    async function performDelete() {
      hideDeleteConfirm();
      if (deleteConfirmInfo.url) {
        try {
          const response = await fetch(deleteConfirmInfo.url, {
            method: 'DELETE',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            }
          });

          const data = await response.json();
          if (response.ok && data && data.alertType === 'success') {
            showCustomToast('success', data.message || "<%= __('department.department_deleted_successfully') %>");
            setTimeout(() => window.location.reload(), 1000);
          } else {
            let errorMsg = data && data.message ? data.message : "<%= __('department.delete_error') %>";
            console.warn('[Delete Department] Error response', response.status, errorMsg, data);
            showCustomToast('error', errorMsg);
          }
        } catch (error) {
          console.error('[Delete Department] Error:', error);
          showCustomToast('error', "<%= __('department.delete_error') %>");
        }
      }
    }

    // Event delegation for delete buttons
    document.addEventListener('click', function(event) {
      const btn = event.target.closest('.delete-dept-btn');
      if (!btn) return;
      event.preventDefault();
      event.stopPropagation();

      const url = btn.getAttribute('data-url');
      const name = btn.getAttribute('data-name') || '';
      showDeleteConfirm(url, name);
    });

    if (cancelBtn) cancelBtn.onclick = hideDeleteConfirm;
    if (confirmBtn) confirmBtn.onclick = performDelete;
  });
</script>