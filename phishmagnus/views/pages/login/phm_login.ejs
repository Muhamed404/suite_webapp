<!DOCTYPE html>
<html lang="<%= locale || 'en' %>" dir="<%= (locale || 'en') === 'ar' ? 'rtl' : 'ltr' %>" translate="no" class="notranslate">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google" content="notranslate">
  <meta name="googlebot" content="notranslate">
  <title>Secure Magnus</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Fondamento:ital@0;1&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap"
    rel="stylesheet">

  <!-- <script src="js/tailwind_3.js"></script> -->
  <script src="/securemagnus_2025/js/tailwind_3.js"></script>

  <script>
    (function () {
      function hideTranslateUi() {
        var selectors = [
          '.goog-te-banner-frame',
          'iframe.goog-te-banner-frame',
          '.goog-te-menu-frame',
          'iframe.goog-te-menu-frame',
          '.VIpgJd-ZVi9od-ORHb-OEVmcd',
          '.VIpgJd-ZVi9od-l4eHX-hSRGPd',
          '.VIpgJd-yAWNEb-L7lbkb',
          '.VIpgJd-ZVi9od-aZ2wEe-wOHMyf',
          '.VIpgJd-ZVi9od-aZ2wEe-OiiCO',
          '#goog-gt-tt',
          '.goog-tooltip',
          '.goog-text-highlight'
        ];

        selectors.forEach(function (selector) {
          document.querySelectorAll(selector).forEach(function (node) {
            node.style.setProperty('display', 'none', 'important');
            node.style.setProperty('visibility', 'hidden', 'important');
          });
        });

        if (document.documentElement) {
          document.documentElement.setAttribute('translate', 'no');
          document.documentElement.classList.add('notranslate');
          document.documentElement.style.setProperty('top', '0px', 'important');
        }

        if (document.body) {
          document.body.setAttribute('translate', 'no');
          document.body.classList.add('notranslate');
          document.body.style.setProperty('top', '0px', 'important');
        }
      }

      hideTranslateUi();
      document.addEventListener('DOMContentLoaded', hideTranslateUi);
      window.addEventListener('load', hideTranslateUi);
      if (typeof MutationObserver !== 'undefined' && document.documentElement) {
        var observer = new MutationObserver(hideTranslateUi);
        observer.observe(document.documentElement, { childList: true, subtree: true });
      }
      setTimeout(hideTranslateUi, 500);
      setTimeout(hideTranslateUi, 1500);
      setInterval(hideTranslateUi, 3000);
    })();
  </script>

  <link rel="stylesheet" href="/securemagnus_2025/css/style.css">


</head>

<body class="bg-white notranslate" translate="no">


  <div class="grid grid-cols-12 min-h-screen">

    <!-- Login (Always Visible) -->
    <div class="flex flex-col justify-between  col-span-12 sm:col-span-6 h-screen lg:p-10 p-4">

      <!-- Header -->
      <div class="flex items-center justify-between ">
        <a href="">
          <img src="/securemagnus_2025/images/phishMagnusLogo.svg" alt="">
        </a>

        <a class="rounded-full text-sm py-1.5 px-4 border border-[var(--teal)] hover:bg-[var(--teal)] hover:text-white transform duration-300"
          href="?lang=en">English</a> |
        <a class="rounded-full text-sm py-1.5 px-4 border border-[var(--teal)] hover:bg-[var(--teal)] hover:text-white transform duration-300"
          href="?lang=ar">العربية</a>

        </a>

      </div>


      <!-- Login Form -->
<form id="loginForm" action="/login<%= locale ? ('?lang=' + locale) : '' %>" method="POST">
        <input type="hidden" name="userTimezone" id="userTimezone">
      <div class="flex items-center justify-center">
        <div class="flex flex-col max-w-2xl items-stretch ">

          <h3 class="text-center text-4xl font-semibold md:mt-12 lg:mt-24"><%= __('generic_label.welcomeToPhishMagnus') %></h3>

          <!-- Alert Message -->
          <% if (locals.message) { %>
            <div class="mt-6 p-4 rounded-lg <%= locals.alertType === 'error' ? 'bg-red-50 border border-red-200' : 'bg-green-50 border border-green-200' %>">
              <p class="text-sm <%= locals.alertType === 'error' ? 'text-red-700' : 'text-green-700' %>">
                <%= locals.message %>
              </p>
            </div>
          <% } %>

          <div class="mt-6 md:mt-10">
            <fieldset class="fieldset">

              <label
                class="flex items-center w-full p-5 rounded-full bg-[var(--gray)] border border-[var(--strokeGray)] focus-within:border-[var(--teal)] transition-colors duration-300">
                <input type="email" placeholder="<%= __('generic_label.emailAddress') %>" name="email" id="email"
                  class="bg-transparent border-none outline-none text-[14px] w-full" />
              </label>
            </fieldset>
            <fieldset class="fieldset">

              <label
                class="flex items-center w-full p-5 mt-3 rounded-full bg-[var(--gray)] border border-[var(--strokeGray)] focus-within:border-[var(--teal)] transition-colors duration-300">
                <input class="bg-transparent border-none outline-none text-[14px] grow" placeholder="<%= __('generic_label.password') %>"
                  name="password" id="password" type="password" />

              </label>

            </fieldset>
            <div class="flex justify-between mt-3">
              <div class="flex items-center gap-3 ">
                <input type="checkbox" class="accent-[var(--teal)] text-white w-5 h-5 rounded"
                  aria-label="Custom checkbox" />

                <label for="agreement" class="text-sm ">
                  <%= __('generic_label.rememberMe') %>
                </label>
              </div>

              <div class="">
                <a class="label-text text-[var(--teal)] text-base-content/80 text-xs" href="">
                  <%= __('generic_label.forgotPassword') %>
                </a>
              </div>

            </div>


              <button type="submit"
                class="w-full flex items-center justify-center gap-3 mt-8 px-6 py-3 rounded-full bg-[var(--teal)] text-white border border-transparent transition-all duration-300 hover:bg-transparent hover:border-[var(--teal)] hover:text-[var(--teal)]">
                <!-- <span class="iconify lucide--log-in size-4"></span> -->
                <%= __('generic_label.login') %>
              </button>

            <p class="text-base-content/80 mt-4 text-center text-sm md:mt-6">
              <%= __('generic_label.dontHaveAccount') %>
              <a class="text-[var(--teal)] ms-1 hover:underline" href="./onboarding1-eng.html">
                <%= __('generic_label.signup') %>
              </a>
            </p>
          </div>
        </div>
      </div>
</form>

      <div>
        <p class="text-sm text-gray-600 mt-4">
          © 2025 Securemagnus
        </p>
      </div>



    </div>




    <!-- Hero (Hidden on Small Screens) -->
    <div class="hidden sm:block col-span-6  lg:p-5 p-4">
      <div class="w-full h-full flex justify-center items-center rounded-3xl bg-[#EDF2F2] overflow-hidden">
        <!-- Background Image -->
        <img src="/securemagnus_2025/images/img/pmagnus-bg.png" class=" w-1/2 object-contain" alt="Background" />


      </div>




    </div>
  </div>



  <script>
    document.getElementById('loginForm').addEventListener('submit', function () {
      document.getElementById('userTimezone').value = Intl.DateTimeFormat().resolvedOptions().timeZone;
    });
  </script>

</body>

</html>