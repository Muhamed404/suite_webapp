<div class="row">
    <div class="col-lg-3 col-sm-6">
        <div class="widget-panel widget-style-2 white-bg">
            <i class="ion-android-contacts text-success"></i>
            <h2 class="m-0 counter">
                <%= totalCampaigns %>
            </h2>
            <div>
                Total Campaigns Initiated
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="widget-panel widget-style-2 white-bg" >
            <i class="ion-android-contacts text-success" style="line-height: 100px;"></i>
            <h2 class="m-0 counter">
                <%= lastCampaignDate %>
            </h2>
            <div>
                Last Campaign Date
            </div>
        </div>
    </div>
