  document.addEventListener("DOMContentLoaded", function () {
    // Defensive: Ensure setProgress exists before calling
    if (typeof setProgress === "function") {
      const phmTotalPurchaseUserLicense = <%= typeof phmTotalPurchaseUserLicense !== 'undefined' ? phmTotalPurchaseUserLicense : 0 %>;
      const phmConsumedUserLicense = <%= typeof phmConsumedUserLicense !== 'undefined' ? phmConsumedUserLicense : 0 %>;
      setProgress("progressCircleRemainingBalance", "remaininglicenseBalance", phmConsumedUserLicense, phmTotalPurchaseUserLicense);
    } else {
      console.warn("setProgress function is not defined.");
    }

    function toArabicNum(num) {
      return num.toString().replace(/\d/g, d => '٠١٢٣٤٥٦٧٨٩'[d]);
    }

    const localeEl = document.getElementById("locale-data");
    const locale = localeEl ? localeEl.dataset.locale : 'en';
    const convertNum = (num) => {
      return locale === 'ar' ? toArabicNum(num) : num.toString();
    };

    const originalSetProgress = window.setProgress;
    window.setProgress = function(circleId, textId, ...args) {
      let percent, textValue;
      if (args.length === 1) {
        percent = args[0];
        textValue = percent;
      } else if (args.length === 2) {
        const consumed = args[0];
        const purchased = args[1];
        percent = purchased > 0 ? (consumed / purchased) * 100 : 0;
        textValue = consumed;
      }
      const circle = document.getElementById(circleId);
      const text = document.getElementById(textId);
      if (!circle || !text) return;
      const radius = 70;
      const circumference = 2 * Math.PI * radius;
      const offset = circumference - (percent / 100) * circumference;
      circle.style.strokeDasharray = circumference;
      circle.style.strokeDashoffset = offset;
      text.textContent = convertNum(textValue);
    };

    document.querySelectorAll('.convert-number').forEach(el => {
      el.textContent = convertNum(el.textContent);
    });
  });


 
</script>