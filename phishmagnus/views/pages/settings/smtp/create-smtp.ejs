<div class="flex flex-col p-6 gap">
  <div class="flex flex-col gap-2 mb-4 border-b border-gray-100 pb-4">
    <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0" aria-label="Breadcrumb">
      <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
      <span class="text-gray-400">›</span>
      <a href="<%= magnusAdmin ? '/organization/profile/' + org + '?tab=settings' : '/organization/profile?tab=settings' %>" class="hover:text-gray-700 transition"><%= __("breadcrumbs.organization") %></a>
      <span class="text-gray-400">›</span>
      <span class="font-semibold text-gray-900"><%= __("breadcrumbs.smtp") %></span>
    </nav>
    <h3 class="text-3xl font-medium text-gray-900">
      <%= Organization ? Organization : 'Secure Magnus' %> - <%= __("smtp.labelSMTPConfiguration") %>
    </h3>
  </div>
</div>

<div class="flex flex-col h-[75vh] gap-4 mt-3 rounded-3xl bg-white">
  <div class="bg-white w-full mt-3 p-8">

    <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10">
      <%= __("smtp.labelSMTPConfiguration") %>
    </h1>

    <form id="smtpSettingsForm"
      class="grid grid-cols-1 md:grid-cols-2 gap-8"
      action="/settings/smtp/<%= org %>"
      method="post">

      <!-- Organization -->
      <div>
        <label class="block text-gray-700 font-medium mb-3">
          <%= __("smtp.labelOrganizationName") %>
        </label>
        <input type="text" readonly name="org"
          value="<%= Organization ? Organization : 'Secure Magnus' %>"
          class="w-full px-4 py-2 border rounded-lg bg-gray-50 text-gray-900" />
      </div>

      <!-- Host -->
      <div>
        <label class="block text-gray-700 font-medium mb-3">
          <%= __("smtp.labelHostName") %>
        </label>
        <input type="text" name="host" required id="host"
          value="<%= typeof host !== 'undefined' && host ? host : '' %>"
          class="w-full px-4 py-2 border rounded-lg outline-none bg-gray-50 focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50" />
      </div>

      <!-- Port -->
      <div>
        <label class="block text-gray-700 font-medium mb-3">
          <%= __("smtp.labelPort") %>
        </label>
        <input type="number" name="port" id="port" min="1" max="65535" required
          value="<%= typeof port !== 'undefined' && port ? port : '' %>"
          class="w-full px-4 py-2 border rounded-lg outline-none bg-gray-50 focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50" />
      </div>

      <!-- SMTP Account -->
      <div id="smtp-account-field">
        <label class="block text-gray-700 font-medium mb-3">
          <%= __("smtp.labelServiceAccount") %>
        </label>
        <input type="text" name="smtp_account" id="smtp_account" maxlength="250" required
          value="<%= typeof smtp_account !== 'undefined' && smtp_account ? smtp_account : '' %>"
          class="w-full px-4 py-2 border rounded-lg outline-none bg-gray-50 focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50" />
      </div>

      <!-- Sender Email -->
      <div>
        <label class="block text-gray-700 font-medium mb-3">
          <%= __("smtp.labelSenderEmail") %>
        </label>
        <input type="email"
          name="sender_email"
          id="sender_email"
          maxlength="250"
          required
          value="<%= typeof sender_email !== 'undefined' && sender_email ? sender_email : '' %>"
          class="w-full px-4 py-2 border rounded-lg outline-none bg-gray-50 focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50" />
      </div>

      <!-- Sender Display Name -->
      <div>
        <label class="block text-gray-700 font-medium mb-3">
          <%= __("smtp.labelSenderDisplayName") %>
        </label>
        <input type="text" name="sender_display_name" id="sender_display_name" maxlength="250"
          value="<%= typeof sender_display_name !== 'undefined' && sender_display_name ? sender_display_name : '' %>"
          class="w-full px-4 py-2 border rounded-lg outline-none bg-gray-50 focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50" />
      </div>

      <!-- Password -->
      <div id="smtp-password-field">
        <label class="block text-gray-700 font-medium mb-3">
          <%= __("smtp.labelPassword") %>
        </label>
        <div class="relative smtp-password-wrap">
          <input type="password" name="smtp_password" id="smtp_password" required
            value="<%= typeof smtp_password !== 'undefined' && smtp_password ? smtp_password : '' %>"
            class="w-full px-4 py-2 <%= (locals.locale || 'en') === 'ar' ? 'pl-10' : 'pr-10' %> border rounded-lg outline-none bg-gray-50 focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50" />
          <button type="button" id="toggleSmtpPassword"
            class="absolute inset-y-0 <%= (locals.locale || 'en') === 'ar' ? 'left-3' : 'right-3' %> flex items-center text-gray-500 hover:text-[var(--teal)] transition-colors duration-200"
            aria-label="Show password"
            aria-pressed="false">
            <svg id="toggleSmtpPasswordIconEye" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <svg id="toggleSmtpPasswordIconEyeOff" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20C5 20 1 12 1 12a21.77 21.77 0 0 1 5.06-6.94"></path>
              <path d="M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.9 21.9 0 0 1-3.17 4.83"></path>
              <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
              <line x1="1" y1="1" x2="23" y2="23"></line>
            </svg>
          </button>
        </div>
      </div>
      <!-- Use TLS / Use SSL -->
      <!-- Toggles -->
      <div class="md:col-span-2 border-t border-gray-100 pt-4 flex flex-col gap-4">

        <!-- Use STARTTLS -->
        <div class="flex items-center gap-4">
          <div>
            <p class="text-sm font-medium text-gray-700"><%= __("smtp.enableStartTLS") %></p>
            <p class="text-xs text-gray-400 mt-0.5"><%= __("smtp.enableStartTLSDesc") %></p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="hidden" name="use_tls" id="use_tls_input" value="<%= typeof use_tls !== 'undefined' && use_tls ? 'true' : 'false' %>" />
            <input type="checkbox" id="use_tls" <%= typeof use_tls !== 'undefined' && use_tls ? 'checked' : '' %> class="sr-only peer" />
            <div class="w-11 h-6 bg-gray-200 rounded-full peer peer-checked:bg-teal-500 peer-focus:ring-2 peer-focus:ring-teal-100 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5"></div>
          </label>
        </div>

        <!-- Use SSL -->
        <div class="flex items-center gap-10">
          <div>
            <p class="text-sm font-medium text-gray-700"><%= __("smtp.enableSSL") %></p>
            <p class="text-xs text-gray-400 mt-0.5"><%= __("smtp.enableSSLDesc") %></p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="hidden" name="use_ssl" id="use_ssl_input" value="<%= typeof use_ssl !== 'undefined' && use_ssl ? 'true' : 'false' %>" />
            <input type="checkbox" id="use_ssl" <%= typeof use_ssl !== 'undefined' && use_ssl ? 'checked' : '' %> class="sr-only peer" />
            <div class="w-11 h-6 bg-gray-200 rounded-full peer peer-checked:bg-teal-500 peer-focus:ring-2 peer-focus:ring-teal-100 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5"></div>
          </label>
        </div>

        <!-- Enable Encryption -->
        <div class="flex items-center gap-4">
          <div>
            <p class="text-sm font-medium text-gray-700"><%= __("smtp.enableSMTPEncryption") %></p>
            <p class="text-xs text-gray-400 mt-0.5"><%= __("smtp.enableSMTPEncryptionDesc") %></p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="hidden" name="encrypt_password" id="encrypt_password_input" value="<%= typeof encrypt_password !== 'undefined' ? (encrypt_password ? 'true' : 'false') : 'true' %>" />
            <input type="checkbox" id="encrypt_password" <%= typeof encrypt_password === 'undefined' || encrypt_password ? 'checked' : '' %> class="sr-only peer" />
            <div class="w-11 h-6 bg-gray-200 rounded-full peer peer-checked:bg-teal-500 peer-focus:ring-2 peer-focus:ring-teal-100 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5"></div>
          </label>
        </div>

        <!-- Is Authenticated -->
        <div class="flex items-center gap-4">
          <div>
            <p class="text-sm font-medium text-gray-700"><%= __("smtp.isAuthenticated") %></p>
            <p class="text-xs text-gray-400 mt-0.5"><%= __("smtp.isAuthenticatedDesc") %></p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="hidden" name="is_authenticated" id="is_authenticated_input" value="<%= typeof is_authenticated !== 'undefined' && is_authenticated === false ? 'false' : 'true' %>" />
            <input type="checkbox" id="is_authenticated" <%= typeof is_authenticated === 'undefined' || is_authenticated ? 'checked' : '' %> class="sr-only peer" />
            <div class="w-11 h-6 bg-gray-200 rounded-full peer peer-checked:bg-teal-500 peer-focus:ring-2 peer-focus:ring-teal-100 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5"></div>
          </label>
        </div>

        <!-- Enable MFA -->
        <% if (Number(org) == 0) { %>

        <div class="flex items-center gap-20">
          <div>
            <p class="text-sm font-medium text-gray-700"><%= __("smtp.enableMFA") %></p>
            <p class="text-xs text-gray-400 mt-0.5"><%= __("smtp.enableMFADesc") %></p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="hidden" name="enable_mfa" id="enable_mfa_input" value="<%= typeof enable_mfa !== 'undefined' && enable_mfa ? 'true' : 'false' %>" />
            <input type="checkbox" id="enable_mfa" <%= typeof enable_mfa !== 'undefined' && enable_mfa ? 'checked' : '' %> class="sr-only peer" />
            <div class="w-11 h-6 bg-gray-200 rounded-full peer peer-checked:bg-teal-500 peer-focus:ring-2 peer-focus:ring-teal-100 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5"></div>
          </label>
        </div>
        <%}%>
      </div>

      <!-- Buttons -->
      <div class="flex justify-end gap-4 mt-10 md:col-span-2">
        <button type="submit" id="saveButton" disabled
          class="px-8 py-2 rounded-lg bg-gray-400 text-white font-semibold cursor-not-allowed transition disabled:opacity-50">
          <%= __("smtp.btnSaveSettings") %>
        </button>

        <button type="button" id="testConnection"
          class="px-8 py-2 rounded-lg bg-green-500 text-white font-semibold hover:bg-green-600 transition">
          <%= __("smtp.btnTestConfiguration") %>
        </button>
      </div>

    </form>
  </div>
</div>

<script src="/securemagnus_2025/js/custom_script/smtp-validator.js"></script>


<script>
  // Localization data
  window.i18n = {
    validation_messages: {
      fill_required_fields_before_testing: "<%- __('validation_messages.fill_required_fields_before_testing') %>",
      fix_validation_errors_before_testing: "<%- __('validation_messages.fix_validation_errors_before_testing') %>",
      smtp_test_connection_successful: "<%- __('validation_messages.smtp_test_connection_successful') %>",
      smtp_test_connection_failed: "<%- __('validation_messages.smtp_test_connection_failed') %>",
      enter_valid_format: "<%- __('validation_messages.enter_valid_format') %>",
      ensure_correct_smtp_port: "<%- __('validation_messages.ensure_correct_smtp_port') %>",
      organization_name_required: "<%- __('validation_messages.organization_name_required') %>",
      organization_name_minlength: "<%- __('validation_messages.organization_name_minlength') %>",
      organization_name_maxlength: "<%- __('validation_messages.organization_name_maxlength') %>",
      smtp_host_required: "<%- __('validation_messages.smtp_host_required') %>",
      host_minlength: "<%- __('validation_messages.host_minlength') %>",
      host_maxlength: "<%- __('validation_messages.host_maxlength') %>",
      valid_hostname_ip: "<%- __('validation_messages.valid_hostname_ip') %>",
      port_required: "<%- __('validation_messages.port_required') %>",
      valid_port_number: "<%- __('validation_messages.valid_port_number') %>",
      port_min: "<%- __('validation_messages.port_min') %>",
      port_max: "<%- __('validation_messages.port_max') %>",
      service_account_required: "<%- __('validation_messages.service_account_required') %>",
      service_account_minlength: "<%- __('validation_messages.service_account_minlength') %>",
      service_account_maxlength: "<%- __('validation_messages.service_account_maxlength') %>",
      sender_email_required: "<%- __('validation_messages.sender_email_required') %>",
      valid_email: "<%- __('validation_messages.valid_email') %>",
      password_required: "<%- __('validation_messages.password_required') %>",
      password_minlength: "<%- __('validation_messages.password_minlength') %>",
      password_maxlength: "<%- __('validation_messages.password_maxlength') %>",
      validation_error: "<%- __('validation_messages.validation_error') %>"
    }
  };

  // Initialize SMTP form validator with configuration
  initSMTPFormValidator({
    orgId: '<%= org %>',
    hasExistingData: '<%= typeof host !== "undefined" && host ? "true" : "false" %>' === 'true'
  });

  // TLS / SSL / Encrypt Password toggle labels + hidden input sync
  ['use_tls', 'use_ssl', 'encrypt_password', 'enable_mfa', 'is_authenticated'].forEach(function(id) {
    var checkbox = document.getElementById(id);
    var hidden = document.getElementById(id + '_input');
    if (!checkbox || !hidden) return;
    checkbox.addEventListener('change', function() {
      hidden.value = this.checked ? 'true' : 'false';
    });
  });

  var AUTH_PLACEHOLDER = 'Authentication set to true';

  function applyIsAuthenticatedState(checked) {
    var accountField = document.getElementById('smtp-account-field');
    var passwordField = document.getElementById('smtp-password-field');
    var accountInput = document.getElementById('smtp_account');
    var passwordInput = document.getElementById('smtp_password');
    if (!accountField || !passwordField || !accountInput || !passwordInput) return;

    if (checked) {
      // is_authenticated ON: show fields and validate normally
      accountField.style.display = '';
      passwordField.style.display = '';
      if (accountInput.value === AUTH_PLACEHOLDER) accountInput.value = '';
      if (passwordInput.value === AUTH_PLACEHOLDER) passwordInput.value = '';
      accountInput.setAttribute('required', 'required');
      passwordInput.setAttribute('required', 'required');
    } else {
      // is_authenticated OFF: hide fields and skip validation
      accountField.style.display = 'none';
      passwordField.style.display = 'none';
      accountInput.value = AUTH_PLACEHOLDER;
      passwordInput.value = AUTH_PLACEHOLDER;
      accountInput.removeAttribute('required');
      passwordInput.removeAttribute('required');
    }
  }

  var isAuthCheckbox = document.getElementById('is_authenticated');
  if (isAuthCheckbox) {
    isAuthCheckbox.addEventListener('change', function() {
      applyIsAuthenticatedState(this.checked);
    });
    // Apply initial state on page load
    applyIsAuthenticatedState(isAuthCheckbox.checked);
  }

  (function () {
    var toggleBtn = document.getElementById('toggleSmtpPassword');
    var passwordInput = document.getElementById('smtp_password');
    var eyeIcon = document.getElementById('toggleSmtpPasswordIconEye');
    var eyeOffIcon = document.getElementById('toggleSmtpPasswordIconEyeOff');
    if (!toggleBtn || !passwordInput || !eyeIcon || !eyeOffIcon) return;

    toggleBtn.addEventListener('click', function () {
      var isHidden = passwordInput.type === 'password';
      passwordInput.type = isHidden ? 'text' : 'password';
      eyeIcon.classList.toggle('hidden', isHidden);
      eyeOffIcon.classList.toggle('hidden', !isHidden);
      toggleBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
      toggleBtn.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
    });
  })();
</script>
