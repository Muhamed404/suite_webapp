<div class="flex flex-col p-6 gap">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div class="flex-1">

      <h3 class="text-3xl font-medium">
        <%= __('phishing_smtp.list.title') %>
      </h3>
    </div>
    <%if(canManageDefault) { %>
    <div>
        <a href="/phm/phishing-smtp/create"
          class="flex items-center justify-center gap-2 px-5 py-2 rounded-full bg-teal-600 text-white font-semibold shadow hover:bg-teal-700 transition-all duration-200 border border-teal-600 hover:border-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-400 lg:order-2"
          title="<%= __('system_template.homescreen.btnCreateTemplate') %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none" />
            <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              d="M12 8v8m-4-4h8" />
          </svg>
          <span class="hidden sm:inline"><%= __('phishing_smtp.list.btn_add_new') %></span>
        </a>
    </div>
    <% }%>
  </div>
</div>
<% const allowEditAndTest = canManageDefault %>

<div class="flex flex-col p-6 pt-0">
  <div class="flex flex-col rounded-3xl bg-white border border-gray-100 shadow-sm">
    <div class="p-6">
      <table id="filter-table" class="min-w-full border-none text-sm text-left text-gray-700" data-placeholder="<%= __('generic_label.search_here') %>" data-per-page="<%= __('entries per page') %>" data-info="<%= __('generic_label.showing') %> {start} <%= __('generic_label.to') %> {end} <%= __('generic_label.of') %> {rows} <%= __('entries') %>" data-no-rows="<%= __('generic_label.no_entries_found') %>">
        <thead class="bg-gray-50 text-gray-600 text-xs">
          <tr>
            <th class="px-4 py-3 text-sm font-normal">
              <img src="/securemagnus_2025/images/package_management/sort.svg" alt="Sort" class="size-3.5 ml-3 inline">
              <%= __('phishing_smtp.list.col_sender_email') %>
            </th>
            <th class="px-4 py-3 text-sm font-normal">
              <img src="/securemagnus_2025/images/package_management/sort.svg" alt="Sort" class="size-3.5 ml-3 inline">
              <%= __('phishing_smtp.list.col_organization') %>
            </th>

            <th class="px-4 py-3 text-sm font-normal">
              <%= __('generic_label.status') %>
            </th>
          <% if (allowEditAndTest) { %>

            <th class="px-4 py-3 text-sm font-normal">
              <%= __('phishing_smtp.list.col_test_connection') %>
            </th>
          <% } %>
            <th class="px-4 py-3 text-sm font-normal">
              <%= __('generic_label.action') %>
            </th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof smtpList !== 'undefined' && smtpList.length > 0) { smtpList.forEach(tpl => { %>
            <tr class="smtp-row bg-white border-b hover:bg-gray-50 cursor-pointer"
              data-id="<%= tpl.id %>"
              data-sender-email="<%= tpl.sender_email %>"
              data-organization="<%= tpl.organization_name || 'Default' %>"
              data-host="<%= tpl.host || '' %>"
              data-port="<%= tpl.port || '' %>"
              data-account="<%= tpl.smtp_account || '' %>"
              data-use-tls="<%= tpl.use_tls %>"
              data-use-ssl="<%= tpl.use_ssl %>"
              data-active="<%= tpl.is_active %>"
              data-details="<%= tpl.details || '' %>">
              <td class="px-4 py-3"><%= tpl.sender_email %></td>
              <td class="px-4 py-3"><%= tpl.organization_name || __('phishing_smtp.list.default_org') %></td>
              <td class="px-4 py-3">
                <% if (tpl.is_active) { %>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-teal-100 text-teal-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-teal-500 inline-block"></span>
                    <%= __('generic_label.active') %>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-500">
                    <span class="w-1.5 h-1.5 rounded-full bg-gray-400 inline-block"></span>
                    <%= __('generic_label.inactive') %>
                  </span>
                <% } %>
              </td>
              <% const isSameOrg = parseInt(tpl.organization_id) === parseInt(currentUserOrgId); %>
              <% const allowDelete = canManageDefault || isSameOrg; %>
                <% if (allowEditAndTest) { %>

              <td class="px-4 py-3">
                  <button
                    class="test-smtp-btn px-3 py-1 rounded-lg bg-green-500 text-white text-xs font-semibold hover:bg-green-600 transition disabled:opacity-50 disabled:cursor-not-allowed"
                    data-smtp-id="<%= tpl.id %>">
                    <%= __('phishing_smtp.list.btn_test') %>
                  </button>
              </td>
             <% }%>

              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <% if (allowEditAndTest) { %>
                    <a href="/phm/phishing-smtp/edit/<%= tpl.id %>" class="text-teal-600 hover:text-teal-800 font-medium transition-colors duration-150"><%= __('generic_label.edit') %></a>
                  <span class="text-gray-300">|</span>

                  <% } %>
                  
                  <% if (allowDelete) { %>
                    <button type="button"
                      class="delete-smtp-btn text-red-500 hover:text-red-700 font-medium transition-colors duration-150"
                      data-delete-url="/phm/phishing-smtp/delete/<%= tpl.id %>"
                      data-sender-email="<%= tpl.sender_email %>">
                      <%= __('generic_label.delete') %>
                    </button>
                  <% }%>
                  
                </div>
              </td>
            </tr>
          <% }); } else { %>
            <tr>
              <td colspan="6" class="px-4 py-6 text-center text-gray-400"><%= __('phishing_smtp.list.no_records') %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<!-- SMTP Detail Modal -->
<div id="smtpDetailModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/40 backdrop-blur-sm">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg mx-4 overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
      <h3 class="text-lg font-semibold text-gray-800"><%= __('phishing_smtp.modal.title') %></h3>
      <button id="closeSmtpModal" class="text-gray-400 hover:text-gray-600 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="px-6 py-5 grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
      <div>
        <p class="text-gray-400 text-xs mb-0.5"><%= __('phishing_smtp.modal.label_sender_email') %></p>
        <p id="modal-sender-email" class="font-medium text-gray-800 break-all">—</p>
      </div>
      <div>
        <p class="text-gray-400 text-xs mb-0.5"><%= __('phishing_smtp.modal.label_organization') %></p>
        <p id="modal-organization" class="font-medium text-gray-800">—</p>
      </div>
      <div>
        <p class="text-gray-400 text-xs mb-0.5"><%= __('phishing_smtp.modal.label_host') %></p>
        <p id="modal-host" class="font-medium text-gray-800 break-all">—</p>
      </div>
      <div>
        <p class="text-gray-400 text-xs mb-0.5"><%= __('phishing_smtp.modal.label_port') %></p>
        <p id="modal-port" class="font-medium text-gray-800">—</p>
      </div>
      <div id="modal-account-field">
        <p class="text-gray-400 text-xs mb-0.5"><%= __('phishing_smtp.modal.label_account') %></p>
        <p id="modal-account" class="font-medium text-gray-800 break-all">—</p>
      </div>
      <div>
        <p class="text-gray-400 text-xs mb-0.5"><%= __('generic_label.status') %></p>
        <p id="modal-status" class="font-medium">—</p>
      </div>
      <div id="modal-tls-field">
        <p class="text-gray-400 text-xs mb-0.5"><%= __('phishing_smtp.modal.label_tls') %></p>
        <p id="modal-tls" class="font-medium text-gray-800">—</p>
      </div>
      <div id="modal-ssl-field">
        <p class="text-gray-400 text-xs mb-0.5"><%= __('phishing_smtp.modal.label_ssl') %></p>
        <p id="modal-ssl" class="font-medium text-gray-800">—</p>
      </div>
      <div class="col-span-2">
        <p class="text-gray-400 text-xs mb-0.5"><%= __('phishing_smtp.modal.label_details') %></p>
        <p id="modal-details" class="font-medium text-gray-800">—</p>
      </div>
    </div>
 
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="smtpDeleteModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/40 backdrop-blur-sm">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 overflow-hidden">
    <!-- Header -->
    <div class="flex items-center gap-3 px-6 py-5 border-b border-gray-100">
      <div class="flex items-center justify-center w-10 h-10 rounded-full bg-red-100 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m2 0H7m4-3h2a1 1 0 011 1v1H9V5a1 1 0 011-1h2z"/>
        </svg>
      </div>
      <div>
        <h3 class="text-base font-semibold text-gray-800"><%= __('phishing_smtp.list.delete_modal_title') %></h3>
        <p class="text-xs text-gray-400 mt-0.5"><%= __('phishing_smtp.list.delete_modal_subtitle') %></p>
      </div>
    </div>
    <!-- Body -->
    <div class="px-6 py-5">
      <p class="text-sm text-gray-600"><%= __('phishing_smtp.list.confirm_delete') %></p>
      <p class="text-sm font-semibold text-gray-800 mt-1" id="deleteSmtpEmail"></p>
    </div>
    <!-- Footer -->
    <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-100">
      <button type="button" id="cancelSmtpDelete"
        class="px-5 py-2 rounded-lg text-sm font-medium text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors">
        <%= __('generic_label.cancel') %>
      </button>
      <a id="confirmSmtpDelete" href="#"
        class="px-5 py-2 rounded-lg text-sm font-semibold text-white bg-red-500 hover:bg-red-600 transition-colors">
        <%= __('generic_label.delete') %>
      </a>
    </div>
  </div>
</div>

<script src="/securemagnus_2025/js/custom_script/phishing-smtp-list.js"
  data-btn-testing="<%= __('phishing_smtp.list.btn_testing') %>"
  data-btn-test-config="<%= __('phishing_smtp.modal.btn_test_config') %>"
  data-enabled="<%= __('phishing_smtp.modal.enabled') %>"
  data-disabled="<%= __('phishing_smtp.modal.disabled') %>"
  data-active="<%= __('generic_label.active') %>"
  data-inactive="<%= __('generic_label.inactive') %>"
  data-toast-success="<%= __('phishing_smtp.toast.connection_success') %>"
  data-toast-failed="<%= __('phishing_smtp.toast.connection_failed') %>"
  data-toast-endpoint-err="<%= __('phishing_smtp.toast.endpoint_error') %>"
  data-allow-edit-and-test="<%= allowEditAndTest ? 'true' : 'false' %>">
</script>
