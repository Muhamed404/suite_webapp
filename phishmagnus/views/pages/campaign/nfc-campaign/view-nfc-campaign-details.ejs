<div class="flex flex-col  p-6 pt-0">
    <!-- first section  -->
    <div class="flex flex-col gap-4 mt-3">
        <!-- Title -->
        <h1 class="text-2xl font-semibold my-2">Phishing Campaign Response Metrics</h1>

        <!-- Top Metrics -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-2">
                    <p class="text-gray-500 text-sm">Total Tags</p>
                    <img src="/securemagnus_2025/images/nfc_sent.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=scannedNotScannedStats.totalDevices%>
                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-2">
                    <p class="text-gray-500 text-sm">Not Scanned</p>
                    <img src="/securemagnus_2025/images/nfc-download.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=scannedNotScannedStats.notScannedCount%>
                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-2">
                    <p class="text-gray-500 text-sm">Total Scanned</p>
                    <img src="/securemagnus_2025/images/nfc-download.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.number_of_scans%>
                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-2">
                    <p class="text-gray-500 text-sm">Opened</p>
                    <img src="/securemagnus_2025/images/nfc-download.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.is_opened%>
                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-2">
                    <p class="text-gray-500 text-sm">Form Interaction</p>
                    <img src="/securemagnus_2025/images/nfc-notsent.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.is_interacted%>
                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-2">
                    <p class="text-gray-500 text-sm">Form Submitted</p>
                    <img src="/securemagnus_2025/images/nfc-people.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.is_submitted%>
                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-2">
                    <p class="text-gray-500 text-sm">File Downloaded</p>
                    <img src="/securemagnus_2025/images/nfc-admin.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.is_downloaded%>
                </p>
            </div>
        </div>

        <!-- Main Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <!-- Bar Chart -->
            <div class="bg-white p-6 rounded-xl   col-span-2">
                <h2 class="text-lg font-semibold mb-4">Campaign Metrics</h2>
                <div id="barChart"></div>
            </div>

            <!-- Phishing Success -->
            <div class="bg-white p-6 rounded-xl gap-11  flex flex-col items-start  justify-start">
                <h2 class="text-lg font-semibold mb-4">Phishing Success</h2>

                <div class="flex items-center  gap-10 w-full justify-between">
                    <!-- Left Side Labels -->
                    <div class="space-y-6">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#3b82f6]"></span> <!-- Blue -->
                            <div>
                                <p class="text-gray-500 text-sm">NFC Scan</p>
                                <p class="text-lg font-bold text-gray-900" id="scanText"> People</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#9ca3af]"></span> <!-- Gray -->
                            <div>
                                <p class="text-gray-500 text-sm">Not Scanned</p>
                                <p class="text-lg font-bold text-gray-900" id="notScanText"> People</p>
                            </div>

                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#fb923c]"></span> <!-- Orange -->
                            <div>
                                <p class="text-gray-500 text-sm">Interaction</p>
                                <p class="text-lg font-bold text-gray-900" id="formInteractionText"> People</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#34d399]"></span> <!-- Green -->
                            <div>
                                <p class="text-gray-500 text-sm">Download</p>
                                <p class="text-lg font-bold text-gray-900" id="attachmentDownloadedText"> People</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#ef4444]"></span> <!-- Red -->
                            <div>
                                <p class="text-gray-500 text-sm">Compromised</p>

                                <p class="text-lg font-bold text-gray-900" id="targetCompromisedText"> People</p>
                            </div>
                        </div>
                    </div>

                    <!-- Donut Chart -->
                    <div id="successChart" style="width:50%; height:50%;"></div>
                </div>
            </div>
        </div>

        <!-- Second Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Employees Phishing Segments -->
            <div class="bg-white p-6 rounded-xl  ">
                <h2 class="text-lg font-semibold mb-4">Phishing Segments</h2>
                <div id="segmentsChart"></div>
            </div>


            <!-- Campaign Details -->
            <div class="bg-white p-6 rounded-xl  ">
                <h2 class="text-lg font-semibold text-gray-800 mb-6">Campaign Details</h2>
                <div class="space-y-4">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">Sender Address</span>
                        <span class="text-gray-800 font-medium">asharniazi@gmail.com</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">URL</span>
                        <span class="text-gray-800 font-medium">www.kkk.com</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">Template Name</span>
                        <span class="text-gray-800 font-medium">
                            <%=templateDetails.name%>
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">Phishing Page</span>
                        <span class="text-gray-800 font-medium">kkk/10</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">Launch Date</span>
                        <span class="text-gray-800 font-medium">
                            <%=campaignDetails.start_datetime%>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Charts -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

            <!-- Links Interaction -->



            <div class="bg-white p-6 rounded-xl   text-center">

                <div class="flex items-center justify-start mb-9 gap-2">
                    <img src="/securemagnus_2025/images/Links-Interaction.svg" alt="">
                    <label for="Scan Interaction">Scan Interaction</label>
                </div>

                <div>
                    <div class="nfcSemiChartLink" uniqueScan="<%=openSegmentStats?.uniqueScanCount%>"
                        totalScan="<%=campaignStats?.number_of_scans%>" noScan="<%=openSegmentStats?.noScanCount%>">
                    </div>
                </div>

            </div>



            <div class="bg-white p-6 rounded-xl   text-center">

                <div class="flex items-center justify-start mb-9 gap-2">
                    <img src="/securemagnus_2025/images/interactfrom.svg" alt="">
                    <label for="Interact Form ">Interact Form </label>
                </div>

                <div>
                    <div class="nfcSemiChartInteract"
                        uniqueScan="<%=formInteractionSegmentStats?.uniqueInteractedCount%>"
                        totalInteractions="<%=campaignStats?.is_interacted%>"
                        noScan="<%=formInteractionSegmentStats?.noInteractedCount%>">
                    </div>
                </div>

            </div>


            <!-- Total Scans -->
            <div class="bg-white p-6 rounded-xl   text-center">

                <div class="flex items-center justify-start mb-9 gap-2">
                    <img src="/securemagnus_2025/images/formsubmitted.svg" alt="">
                    <label for="Form Submitted">Form Submitted</label>
                </div>

                <div>
                    <div class="nfcSemiChartSubmitted" uniqueScan="<%=formSubmittedSegmentStats?.uniqueSubmittedCount%>"
                        totalSubmitted="<%=campaignStats?.is_submitted%>"
                        noScan="<%=formSubmittedSegmentStats?.noSubmittedCount%>">
                    </div>
                </div>
            </div>

            <!-- Form Submitted -->
            <div class="bg-white p-6 rounded-xl   text-center">

                <div class="flex items-center justify-start mb-9 gap-2">
                    <img src="/securemagnus_2025/images/attachmentopened.svg" alt="">
                    <label for="Attachment Opened">Attachment Opened</label>
                </div>

                <div>
                    <div class="nfcSemiChartDownload" uniqueScan="<%=downloadSegmentStats?.uniqueDownloadCount%>"
                        repeatedScan="<%=downloadSegmentStats?.repeatedDownloadCount%>"
                        noScan="<%=downloadSegmentStats?.noDownloadCount%>">
                    </div>
                </div>
            </div>



        </div>


        <!-- last table  -->

        <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white">
            <div class="flex items-center justify-between gap-3 px-5 pt-5">

                <div class="relative">
                    <h2 class="text-2xl mb-4">Interaction report</h2>

                </div>


                <div class="flex gap-4">




                    <button class="hidden lg:block ms-auto">
                        <div class="relative">
                            <input type="text" placeholder="Search here..."
                                class="pl-14 pr-10 py-3 rounded-full bg-white text-sm border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[var(--teal)]">
                            <img src="/securemagnus_2025/images/img/search.svg"
                                class="w-5 h-5 text-gray-400 absolute left-7 top-1/2 transform -translate-y-1/2" alt="">
                        </div>

                    </button>
                    <button class="hidden lg:block ms-auto">
                        <a href=""
                            class=" flex items-center justify-center gap-3 px-6 py-2.5 rounded-full bg-transparent text-gray-900 border border-[var(--strokeGray)] transition-all duration-300 hover:bg-transparent hover:border-[var(--teal)] hover:text-[var(--teal)]">

                            Sort by
                            <img src="images/img/arrow.svg" alt="">
                        </a>

                    </button>
                </div>


                <a href="" class="block lg:hidden">
                    <img src="/securemagnus_2025/images/img/sortby.svg" class="size-9" alt="">
                </a>
            </div>
            <div class="overflow-x-auto hide-scrollbar">
                <table class="min-w-full text-sm text-left">
                    <thead class="bg-[#FAFBFC]">
                        <tr>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap">Tag Number</th>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap">NFC Code</th>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap">Copy URL</th>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap">
                                View Report
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(typeof nfcDevices !==undefined || nfcDevices !==null){ nfcDevices.forEach((device,index)=>
                            { %>
                            <tr class="border-t hover:bg-blue-50 transition-colors">
                                <td class="px-6 py-6 whitespace-nowrap editable">
                                    <%= index %>
                                </td>
                                <td class="px-6 py-6 whitespace-nowrap editable">
                                    <%= device.nfc_code %>
                                </td>
                                <td class="px-6 py-6 whitespace-nowrap editable">
                                    <button
                                        class="copyUrlButton flex gap-1 text-teal-500 hover:text-white hover:bg-teal-500 border border-teal-500 px-2 py-1.5 p-1 rounded-lg transition"
                                        data-url="<%=device.download_url%>" title="Copy URL">
                                        Copy URL
                                        <img src="/securemagnus_2025/images/copy.svg" class="svg" alt="">
                                    </button>
                                </td>
                                <td class="px-6 py-4 text-start flex items-center gap-2">
                                    <div class="flex gap-2">
                                        <a class="p-2 rounded-full hover:bg-blue-50" title="View Details"
                                            href="/phm/campaign/nfc/device/report/<%= campaignDetails.id %>/<%=device.nfc_code %>">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                class="w-5 h-5 text-blue-600 hover:text-blue-800" fill="none"
                                                viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                                </path>
                                            </svg>
                                        </a>

                                    </div>


                                </td>
                            </tr>
                            <% })}%>

                    </tbody>
                </table>
            </div>





            <div class="flex justify-between items-center px-6 mt-16">

                <p class="text-[#656972]">
                    Showing 1-8 out of 32 Entries
                </p>


                <div class=" py-7 pb-9 flex flex-wrap items-center justify-center gap-2">
                    <button
                        class="w-8 h-8 rounded-full flex items-center justify-center bg-[#F1F5F8] text-gray-500 hover:text-white hover:bg-[var(--teal)] duration-300">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
                        </svg>
                    </button>
                    <button
                        class="w-8 h-8 rounded-full flex items-center justify-center text-gray-600 hover:bg-teal-50 hover:text-[var(--teal)] hover:border hover:border-[var(--teal)] duration-300">1</button>
                    <button
                        class="w-8 h-8 rounded-full bg-teal-50 text-[var(--teal)] border border-[var(--teal)]">2</button>
                    <button
                        class="w-8 h-8 rounded-full flex items-center justify-center text-gray-600 hover:bg-teal-50 hover:text-[var(--teal)] hover:border hover:border-[var(--teal)] duration-300">3</button>
                    <button
                        class="w-8 h-8 rounded-full flex items-center justify-center text-gray-600 hover:bg-teal-50 hover:text-[var(--teal)] hover:border hover:border-[var(--teal)] duration-300">4</button>
                    <button
                        class="w-8 h-8 rounded-full flex items-center justify-center bg-[#F1F5F8] text-gray-500 hover:text-white hover:bg-[var(--teal)] duration-300">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>



<script>
    $('table').on('click', '.copyUrlButton', function () {
        // alert('Copy URL button clicked');
        const url = $(this).data('url');
        navigator.clipboard.writeText(url)
            .then(() => alert('URL copied!'))
            .catch(() => alert('Failed to copy URL'));
    });
    window.CampaignMetrics = {
        openedLink: <%= typeof campaignStats !== 'undefined' && campaignStats?.is_opened || 0 %>,
        interactForm: <%= typeof campaignStats !== 'undefined' && campaignStats?.is_interacted || 0 %>,
        submitForm: <%= typeof campaignStats !== 'undefined' && campaignStats?.is_submitted || 0 %>,
        attachmentDownloaded: <%= typeof campaignStats !== 'undefined' && campaignStats?.is_downloaded || 0 %>,
        totalScans: <%= typeof campaignStats !== 'undefined' && campaignStats?.number_of_scans || 0 %>,
        totalNotScans: <%= typeof scannedNotScannedStats !== 'undefined' && scannedNotScannedStats?.notScannedCount || 0 %>,
        totalNFCDevices: <%= typeof scannedNotScannedStats !== 'undefined' && scannedNotScannedStats?.totalDevices || 0 %>,
    };


</script>
<script src="/securemagnus_2025/js/nfc_camp_view.js"></script>
<script src="/securemagnus_2025/js/icons.js"></script>