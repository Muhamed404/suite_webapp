<div class="flex flex-col p-6 gap">
  <div class="flex flex-col gap-2 mb-4 border-b border-gray-100 pb-4">
    <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0" aria-label="Breadcrumb">
      <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
      <span class="text-gray-400">›</span>
      <a href="/phm/campaign/all-campaigns" class="hover:text-gray-700 transition"><%= __("breadcrumbs.campaigns") %></a>
      <span class="text-gray-400">›</span>
      <span class="font-semibold text-gray-900"><%= __("breadcrumbs.createNFCCampaign") %></span>
    </nav>
    <h3 class="text-3xl font-medium text-gray-900"><%= __("breadcrumbs.createNFCCampaign") %></h3>
  </div>

  <!-- first section  -->

  <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white">

    <form id="nfcCampaignForm" name="nfcCampaignForm" class="bg-white  w-full mt-3 p-8" 
    action="/phm/campaign/nfc/create" method="post">
      <!-- Stepper Navigation -->
      <div id="stepper" class="flex items-center justify-between mb-10">
        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-teal-500 text-white font-bold text-xs">
            1</div>
          <span class="font-medium step-label text-teal-700 text-sm">
            <%= __("generic_label.select_template") %>

          </span>
        </div>
        <div class="flex-1 h-0.5 bg-teal-100 mx-2"></div>
        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-white border-2 border-teal-300 text-teal-400 font-bold text-xs">
            2</div>
          <span class="font-medium step-label text-gray-400 text-sm">
           <%= __("nfc_campaign.select_tag_quantity") %>
          </span>
        </div>
        <div class="flex-1 h-0.5 bg-teal-100 mx-2"></div>
        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-white border-2 border-teal-300 text-teal-400 font-bold text-xs">
            3</div>
          <span class="font-medium step-label text-gray-400 text-sm">
                       <%= __("generic_label.select_date_time") %>

          </span>
        </div>
        
        
      </div>

      <div id="steps">
        <!-- Step 1: Trial and Subscription Details -->
        <%- include('./selectTemplate.ejs') %>

          <!-- Step 2: Select Department & Group -->

          <%- include('./selectTagQuantity.ejs') %>

          <%- include('./selectDateTime.ejs') %>

      </div>


    </form>

    <!-- Buttons -->
    <div class="flex justify-end gap-4 mt-10 p-8">
      <button id="backBtn" type="button"
        class="px-8 py-2 rounded-lg bg-gray-100 text-gray-600 font-medium border hover:border-gray-300 transition"><%= __("generic_label.back") %></button>
      <button id="nextBtn" type="submit"
        class="px-8 py-2 rounded-lg bg-[var(--teal)] text-white font-semibold hover:bg-teal-500 transition"><%= __("generic_label.next") %></button>
    </div>


  </div>

</div>

<!-- expose server-side arrays for client JS -->
<script>
  // expose server-side arrays for client JS
  window._userTemplates = <%- JSON.stringify(templates || []) %>;
  window._systemTemplates = <%- JSON.stringify(systemTemplate || []) %>;
  window.i18n = {
    labels: {
      select_template: "<%= __('generic_label.select_template') %>",
      selectTemplate: "<%= __('generic_label.select_template') %>",
      next: "<%= __('generic_label.next') %>",
      back: "<%= __('generic_label.back') %>",
      finish: "<%= __('generic_label.Finish') %>"
    },
    generic_label: {
      emailOpened: "<%= __('generic_label.emailOpened') %>",
      linkClicked: "<%= __('generic_label.linkClicked') %>",
      qrScanned: "<%= __('generic_label.qrScanned') %>",
      nfcScanned: "<%= __('generic_label.nfcScanned') %>",
      attachmentOpened: "<%= __('generic_label.attachmentOpened') %>",
      formInteraction: "<%= __('generic_label.formInteraction') %>",
      formSubmitted: "<%= __('generic_label.formSubmitted') %>"
    },
    template: {
      tracking_header: "<%= __('template.tracking_header') %>"
    },
    validation_messages: {
      campaign_name_required: "<%= __('validation_messages.campaign_name_required') %>",
      tag_quantity_required: "<%= __('validation_messages.nfc_quantity_required') %>",
      min_value_validation: "<%= __('validation_messages.min_value_validation') %>"
    }
  };
</script>
<script src="/securemagnus_2025/js/custom_script/nfc_create_campaign_validation.js"></script>
<script src="/securemagnus_2025/js/form_stepper.js"></script>
<script src="/securemagnus_2025/js/time-validation.js"></script>
<script src="/securemagnus_2025/js/jqueryNFCCreateCampaign.js"></script>
<script src="/securemagnus_2025/js/email_campaign_form_stepper.js"></script>

