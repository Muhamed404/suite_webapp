<div class="flex flex-col p-6 pt-0">
  <!-- first section  -->
  <div class="flex flex-col gap-4 mt-3">
    <!-- Title -->
    <h1 class="my-2 text-2xl font-semibold"><%= __('nfc_campaign.tagReport') %> : <%=nfcReportProfile.nfc_code%>
    </h1>
    
    <!-- Top Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <div class="bg-white p-4 flex flex-col rounded-xl">
            <div class="flex items-center justify-between gap-2 mb-8">
                <p class="text-gray-500 text-sm"><%= __('nfc_campaign.totalNotScans') %></p>
                <img src="/securemagnus_2025/images/Icons_Campaign_Report/Report_Admin.svg" alt="">
            </div>
            <p class="text-4xl">
                <%=interactionStats.number_of_scans%>

            </p>
        </div>
        <div class="bg-white p-4 flex flex-col rounded-xl">
            <div class="flex items-center justify-between gap-2 mb-8">
                <p class="text-gray-500 text-sm"><%= __('nfc_campaign.opened') %></p>
                <img src="/securemagnus_2025/images/Icons_Campaign_Report/Opened_by_people.svg" alt="">
            </div>
            <p class="text-4xl">
                <%=interactionStats.is_opened%>
            </p>
        </div>
        <div class="bg-white p-4 flex flex-col rounded-xl">
            <div class="flex items-center justify-between gap-2 mb-8">
                <p class="text-gray-500 text-sm"><%= __('nfc_campaign.download') %></p>
                <img src="/securemagnus_2025/images/Icons_Campaign_Report/not_opened.svg" alt="">
            </div>
            <p class="text-4xl">
                <%=interactionStats.is_downloaded%>

            </p>
        </div>
        <div class="bg-white p-4 flex flex-col rounded-xl">
            <div class="flex items-center justify-between gap-2 mb-8">
                <p class="text-gray-500 text-sm"><%= __('nfc_campaign.totalSubmitted') %></p>
                <img src="/securemagnus_2025/images/Icons_Campaign_Report/link_Clicked.svg" alt="">
            </div>
            <p class="text-4xl">
                <%=interactionStats.is_submitted%>

            </p>
        </div>
        <div class="bg-white p-4 flex flex-col rounded-xl">
            <div class="flex items-center justify-between gap-2 mb-8">
                <p class="text-gray-500 text-sm"><%= __('nfc_campaign.totalInteract') %></p>
                <img src="/securemagnus_2025/images/Icons_Campaign_Report/Report_Admin.svg" alt="">
            </div>
            <p class="text-4xl">
                <%=interactionStats.is_interacted%>

            </p>
        </div>
    </div>

    <!-- Main Section -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
      <!-- Timeline Chart -->
      <div class="col-span-2 p-6 bg-white rounded-xl">
        <h2 class="mb-4 text-lg font-semibold"><%= __('nfc_campaign.campaignMetrics') %></h2>
        <div id="timelineChart"></div>
      </div>

      <!-- Phishing Success -->
      <div class="flex flex-col items-start justify-start p-6 bg-white rounded-xl gap-11">
        <h2 class="mb-4 text-lg font-semibold"><%= __('nfc_campaign.phishingSuccess') %></h2>

        <div class="flex items-center justify-between w-full gap-10">
          <!-- Left Side Labels -->
          <div class="space-y-6">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#38bdf8]"></span>
              <div>
                <p class="text-sm text-gray-500"><%= __('nfc_campaign.nfcView') %></p>
                <p class="text-lg font-bold text-gray-900" id="qrScanned">
                    
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#f87171]"></span>
              <div>
                <p class="text-sm text-gray-500"><%= __('nfc_campaign.formInteracted') %></p>
                <p class="text-lg font-bold text-gray-900" id="formInteract">
                   
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#34d399]"></span>
              <div>
                <p class="text-sm text-gray-500"><%= __('nfc_campaign.totalActivity') %></p>
                <p class="text-lg font-bold text-gray-900" id="targetCompromisedText">
                  
                </p>
              </div>
            </div>
          </div>

          <!-- Donut Chart -->
          <div id="successChart" style="width:50%; height:50%;"></div>
        </div>
      </div>
    </div>

    <!-- IP Interaction Cards -->
    <div class="p-6 bg-white rounded-xl">
      <button type="button" onclick="toggleTimelineCards()" class="flex items-center justify-between w-full text-left">
        <h2 class="text-lg font-semibold"><%= __('nfc_campaign.ipInteractions') %></h2>
        <span id="timelineCardsChevron" class="flex items-center justify-center w-7 h-7 rounded-full transition-transform" style="background:#f1f5f9">
          <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
          </svg>
        </span>
      </button>
      <div id="timelineCards" class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4"></div>
    </div>

    <!-- Second Row -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <!-- Employees Phishing Segments -->
      <div class="p-6 bg-white rounded-xl ">
        <h2 class="mb-4 text-lg font-semibold">
          <%= __('nfc_campaign.phishingSegments') %>
        </h2>
        <div id="userPhishingSegmentsChart"></div>
      </div>

      <!-- Reported To Admin -->
      <div class="p-6 bg-white rounded-xl ">
        <h2 class="mb-4 text-lg font-semibold"><%= __('nfc_campaign.employeeResponse') %></h2>
        <div id="reportChart"></div>
      </div>

      <!-- Employee Details -->
      <div class="p-6 bg-white rounded-xl ">
        <h2 class="mb-6 text-lg font-semibold text-gray-800"><%= __('nfc_campaign.nfcCampaignDetails') %></h2>
        <div class="space-y-4">
          <div class="flex justify-between text-sm">
            <span class="text-gray-500"><%= __('nfc_campaign.nfcDeviceCode') %></span>
            <span class="font-medium text-gray-800">
              <%=nfcReportProfile.nfc_code%>
            </span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-500"><%= __('nfc_campaign.campaignName') %></span>
            <span class="font-medium text-gray-800">
              <%=campaignDetails.name%>
            </span>
          </div>
 
          <div class="flex justify-between text-sm">
            <span class="text-gray-500"><%= __('nfc_campaign.campaignDate') %></span>
            <span class="font-medium text-gray-800">              <%=campaignDetails.start_datetime%>
</span>
          </div>
        </div>
      </div>
    </div>
    
  </div>
</div>



<script>
 
// Client-side i18n setup for NFC report
window.i18n = {
  qr_report: {
    times: "<%= __('qr_report.times') %>",
    no_timeline_data: "<%= __('qr_report.no_timeline_data') %>",
    no_user_interactions: "<%= __('qr_report.no_user_interactions') %>",
    qr_scanned: "<%= __('qr_report.qr_scanned') %>",
    links_clicked: "<%= __('qr_report.links_clicked') %>",
    target_compromised: "<%= __('qr_report.target_compromised') %>",
    qr_not_scanned: "<%= __('qr_report.qr_not_scanned') %>",
    interact_form: "<%= __('qr_report.interact_form') %>",
    submit_data: "<%= __('qr_report.submit_data') %>",
    attachment_opened: "<%= __('qr_report.attachment_opened') %>",
    total_actions: "<%= __('qr_report.total_actions') %>",
    nfc_created: "<%= __('qr_report.nfc_created') %>",
    scanned: "<%= __('qr_report.scanned') %>",
    attachment_open: "<%= __('qr_report.attachment_open') %>",
    qr_created: "<%= __('qr_report.qr_created') %>"
  }
};
</script>
<script>
(function () {
  var _tlOpen = true;
  function toggleTimelineCards() {
    _tlOpen = !_tlOpen;
    var body = document.getElementById('timelineCards');
    var chevron = document.getElementById('timelineCardsChevron');
    if (body) body.style.display = _tlOpen ? '' : 'none';
    if (chevron) chevron.style.transform = _tlOpen ? '' : 'rotate(180deg)';
  }
  window.toggleTimelineCards = toggleTimelineCards;
})();
</script>
<script>

  // Pass user interaction timeline data to JavaScript
  window.interactionTimeline = <%- JSON.stringify(interactionTimeline || []) %>;
  window.interactionStats = <%- JSON.stringify(interactionStats || []) %>;
  // nfc_report_details mapped as qrTagReportDetails for timeline chart reuse
  window.qrTagReportDetails = <%- JSON.stringify(nfcReportDetails || []) %>;



</script>
<script src="/securemagnus_2025/js/nfc-tag-report.js"></script>