        linkClicked: '<%= __("whatsapp.campaign_details.link_clicked") || "Link Clicked" %>',
        pageVisited: '<%= __("whatsapp.campaign_details.page_visited") || "Page Visited" %>',
        formInteracted: '<%= __("whatsapp.campaign_details.form_interacted") || "Form Interacted" %>',
        formSubmitted: '<%= __("whatsapp.campaign_details.form_submitted") || "Form Submitted" %>',
        fileDownloaded: '<%= __("whatsapp.campaign_details.file_downloaded") || "File Downloaded" %>',
        noInteraction: '<%= __("whatsapp.campaign_details.no_interaction") || "No Interaction" %>',
        interacted: '<%= __("whatsapp.campaign_details.interacted") || "Interacted" %>',
        
    };
