<div class="flex flex-col p-6 pt-0">
    <!-- Header Section -->
    <div class="flex flex-col gap-4 mt-3">
        <!-- Title -->
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-semibold my-2">
                    <%= __("whatsapp.campaign_details.title") || "SMS Campaign Details" %>
                </h1>
                <p class="text-gray-500">
                    <%= campaign?.name || "Campaign Name" %>
                </p>
            </div>
            <div class="flex gap-2">

                <a href="/phm/campaign/whatsapp/report"
                    class="px-4 py-2 rounded-full bg-gray-300 text-gray-800 hover:bg-gray-400 transition">
                    <i class="fas fa-arrow-left mr-2"></i>
                    <%= __("whatsapp.campaign_details.back") || "Back" %>
                </a>
            </div>
        </div>

        <!-- Top Metrics - SMS Specific -->
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 mt-4">
            <!-- Total SMS Sent -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                <div class="flex items-center justify-between gap-2 mb-4">
                    <p class="text-gray-600 text-xs font-medium">
                        <%= __("whatsapp.campaign_details.total_sms_sent") || "SMS Sent" %>
                    </p>
                    <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-envelope text-blue-600 text-sm"></i>
                    </div>
                </div>
                <div class="flex items-center justify-between gap-2 mb-2">
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full bg-green-100 text-green-700 text-sm font-semibold">
                        <i class="fas fa-paper-plane mr-1"></i>
                        <%= inviteesCountStats?.totalSent || 0 %> Sent
                    </span>
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full bg-gray-200 text-gray-700 text-sm font-semibold">
                        <i class="fas fa-clock mr-1"></i>
                        <%= inviteesCountStats?.totalUnSent || 0 %> Unsent
                    </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
                    <% const sent=inviteesCountStats?.totalSent || 0; %>
                        <% const unsent=inviteesCountStats?.totalUnSent || 0; %>
                            <% const total=sent + unsent; %>
                                <% const sentPercent=total> 0 ? (sent / total) * 100 : 0; %>
                                    <div class="bg-blue-500 h-2 rounded-full transition-all duration-500"
                                        style="width: <%= sentPercent %>%"></div>
                </div>
                <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>Sent</span>
                    <span>Unsent</span>
                </div>
            </div>

            <!-- SMS Delivered Enhanced -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                <div class="flex items-center justify-between gap-2 mb-4">
                    <p class="text-gray-600 text-xs font-medium">
                        <%= __("whatsapp.campaign_details.sms_delivered") || "Delivered" %>
                    </p>
                    <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-check-circle text-green-600 text-sm"></i>
                    </div>
                </div>
                <div class="flex items-center justify-between gap-2 mb-2">
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full bg-green-100 text-green-700 text-sm font-semibold">
                        <i class="fas fa-check mr-1"></i>
                        <%= campaign?.whatsappStats?.totalDelivered || 0 %> Delivered
                    </span>
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full bg-gray-200 text-gray-700 text-sm font-semibold">
                        <i class="fas fa-times mr-1"></i>
                        <%= (campaign?.whatsappStats?.totalSMSSent || 0) - (campaign?.whatsappStats?.totalDelivered ||
                            0) %> Not
                    </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
                    <% const delivered=campaign?.whatsappStats?.totalDelivered || 0; %>
                        <% const totalSMS=campaign?.whatsappStats?.totalSMSSent || 0; %>
                            <% const deliveredPercent=totalSMS> 0 ? (delivered / totalSMS) * 100 : 0; %>
                                <div class="bg-green-500 h-2 rounded-full transition-all duration-500"
                                    style="width: <%= deliveredPercent %>%"></div>
                </div>
                <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>Delivered</span>
                    <span>Not Delivered</span>
                </div>
            </div>

            <!-- Link Clicked Enhanced -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                <div class="flex items-center justify-between gap-2 mb-4">
                    <p class="text-gray-600 text-xs font-medium">
                        <%= __("whatsapp.campaign_details.link_clicked") || "Link Clicked" %>
                    </p>
                    <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-link text-purple-600 text-sm"></i>
                    </div>
                </div>
                <div class="flex items-center justify-between gap-2 mb-2">
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full bg-purple-100 text-purple-700 text-sm font-semibold">
                        <i class="fas fa-mouse-pointer mr-1"></i>
                        <%= campaign?.whatsappStats?.is_link_clicked || 0 %> Clicked
                    </span>
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full bg-gray-200 text-gray-700 text-sm font-semibold">
                        <i class="fas fa-times mr-1"></i>
                        <%= (campaign?.whatsappStats?.totalSMSSent || 0) - (campaign?.whatsappStats?.is_link_clicked ||
                            0) %> Not
                    </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
                    <% const clicked=campaign?.whatsappStats?.totalUniqueClickCount || 0; %>
                        <% const totalSMS_link_clicked=campaign?.whatsappStats?.totalSMSSent || 0; %>
                            <% const clickedPercent=totalSMS_link_clicked> 0 ? (clicked / totalSMS_link_clicked) * 100 :
                                0; %>
                                <div class="bg-purple-500 h-2 rounded-full transition-all duration-500"
                                    style="width: <%= clickedPercent %>%"></div>
                </div>
                <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>Clicked</span>
                    <span>Not Clicked</span>
                </div>
            </div>

            <!-- Page Visited Enhanced -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                <div class="flex items-center justify-between gap-2 mb-4">
                    <p class="text-gray-600 text-xs font-medium">
                        <%= __("whatsapp.campaign_details.page_visited") || "Page Visited" %>
                    </p>
                    <div class="w-8 h-8 bg-orange-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-globe text-orange-600 text-sm"></i>
                    </div>
                </div>
                <div class="flex items-center justify-between gap-2 mb-2">
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full bg-orange-100 text-orange-700 text-sm font-semibold">
                        <i class="fas fa-eye mr-1"></i>
                        <%= campaign?.whatsappStats?.is_page_visited || 0 %> Visited
                    </span>
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full bg-gray-200 text-gray-700 text-sm font-semibold">
                        <i class="fas fa-times mr-1"></i>
                        <%= (campaign?.whatsappStats?.totalSMSSent || 0) - (campaign?.whatsappStats?.is_page_visited ||
                            0) %> Not
                    </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
                    <% const visited=campaign?.whatsappStats?.totalUniqePageClickCount || 0; %>
                        <% const totalSMS_page_visited=campaign?.whatsappStats?.totalSMSSent || 0; %>
                            <% const visitedPercent=totalSMS_page_visited> 0 ? (visited / totalSMS_page_visited) * 100 :
                                0; %>
                                <div class="bg-orange-500 h-2 rounded-full transition-all duration-500"
                                    style="width: <%= visitedPercent %>%"></div>
                </div>
                <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>Visited</span>
                    <span>Not Visited</span>
                </div>
            </div>

            <!-- Form Submitted -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                <div class="flex items-center justify-between gap-2 mb-4">
                    <p class="text-gray-600 text-xs font-medium">
                        <%= __("whatsapp.campaign_details.form_submitted") || "Form Submitted" %>
                    </p>
                    <div class="w-8 h-8 bg-teal-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-check text-teal-600 text-sm"></i>
                    </div>
                </div>
                <div class="flex items-center justify-between gap-2 mb-2">
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full bg-teal-100 text-teal-700 text-sm font-semibold">
                        <i class="fas fa-check-double mr-1"></i>
                        <%= campaign?.whatsappStats?.is_form_submitted || 0 %> Submitted
                    </span>
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full bg-gray-200 text-gray-700 text-sm font-semibold">
                        <i class="fas fa-times mr-1"></i>
                        <%= (campaign?.whatsappStats?.totalSMSSent || 0) - (campaign?.whatsappStats?.is_form_submitted
                            || 0) %> Not
                    </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
                    <% const submitted=campaign?.whatsappStats?.totalUniqueSubmitCount || 0; %>
                        <% const totalSMS_form_submitted=campaign?.whatsappStats?.totalSMSSent || 0; %>
                            <% const submittedPercent=totalSMS_form_submitted> 0 ? (submitted / totalSMS_form_submitted)
                                * 100 : 0; %>
                                <div class="bg-teal-500 h-2 rounded-full transition-all duration-500"
                                    style="width: <%= submittedPercent %>%"></div>
                </div>
                <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>Submitted</span>
                    <span>Not Submitted</span>
                </div>
            </div>

            <!-- File Downloaded -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                <div class="flex items-center justify-between gap-2 mb-4">
                    <p class="text-gray-600 text-xs font-medium">
                        <%= __("whatsapp.campaign_details.file_downloaded") || "File Downloaded" %>
                    </p>
                    <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-download text-red-600 text-sm"></i>
                    </div>
                </div>
                <div class="flex items-center justify-between gap-2 mb-2">
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full bg-red-100 text-red-700 text-sm font-semibold">
                        <i class="fas fa-file-download mr-1"></i>
                        <%= campaign?.whatsappStats?.is_file_downloaded || 0 %> Downloaded
                    </span>
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full bg-gray-200 text-gray-700 text-sm font-semibold">
                        <i class="fas fa-times mr-1"></i>
                        <%= (campaign?.whatsappStats?.totalSMSSent || 0) - (campaign?.whatsappStats?.is_file_downloaded
                            || 0) %>
                            Not
                    </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
                    <% const downloaded=campaign?.whatsappStats?.totalUniqueDownloadCount || 0; %>
                        <% const totalSMS_file_downloaded=campaign?.whatsappStats?.totalSMSSent || 0; %>
                            <% const downloadedPercent=totalSMS_file_downloaded> 0 ? (downloaded /
                                totalSMS_file_downloaded) * 100 : 0; %>
                                <div class="bg-red-500 h-2 rounded-full transition-all duration-500"
                                    style="width: <%= downloadedPercent %>%"></div>
                </div>
                <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>Downloaded</span>
                    <span>Not Downloaded</span>
                </div>
            </div>
        </div>

        <!-- Main Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mt-6">
            <!-- Campaign Metrics Bar Chart -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 lg:col-span-2">
                <h2 class="text-lg font-semibold mb-6 text-gray-900">
                    <%= __("whatsapp.campaign_details.interaction_metrics") || "Interaction Metrics" %>
                </h2>
                <div id="campaignMetricsChart" style="height: 350px;"></div>
            </div>

            <!-- SMS Interaction Summary - Donut Chart -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                <h2 class="text-lg font-semibold mb-6 text-gray-900">
                    <%= __("whatsapp.campaign_details.interaction_summary") || "Interaction Summary" %>
                </h2>
                <div id="interactionSummaryChart" style="height: 350px;"></div>
            </div>
        </div>

        <!-- Detailed Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
            <!-- SMS Reply Stats -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                <h2 class="text-lg font-semibold mb-4 text-gray-900">
                    <%= __("whatsapp.campaign_details.sms_reply_stats") || "SMS Reply Stats" %>
                </h2>
                <div class="space-y-4">
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600">
                            <%= __("whatsapp.campaign_details.sms_replied") || "SMS Replied" %>
                        </span>
                        <span class="font-semibold text-lg text-blue-600">
                            <%= campaign?.whatsappStats?.is_sms_replied || 0 %>
                        </span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600">
                            <%= __("whatsapp.campaign_details.call_made") || "Call Made" %>
                        </span>
                        <span class="font-semibold text-lg text-orange-600">
                            <%= campaign?.whatsappStats?.is_call_made || 0 %>
                        </span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600">
                            <%= __("whatsapp.campaign_details.otp_shared") || "OTP Shared" %>
                        </span>
                        <span class="font-semibold text-lg text-red-600">
                            <%= campaign?.whatsappStats?.is_otp_shared || 0 %>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Campaign Details -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                <h2 class="text-lg font-semibold mb-4 text-gray-900">
                    <%= __("whatsapp.campaign_details.campaign_details") || "Campaign Details" %>
                </h2>
                <div class="space-y-4">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-600">
                            <%= __("whatsapp.campaign_details.campaign_name") || "Campaign Name" %>
                        </span>
                        <span class="font-medium text-gray-900">
                            <%= campaign?.name || "N/A" %>
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-600">
                            <%= __("whatsapp.campaign_details.template_name") || "Template" %>
                        </span>
                        <span class="font-medium text-gray-900">
                            <%= campaign?.template?.name || "N/A" %>
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-600">
                            <%= __("whatsapp.campaign_details.launch_date") || "Launch Date" %>
                        </span>
                        <span class="font-medium text-gray-900">
                            <%= campaign?.launchDate || "N/A" %>
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-600">
                            <%= __("whatsapp.campaign_details.status") || "Status" %>
                        </span>
                        <span
                            class="inline-flex items-center px-2 py-1 text-xs font-medium rounded-full <%= campaign?.campaignStatus === 'Active' ? 'bg-green-100 text-green-800' : campaign?.campaignStatus === 'Completed' ? 'bg-blue-100 text-blue-800' : 'bg-yellow-100 text-yellow-800' %>">
                            <%= campaign?.campaignStatus || "Unknown" %>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Delivery Performance -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                <h2 class="text-lg font-semibold mb-4 text-gray-900">
                    <%= __("whatsapp.campaign_details.delivery_performance") || "Delivery Performance" %>
                </h2>
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between mb-2">
                            <span class="text-gray-600 text-sm">
                                <%= __("whatsapp.campaign_details.delivery_rate") || "Delivery Rate" %>
                            </span>
                            <span class="font-semibold text-teal-600">
                                <%= campaign?.whatsappStats?.deliveryRate || "0%" %>
                            </span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-teal-600 h-2 rounded-full"
                                style="width: <%= campaign?.whatsappStats?.deliveryRate?.replace('%', '') || 0 %>%">
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between mb-2">
                            <span class="text-gray-600 text-sm">
                                <%= __("whatsapp.campaign_details.interaction_rate") || "Interaction Rate" %>
                            </span>
                            <span class="font-semibold text-blue-600">
                                <% const interactionRate=((campaign?.whatsappStats?.totalInteractionCount || 0) /
                                    (campaign?.whatsappStats?.totalSMSSent || 1) * 100).toFixed(2) %>
                                    <%= interactionRate %>%
                            </span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-blue-600 h-2 rounded-full" style="width: <%= interactionRate %>%">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Interaction Breakdown Charts -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
            <!-- Link Interaction -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                <div class="flex items-center gap-2 mb-4">
                    <i class="fas fa-link text-purple-600 text-lg"></i>
                    <h3 class="text-lg font-semibold text-gray-900">
                        <%= __("whatsapp.campaign_details.link_interaction") || "Link Clicked" %>
                    </h3>
                </div>
                <div id="linkInteractionChart"></div>
            </div>

            <!-- Form Interaction -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                <div class="flex items-center gap-2 mb-4">
                    <i class="fas fa-check text-teal-600 text-lg"></i>
                    <h3 class="text-lg font-semibold text-gray-900">
                        <%= __("whatsapp.campaign_details.form_interaction") || "Form Interacted" %>
                    </h3>
                </div>
                <div id="formInteractionChart"></div>
            </div>

            <!-- Page Visit -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                <div class="flex items-center gap-2 mb-4">
                    <i class="fas fa-globe text-orange-600 text-lg"></i>
                    <h3 class="text-lg font-semibold text-gray-900">
                        <%= __("whatsapp.campaign_details.page_visit") || "Page Visited" %>
                    </h3>
                </div>
                <div id="pageVisitChart"></div>
            </div>

            <!-- File Download -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                <div class="flex items-center gap-2 mb-4">
                    <i class="fas fa-download text-red-600 text-lg"></i>
                    <h3 class="text-lg font-semibold text-gray-900">
                        <%= __("whatsapp.campaign_details.file_download") || "File Downloaded" %>
                    </h3>
                </div>
                <div id="fileDownloadChart"></div>
            </div>
        </div>

        <!-- Invitee Response Table -->
        <div class="mt-6 bg-white rounded-2xl shadow-sm border border-gray-100">
            <div class="flex items-center justify-between gap-3 px-6 py-5 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">
                    <%= __("whatsapp.campaign_details.invitee_responses") || "Invitee Responses" %>
                </h2>
                <div class="relative flex-1 max-w-xs">
                    <input type="text" id="responseSearchInput" placeholder="<%= __(" generic_label.search_here")
                        || 'Search...' %>"
                    class="w-full pl-10 pr-4 py-2 rounded-full bg-gray-50 text-sm border border-gray-300
                    focus:outline-none focus:ring-2 focus:ring-[var(--teal)]">
                    <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-[#FAFBFC] border-b border-gray-200">
                        <tr>

                            <th class="px-6 py-4 font-semibold text-gray-700 whitespace-nowrap">
                                <%= __("whatsapp.campaign_details.invitee_name") || "Invitee Name" %>
                            </th>

                            <th class="px-6 py-4 font-semibold text-gray-700 whitespace-nowrap text-center">
                                <%= __("whatsapp.campaign_details.total_sms_sent") || "Sent" %>
                            </th>
                            
                            <th class="px-6 py-4 font-semibold text-gray-700 whitespace-nowrap text-center">
                                <%= __("whatsapp.campaign_details.link_clicked") || "Link Clicked" %>
                            </th>
                            <th class="px-6 py-4 font-semibold text-gray-700 whitespace-nowrap text-center">
                                <%= __("whatsapp.campaign_details.page_visited") || "Page Visited" %>
                            </th>
                            <th class="px-6 py-4 font-semibold text-gray-700 whitespace-nowrap text-center">
                                <%= __("whatsapp.campaign_details.form_interacted") || "Form Interacted" %>
                            </th>
                            <th class="px-6 py-4 font-semibold text-gray-700 whitespace-nowrap text-center">
                                <%= __("whatsapp.campaign_details.form_submitted") || "Form Submitted" %>
                            </th>

                        </tr>
                    </thead>
                    <tbody id="inviteeTableBody">
                        <!-- Rows will be populated by JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls -->
            <div
                class="px-6 py-4 border-t border-gray-200 flex flex-col gap-3 md:flex-row items-center justify-between">
                <div class="text-sm text-gray-600">
                    <span id="paginationInfo">Showing 0 of 0</span>
                </div>
                <div class="flex flex-wrap gap-1 justify-center">
                    <button id="prevBtn"
                        class="px-3 py-2 rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 disabled:opacity-50 disabled:cursor-not-allowed transition text-sm whitespace-nowrap">
                        <i class="fas fa-chevron-left mr-1"></i>
                        <%= __("generic_label.previous") || "Previous" %>
                    </button>
                    <div id="pageNumbers" class="flex flex-wrap gap-1 justify-center"></div>
                    <button id="nextBtn"
                        class="px-3 py-2 rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 disabled:opacity-50 disabled:cursor-not-allowed transition text-sm whitespace-nowrap">
                        <%= __("generic_label.next") || "Next" %>
                            <i class="fas fa-chevron-right ml-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    // Pass data from EJS to JavaScript
    window.CampaignData = {
        campaign_name: '<%= campaign?.name || "N/A" %>',
        total_sms: <%= campaign?.whatsappStats?.totalSMSSent || 0 %>,
        delivered: <%= campaign?.whatsappStats?.totalDelivered || 0 %>,
        link_clicked: <%= campaign?.whatsappStats?.is_link_clicked || 0 %>,
        page_visited: <%= campaign?.whatsappStats?.is_page_visited || 0 %>,
        form_interacted: <%= campaign?.whatsappStats?.is_form_interacted || 0 %>,
        form_submitted: <%= campaign?.whatsappStats?.is_form_submitted || 0 %>,
        file_downloaded: <%= campaign?.whatsappStats?.is_file_downloaded || 0 %>,
        sms_replied: <%= campaign?.whatsappStats?.is_sms_replied || 0 %>,
        call_made: <%= campaign?.whatsappStats?.is_call_made || 0 %>,
        otp_shared: <%= campaign?.whatsappStats?.is_otp_shared || 0 %>,
        sms_interacted: <%= campaign?.whatsappStats?.is_sms_interacted || 0 %>,
        totalSMSSent: <%= campaign?.whatsappStats?.totalSMSSent || 0 %>,
        totalInteractionCount: <%= campaign?.whatsappStats?.totalInteractionCount || 0 %>,
        totalInviteeCount: <%= campaign?.whatsappStats?.totalInviteeCount || 0 %>,
        totalInviteeReportCount: <%= campaign?.whatsappStats?.totalInviteeReportCount || 0 %>,
        totalUniqePageClickCount: <%= campaign?.whatsappStats?.totalUniqePageClickCount || 0 %>,
        totalUniqueClickCount: <%= campaign?.whatsappStats?.totalUniqueClickCount || 0 %>,
        totalUniqueFormInteractionCount: <%= campaign?.whatsappStats?.totalUniqueFormInteractionCount || 0 %>,
