<div class="flex flex-col p-6 pt-0">
    <!-- Header Section -->
    <div class="flex flex-col gap-2 mt-3">
        <!-- Breadcrumb -->
        <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0 mb-2" aria-label="Breadcrumb">
            <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
            <span class="text-gray-400">›</span>
            <a href="/phm/campaign/reports" class="hover:text-gray-700 transition"><%= __("breadcrumbs.reports") %></a>
            <span class="text-gray-400">›</span>
            <span class="font-semibold text-gray-900"><%= __("breadcrumbs.whatsappCampaignReport") %></span>
        </nav>

        <!-- Title -->
        <h3 class="text-3xl font-medium text-gray-900">
            <%= __("whatsapp.campaign_report.title") || "WhatsApp Campaign Reports" %>
        </h3>

        <!-- Campaigns Table Section -->
        <div class="flex flex-col gap-4 mt-3">
            <!-- Header with Search and Sort -->
            <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3 w-full pt-5">
                <div id="statusTabs"
                    data-active-count="<%= (stats && typeof stats.active !== 'undefined') ? stats.active : 0 %>"
                    data-inactive-count="<%= (stats && typeof stats.inactive !== 'undefined') ? stats.inactive : 0 %>"
                    data-current-status="<%= isActiveFilter === 'true' ? 'active' : (isActiveFilter === 'false' ? 'inactive' : 'all') %>"
                    class="flex items-center justify-start gap-3 p-1 text-sm font-medium bg-white rounded-full w-fit">
                </div>

                <div class="flex flex-col lg:flex-row gap-4 w-full lg:w-auto lg:ml-auto">
                    <!-- Search Input -->
                    <div class="relative flex-1 lg:flex-initial">
                        <input type="text" 
                               id="searchInput" 
                               value="<%= searchQuery || '' %>"
                               placeholder="<%= __("generic_label.search_here") || 'Search here...' %>"
                               class="w-full lg:w-64 pl-14 pr-10 py-3 rounded-full bg-white text-sm border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[var(--teal)]">
                        <div class="absolute inset-y-0 left-0 flex items-center pl-4">
                            <img src="/securemagnus_2025/images/img/search.svg"
                                class="w-5 h-5 text-gray-400" alt="">
                        </div>
                    </div>

                    <!-- Mobile Sort Icon -->
                    <button class="lg:hidden p-2 rounded-full hover:bg-gray-100 transition">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                </div>
            </div>

            <% if (hasMessages) { %>
            <div class="bg-white rounded-3xl p-12 text-center">
                <div class="mb-4">
                    <i class="fas fa-inbox text-gray-400 text-6xl"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">
                    <%= emptyMessage %>
                </h3>
                <p class="text-gray-600 mb-6">
                    <%= __("whatsapp.campaign_report.empty_description") || "Create your first SMS campaign to see reports here." %>
                </p>
                <a href="/phm/campaign/whatsapp/create" class="inline-block bg-teal-600 text-white px-6 py-2 rounded-full hover:bg-teal-700 transition">
                    <i class="fas fa-plus mr-2"></i>
                    <%= __("whatsapp.campaign_report.create_campaign") || "Create Campaign" %>
                </a>
            </div>
            <% } else { %>
            <div class="bg-white rounded-3xl overflow-hidden">
            <!-- Table Container with Horizontal Scrollbar -->
            <div class="overflow-x-auto hide-scrollbar">
                <table class="min-w-full text-sm text-left">
                    <thead class="bg-[#FAFBFC]">
                        <tr>
                            <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap">
                                <%= __("whatsapp.campaign_report.campaign_name") || "Campaign Name" %>
                            </th>
                            <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap">
                                <%= __("whatsapp.campaign_report.template") || "Template" %>
                            </th>
                            <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <i class="fas fa-users text-green-600 text-sm"></i>
                                    <%= __("whatsapp.campaign_report.total_invitees") || "Total Invitees" %>
                                </div>
                            </th>
                            <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <i class="fas fa-check-circle text-green-600 text-sm"></i>
                                    <%= __("whatsapp.campaign_report.delivered") || "Delivered" %>
                                </div>
                            </th>
                            <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <i class="fas fa-chart-line text-blue-600 text-sm"></i>
                                    <%= __("whatsapp.campaign_report.delivery_rate") || "Delivery Rate" %>
                                </div>
                            </th>
                            <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap">
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-info-circle text-yellow-600 text-sm"></i>
                                    <%= __("whatsapp.campaign_report.status") || "Status" %>
                                </div>
                            </th>
                            <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap">
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-chart-bar text-orange-600 text-sm"></i>
                                    <%= __("whatsapp.campaign_report.activity") || "Activity" %>
                                </div>
                            </th>
                            <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap text-center">
                                <%= __("whatsapp.campaign_report.actions") || "Actions" %>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <% campaigns.forEach(campaign => { %>
                            <tr data-active-status="<%= campaign.isActive ? 'active' : 'inactive' %>">
                                <!-- Campaign Name -->
                                <td class="px-6 py-6 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        <div>
                                            <a href="/phm/campaign/whatsapp/report/campaign/<%= campaign.id %>" class="font-medium text-gray-900 hover:text-gray-700 block">
                                                <%= campaign.name %>
                                            </a>
                                            <p class="text-xs text-gray-500">ID: <%= campaign.campaign_identifier %></p>
                                        </div>
                                    </div>
                                </td>

                                <!-- Template Name -->
                                <td class="px-6 py-6 whitespace-nowrap">
                                    <span class="text-gray-700"><%= campaign.templateName %></span>
                                </td>

                                <!-- Total Invitees -->
                                <td class="px-6 py-6 whitespace-nowrap text-center">
                                    <span class="font-semibold text-gray-900">
                                        <%= campaign.totalInvitees %>
                                    </span>
                                </td>

                                <!-- Delivered -->
                                <td class="px-6 py-6 whitespace-nowrap text-center">
                                    <span class="font-semibold text-green-600">
                                        <%= campaign.totalDelivered %>
                                    </span>
                                </td>

                                <!-- Delivery Rate -->
                                <td class="px-6 py-6 whitespace-nowrap">
                                    <div class="flex items-center gap-2 justify-center">
                                        <div class="w-12 bg-gray-200 rounded-full h-1.5">
                                            <div class="bg-teal-600 h-1.5 rounded-full" 
                                                 style="width: <%= campaign.deliveryRate.replace('%', '') %>%">
                                            </div>
                                        </div>
                                        <span class="text-xs font-medium text-gray-900 w-10">
                                            <%= campaign.deliveryRate %>
                                        </span>
                                    </div>
                                </td>

                                <!-- Campaign Status -->
                                <td class="px-6 py-6 whitespace-nowrap">
                                    <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold <%= campaign.campaignStatus === 'Active' || campaign.campaignStatus === 'Completed' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                                        <%= campaign.campaignStatus %>
                                    </span>
                                </td>

                                <!-- Active Status -->
                                <td class="px-6 py-6 whitespace-nowrap">
                                    <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold <%= campaign.isActive ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                                        <%= campaign.isActive ? __("whatsapp.campaign_report.active") || "Active" : __("whatsapp.campaign_report.inactive") || "Inactive" %>
                                    </span>
                                </td>

                                <!-- Actions -->
                                <td class="px-6 py-6 whitespace-nowrap">
                                    <div class="flex gap-3 justify-center">
                                        <a href="/phm/campaign/whatsapp/report/campaign/<%= campaign.id %>" 
                                           class="p-2 rounded-full hover:bg-blue-50 transition"
                                           title="<%= __("whatsapp.campaign_report.view_details") || "View Details" %>">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600 hover:text-blue-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination Footer -->
            <div class="flex flex-col lg:flex-row items-center justify-between gap-4 px-5 py-4 border-t border-gray-200 bg-white">
                <p class="text-sm text-[#656972]">
                    <%= __("whatsapp.campaign_report.showing") || "Showing" %>
                    <span class="font-medium"><%= pagination.startItem %></span>
                    <%= __("whatsapp.campaign_report.to") || "-" %>
                    <span class="font-medium"><%= pagination.endItem %></span>
                    <%= __("whatsapp.campaign_report.of") || "of" %>
                    <span class="font-medium"><%= pagination.totalCampaigns %></span>
                    <%= __("whatsapp.campaign_report.entries") || "Entries" %>
                </p>

                <div class="flex flex-wrap items-center justify-center gap-1">
                    <% const querySuffix = searchQuery ? `&searchQuery=${encodeURIComponent(searchQuery)}` : ''; %>
                    <% const activeSuffix = isActiveFilter ? `&isActive=${encodeURIComponent(isActiveFilter)}` : ''; %>
                    <!-- First Page Button -->
                    <% if (pagination.hasPreviousPage) { %>
                        <a href="?page=1&pageSize=<%= pagination.pageSize %><%= querySuffix %><%= activeSuffix %>"
                            class="w-8 h-8 rounded-full flex items-center justify-center bg-[#F1F5F8] text-gray-500 hover:text-white hover:bg-[var(--teal)] transition-all duration-300">
                            <i class="fas <%= locals.locale === 'ar' ? 'fa-chevron-right' : 'fa-chevron-left' %> text-xs"></i>
                        </a>
                    <% } else { %>
                        <button disabled class="w-8 h-8 rounded-full flex items-center justify-center bg-[#F1F5F8] text-gray-300 cursor-not-allowed">
                            <i class="fas <%= locals.locale === 'ar' ? 'fa-chevron-right' : 'fa-chevron-left' %> text-xs"></i>
                        </button>
                    <% } %>

                    <!-- Page Numbers -->
                    <% 
                    const startPage = Math.max(1, pagination.currentPage - 2);
                    const endPage = Math.min(pagination.totalPages, pagination.currentPage + 2);
                    for (let i = startPage; i <= endPage; i++) { 
                    %>
                        <% if (i === pagination.currentPage) { %>
                            <button class="w-8 h-8 rounded-full bg-teal-50 text-[var(--teal)] border border-[var(--teal)] font-medium text-sm">
                                <%= i %>
                            </button>
                        <% } else { %>
                            <a href="?page=<%= i %>&pageSize=<%= pagination.pageSize %><%= querySuffix %><%= activeSuffix %>"
                                class="w-8 h-8 rounded-full flex items-center justify-center text-gray-600 hover:bg-teal-50 hover:text-[var(--teal)] hover:border hover:border-[var(--teal)] transition-all duration-300 text-sm">
                                <%= i %>
                            </a>
                        <% } %>
                    <% } %>

                    <!-- Next Page Button -->
                    <% if (pagination.hasNextPage) { %>
                        <a href="?page=<%= pagination.totalPages %>&pageSize=<%= pagination.pageSize %><%= querySuffix %><%= activeSuffix %>"
                            class="w-8 h-8 rounded-full flex items-center justify-center bg-[#F1F5F8] text-gray-500 hover:text-white hover:bg-[var(--teal)] transition-all duration-300">
                            <i class="fas <%= locals.locale === 'ar' ? 'fa-chevron-left' : 'fa-chevron-right' %> text-xs"></i>
                        </a>
                    <% } else { %>
                        <button disabled class="w-8 h-8 rounded-full flex items-center justify-center bg-[#F1F5F8] text-gray-300 cursor-not-allowed">
                            <i class="fas <%= locals.locale === 'ar' ? 'fa-chevron-left' : 'fa-chevron-right' %> text-xs"></i>
                        </button>
                    <% } %>
                </div>
            </div>
            </div>
            <% } %>
        </div>
    </div>
</div>

<style>
    /* Horizontal scrollbar styling */
    .overflow-x-auto {
        scrollbar-width: thin;
        scrollbar-color: #cbd5e0 #f1f5f8;
    }

    .overflow-x-auto::-webkit-scrollbar {
        height: 6px;
    }

    .overflow-x-auto::-webkit-scrollbar-track {
        background: #f1f5f8;
        border-radius: 10px;
    }

    .overflow-x-auto::-webkit-scrollbar-thumb {
        background: #cbd5e0;
        border-radius: 10px;
    }

    .overflow-x-auto::-webkit-scrollbar-thumb:hover {
        background: #a0aec0;
    }
</style>

<script>
    const statusTabs = document.getElementById('statusTabs');
    const searchInput = document.getElementById('searchInput');
    const backendStats = {
        active: Number(statusTabs?.dataset.activeCount || 0),
        inactive: Number(statusTabs?.dataset.inactiveCount || 0)
    };
    let currentStatusFilter = statusTabs?.dataset.currentStatus || 'all';

    function buildStatusFilterUrl(statusKey) {
        const params = new URLSearchParams(window.location.search);
        const searchValue = (searchInput?.value || '').trim();

        params.delete('page');
        params.delete('pageSize');

        if (searchValue) {
            params.set('searchQuery', searchValue);
        } else {
            params.delete('searchQuery');
        }

        if (statusKey === 'active') {
            params.set('isActive', 'true');
        } else if (statusKey === 'inactive') {
            params.set('isActive', 'false');
        } else {
            params.delete('isActive');
        }

        return `?${params.toString()}`;
    }

    function getStatusCounts() {
        const counts = {
            active: backendStats.active,
            inactive: backendStats.inactive
        };
        counts.all = counts.active + counts.inactive;
        return counts;
    }

    function renderStatusTabs() {
        if (!statusTabs) return;

        const counts = getStatusCounts();
        const tabs = [
            { key: 'all', label: '<%= __("generic_label.all") || "All" %>' },
            { key: 'active', label: '<%= __("whatsapp.campaign_report.active") || "Active" %>' },
            { key: 'inactive', label: '<%= __("whatsapp.campaign_report.inactive") || "Inactive" %>' }
        ];

        statusTabs.innerHTML = tabs.map(tab => {
            const isActive = currentStatusFilter === tab.key;
            const tabUrl = buildStatusFilterUrl(tab.key);
            if (isActive) {
                return `
                    <a href="${tabUrl}" data-status="${tab.key}" class="status-tab-btn flex items-center gap-1 px-4 py-2 text-white transition-all duration-300 bg-gray-900 rounded-full">
                        ${tab.label}
                        <span class="number bg-gray-700 text-white text-xs px-2 py-0.5 rounded-full transition-all duration-300">${counts[tab.key]}</span>
                    </a>
                `;
            }

            return `
                <a href="${tabUrl}" data-status="${tab.key}" class="status-tab-btn flex items-center gap-1 px-4 py-2 text-gray-600 transition-all duration-300 rounded-full hover:text-black">
                    ${tab.label}
                    <span class="number text-green-500 bg-green-500/15 text-xs px-2 py-0.5 rounded-full transition-all duration-300">${counts[tab.key]}</span>
                </a>
            `;
        }).join('');
    }

    function applyServerSearch() {
        const params = new URLSearchParams(window.location.search);
        const searchValue = (searchInput?.value || '').trim();

        params.set('page', '1');
        params.delete('pageSize');

        if (searchValue) {
            params.set('searchQuery', searchValue);
        } else {
            params.delete('searchQuery');
        }

        window.location.href = `?${params.toString()}`;
    }

    searchInput?.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            applyServerSearch();
        }
    });

    renderStatusTabs();
</script>