<div class="step fade-enter-active" id="step-1">
    <!-- Main Form -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="md:col-span-1">
            <label class="block text-gray-700 font-medium mb-3">
                <%= __("sms.create_campaign.campaign_name") %> <span class="text-red-500">*</span>
            </label>
            <input type="text" placeholder="Enter Campaign Name" id="name" name="name" required
                class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50" />
        </div>


        <div class="md:col-span-1">
            <label class="block text-gray-700 font-medium mb-3">
                <%= __("sms.create_campaign.description") %>
            </label>
            <input type="text" placeholder="<%= __("sms.create_campaign.description") %>"
            id="description" name="description"
            class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900
            bg-gray-50" />
        </div>

        <!-- Template Selection -->


        <div class="md:col-span-1 flex flex-col gap-4">
            <div class="flex gap-6">
                <label for="myTemplate"
                    class="flex items-center gap-2 px-4 py-2 rounded-2xl cursor-pointer transition border-2 border-transparent has-[:checked]:bg-teal-50 has-[:checked]:border-teal-400 has-[:checked]:text-teal-600">
                    <input type="radio" checked id="myTemplate" name="templateOption" value="myTemplates"
                        class="template-radio hidden">
                    <svg class="w-5 h-5 transition-colors" fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" stroke="currentColor"></circle>
                    </svg>
                    <svg class="w-3 h-3 absolute ml-1 hidden has-[:checked]:block transition-opacity" fill="currentColor" viewBox="0 0 12 12">
                        <circle cx="6" cy="6" r="6"></circle>
                    </svg>
                    <span class="ml-4">
                        <%= __("sms.create_campaign.myTemplate") %>
                    </span>
                </label>
                <label for="systemTemplate"
                    class="flex items-center gap-2 px-4 py-2 rounded-2xl cursor-pointer transition border-2 border-transparent has-[:checked]:bg-teal-50 has-[:checked]:border-teal-400 has-[:checked]:text-teal-600">
                    <input type="radio" id="systemTemplate" name="templateOption" value="systemTemplates"
                        class="template-radio hidden">
                    <svg class="w-5 h-5 transition-colors" fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" stroke="currentColor"></circle>
                    </svg>
                    <svg class="w-3 h-3 absolute ml-1 hidden has-[:checked]:block transition-opacity" fill="currentColor" viewBox="0 0 12 12">
                        <circle cx="6" cy="6" r="6"></circle>
                    </svg>
                    <span class="ml-4">
                        <%= __("sms.create_campaign.systemTemplates") %>
                    </span>
                </label>

            </div>


            <div id="templateSelection" class="space-y-6">
               
                <div class="relative">
                    <select id="templateSelect" 
                            name="templateSelect"  
                            class="groupSelect w-full px-4 py-2 border border-gray-300 rounded-lg appearance-none focus:ring-2 focus:ring-teal-400 focus:outline-none">
                        <option value="" disabled selected><%= __("sms.create_campaign.select_template") %></option>
                    </select>
                </div>
                <div class="selectedTags flex flex-wrap gap-2 mt-3"></div>

            </div>


        </div>
            <!-- Preview -->
    
    </div>
</div>
