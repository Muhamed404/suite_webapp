  // templates & systemTemplate come from controller
  window._userTemplates = <%- JSON.stringify(templates || []) %>;
  window._systemTemplates = <%- JSON.stringify(systemTemplate || []) %>;
  window.backendUrl = '<%= backendUrl %>';
  window.backendTVBSUrl = '<%= backendTVBSUrl %>';
  window.i18n = {
    labels: {
      next: "<%= __('generic_label.next') %>",
      finish: "<%= __('generic_label.Finish') %>",
