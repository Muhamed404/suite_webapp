<div class="flex flex-col p-6 pt-0">



  <!-- first section  -->

  <div class="flex flex-col gap-4 mt-3">




    <!-- Title -->
    <h1 class="my-2 text-2xl font-semibold"><%= __("emailUserReport.userReport") %>: <%= userProfile.first_name %>
    </h1>

    <!-- Top Metrics -->
    <div class="grid grid-cols-2 gap-4 md:grid-cols-5">
      <div class="flex flex-col p-4 bg-white rounded-xl">
        <div class="flex items-center justify-between gap-2 mb-8">
          <p class="text-sm text-gray-500"><%= __("emailUserReport.emailSent") %></p>
          <img src="/securemagnus_2025/images/Icons_Campaign_Report/Email_Sent.svg" alt="">
        </div>
        <p class="text-4xl">
            <%= (campaignStats.sentUnSentStats && campaignStats.sentUnSentStats[0] && campaignStats.sentUnSentStats[0].sentCount != null && campaignStats.sentUnSentStats[0].sentCount !== '') ? campaignStats.sentUnSentStats[0].sentCount : 0 %>
        </p>
      </div>
      <div class="flex flex-col p-4 bg-white rounded-xl">
        <div class="flex items-center justify-between gap-2 mb-8">
          <p class="text-sm text-gray-500"><%= __("emailUserReport.openEmail") %></p>
          <img src="/securemagnus_2025/images/Icons_Campaign_Report/Opened_by_people.svg" alt="">
        </div>
        <p class="text-4xl">
          <%=campaignStats.campaignInteractionStats?.is_phish_msg_opened || 0%>
        </p>
      </div>
      <div class="flex flex-col p-4 bg-white rounded-xl">
        <div class="flex items-center justify-between gap-2 mb-8">
          <p class="text-sm text-gray-500"><%= __("emailUserReport.formInteractionSubmission") %></p>
          <img src="/securemagnus_2025/images/Icons_Campaign_Report/not_opened.svg" alt="">
        </div>
        <p class="text-4xl">
          <%=campaignStats.campaignInteractionStats?.is_phish_msg_data_entered_submited_in_form || 0%> / <%=campaignStats.campaignInteractionStats?.is_phish_msg_data_entered_in_form || 0%>

        </p>
      </div>
      <div class="flex flex-col p-4 bg-white rounded-xl">
        <div class="flex items-center justify-between gap-2 mb-8">
          <p class="text-sm text-gray-500"><%= __("emailUserReport.linksClicked") %></p>
          <img src="/securemagnus_2025/images/Icons_Campaign_Report/link_Clicked.svg" alt="">
        </div>
        <p class="text-4xl">
          <%=campaignStats.campaignInteractionStats?.is_phish_msg_link_opened || 0%>
        </p>
      </div>
      <div class="flex flex-col p-4 bg-white rounded-xl">
        <div class="flex items-center justify-between gap-2 mb-8">
          <p class="text-sm text-gray-500"><%= __("emailUserReport.reportedToAdmin") %></p>
          <img src="/securemagnus_2025/images/Icons_Campaign_Report/Report_Admin.svg" alt="">
        </div>
        <p class="text-4xl">
          <%=campaignStats.campaignInteractionStats?.is_phish_msg_reported_to_admin || 0%>
        </p>
      </div>
    </div>

    <!-- Main Section -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
      <!-- Bar Chart -->
      <div class="col-span-2 p-6 bg-white rounded-xl">
        <h2 class="mb-4 text-lg font-semibold"><%= __("emailUserReport.campaignMetrics") %></h2>
        <div id="chart"></div>
      </div>

      <!-- Phishing Success -->
      <div class="flex flex-col items-start justify-start p-6 bg-white rounded-xl gap-11">
        <h2 class="mb-4 text-lg font-semibold"><%= __("emailUserReport.phishingSuccess") %></h2>

        <div class="flex items-center justify-between w-full gap-10">
          <!-- Left Side Labels -->
          <div class="space-y-6">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#38bdf8]"></span>
              <div>
                <p class="text-sm text-gray-500"><%= __("emailUserReport.emailView") %></p>
                <p class="text-lg font-bold text-gray-900" id="emailViewedText">
                    
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#f87171]"></span>
              <div>
                <p class="text-sm text-gray-500"><%= __("emailUserReport.emailOpened") %></p>
                <p class="text-lg font-bold text-gray-900" id="linksClickedText">
                   
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#34d399]"></span>
              <div>
                <p class="text-sm text-gray-500"><%= __("emailUserReport.totalActivity") %></p>
                <p class="text-lg font-bold text-gray-900" id="targetCompromisedText">
                  
                </p>
              </div>
            </div>
          </div>

          <!-- Donut Chart -->
          <div id="successChart" style="width:50%; height:50%;"></div>
        </div>
      </div>
    </div>

    <!-- Second Row -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <!-- Employees Phishing Segments -->
      <div class="p-6 bg-white rounded-xl ">
        <h2 class="mb-4 text-lg font-semibold">
          <%= userProfile.first_name %> <%= __("emailUserReport.phishingSegments") %>
        </h2>
        <div id="userPhishingSegmentsChart"></div>
      </div>

      <!-- Reported To Admin -->
      <div class="p-6 bg-white rounded-xl ">
        <h2 class="mb-4 text-lg font-semibold"><%= __("emailUserReport.employeeResponse") %></h2>
        <div id="reportChart"></div>
      </div>

      <!-- Employee Details -->
      <div class="p-6 bg-white rounded-xl ">
        <h2 class="mb-6 text-lg font-semibold text-gray-800"><%= __("emailUserReport.employeeDetails") %></h2>
        <div class="space-y-4">
          <div class="flex justify-between text-sm">
            <span class="text-gray-500"><%= __("emailUserReport.receiverAddress") %></span>
            <span class="font-medium text-gray-800">
              <%= userProfile.email %>
            </span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-500"><%= __("emailUserReport.department") %></span>
            <span class="font-medium text-gray-800">IT</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-500"><%= __("emailUserReport.employeeId") %></span>
            <span class="font-medium text-gray-800">3333</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-500"><%= __("emailUserReport.campaignDate") %></span>
            <span class="font-medium text-gray-800">2025-08-12</span>
          </div>
        </div>
      </div>
    </div>

    <!-- last table  -->

    <div class="flex flex-col gap-4 mt-3 bg-white rounded-3xl">
      <div class="flex items-center justify-between gap-3 px-5 pt-5">

        <div class="relative">
          <h2 class="mb-4 text-2xl"><%= __("emailUserReport.interactionReport") %></h2>

        </div>


        <div class="flex gap-4">




          <button class="hidden lg:block ms-auto">
            <div class="relative">
              <input type="text" placeholder="<%= __("emailUserReport.searchHere") %>"
                class="pl-14 pr-10 py-3 h-12 rounded-full bg-white text-sm border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[var(--teal)]">
              <img src="/securemagnus_2025/images/img/search.svg"
                class="w-5 h-5 text-gray-400 absolute left-4 top-3.5" alt="">
            </div>

          </button>
          <button class="hidden lg:block ms-auto">
            <a href=""
              class=" flex items-center justify-center gap-3 px-6 py-2.5 rounded-full bg-transparent text-gray-900 border border-[var(--strokeGray)] transition-all duration-300 hover:bg-transparent hover:border-[var(--teal)] hover:text-[var(--teal)]">

              <%= __("emailUserReport.sortBy") %>
              <img src="/securemagnus_2025/images/img/arrow.svg" alt="">
            </a>

          </button>
        </div>


        <a href="" class="block lg:hidden">
          <img src="/securemagnus_2025/images/img/sortby.svg" class="size-9" alt="">
        </a>
      </div>
      <div class="overflow-x-auto hide-scrollbar">
        <table class="min-w-full text-sm text-left">
          <thead class="bg-[#FAFBFC]">
            <tr>
              <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap"><%= __("emailUserReport.campaignName") %></th>
              <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap"><%= __("emailUserReport.date") %></th>
              <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap"><%= __("emailUserReport.riskScore") %></th>
              <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <img src="/securemagnus_2025/images/email-opned.svg" class="w-5 h-5" alt="">
                  <%= __("emailUserReport.openEmail") %>
                </div>
              </th>
              <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <img src="/securemagnus_2025/images/Links-Interaction.svg" class="w-5 h-5" alt="">
                  <%= __("emailUserReport.clickedLinked") %>
                </div>
              </th>
              <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <img src="/securemagnus_2025/images/eye.svg" class="w-5 h-5" alt="">
                  <%= __("emailUserReport.interactForm") %>
                </div>
              </th>
              <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <img src="/securemagnus_2025/images/form-submit.svg" class="w-5 h-5" alt="">
                  <%= __("emailUserReport.formSubmit") %>
                </div>
              </th>
              <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <img src="/securemagnus_2025/images/attachmentopened.svg" class="w-5 h-5" alt="">
                  <%= __("emailUserReport.attachmentOpened") %>
                </div>
              </th>
              
              </th>
              <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <img src="/securemagnus_2025/images/email-letter-mail-document.svg" class="w-5 h-5" alt="">
                  <%= __("emailUserReport.reportedToAdmin") %>
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
    
        <tr class="transition-colors border-t hover:bg-blue-50">
              <td class="px-6 py-6 whitespace-nowrap">
                <%=campaignDetails.name%>
              </td>
              <td class="px-6 py-6 whitespace-nowrap">
                <%=campaignDetails.start_datetime%>
              </td>
              <td class="px-2 py-6 whitespace-nowrap">
                <%
                  var _opened   = campaignStats.campaignInteractionStats.is_phish_msg_opened;
                  var _clicked  = campaignStats.campaignInteractionStats.is_phish_msg_link_opened;
                  var _entered  = campaignStats.campaignInteractionStats.is_phish_msg_data_entered_in_form;
                  var _reported = campaignStats.campaignInteractionStats.is_phish_msg_reported_to_admin;

                  var riskLabel, riskColor;
                  if (_opened && _clicked && _entered) {
                    riskLabel = 'Very High Risk';
                    riskColor = 'text-red-600 border-red-600 bg-red-50';
                  } else if (_opened && _clicked) {
                    riskLabel = 'High Risk';
                    riskColor = 'text-orange-500 border-orange-500 bg-orange-50';
                  } else if (_opened && _reported) {
                    riskLabel = 'Low Risk';
                    riskColor = 'text-yellow-600 border-yellow-500 bg-yellow-50';
                  } else if (_opened) {
                    riskLabel = 'Medium Risk';
                    riskColor = 'text-blue-500 border-blue-500 bg-blue-50';
                  } else {
                    riskLabel = 'No Action';
                    riskColor = 'text-green-500 border-green-500 bg-green-50';
                  }
                %>
                <span class="inline-flex items-center px-3 py-1 text-sm border rounded-full <%=riskColor%>">
                  <%=riskLabel%>
                </span>
              </td>
              <td class="px-6 py-6 whitespace-nowrap">
                <%=campaignStats.campaignInteractionStats.is_phish_msg_opened%>
              </td>
              <td class="px-6 py-6 whitespace-nowrap">
                <%=campaignStats.campaignInteractionStats.is_phish_msg_link_opened%>
              </td>
              <td class="px-6 py-6 whitespace-nowrap">
                <%=campaignStats.campaignInteractionStats.is_phish_msg_data_entered_in_form%>
              </td>
              <td class="px-6 py-6 whitespace-nowrap">
                <%=campaignStats.campaignInteractionStats.is_phish_msg_data_entered_submited_in_form%>
              </td>
              <td class="px-6 py-6 whitespace-nowrap">
                <%=campaignStats.campaignInteractionStats.is_phish_msg_file_downloaded%>
              </td>
              <td class="px-6 py-6 whitespace-nowrap">
                <%=campaignStats.campaignInteractionStats.is_phish_msg_reported_to_admin%>
              </td>
              
          </tr>


          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>



<script>

  // Pass user interaction timeline data to JavaScript
  window.userInteractionTimeline = <%- JSON.stringify(userInteractionTimeline || []) %>;

  // Pass other campaign stats if needed
  window.campaignStats = <%- JSON.stringify(campaignStats || {}) %>;

</script>
<script src="/securemagnus_2025/js/user-report.js"></script>
