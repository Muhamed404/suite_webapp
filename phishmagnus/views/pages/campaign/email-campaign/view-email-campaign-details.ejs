<div class="flex flex-col  p-6 pt-0">
    <!-- first section  -->
    <div class="flex flex-col gap-4 mt-3">
        <!-- Title -->
        <h1 class="text-2xl font-semibold my-2"><%= __("campaign.email_campaign_detail.labelTitle") %></h1>

        <!-- Top Metrics -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"><%= __("campaign.email_campaign_detail.labelSent") %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Email_Sent.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.sentUnSentStats?.sentCount || 0%>
                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"><%= __("campaign.email_campaign_detail.labelOpenNoOpen") %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Opened_by_people.svg" alt=""
                        style="color: black;">
                </div>
                <p class="text-4xl">

                    <%=campaignStats.campaignInteractionStats?.is_phish_msg_opened || 0%>
                        /
                        <%=campaignStats.campaignInteractionStats?.notOpenCount || 0%>
                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"><%= __("campaign.email_campaign_detail.labelClickNotClick") %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/link_Clicked.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.campaignInteractionStats?.is_phish_msg_link_opened || 0%>
                        /
                        <%=campaignStats.emailClickSegmentStats?.noClickCount || 0%>
                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"><%= __("campaign.email_campaign_detail.labelInteractionSubmission") %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/link_Clicked.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.campaignInteractionStats?.is_phish_msg_data_entered_in_form || 0%> / 
                    <%=campaignStats.campaignInteractionStats?.is_phish_msg_data_entered_submited_in_form || 0%>
                </p>
            </div>
 

            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"><%= __("campaign.email_campaign_detail.labelReportToAdmin") %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Report_Admin.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.campaignInteractionStats?.is_phish_msg_reported_to_admin || 0%>
                </p>
            </div>
        </div>

        <!-- Main Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <!-- Bar Chart -->
            <div class="bg-white p-6 rounded-xl   col-span-2">
                <h2 class="text-lg font-semibold mb-4"><%= __("campaign.email_campaign_detail.labelCampaignMatrices") %></h2>
                <div id="barChart"></div>
            </div>

            <!-- Phishing Success -->
            <div class="bg-white p-6 rounded-xl gap-11  flex flex-col items-start  justify-start">
                <h2 class="text-lg font-semibold mb-4"><%= __("campaign.email_campaign_detail.labelPhishingSuccess") %></h2>

                <div class="flex items-center  gap-10 w-full justify-between">
                    <!-- Left Side Labels -->
                    <div class="space-y-6">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#fbbf24]"></span>
                            <div>
                                <p class="text-gray-500 text-sm"><%= __("campaign.email_campaign_detail.labelEmailViews") %></p>
                                <p class="text-lg font-bold text-gray-900" id="emailViewedText">
                                    <%=campaignStats.campaignInteractionStats?.is_phish_msg_opened || 0%> <%= __("campaign.email_campaign_detail.labelPeople") %>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#f87171]"></span>
                            <div>
                                <p class="text-gray-500 text-sm"><%= __("campaign.email_campaign_detail.labelLinksClicked") %></p>
                                <p class="text-lg font-bold text-gray-900" id="linksClickedText">
                                    <%=campaignStats.campaignInteractionStats?.is_phish_msg_link_opened || 0%> <%= __("campaign.email_campaign_detail.labelPeople") %>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#38bdf8]"></span>
                            <div>
                                <p class="text-gray-500 text-sm"><%= __("campaign.email_campaign_detail.labelReportToAdmin") %></p>
                                <p class="text-lg font-bold text-gray-900" id="linksClickedText">
                                    <%=campaignStats.campaignInteractionStats?.is_phish_msg_reported_to_admin || 0%>
                                        <%= __("campaign.email_campaign_detail.labelPeople") %>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#34d399]"></span>
                            <div>
                                <p class="text-gray-500 text-sm"><b><%= __("campaign.email_campaign_detail.labelTargetCompromised") %></b></p>
                                <p class="text-lg font-bold text-gray-900" id="targetCompromisedText">
                                    <%= campaignStats.campaignInteractionStats?.is_phish_msg_opened || 0 +
                                        campaignStats.campaignInteractionStats?.is_phish_msg_link_opened || 0 +
                                        campaignStats.campaignInteractionStats?.is_phish_msg_reported_to_admin || 0 +
                                        campaignStats.campaignInteractionStats?.is_phish_msg_file_downloaded || 0 +
                                        campaignStats.campaignInteractionStats?.is_phish_msg_data_entered_submited_in_form
                                        || 0 + campaignStats.campaignInteractionStats?.is_phish_msg_data_entered_in_form
                                        || 0%> <%= __("campaign.email_campaign_detail.labelTimes") %>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Donut Chart -->
                    <div id="successChart" style="width:50%; height:50%;"></div>
                </div>
            </div>
        </div>

        <!-- Second Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Employees Phishing Segments -->
            <div class="bg-white p-6 rounded-xl  ">
                <h2 class="text-lg font-semibold mb-4"><%= __("campaign.email_campaign_detail.labelEmployeesPhishingSegments") %></h2>
                <div id="segmentsChart"></div>
            </div>

            <!-- Reported To Admin -->
            <div class="bg-white p-6 rounded-xl  ">
                <h2 class="text-lg font-semibold mb-4"><%= __("campaign.email_campaign_detail.labelAdminReportSegments") %></h2>
                <div id="reportChart"></div>
            </div>

            <!-- Campaign Details -->
            <div class="bg-white p-6 rounded-xl  ">
                <h2 class="text-lg font-semibold text-gray-800 mb-6"><%= __("campaign.email_campaign_detail.labelCampaignDetails") %></h2>
                <div class="space-y-4">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500"><%= __("campaign.email_campaign_detail.labelSenderAddress") %></span>
                        <span class="text-gray-800 font-medium">
                            <%=campaignDetails?.Templates?.sender_email_or_contact || 'N/A' %>
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500"><%= __("campaign.email_campaign_detail.labelURL") %></span>
                        <span class="text-gray-800 font-medium">
                            <%=campaignDetails?.Templates?.company_domain || 'N/A' %>
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500"><%= __("campaign.email_campaign_detail.labelTemplateName") %></span>
                        <span class="text-gray-800 font-medium">
                            <%=campaignDetails?.Templates?.name || 'N/A' %>
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500"><%= __("campaign.email_campaign_detail.labelPhishingPage") %></span>
                        <span class="text-gray-800 font-medium">
                            <%=campaignDetails?.Templates?.company_domain || 'N/A' %>/<%=campaignDetails?.Templates?.id
                                    || '' %>
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500"><%= __("campaign.email_campaign_detail.labelLaunchDate") %></span>
                        <span class="text-gray-800 font-medium">
                            <%=campaignDetails?.start_datetime || 'N/A' %>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Charts -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

            <!-- Links Interaction -->



            <div class="bg-white p-6 rounded-xl   text-center">

                <div class="flex items-center justify-start mb-9 gap-2">
                    <img src="/securemagnus_2025/images/Links-Interaction.svg" alt="">
                    <label for="Links Interaction"><%= __("campaign.email_campaign_detail.labelLinksInteraction") %></label>
                </div>

                <div>
                    <div class="semichartLinksInteraction"
                        uniqueClick="<%=campaignStats.emailClickSegmentStats?.uniqueClickCount%>"
                        repeatedClicks="<%=campaignStats.emailClickSegmentStats?.repeatedClickCount%>"
                        noClicks="<%=campaignStats.emailClickSegmentStats?.noClickCount%>">
                    </div>
                </div>

            </div>


            <!-- Form Interact -->
            <div class="bg-white p-6 rounded-xl   text-center">

                <div class="flex items-center justify-start mb-9 gap-2">
                    <img src="/securemagnus_2025/images/interactfrom.svg" alt="">
                    <label for="Interact Form "><%= __("campaign.email_campaign_detail.labelFormInteraction") %></label>
                </div>

                <div>
                    <div class="semichartInteractForm"
                        uniqueClick="<%=campaignStats.emailFormSegmentStats?.formInteractionUniqueCount%>"
                        repeatedClicks="<%=campaignStats.emailFormSegmentStats?.formInteractionRepeatedCount%>"
                        noClicks="<%=campaignStats.emailFormSegmentStats?.noFormInteractionCount%>">

                    </div>
                </div>
            </div>

            <!-- Form Submitted -->
            <div class="bg-white p-6 rounded-xl   text-center">

                <div class="flex items-center justify-start mb-9 gap-2">
                    <img src="/securemagnus_2025/images/formsubmitted.svg" alt="">
                    <label for="Form Submitted"><%= __("campaign.email_campaign_detail.labelFormSubmitted") %></label>
                </div>

                <div>
                    <div class="semichartFormSubmitted"
                        uniqueClick="<%=campaignStats.emailFormSegmentStats?.formSubmittedUniqueCount%>"
                        repeatedClicks="<%=campaignStats.emailFormSegmentStats?.formSubmittedRepeatedCount%>"
                        noClicks="<%=campaignStats.emailFormSegmentStats?.noFormSubmitCount%>">
                    </div>
                </div>
            </div>

            <!-- Attachment Opened -->
            <div class="bg-white p-6 rounded-xl   text-center">

                <div class="flex items-center justify-start mb-9 gap-2">
                    <img src="/securemagnus_2025/images/attachmentopened.svg" alt="">
                    <label for="Attachment Opened"><%= __("campaign.email_campaign_detail.labelAttachmentOpened") %></label>
                </div>

                <div>
                    <div class="semichartAttachmentOpened"
                        uniqueClick="<%=campaignStats.emailAttachmentSegmentStats?.uniqueClickCount%>"
                        repeatedClicks="<%=campaignStats.emailAttachmentSegmentStats?.repeatedClickCount%>"
                        noClicks="<%=campaignStats.emailAttachmentSegmentStats?.noClickCount%>">
                    </div>
                </div>
            </div>

        </div>


        <!-- last table  -->

        <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white">
            <div class="flex items-center justify-between gap-3 px-5 pt-5">

                <div class="relative">
                    <h2 class="text-2xl mb-4"><%= __("campaign.email_campaign_detail.labelInteractionReportByUser") %></h2>

                </div>


                <div class="flex gap-4">




                    <button class="hidden lg:block ms-auto">
                        <div class="relative">
                            <input type="text" placeholder="<%= __("generic_label.search_here") || 'Search here...' %>"
                                class="pl-14 pr-10 py-3 h-12 rounded-full bg-white text-sm border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[var(--teal)]">
                            <img src="/securemagnus_2025/images/img/search.svg"
                                class="w-5 h-5 text-gray-400 absolute left-4 top-3.5" alt="">
                        </div>

                    </button>
                    <button class="hidden lg:block ms-auto">
                        <a href=""
                            class=" flex items-center justify-center gap-3 px-6 py-2.5 rounded-full bg-transparent text-gray-900 border border-[var(--strokeGray)] transition-all duration-300 hover:bg-transparent hover:border-[var(--teal)] hover:text-[var(--teal)]">

                            <%= __("generic_label.sort_by") %>
                            <img src="/securemagnus_2025/images/img/arrow.svg" alt="">
                        </a>

                    </button>
                </div>


                <a href="" class="block lg:hidden">
                    <img src="/securemagnus_2025/images/img/sortby.svg" class="size-9" alt="">
                </a>
            </div>
            <div class="overflow-x-auto hide-scrollbar">
                <table class="min-w-full text-sm text-left">
                    <thead class="bg-[#FAFBFC]">
                        <tr>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap"><%= __("campaign.email_campaign_detail.labelFirstName") %></th>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap"><%= __("campaign.email_campaign_detail.labelLastName") %></th>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap"><%= __("campaign.email_campaign_detail.labelEmail") %></th>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap">
                                <div class="flex items-center gap-2">
                                    <img src="/securemagnus_2025/images/email-opned.svg" class="w-5 h-5" alt="">
                                    <%= __("campaign.email_campaign_detail.labelEmailOpen") %>
                                </div>
                            </th>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap">
                                <div class="flex items-center gap-2">
                                    <img src="/securemagnus_2025/images/Links-Interaction.svg" class="w-5 h-5" alt="">
                                    <%= __("campaign.email_campaign_detail.labelClickedLink") %>
                                </div>
                            </th>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap">
                                <div class="flex items-center gap-2">
                                    <img src="/securemagnus_2025/images/eye.svg" class="w-5 h-5" alt="">
                                    <%= __("campaign.email_campaign_detail.labelInteractForm") %>
                                </div>
                            </th>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap">
                                <div class="flex items-center gap-2">
                                    <img src="/securemagnus_2025/images/form-submit.svg" class="w-5 h-5" alt="">
                                    <%= __("campaign.email_campaign_detail.labelFormSubmit") %>
                                </div>
                            </th>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap">
                                <div class="flex items-center gap-2">
                                    <img src="/securemagnus_2025/images/attachmentopened.svg" class="w-5 h-5" alt="">
                                    <%= __("campaign.email_campaign_detail.labelAttachmentOpened") %>
                                </div>
                            </th>
                            <th class="px-6 py-6 text-gray-700 font-semibold whitespace-nowrap"><%= __("campaign.email_campaign_detail.labelAction") %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(usersDetail && usersDetail.Phishing_Invities){ %>
    <% usersDetail.Phishing_Invities.forEach((invitee,index)=> { %>

                            <tr class="border-t hover:bg-blue-50 transition-colors">
                                <td class="px-6 py-6 whitespace-nowrap editable">
                                    <%=invitee.User.UserProfile.first_name %>
                                </td>
                                <td class="px-6 py-6 whitespace-nowrap editable">
                                    <%=invitee.User.UserProfile.last_name %>
                                </td>
                                <td class="px-6 py-6 whitespace-nowrap editable">
                                    <%=invitee.User.UserProfile.email %>
                                </td>


                                <td class="px-6 py-6 whitespace-nowrap editable text-red-500">
                                    <%=invitee?.Report?.is_phish_msg_opened ? 'Yes' : 'No' %>
                                </td>
                                <td class="px-6 py-6 whitespace-nowrap editable">
                                    <%=invitee?.Report?.is_phish_msg_link_opened ? 'Yes' : 'No' %>
                                </td>
                                <td class="px-6 py-6 whitespace-nowrap editable">
                                    <%=invitee?.Report?.is_phish_msg_data_entered_in_form ? 'Yes' : 'No' %>
                                </td>
                                <td class="px-6 py-6 whitespace-nowrap editable">
                                    <%=invitee?.Report?.is_phish_msg_data_entered_submited_in_form ? 'Yes' : 'No' %>
                                </td>

                                <td class="px-6 py-6 whitespace-nowrap editable">
                                    <%=invitee?.Report?.is_phish_msg_file_downloaded ? 'Yes' : 'No' %>
                                </td>

                                <td class="px-6 py-4 text-start flex items-center gap-2">
                                    <div class="flex gap-2">
                                        <a class="p-2 rounded-full hover:bg-blue-50" title="View Details"
                                            href="/phm/campaign/email/user/report/<%=invitee.id%>/<%=campaignDetails.id%>">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                class="w-5 h-5 text-blue-600 hover:text-blue-800" fill="none"
                                                viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                                </path>
                                            </svg>
                                        </a>

                                    </div>


                                </td>
                            </tr>
                            <% })}%>

                    </tbody>
                </table>
            </div>





        </div>
    </div>
</div>
<script>
    window.translations = <%- JSON.stringify(translations) %>;
    window.phishingSuccessRate = {
        view: <%= typeof campaignStats !== 'undefined' && campaignStats.campaignInteractionStats?.is_phish_msg_opened || 0 %>,
        linkClicks: <%= typeof campaignStats !== 'undefined' && campaignStats.campaignInteractionStats?.is_phish_msg_link_opened || 0 %>,
        targetCompromised: <%= typeof campaignStats !== 'undefined' &&
            campaignStats.campaignInteractionStats?.is_phish_msg_opened || 0 +
            campaignStats.campaignInteractionStats?.is_phish_msg_link_opened || 0 +
            campaignStats.campaignInteractionStats?.is_phish_msg_reported_to_admin || 0 +
            campaignStats.campaignInteractionStats?.is_phish_msg_file_downloaded || 0 +
            campaignStats.campaignInteractionStats?.is_phish_msg_data_entered_submited_in_form || 0 +
            campaignStats.campaignInteractionStats?.is_phish_msg_data_entered_in_form || 0 %>,
        reportedToAdmin: <%= typeof campaignStats !== 'undefined' && campaignStats.campaignInteractionStats?.is_phish_msg_reported_to_admin || 0 %>

    };


    window.CampaignMetrics = {
        sent: <%= typeof campaignStats !== 'undefined' && campaignStats.sentUnSentStats?.sentCount || 0 %>,
        open: <%= typeof campaignStats !== 'undefined' && campaignStats.campaignInteractionStats?.is_phish_msg_opened || 0 %>,
        clickLinkOpen: <%= typeof campaignStats !== 'undefined' && campaignStats.campaignInteractionStats?.is_phish_msg_link_opened || 0 %>,
        interactForm: <%= typeof campaignStats !== 'undefined' && campaignStats.campaignInteractionStats?.is_phish_msg_data_entered_in_form || 0 %>,
        formSubmit: <%= typeof campaignStats !== 'undefined' && campaignStats.campaignInteractionStats?.is_phish_msg_data_entered_submited_in_form || 0 %>,
        attachmentDownload: <%= typeof campaignStats !== 'undefined' && campaignStats.campaignInteractionStats?.is_phish_msg_file_downloaded || 0 %>,
    };


    window.EmployeePhishingSegments = {
        sent: <%= typeof campaignStats !== 'undefined' && campaignStats.sentUnSentStats?.sentCount || 0 %>,
        notOpen:<%= typeof campaignStats !== 'undefined' && campaignStats.campaignInteractionStats?.notOpenCount || 0 %>,
        interactForm: <%= typeof campaignStats !== 'undefined' && campaignStats.campaignInteractionStats?.is_phish_msg_data_entered_in_form || 0 %>,
        formSubmit: <%= typeof campaignStats !== 'undefined' && campaignStats.campaignInteractionStats?.is_phish_msg_data_entered_submited_in_form || 0 %>,
        attachmentDownload: <%= typeof campaignStats !== 'undefined' && campaignStats.campaignInteractionStats?.is_phish_msg_file_downloaded || 0 %>,
    };


    window.ReportToAdminSegments = {
        opened_not_reported: <%= typeof campaignStats !== 'undefined' && campaignStats.emailOpenAndReportStats?.opened_not_reported || 0 %>,
        opened_and_reported: <%= typeof campaignStats !== 'undefined' && campaignStats.emailOpenAndReportStats?.opened_and_reported || 0 %>,
        not_opened_but_reported: <%= typeof campaignStats !== 'undefined' && campaignStats.emailOpenAndReportStats?.not_opened_but_reported || 0 %>,
    };

</script>
<script src="/securemagnus_2025/js/email_phishing_campaign_report.js"></script>