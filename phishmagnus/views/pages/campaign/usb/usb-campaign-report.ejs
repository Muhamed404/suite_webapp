<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-teal-700 mb-6"><%= __("usb_campaign.report.title") %></h1>
  <div class="overflow-x-auto bg-white rounded-xl shadow">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider"><%= __("usb_campaign.report.header.campaign_name") %></th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider"><%= __("usb_campaign.report.header.total_usb") %></th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider"><%= __("usb_campaign.report.header.start_date") %></th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider"><%= __("usb_campaign.report.header.actions") %></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-100">
        <% if (campaigns && campaigns.length) { %>
          <% campaigns.forEach(campaign => { %>
            <tr class="hover:bg-gray-50 transition">
              <td class="px-6 py-4 whitespace-nowrap text-gray-800 font-medium"><%= campaign.campaign_name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-gray-800"><%= campaign.total_usb_created %></td>
              <td class="px-6 py-4 whitespace-nowrap text-gray-800"><%= campaign.start_date %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <a href="/phm/campaign/usb/report-view/<%= campaign.campaign_identifier %>" 
                   class="inline-flex items-center px-4 py-2 bg-teal-600 text-white rounded shadow hover:bg-teal-700 transition text-sm font-semibold">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" class="px-6 py-8 text-center text-gray-500"><%= __("generic_label.no_data") %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <!-- Pagination -->
  <div class="flex justify-center mt-8">
    <% for (let i = 1; i <= totalPages; i++) { %>
      <form method="get" action="/phm/campaign/usb/report" class="inline">
        <input type="hidden" name="page" value="<%= i %>">
        <button type="submit" class="mx-1 px-4 py-2 rounded 
          <%= page === i ? 'bg-teal-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300' %>">
          <%= i %>
        </button>
      </form>
    <% } %>
  </div>
</div>