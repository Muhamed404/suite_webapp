<div class="flex flex-col p-6 gap">
  <div class="flex flex-col gap-2 mb-4 border-b border-gray-100 pb-4">
    <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0" aria-label="Breadcrumb">
      <a href="/home" class="hover:text-gray-700 transition">
        <%= __("breadcrumbs.home") %>
      </a>
      <span class="text-gray-400">›</span>
      <a href="/phm/campaign/all-campaigns" class="hover:text-gray-700 transition">
        <%= __("breadcrumbs.campaigns") %>
      </a>
      <span class="text-gray-400">›</span>
      <span class="font-semibold text-gray-900">
        <%= __("breadcrumbs.createUSBCampaign") %>
      </span>
    </nav>
    <h3 class="text-3xl font-medium text-gray-900">
      <%= __("breadcrumbs.createUSBCampaign") %>
    </h3>
  </div>

  <!-- first section  -->

  <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white">

    <form id="usbCampaignForm" name="usbCampaignForm" class="bg-white  w-full mt-3 p-8"
      action="/phm/campaign/usb/create" method="post">
      <!-- Stepper Navigation -->
      <div id="stepper" class="flex items-center justify-between mb-10">
        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-teal-500 text-white font-bold text-xs">
            1
          </div>
          <span class="font-medium step-label text-teal-700 text-sm">
            <%= __('usb_campaign.stepper.step1') %>
          </span>
        </div>

        <div class="flex-1 h-0.5 bg-teal-100 mx-2"></div>

        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-white border-2 border-teal-300 text-teal-400 font-bold text-xs">
            2
          </div>
          <span class="font-medium step-label text-gray-400 text-sm">
            <%= __('usb_campaign.stepper.step2') %>
          </span>
        </div>

        <div class="flex-1 h-0.5 bg-teal-100 mx-2"></div>

        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-white border-2 border-teal-300 text-teal-400 font-bold text-xs">
            3
          </div>
          <span class="font-medium step-label text-gray-400 text-sm">
            <%= __('usb_campaign.stepper.step3') %>
          </span>
        </div>
      </div>

      <div id="steps">

        <!-- Step 1 -->
        <div class="step fade-enter-active" id="step-1">
          <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10">
            <%= __('usb_campaign.steps.campaignTitle') %>
          </h1>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-1">
              <label class="block text-gray-700 font-medium mb-3">
                <%= __('usb_campaign.camp.nameLabel') %><span class="text-red-500">*</span>
              </label>
              <input type="text" id="name" name="name"
                class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50" />
            </div>

            <div class="md:col-span-1">
              <label class="block text-gray-700 font-medium mb-3">
                <%= __('usb_campaign.camp.descriptionLabel') %><span class="text-red-500">*</span>
              </label>
              <input type="text" id="description" name="description"
                class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50" />
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="step hidden" id="step-2">
          <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10">
            <%= __('usb_campaign.steps.step2Title') %>
          </h1>

          <div data-step class="step">
            <div data-time="1" class="time-block">
              <div class="pb-6">
                <label class="block text-gray-700 font-semibold mb-2">
                  <%= __('usb_campaign.schedule.startTime') %><span class="text-red-500">*</span>
                </label>
                <div class="flex items-center gap-2">
                    <input type="datetime-local" id="startTime" name="startTime"
                        class="start-time w-full border border-gray-300 rounded-xl px-4 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
                    <button type="button"
                        class="open-start p-2 border border-gray-300 rounded-xl hover:bg-gray-100 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-600" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                            </path>
                        </svg>
                    </button>
                </div>
              </div>

              <div>
                <label class="block text-gray-700 font-semibold mb-2">
                  <%= __('usb_campaign.schedule.endTime') %><span class="text-red-500">*</span>
                </label>
                <div class="flex items-center gap-2">
                  <input type="datetime-local" id="endTime" name="endTime"
                    class="end-time w-full border border-gray-300 rounded-xl px-4 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
                  <button type="button"
                    class="open-end p-2 border border-gray-300 rounded-xl hover:bg-gray-100 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-600" fill="none"
                      viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                      </path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="step hidden" id="step-3">
          <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10">
            <%= __('usb_campaign.steps.step3Title') %>
          </h1>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div class="flex flex-col gap-6">
              <div>
                <label class="block text-gray-700 font-medium mb-3">
                  <%= __('usb_campaign.usb.totalUSB') %><span class="text-red-500">*</span>
                </label>
                <input id="noOfUSB" name="noOfUSB" type="text"
                  oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value.startsWith('-')) this.value = this.value.substr(1);"
                  min="1"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
              </div>

              <div>
                <label class="block text-gray-700 font-medium mb-3">
                  <%= __('usb_campaign.usb.envVariables') %><span class="text-red-500">*</span>
                </label>
                <input type="text" id="envVariable" name="envVariable"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
              </div>
            </div>

            <div class="flex flex-col gap-6">
              <div>
                <label class="block text-gray-700 font-medium mb-3">
                  <%= __('usb_campaign.usb.fileName') %><span class="text-red-500">*</span>
                </label>
                <input type="text" id="filename" name="filename"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
              </div>
            </div>

          </div>
        </div>
      </div>



    </form>

    <!-- Buttons -->
    <div class="flex justify-end gap-4 mt-10 p-8">
      <button id="backBtn" type="button"
        class="px-8 py-2 rounded-lg bg-gray-100 text-gray-600 font-medium border hover:border-gray-300 transition">Back</button>
      <button id="nextBtn" type="submit"
        class="px-8 py-2 rounded-lg bg-[var(--teal)] text-white font-semibold hover:bg-teal-500 transition">Next</button>
    </div>


  </div>

</div>


<script src="/securemagnus_2025/js/form_stepper.js"></script>
<script src="/securemagnus_2025/js/time-validation.js"></script>

<script src="/securemagnus_2025/js/custom_script/create-usb-campaign-validation.js"></script>