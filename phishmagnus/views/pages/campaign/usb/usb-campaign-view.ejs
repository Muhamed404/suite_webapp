<div class="flex flex-col p-6 pt-0">
    <!-- Breadcrumb -->
    <div class="flex flex-col gap-2 mb-4 border-b border-gray-100 pb-4 mt-3">
        <nav class="flex items-center text-sm text-gray-500 gap-2" aria-label="Breadcrumb">
            <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
            <span class="text-gray-400">&rsaquo;</span>
            <a href="/phm/campaign/reports" class="hover:text-gray-700 transition"><%= __("breadcrumbs.reports") %></a>
            <span class="text-gray-400">&rsaquo;</span>
            <a href="/phm/campaign/usb/report" class="hover:text-gray-700 transition"><%= __("breadcrumbs.usbCampaignReport") %></a>
            <span class="text-gray-400">&rsaquo;</span>
            <span class="font-semibold text-gray-900"><%= campaigns.campaign_name || __('usb_campaign.report.view_report_title') %></span>
        </nav>
        <h1 class="text-3xl font-medium text-gray-900"><%= campaigns.campaign_name || __('usb_campaign.report.view_report_title') %></h1>
    </div>

    <!-- first section  -->
    <div class="flex flex-col gap-4">

        <!-- Top Metrics -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"><%= __('usb_campaign.report.total_usb_initiated') %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Email_Sent.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=totalDevices%>

                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"> <%= __('usb_campaign.report.usb_plugged') %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Opened_by_people.svg" alt=""
                        style="color: black;">
                </div>
                <p class="text-4xl">

                    <%=campaigns.total_plugged_usb%>
                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"> <%= __('usb_campaign.report.usb_unplugged') %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Opened_by_people.svg" alt=""
                        style="color: black;">
                </div>
                <p class="text-4xl">

                    <%=campaigns.total_unplugged_usb%>
                </p>
            </div>




        </div>

        <!-- Main Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <!-- Bar Chart -->
            <div class="bg-white p-6 rounded-xl   col-span-2">
                <h2 class="text-lg font-semibold mb-4"><%= __('usb_campaign.report.usb_campaign_metrics') %></h2>
                <div id="barChart"></div>
            </div>

            <!-- Campaign Details -->
            <div class="bg-white p-6 rounded-xl  ">
                <h2 class="text-lg font-semibold text-gray-800 mb-6">
                    <%= __("campaign.email_campaign_detail.labelCampaignDetails") %>
                </h2>
                <div class="space-y-4">

                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">
                            <%= __('usb_campaign.report.campaign_name') %>
                        </span>
                        <span class="text-gray-800 font-medium">
                            <%=campaigns.campaign_name%>
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">
                            <%= __('usb_campaign.report.launch_date') %>
                        </span>
                        <span class="text-gray-800 font-medium">
                            <%=campaigns.start_datetime%>
                        </span>
                    </div>
                </div>
            </div>

        </div>

        <!-- last table  -->

        <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white">
            <div class="flex items-center justify-between gap-3 px-5 pt-5">

                <div class="relative">
                    <h2 class="text-2xl mb-4"><%= __('usb_campaign.report.download_usb_package') %></h2>

                </div>


                <div class="flex gap-4">
                    <form method="get" class="hidden lg:block ms-auto" id="usbSearchForm">
                        <input type="hidden" name="page" value="1">
                        <div class="relative">
                            <input type="text" name="search" id="usbSearchInput"
                                value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                                placeholder="<%= __('generic_label.search_here') || 'Search here...' %>"
                                class="pl-10 pr-4 py-3 rounded-full bg-white text-sm border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[var(--teal)]">
                            <button type="submit"
                                class="absolute inset-y-0 left-3 flex items-center justify-center text-gray-400"
                                aria-label="Search">
                                <img src="/securemagnus_2025/images/img/search.svg" class="block w-5 h-5" alt="">
                            </button>
                        </div>
                    </form>
                </div>
            </div>






            <div class="bg-white rounded-xl shadow mt-8">
                <table dir="ltr" class="min-w-full divide-y divide-gray-200" id="usbPackageTable">
                    <thead class="bg-gray-50">
                        <tr>
                            <th
                                class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                <span class="inline-flex items-center gap-2">
                                    <%= __("generic_label.sr_no") %>
                                </span>
                            </th>
                            <th
                                class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                <span class="inline-flex items-center gap-2">
                                    <img src="/securemagnus_2025/images/img/c-usb.svg" class="w-5 h-5" alt="">
                                    <%= __("usb_campaign.device_code") %>
                                </span>
                            </th>
                            <th
                                class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                <span class="inline-flex items-center gap-2">
                                    <img src="/securemagnus_2025/images/img/form.svg" class="w-5 h-5" alt="">
                                    <%= __("usb_campaign.description") %>
                                </span>
                            </th>
                            <th
                                class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                <span class="inline-flex items-center gap-2">
                                    <img src="/securemagnus_2025/images/img/calendar.svg" class="w-4 h-4" alt="">
                                    <%= __("usb_campaign.start_date") %>
                                </span>
                            </th>
                            
                            <th
                                class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                <span class="inline-flex items-center gap-2">
                                    <svg class="w-4 h-4 <%= locals.locale === 'ar' ? '' : 'translate-x-1' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                                        stroke-width="1.8">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v10m0 0l-4-4m4 4l4-4" />
                                    </svg>
                                    <%= __('usb_campaign.report.download') %>
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-100" id="usbPackageTableBody">
                        <% if (paginatedDevices.length) { %>
                            <% paginatedDevices.forEach((device, idx)=> { %>
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="px-6 py-4 whitespace-nowrap text-gray-800 font-medium">
                                        <%= startIdx + idx + 1 %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-gray-800">
                                        <%= device.usb_code %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-gray-800">
                                        <%= device.description %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-gray-800">
                                        <%= device.creation_date ? new Date(device.creation_date).toLocaleString() : 'N/A' %>
                                    </td>
                                     
                                    <td class="px-6 py-4 whitespace-nowrap text-gray-800">
                                        <button type="button" title="Download"
                                            data-url="/phm/campaign/usb/package/download/<%= device.campaign_id %>/<%= device.usb_code %>">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                class="h-6 w-6 text-yellow-500 cursor-pointer" fill="none"
                                                viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V4" />
                                            </svg>
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                                                <%= (searchQuery && searchQuery.length) ? (__("generic_label.no_results_match_search") || __("usb_campaign.no_records")) : __("usb_campaign.no_records") %>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
                <div id="paginationContainer" class="flex items-center justify-between px-6 py-6 mt-2">
                    <select id="rowsPerPage" dir="<%= locale === 'ar' ? 'rtl' : 'ltr' %>"
                        class="<%= locale === 'ar' ? 'pl-8 pr-4' : 'pl-4 pr-8' %> py-2 border border-gray-300 rounded-md text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="5" <%= Number(pageSize) === 5 ? 'selected' : '' %>>5</option>
                        <option value="10" <%= Number(pageSize) === 10 ? 'selected' : '' %>>10</option>
                        <option value="20" <%= Number(pageSize) === 20 ? 'selected' : '' %>>20</option>
                    </select>
                    <div id="usbPaginationControls" class="space-x-2 <%= locale === 'ar' ? 'pl-3' : '' %>"></div>
                </div>
            </div>


        </div>

        <!-- USB Interaction Details -->
        <% if (campaigns.usbUserDataDetails && campaigns.usbUserDataDetails.length > 0) { %>
        <div class="flex flex-col gap-4 bg-white rounded-3xl p-6">

          <button type="button" onclick="toggleUsbDetails()" class="flex items-center justify-between w-full text-left cursor-pointer" id="usbDetailsToggle">
            <div>
              <h2 class="text-xl font-bold text-gray-800"><%= __('usb_campaign.report.interaction_details_title') %></h2>
              <p class="text-xs text-gray-400 mt-0.5"><%= campaigns.usbUserDataDetails.length %> <%= __('usb_campaign.report.interactions_recorded') %></p>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs px-3 py-1.5 rounded-full font-semibold" style="background:#fff7ed;color:#c2410c">
                <%= campaigns.unique_users %> <%= __('usb_campaign.report.unique_users') %>
              </span>
              <span id="usbDetailsChevron" class="flex items-center justify-center w-7 h-7 rounded-full transition-transform" style="background:#f1f5f9">
                <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
                </svg>
              </span>
            </div>
          </button>

          <div id="usbDetailsBody" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <% campaigns.usbUserDataDetails.forEach((entry, i) => { %>
              <%
                let sysDet = {};
                try { sysDet = JSON.parse(entry.system_details || '{}'); } catch(e) {}
                const linkedDevice = (campaigns.usb_devices || []).find(d => d.id === entry.usb_device_id);
                const deviceCode = linkedDevice ? linkedDevice.usb_code : '—';
                const usbFullName = [entry.first_name, entry.last_name].filter(Boolean).join(' ');
                const usbInitials = usbFullName
                  ? (entry.first_name?.[0] || '') + (entry.last_name?.[0] || '')
                  : (entry.user_email || entry.ip_address || '?').slice(0, 2).toUpperCase();
              %>
              <div class="rounded-xl overflow-hidden" style="border:1px solid #e5e7eb">

                <!-- Card header -->
                <div class="flex items-center justify-between px-4 py-3" style="background:#f8fafc;border-bottom:1px solid #e5e7eb">
                  <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background:linear-gradient(135deg,#f97316,#c2410c)">
                      <%- usbInitials %>
                    </span>
                    <div>
                      <% if (usbFullName) { %>
                        <p class="text-sm font-semibold text-gray-800"><%- usbFullName %></p>
                        <div class="flex items-center gap-1.5 flex-wrap">
                          <!-- <span class="text-xs text-gray-400"><%= entry.ip_address || '—' %></span> -->
                        <p class="text-xs text-gray-400"><%= entry.creation_date ? entry.creation_date : '—' %></p>

                          <% if (entry.user_email) { %>
                            <span class="text-xs px-1.5 py-0.5 rounded font-medium" style="background:#f0fdf4;color:#16a34a"><%= entry.user_email %></span>
                          <% } %>
                        </div>
                      <% } else { %>
                        <p class="text-sm font-semibold text-gray-800"><%= entry.user_email || entry.ip_address || '—' %></p>
                        <p class="text-xs text-gray-400"><%= entry.creation_date ? entry.creation_date : '—' %></p>
                      <% } %>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs px-2 py-1 rounded-full font-semibold font-mono" style="background:#fff7ed;color:#c2410c" title="Device Code">
                      <svg class="w-3 h-3 inline-block mr-0.5 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
                      </svg>
                      <%= deviceCode %>
                    </span>
                    <% if (entry.is_plugged) { %>
                      <span class="text-xs px-2 py-1 rounded-full font-semibold" style="background:#f0fdf4;color:#16a34a">● <%= __('usb_campaign.report.plugged') %></span>
                    <% } else { %>
                      <span class="text-xs px-2 py-1 rounded-full font-semibold" style="background:#fef2f2;color:#dc2626">● <%= __('usb_campaign.report.unplugged') %></span>
                    <% } %>
                  </div>
                </div>

                <!-- Card body -->
                <div class="p-4 bg-white flex flex-col gap-3">

                  <!-- IP + MAC row -->
                  <div class="grid grid-cols-2 gap-3">
                    <div class="rounded-lg p-3" style="background:#eff6ff">
                      <p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color:#2563eb"><%= __('usb_campaign.report.ip_address') %></p>
                      <p class="text-sm font-mono font-bold text-gray-800"><%= entry.ip_address || '—' %></p>
                    </div>
                    <div class="rounded-lg p-3" style="background:#faf5ff">
                      <p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color:#7c3aed"><%= __('usb_campaign.report.mac_address') %></p>
                      <p class="text-sm font-mono font-bold text-gray-800"><%= entry.mac_address || '—' %></p>
                    </div>
                  </div>

                  <!-- Env data -->
                  <div class="rounded-lg p-3" style="background:#fffbeb">
                    <p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color:#d97706"><%= __('usb_campaign.report.env_path') %></p>
                    <p class="text-xs font-mono text-gray-700 break-all"><%= entry.env_data || '—' %></p>
                  </div>

                  <!-- System details parsed -->
                  <% if (Object.keys(sysDet).length > 0) { %>
                  <div class="rounded-lg overflow-hidden" style="border:1px solid #f43f5e33">
                    <div class="flex items-center gap-1.5 px-3 py-2" style="background:#fff1f2">
                      <svg class="w-3.5 h-3.5 flex-shrink-0" style="color:#e11d48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
                      </svg>
                      <span class="text-xs font-bold uppercase tracking-widest" style="color:#e11d48"><%= __('usb_campaign.report.system_details') %></span>
                    </div>
                    <div class="px-3 divide-y" style="background:#fff8f8;border-color:#f43f5e22">
                      <% Object.entries(sysDet).forEach(([k, v]) => { %>
                        <div class="flex items-start gap-2 py-2">
                          <span class="text-xs font-semibold capitalize min-w-[90px] flex-shrink-0" style="color:#e11d48"><%= k.replace(/_/g, ' ') %></span>
                          <span class="text-xs text-gray-700 break-all font-mono"><%= v %></span>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                  <% } %>

                </div>
              </div>
            <% }) %>
          </div>

        </div>
        <% } %>

    </div>
</div>

<script>
(function () {
  var _usbOpen = true;
  function toggleUsbDetails() {
    _usbOpen = !_usbOpen;
    var body = document.getElementById('usbDetailsBody');
    var chevron = document.getElementById('usbDetailsChevron');
    if (body) {
      body.style.display = _usbOpen ? '' : 'none';
    }
    if (chevron) {
      chevron.style.transform = _usbOpen ? '' : 'rotate(180deg)';
    }
  }
  window.toggleUsbDetails = toggleUsbDetails;
})();
</script>


<script>



    window.metrices = {
        totalDevices: <%= typeof campaigns !== 'undefined' && campaigns.total_usb_devices || 0 %>,
        totalPlugged: <%= typeof campaigns !== 'undefined' && campaigns.total_plugged_usb || 0 %>,
        totalUnPlugged: <%= typeof campaigns !== 'undefined' && campaigns.total_unplugged_usb || 0 %>,
    };
</script>
<script>
// Client-side i18n setup for USB report
window.i18n = {
  usb_campaign: {
    report: {
      total_devices: "<%= __('usb_campaign.report.total_devices') %>",
      total_plugged: "<%= __('usb_campaign.report.total_plugged') %>",
      total_unplugged: "<%= __('usb_campaign.report.total_unplugged') %>"
    }
  }
};
</script>
<script src="/securemagnus_2025/js/JQuery_usb_phishing_campaign_report.js"></script>
<script>
    (function () {
        var searchInput = document.getElementById('usbSearchInput');
        var searchForm = document.getElementById('usbSearchForm');
        var tableBody = document.getElementById('usbPackageTableBody');
        var paginationControls = document.getElementById('usbPaginationControls');
        var rowsPerPageSelect = document.getElementById('rowsPerPage');
        if (!searchInput || !searchForm || !tableBody || !paginationControls || !rowsPerPageSelect) return;

        var currentSearch = (searchInput.value || '').trim();
        var currentPageSize = Number(rowsPerPageSelect.value || <%= Number(pageSize || 5) %>);
        var translations = {
            showingResults: '<%= __("all_campaigns.showingResults") %>'
        };
        var noRecordsText = '<%= __("usb_campaign.no_records") %>';
        var noSearchResultsText = '<%= __("generic_label.no_results_match_search") || __("usb_campaign.no_records") %>';
        var naText = 'N/A';
        var locale = '<%= locals.locale || "en" %>';

        function escapeHtml(value) {
            return String(value == null ? '' : value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function formatDate(value) {
            if (!value) return naText;
            var d = new Date(value);
            if (isNaN(d.getTime())) return naText;
            return d.toLocaleString(locale);
        }

        function buildRow(device, idx, startIdx) {
            var rowNumber = startIdx + idx + 1;
            var usbCode = escapeHtml(device && device.usb_code ? device.usb_code : '');
            var description = escapeHtml(device && device.description ? device.description : '');
            var creationDate = escapeHtml(formatDate(device && device.creation_date ? device.creation_date : null));
            var campaignId = device && device.campaign_id ? encodeURIComponent(device.campaign_id) : '';
            var usbCodeForUrl = device && device.usb_code ? encodeURIComponent(device.usb_code) : '';

            return `
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 whitespace-nowrap text-gray-800 font-medium">${rowNumber}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-gray-800">${usbCode}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-gray-800">${description}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-gray-800">${creationDate}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-gray-800">
                        <button type="button" title="Download"
                            data-url="/phm/campaign/usb/package/download/${campaignId}/${usbCodeForUrl}">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6 text-yellow-500 cursor-pointer" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V4" />
                            </svg>
                        </button>
                    </td>
                </tr>
            `;
        }

        function buildEmptyRow(searchValue) {
            var text = searchValue ? noSearchResultsText : noRecordsText;
            return `
                <tr>
                    <td colspan="5" class="px-6 py-8 text-center text-gray-500">${escapeHtml(text)}</td>
                </tr>
            `;
        }

        function buildQuery(page, pageSize, searchValue) {
            var params = new URLSearchParams();
            params.set('page', String(page || 1));
            params.set('pageSize', String(pageSize || currentPageSize || 5));
            if (searchValue) {
                params.set('search', searchValue);
            }
            return '?' + params.toString();
        }

        function buildPaginationHtml(currentPage, totalPages, pageSize, totalCount, searchValue) {
            if (totalPages <= 1) {
                return '';
            }

            var html = `
                <div class="flex items-center justify-between w-full ${locale === 'ar' ? 'pl-2' : ''}">
                    <div>
                        <p class="text-sm text-gray-700 ${locale === 'ar' ? 'ml-2' : 'mr-2'}">
                            ${translations.showingResults
                                .replace('{start}', ((currentPage - 1) * pageSize) + 1)
                                .replace('{end}', Math.min(currentPage * pageSize, totalCount))
                                .replace('{total}', totalCount)}
                        </p>
                    </div>
                    <div class="flex space-x-2">
            `;

            if (currentPage > 1) {
                html += `
                    <a href="${buildQuery(currentPage - 1, pageSize, searchValue)}" data-page="${currentPage - 1}" class="px-3 py-1 rounded-full border text-gray-600 hover:bg-teal-50 hover:text-[var(--teal)] hover:border hover:border-[var(--teal)] duration-300">&lsaquo;</a>
                `;
            }

            var maxVisiblePages = 3;
            var startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
            var endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
            if (endPage - startPage + 1 < maxVisiblePages) {
                startPage = Math.max(1, endPage - maxVisiblePages + 1);
            }

            for (var i = startPage; i <= endPage; i++) {
                var isActive = i === currentPage;
                var activeClass = isActive
                    ? 'bg-teal-50 text-[var(--teal)] border border-[var(--teal)]'
                    : 'border text-gray-600 hover:bg-teal-50 hover:text-[var(--teal)] hover:border hover:border-[var(--teal)] duration-300';
                html += `
                    <a href="${buildQuery(i, pageSize, searchValue)}" data-page="${i}" class="px-3 py-1 rounded-full ${activeClass}">${i}</a>
                `;
            }

            if (currentPage < totalPages) {
                html += `
                    <a href="${buildQuery(currentPage + 1, pageSize, searchValue)}" data-page="${currentPage + 1}" class="px-3 py-1 rounded-full border text-gray-600 hover:bg-teal-50 hover:text-[var(--teal)] hover:border hover:border-[var(--teal)] duration-300">&rsaquo;</a>
                `;
            }

            html += `
                    </div>
                </div>
            `;
            return html;
        }

        function renderAjaxResponse(result, searchValue) {
            var payload = result && result.data ? result.data : {};
            var rows = payload.paginatedDevices || [];
            var pagination = payload.pagination || {};
            var startIdx = pagination.startIdx || 0;
            var currentPage = pagination.currentPage || 1;
            var totalPages = pagination.totalPages || 1;
            var pageSize = Number(pagination.pageSize || currentPageSize || 5);
            var totalCount = Number(pagination.filteredDevicesCount || 0);
            currentPageSize = pageSize;
            rowsPerPageSelect.value = String(pageSize);

            if (!rows.length) {
                tableBody.innerHTML = buildEmptyRow(searchValue);
            } else {
                tableBody.innerHTML = rows.map(function (device, idx) {
                    return buildRow(device, idx, startIdx);
                }).join('');
            }

            paginationControls.innerHTML = buildPaginationHtml(currentPage, totalPages, pageSize, totalCount, searchValue);
        }

        function buildAjaxUrl(page, searchValue, pageSize) {
            var url = new URL(window.location.href);
            url.searchParams.set('ajax', '1');
            url.searchParams.set('page', String(page || 1));
            url.searchParams.set('pageSize', String(pageSize || currentPageSize || 5));

            if (searchValue) {
                url.searchParams.set('search', searchValue);
            } else {
                url.searchParams.delete('search');
            }
            return url;
        }

        function updateBrowserUrl(page, searchValue, pageSize) {
            var url = new URL(window.location.href);
            url.searchParams.delete('ajax');
            url.searchParams.set('page', String(page || 1));
            url.searchParams.set('pageSize', String(pageSize || currentPageSize || 5));
            if (searchValue) {
                url.searchParams.set('search', searchValue);
            } else {
                url.searchParams.delete('search');
            }
            window.history.replaceState({}, '', url.toString());
        }

        function fetchTableData(page, searchValue, pageSize) {
            var normalizedPageSize = Number(pageSize || currentPageSize || 5);
            currentPageSize = normalizedPageSize;
            var ajaxUrl = buildAjaxUrl(page, searchValue, normalizedPageSize);
            fetch(ajaxUrl.toString())
                .then(function (response) {
                    if (!response.ok) throw new Error('Failed to fetch USB devices');
                    return response.json();
                })
                .then(function (result) {
                    renderAjaxResponse(result, searchValue);
                    var nextPage = result && result.data && result.data.pagination
                        ? result.data.pagination.currentPage
                        : (page || 1);
                    updateBrowserUrl(nextPage, searchValue, normalizedPageSize);
                })
                .catch(function (error) {
                    console.error('Error fetching USB table data:', error);
                });
        }

        searchForm.addEventListener('submit', function (e) {
            e.preventDefault();
            currentSearch = (searchInput.value || '').trim();
            fetchTableData(1, currentSearch, currentPageSize);
        });

        paginationControls.addEventListener('click', function (e) {
            var target = e.target.closest('a[data-page]');
            if (!target) return;
            e.preventDefault();
            var page = parseInt(target.getAttribute('data-page') || '1', 10);
            fetchTableData(page, currentSearch, currentPageSize);
        });

        rowsPerPageSelect.addEventListener('change', function (e) {
            var pageSize = Number(e.target.value || 5);
            fetchTableData(1, currentSearch, pageSize);
        });

        var debounceTimer = null;
        searchInput.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function () {
                currentSearch = (searchInput.value || '').trim();
                fetchTableData(1, currentSearch, currentPageSize);
            }, 500);
        });

        paginationControls.innerHTML = buildPaginationHtml(
            <%= Number(currentPage || 1) %>,
            <%= Number(totalPages || 1) %>,
            <%= Number(pageSize || 5) %>,
            <%= Number(filteredDevicesCount || 0) %>,
            currentSearch
        );
    })();
</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.addEventListener('click', function (event) {
            const btn = event.target.closest('button[data-url]');
            if (!btn) return;
                const url = btn.getAttribute('data-url');
                let fileName = 'default-name.zip';
                btn.style.opacity = '0.5';

                fetch(url)
                    .then(response => {
                        if (!response.ok) throw new Error('Failed to download file.');
                        const contentDisposition = response.headers.get('Content-Disposition');
                        if (contentDisposition && contentDisposition.indexOf('attachment') !== -1) {
                            const fileNameMatch = contentDisposition.match(/filename="(.+)"/);
                            if (fileNameMatch && fileNameMatch[1]) fileName = fileNameMatch[1];
                        }
                        return response.blob();
                    })
                    .then(blob => {
                        const downloadUrl = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = downloadUrl;
                        a.download = fileName;
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                        URL.revokeObjectURL(downloadUrl);
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Could not download the file.');
                    })
                    .finally(() => {
                        btn.style.opacity = '1';
                    });
        });
    });
</script>
