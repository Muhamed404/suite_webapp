<div class="flex flex-col  p-6 pt-0">
    <!-- first section  -->
    <div class="flex flex-col gap-4 mt-3">
        <!-- Title -->
        <div class="flex items-center justify-between gap-3 my-2">
            <h1 class="text-2xl font-semibold">
                <%= __( "qr_campaign.phishingCampaignResponseMetrics" ) %>
            </h1>
            <button type="button" onclick="window.location.reload()" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold bg-white text-teal-600 border-2 border-teal-600 shadow-sm hover:bg-teal-50 hover:text-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-200 transition shrink-0" aria-label="<%= __('generic_label.refresh') %>">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
