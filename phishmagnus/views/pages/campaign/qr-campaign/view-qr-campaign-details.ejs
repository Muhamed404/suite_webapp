<div class="flex flex-col  p-6 pt-0">
    <!-- first section  -->
    <div class="flex flex-col gap-4 mt-3">
        <!-- Title -->
        <h1 class="text-2xl font-semibold my-2">
            <%= __( "qr_campaign.phishingCampaignResponseMetrics" ) %>
        </h1>

        <!-- Top Metrics -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm">
                        <%= __( "qr_campaign.totalQrImagesCreated" ) %>
                    </p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Email_Sent.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=openSegmentStats.totalQRCodeCount%>

                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm">
                        <%= __( "qr_campaign.notScanQrImages" ) %>
                    </p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/not_opened.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.number_of_total_not_scans%>

                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm">
                        <%= __( "qr_campaign.totalQrScans" ) %>
                    </p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Report_Admin.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.number_of_scans%>

                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm">
                        <%= __( "qr_campaign.scanAndOpenUrl" ) %>
                    </p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Opened_by_people.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.is_opened%>
                </p>
            </div>

            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm">
                        <%= __( "qr_campaign.submittedForm" ) %>
                    </p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/link_Clicked.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.is_submitted%>

                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm">
                        <%= __( "qr_campaign.totalInteract" ) %>
                    </p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Report_Admin.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.is_interacted%>

                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm">
                        <%= __( "qr_campaign.downloadFile" ) %>
                    </p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/link_Clicked.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=campaignStats.is_downloaded%>

                </p>
            </div>

            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm">
                        <%= __( "qr_campaign.totalUniqueIps" ) %>
                    </p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Report_Admin.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=uniqueIpCount.unique_ip_count%>

                </p>
            </div>
        


        </div>

        <!-- Main Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <!-- Bar Chart -->
            <div class="bg-white p-6 rounded-xl   col-span-2">
                <h2 class="text-lg font-semibold mb-4">
                    <%= __( "qr_campaign.campaignMetrics" ) %>
                </h2>
                <div id="barChart"></div>
            </div>

            <!-- Phishing Success -->
            <div class="bg-white p-6 rounded-xl flex flex-col">
                <h2 class="text-lg font-semibold mb-4"><%= __("qr_campaign.phishingSuccess") %></h2>
                <div id="successChart"></div>
            </div>
        </div>

        <!-- Second Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Employees Phishing Segments -->
            <div class="bg-white p-6 rounded-xl  ">
                <h2 class="text-lg font-semibold mb-4">
                    <%= __( "qr_campaign.employeesPhishingSegments" ) %>
                </h2>
                <div id="segmentsChart"></div>
            </div>

            <!-- Reported To Admin -->
            <div class="bg-white p-6 rounded-xl  ">
                <h2 class="text-lg font-semibold mb-4">
                    <%= __( "qr_campaign.adminReportSegments" ) %>
                </h2>
                <div id="adminReportChart"></div>
            </div>

            <!-- Campaign Details -->
            <div class="bg-white p-6 rounded-xl  ">
                <h2 class="text-lg font-semibold text-gray-800 mb-6">
                    <%= __( "qr_campaign.campaignDetails" ) %>
                </h2>
                <div class="space-y-4">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">
                            <%= __( "qr_campaign.campaignName" ) %>
                        </span>
                        <span class="text-gray-800 font-medium">
                            <%= campaignDetails.name %>
                        </span>
                    </div>
                    <% if (tvbs_backend_url) { %>
                    <div class="flex justify-between items-center text-sm gap-2">
                        <span class="text-gray-500 flex-shrink-0">
                            <%= __( "qr_campaign.phishingPage" ) %>
                        </span>
                        <button
                            class="copyUrlButton flex items-center gap-1 text-teal-500 hover:text-white hover:bg-teal-500 border border-teal-500 px-2 py-1 rounded-lg transition text-xs"
                            data-url="<%= tvbs_backend_url %>/rq?iqr=test&cid=<%= campaignDetails.id %>" title="Copy URL">
                            <%= __('nfc_campaign.copyUrl') %>
                            <img src="/securemagnus_2025/images/copy.svg" class="svg w-3.5 h-3.5" alt="">
                        </button>
                    </div>
                    <% } %>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">
                            <%= __( "qr_campaign.templateName" ) %>
                        </span>
                        <span class="text-gray-800 font-medium">
                            <%= templateDetails.name %>

                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">
                            <%= __( "qr_campaign.launchDate" ) %>
                        </span>
                        <span class="text-gray-800 font-medium">
                            <%= campaignDetails.start_datetime %>

                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Charts -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

            <!-- Links Interaction -->



            <div class="bg-white p-6 rounded-xl   text-center">

                <div class="flex items-center justify-start mb-9 gap-2">
                    <img src="/securemagnus_2025/images/Links-Interaction.svg" alt="">
                    <label for="Links Interaction">
                        <%= __( "qr_campaign.linksInteraction" ) %>
                    </label>
                </div>

                <div>
                    <div class="qrSemiChartLink" uniqueScan="<%=openSegmentStats?.uniqueScanCount%>"
                        repeatedScan="<%=openSegmentStats?.repeatedScanCount%>"
                        noScan="<%=openSegmentStats?.noScanCount%>">
                    </div>
                </div>

            </div>


            <!-- Form Interact -->
            <div class="bg-white p-6 rounded-xl   text-center">

                <div class="flex items-center justify-start mb-9 gap-2">
                    <img src="/securemagnus_2025/images/interactfrom.svg" alt="">
                    <label for="Interact Form ">
                        <%= __( "qr_campaign.interactForm" ) %>
                    </label>
                </div>

                <div>
                    <div class="qrSemiChartInteract"
                        uniqueScan="<%=formInteractionSegmentStats?.uniqueInteractedCount%>"
                        repeatedScan="<%=formInteractionSegmentStats?.repeatedInteractedCount%>"
                        noScan="<%=formInteractionSegmentStats?.noInteractedCount%>">
                    </div>
                </div>
            </div>

            <!-- Form Submitted -->
            <div class="bg-white p-6 rounded-xl   text-center">

                <div class="flex items-center justify-start mb-9 gap-2">
                    <img src="/securemagnus_2025/images/formsubmitted.svg" alt="">
                    <label for="Form Submitted">
                        <%= __( "qr_campaign.formSubmitted" ) %>
                    </label>
                </div>

                <div>
                    <div class="qrSemiChartSubmitted" uniqueScan="<%=formSubmittedSegmentStats?.uniqueSubmittedCount%>"
                        repeatedScan="<%=formSubmittedSegmentStats?.repeatedSubmittedCount%>"
                        noScan="<%=formSubmittedSegmentStats?.noSubmittedCount%>">
                    </div>
                </div>
            </div>

            <!-- Attachment Opened -->
            <div class="bg-white p-6 rounded-xl   text-center">

                <div class="flex items-center justify-start mb-9 gap-2">
                    <img src="/securemagnus_2025/images/attachmentopened.svg" alt="">
                    <label for="Attachment Opened">
                        <%= __( "qr_campaign.attachmentOpened" ) %>
                    </label>
                </div>

                <div>
                    <div class="qrSemiChartDownload" uniqueScan="<%=downloadSegmentStats?.uniqueDownloadCount%>"
                        repeatedScan="<%=downloadSegmentStats?.repeatedDownloadCount%>"
                        noScan="<%=downloadSegmentStats?.noDownloadCount%>">
                    </div>
                </div>
            </div>

        </div>


        <!-- last table  -->

        <div class="flex flex-col rounded-3xl bg-white border border-gray-100 shadow-sm mt-3">
            <!-- Header -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-6 pt-6 pb-4 border-b border-gray-100">
                <h2 class="text-lg font-semibold text-gray-800">
                    <%= __( "qr_campaign.interactionReportByEachQRCode" ) %>
                </h2>
                <div class="relative hidden lg:block">
                    <input type="text" placeholder="<%= __('qr_campaign.searchHere') %>"
                        class="pl-9 pr-4 py-2 rounded-full bg-gray-50 text-sm border border-gray-200 focus:outline-none focus:ring-2 focus:ring-teal-400 w-56">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                    </svg>
                </div>
            </div>
            <!-- Table -->
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm text-left">
                    <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
                        <tr>
                            <th class="px-6 py-3 font-medium whitespace-nowrap">#</th>
                            <th class="px-6 py-3 font-medium whitespace-nowrap"><%= __( "qr_campaign.tagCode" ) %></th>
                            <th class="px-6 py-3 font-medium whitespace-nowrap"><%= __( "qr_campaign.scanned" ) %></th>
                            <th class="px-6 py-3 font-medium whitespace-nowrap"><%= __( "qr_campaign.downloadQRCode" ) %></th>
                            <th class="px-6 py-3 font-medium whitespace-nowrap"><%= __( "qr_campaign.viewReport" ) %></th>
                            <th class="px-6 py-3 font-medium whitespace-nowrap"><%= __('qr_campaign.testUrl') %></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        <% if (typeof qrImageUrls !== 'undefined' && qrImageUrls !== null && qrImageUrls.length > 0) {
                            qrImageUrls.forEach((images, index) => { %>
                            <tr class="bg-white hover:bg-gray-50 transition-colors duration-150">
                                <td class="px-6 py-4 text-gray-400 font-medium whitespace-nowrap"><%=index + 1%></td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700">
                                        <%=images.qr_code %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <% if (images.is_scanned) { %>
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-teal-100 text-teal-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-teal-500 inline-block"></span>
                                            <%= __('qr_campaign.scannedYes') %>
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-500">
                                            <span class="w-1.5 h-1.5 rounded-full bg-gray-400 inline-block"></span>
                                            <%= __('qr_campaign.scannedNo') %>
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <button type="button"
                                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-teal-600 border border-teal-200 bg-teal-50 hover:bg-teal-600 hover:text-white transition-colors duration-150"
                                        title="Download" data-url="<%= images.download_url %>" data-toggle="tooltip">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                        </svg>
                                        <%= __( "qr_campaign.downloadQRCode" ) %>
                                    </button>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <a href="/phm/campaign/qr/tag/report/<%= campaignDetails.id %>/<%=images.qr_code %>"
                                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-blue-600 border border-blue-200 bg-blue-50 hover:bg-blue-600 hover:text-white transition-colors duration-150">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                        <%= __( "qr_campaign.viewReport" ) %>
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <a href="<%=tvbs_backend_url%>/rq?iqr=<%=images.qr_code%>" target="_blank"
                                        class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-teal-600 transition-colors duration-150">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                        </svg>
                                        <%= __('qr_campaign.clickToTest') %>
                                    </a>
                                </td>
                            </tr>
                        <% }); } else { %>
                            <tr>
                                <td colspan="6" class="px-6 py-10 text-center text-gray-400 text-sm">
                                    <svg class="w-8 h-8 mx-auto mb-2 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-6a2 2 0 012-2h2a2 2 0 012 2v6m-6 0h6"/>
                                    </svg>
                                    <%= __('qr_campaign.noRecords') %>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<script>

    var localizedLabels = {
        people: '<%= __("generic_label.people") %>',
        qrCodesSent: '<%= __("qr_campaign.totalQrImagesCreated") %>',
        qrCodesNotScanned: '<%= __("qr_campaign.notScanQrImages") %>',
        qrCodeScanned: '<%= __("qr_campaign.totalQrScans") %>',
        qrCodeSubmitData: '<%= __("qr_campaign.submittedForm") %>',
        qrCodeAttachmentOpened: '<%= __("qr_campaign.downloadFile") %>',
        qrCodes: '<%= __("qr_campaign.totalQrImagesCreated") %>',
        totalScans: '<%= __("qr_campaign.totalQrScans") %>',
        openedLink: '<%= __("qr_campaign.scanAndOpenUrl") %>',
        interactForm: '<%= __("qr_campaign.totalInteract") %>',
        submitForm: '<%= __("qr_campaign.submittedForm") %>',
        attachmentDownloaded: '<%= __("qr_campaign.downloadFile") %>',
        scanned: '<%= __("qr_campaign.tagScan") %>',
        interaction: '<%= __("qr_campaign.totalInteract") %>',
        fileDownloaded: '<%= __("qr_campaign.downloadFile") %>',
        targetCompromised: '<%= __("generic_label.targetCompromised") %>',
        notScanned: '<%= __("qr_campaign.notScanTag") %>',
        uniqueScans: '<%= __("qr_campaign.uniqueScans") %>',
        repeatedScans: '<%= __("qr_campaign.repeatedScans") %>',
        noScans: '<%= __("qr_campaign.noScans") %>',
        repeatedInteractions: '<%= __("qr_campaign.repeatedInteractions") %>',
        repeatedSubmitted: '<%= __("qr_campaign.repeatedSubmitted") %>',
        repeatedDownloads: '<%= __("qr_campaign.repeatedDownloads") %>'
    };

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('button[title="Download"][data-url]').forEach(btn => {
            btn.addEventListener('click', (event) => {
                const url = btn.getAttribute('data-url');
                if (url) {
                    window.location.href = url;
                } else {
                    alert('Invalid download URL.');
                }
            });
        });
    });

    window.CampaignMetrics = {
        openedLink: <%= typeof campaignStats !== 'undefined' && campaignStats?.is_opened || 0 %>,
        interactForm: <%= typeof campaignStats !== 'undefined' && campaignStats?.is_interacted || 0 %>,
        submitForm: <%= typeof campaignStats !== 'undefined' && campaignStats?.is_submitted || 0 %>,
        attachmentDownloaded: <%= typeof campaignStats !== 'undefined' && campaignStats?.is_downloaded || 0 %>,
        totalQRImages: <%= typeof openSegmentStats !== 'undefined' && openSegmentStats?.totalQRCodeCount || 0 %>,
        totalScans: <%= typeof campaignStats !== 'undefined' && campaignStats?.number_of_scans || 0 %>,
        totalNotScans: <%= typeof openSegmentStats !== 'undefined' && openSegmentStats?.noScanCount || 0 %>,
        uniqueScans: <%= typeof openSegmentStats !== 'undefined' && openSegmentStats?.uniqueScanCount || 0 %>,
        uniqueInteractedCount: <%= typeof formInteractionSegmentStats !== 'undefined' && formInteractionSegmentStats?.uniqueInteractedCount || 0 %>,
        uniqueFormSubmittedCount: <%= typeof formSubmittedSegmentStats !== 'undefined' && formSubmittedSegmentStats?.uniqueSubmittedCount || 0 %>,
        uniqueDownloadedCount: <%= typeof downloadSegmentStats !== 'undefined' && downloadSegmentStats?.uniqueDownloadCount || 0 %>,
    };




</script>
<script>
    $(document).on('click', '.copyUrlButton', function () {
        const url = $(this).data('url');
        navigator.clipboard.writeText(url)
            .then(() => showCustomToast('success', 'URL copied!'))
            .catch(() => showCustomToast('error', 'Failed to copy URL'));
    });
</script>
<script src="/securemagnus_2025/js/qr_camp_view.js"></script>