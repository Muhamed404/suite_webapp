<div class="flex flex-col p-6 pt-0">



  <!-- first section  -->

  <div class="flex flex-col gap-4 mt-3">




    <!-- Title -->
    <h1 class="my-2 text-2xl font-semibold"><%= __("qr_report.title") %> <%=qrReportProfile.qr_code%>
    </h1>

        <!-- Top Metrics -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"><%= __("qr_report.total_scans") %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Report_Admin.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=interactionStats.number_of_scans%>

                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"><%= __("qr_report.open") %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Opened_by_people.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=interactionStats.is_opened%>
                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"><%= __("qr_report.download") %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/not_opened.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=interactionStats.is_downloaded%>

                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"><%= __("qr_report.total_submitted") %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/link_Clicked.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=interactionStats.is_submitted%>

                </p>
            </div>
            <div class="bg-white p-4 flex flex-col rounded-xl">
                <div class="flex items-center justify-between gap-2 mb-8">
                    <p class="text-gray-500 text-sm"><%= __("qr_report.total_interact") %></p>
                    <img src="/securemagnus_2025/images/Icons_Campaign_Report/Report_Admin.svg" alt="">
                </div>
                <p class="text-4xl">
                    <%=interactionStats.is_interacted%>

                </p>
            </div>
        </div>

    <!-- Main Section -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
      <!-- Bar Chart -->
      <div class="col-span-2 p-6 bg-white rounded-xl">
        <h2 class="mb-4 text-lg font-semibold"><%= __("qr_report.campaign_metrics") %></h2>
        <div id="chart"></div>
      </div>

      <!-- Phishing Success -->
      <div class="flex flex-col items-start justify-start p-6 bg-white rounded-xl gap-11">
        <h2 class="mb-4 text-lg font-semibold"><%= __("qr_report.phishing_success") %></h2>

        <div class="flex items-center justify-between w-full gap-10">
          <!-- Left Side Labels -->
          <div class="space-y-6">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#38bdf8]"></span>
              <div>
                <p class="text-sm text-gray-500"><%= __("qr_report.qr_view") %></p>
                <p class="text-lg font-bold text-gray-900" id="qrScanned">
                    
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#f87171]"></span>
              <div>
                <p class="text-sm text-gray-500"><%= __("qr_report.form_interacted") %></p>
                <p class="text-lg font-bold text-gray-900" id="formInteract">
                   
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#34d399]"></span>
              <div>
                <p class="text-sm text-gray-500"><%= __("qr_report.total_activity") %></p>
                <p class="text-lg font-bold text-gray-900" id="targetCompromisedText">
                  
                </p>
              </div>
            </div>
          </div>

          <!-- Donut Chart -->
          <div id="successChart" style="width:50%; height:50%;"></div>
        </div>
      </div>
    </div>

    <!-- Second Row -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <!-- Employees Phishing Segments -->
      <div class="p-6 bg-white rounded-xl ">
        <h2 class="mb-4 text-lg font-semibold">
          <%= __("qr_report.phishing_segments") %>
        </h2>
        <div id="userPhishingSegmentsChart"></div>
      </div>



      <!-- Employee Details -->
      <div class="p-6 bg-white rounded-xl ">
        <h2 class="mb-6 text-lg font-semibold text-gray-800"><%= __("qr_report.qr_campaign_details") %></h2>
        <div class="space-y-4">
          <div class="flex justify-between text-sm">
            <span class="text-gray-500"><%= __("qr_report.qr_image_code") %></span>
            <span class="font-medium text-gray-800">
              <%=qrReportProfile.qr_code%>
            </span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-500"><%= __("qr_report.campaign_name") %></span>
            <span class="font-medium text-gray-800">
              <%=campaignDetails.name%>
            </span>
          </div>
 
          <div class="flex justify-between text-sm">
            <span class="text-gray-500"><%= __("qr_report.campaign_date") %></span>
            <span class="font-medium text-gray-800">              <%=campaignDetails.start_datetime%>
</span>
          </div>
        </div>
      </div>
    </div>

