<div class="flex flex-col p-6 pt-0">



  <!-- first section  -->

  <div class="flex flex-col gap-4 mt-3">




    <%
      const _qrStat = (qrReportProfile.QRReport && qrReportProfile.QRReport[0]) ? qrReportProfile.QRReport[0] : {};
      const _total  = (qrTagReportDetails || []).reduce((sum, r) => sum + (r.total_scanned || 0), 0) || _qrStat.number_of_scans || 0;
      const _pct    = (v) => _total > 0 ? Math.round(((v||0) / _total) * 100) : 0;
      const _startDate = campaignDetails.start_datetime
        ? new Date(campaignDetails.start_datetime).toLocaleDateString([], { day:'2-digit', month:'short', year:'numeric' })
        : '—';
      const _updatedDate = _qrStat.updatedAt
        ? new Date(_qrStat.updatedAt).toLocaleString([], { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' })
        : '—';
    %>

    <!-- Hero Campaign Banner -->
    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">

      <!-- Top strip: identity -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 px-6 py-5 border-b border-gray-100">
        <div class="flex items-center gap-4 min-w-0">
          <!-- Icon -->
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-teal-400 to-teal-600 flex items-center justify-center flex-shrink-0 shadow-sm">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 3.5V16M4 4h4v4H4V4zm12 0h4v4h-4V4zM4 16h4v4H4v-4z"/>
            </svg>
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2 mb-0.5">
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-teal-50 text-teal-600 tracking-wide uppercase">QR Report</span>
              <span class="text-xs text-gray-400">·</span>
              <span class="text-xs text-gray-400">ID #<%=campaignDetails.id%></span>
            </div>
            <h1 class="text-xl font-bold text-gray-900 truncate"><%=campaignDetails.name%></h1>
          </div>
        </div>

        <!-- Meta chips -->
        <div class="flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-50 border border-amber-100 text-xs font-medium text-amber-700">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 3.5V16M4 4h4v4H4V4zm12 0h4v4h-4V4zM4 16h4v4H4v-4z"/>
            </svg>
            <%=qrReportProfile.qr_code%>
          </span>
          <% if (campaignDetails.Templates && campaignDetails.Templates.name) { %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-purple-50 border border-purple-100 text-xs font-medium text-purple-700">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 4H7a2 2 0 01-2-2V6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v12a2 2 0 01-2 2z"/>
            </svg>
            <%=campaignDetails.Templates.name%>
          </span>
          <% } %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-50 border border-blue-100 text-xs font-medium text-blue-700">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <%=_startDate%>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gray-50 border border-gray-200 text-xs font-medium text-gray-500">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Last activity: <%=_updatedDate%>
          </span>
        </div>
      </div>

      <!-- Stats grid -->
      <div class="grid grid-cols-1 sm:grid-cols-5 gap-0 divide-y sm:divide-y-0 sm:divide-x divide-gray-100">

        <!-- Total Scans -->
        <div class="flex flex-col justify-between gap-4 p-5 transition-colors" style="border-top:3px solid #0ea5e9">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color:#0ea5e9"><%= __("qr_report.total_scans") %></span>
            <span class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:#e0f2fe">
              <svg class="w-4 h-4" style="color:#0284c7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </span>
          </div>
          <p class="text-4xl font-black leading-none" style="color:#0284c7"><%=_total%></p>
        </div>

        <!-- Opened -->
        <div class="flex flex-col justify-between gap-4 p-5 transition-colors" style="border-top:3px solid #10b981">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color:#10b981"><%= __("qr_report.open") %></span>
            <span class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:#d1fae5">
              <svg class="w-4 h-4" style="color:#059669" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </span>
          </div>
          <p class="text-4xl font-black leading-none" style="color:#059669"><%=_qrStat.is_opened || 0%></p>
        </div>

        <!-- Interacted -->
        <div class="flex flex-col justify-between gap-4 p-5 transition-colors" style="border-top:3px solid #f59e0b">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color:#f59e0b"><%= __("qr_report.total_interact") %></span>
            <span class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:#fef3c7">
              <svg class="w-4 h-4" style="color:#d97706" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5"/>
              </svg>
            </span>
          </div>
          <p class="text-4xl font-black leading-none" style="color:#d97706"><%=_qrStat.is_interacted || 0%></p>
        </div>

        <!-- Submitted -->
        <div class="flex flex-col justify-between gap-4 p-5 transition-colors" style="border-top:3px solid #f43f5e">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color:#f43f5e"><%= __("qr_report.total_submitted") %></span>
            <span class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:#ffe4e6">
              <svg class="w-4 h-4" style="color:#e11d48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
              </svg>
            </span>
          </div>
          <p class="text-4xl font-black leading-none" style="color:#e11d48"><%=_qrStat.is_submitted || 0%></p>
        </div>

        <!-- Downloaded -->
        <div class="flex flex-col justify-between gap-4 p-5 transition-colors" style="border-top:3px solid #8b5cf6">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color:#8b5cf6"><%= __("qr_report.download") %></span>
            <span class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:#ede9fe">
              <svg class="w-4 h-4" style="color:#7c3aed" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
            </span>
          </div>
          <p class="text-4xl font-black leading-none" style="color:#7c3aed"><%=_qrStat.is_downloaded || 0%></p>
        </div>

      </div>
    </div>

    <!-- IP Interaction Timeline -->
    <div class="bg-white p-6 rounded-xl">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-semibold"><%= __("qr_report.interaction_timeline") %></h2>
        <div class="flex gap-3 text-xs">
          <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded-full bg-[#38bdf8]"></span> Scanned</span>
          <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded-full bg-[#fbbf24]"></span> Form Interaction</span>
          <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded-full bg-[#a78bfa]"></span> Form Submitted</span>
          <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded-full bg-[#4ade80]"></span> File Downloaded</span>
        </div>
      </div>
      <!-- Chart -->
      <div id="timelineChart"></div>
      <!-- Per-IP event cards -->
      <div id="timelineCards" class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4"></div>
    </div>
 
  </div>
</div>



<script>
 
// Client-side i18n setup for QR report
window.i18n = {
  qr_report: {
    times: "<%= __('qr_report.times') %>",
    no_timeline_data: "<%= __('qr_report.no_timeline_data') %>",
    no_user_interactions: "<%= __('qr_report.no_user_interactions') %>",
    qr_scanned: "<%= __('qr_report.qr_scanned') %>",
    links_clicked: "<%= __('qr_report.links_clicked') %>",
    target_compromised: "<%= __('qr_report.target_compromised') %>",
    qr_not_scanned: "<%= __('qr_report.qr_not_scanned') %>",
    interact_form: "<%= __('qr_report.interact_form') %>",
    submit_data: "<%= __('qr_report.submit_data') %>",
    attachment_opened: "<%= __('qr_report.attachment_opened') %>",
    total_actions: "<%= __('qr_report.total_actions') %>",
    nfc_created: "<%= __('qr_report.nfc_created') %>",
    scanned: "<%= __('qr_report.scanned') %>",
    attachment_open: "<%= __('qr_report.attachment_open') %>",
    qr_created: "<%= __('qr_report.qr_created') %>"
  }
};
</script>
<script>

  // Pass user interaction timeline data to JavaScript
  window.interactionStats = <%- JSON.stringify(interactionStats || []) %>;
  window.qrTagReportDetails = <%- JSON.stringify(qrTagReportDetails || []) %>;



</script>
<script src="/securemagnus_2025/js/qr-tag-report.js"></script>