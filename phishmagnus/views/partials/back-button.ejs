<div class="mb-3">
    <button type="button" class="<%= typeof btnClass !== 'undefined' ? btnClass : 'inline-flex items-center gap-2 px-4 py-2 rounded-full bg-transparent text-teal-600 border border-teal-600 hover:bg-teal-50 hover:text-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-200 transition' %>"
      onclick="<%= typeof onclick !== 'undefined' ? onclick : 'window.history.back()' %>">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 18l-6-6 6-6"></path>
    </svg>
    <span><%= typeof label !== 'undefined' ? label : (typeof __ === 'function' ? __('common.goBack') : 'Go Back') || 'Go Back' %></span>
  </button>
</div>
