// =============================================================================
// Jenkinsfile — suite_webapp + awaremagnus
// Uses external scripts for deployment logic
// Deploys to OCI server via SSH from separate Jenkins server
// =============================================================================

pipeline {
    agent any

    environment {
        GIT_REPO_URL    = 'https://github.com/SecureMagnusLLC/suite_webapp.git'
        GIT_BRANCH_NAME = 'cicd/jenkins-pipeline'
        NODE_VERSION    = '20.19.2'
        SERVICE_USER    = 'ubuntu'

        // OCI Server credentials
        OCI_HOST = credentials('OCI_HOST')
        OCI_USER = credentials('OCI_USER')

        // suite_webapp credentials
        REDIS_URL                = credentials('REDIS_URL')
        REDIS_SERVER_IP          = credentials('REDIS_SERVER_IP')
        REDIS_SERVER_PORT        = credentials('REDIS_SERVER_PORT')
        REDIS_SESSION_SECRET_KEY = credentials('REDIS_SESSION_SECRET_KEY')

        // awaremagnus credentials
        AWAREMAGNUS_API_URL              = credentials('AWAREMAGNUS_API_URL')
        AWAREMAGNUS_PORT                 = credentials('AWAREMAGNUS_PORT')
        NEXT_PUBLIC_SERVICE_AWM_URL      = credentials('NEXT_PUBLIC_SERVICE_AWM_URL')
        NEXT_PUBLIC_SERVICE_SUITE_URL    = credentials('NEXT_PUBLIC_SERVICE_SUITE_URL')
        NEXT_PUBLIC_SUITE_WEBAPP_URL     = credentials('NEXT_PUBLIC_SUITE_WEBAPP_URL')
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'REF',            value: '$.ref',                    expressionType: 'JSONPath'],
                [key: 'CHANGED_FILES',  value: '$.commits[*].modified[*]', expressionType: 'JSONPath'],
                [key: 'ADDED_FILES',    value: '$.commits[*].added[*]',    expressionType: 'JSONPath'],
                [key: 'COMMIT_MESSAGE', value: '$.head_commit.message',    expressionType: 'JSONPath'],
                [key: 'COMMIT_SHA',     value: '$.head_commit.id',         expressionType: 'JSONPath']
            ],
            regexpFilterText:       '$REF',
            regexpFilterExpression: 'refs/heads/cicd/jenkins-pipeline',
            token: 'suite_webapp_token'
        )
    }

    stages {

        // ─────────────────────────────────────────────────────────────────────
        // Check Changed Files
        // ─────────────────────────────────────────────────────────────────────
        
        stage('Check Changed Files') {
            steps {
                script {
                    def allChanged = "${env.CHANGED_FILES ?: ''} ${env.ADDED_FILES ?: ''}"
                    echo "Changed files: ${allChanged}"

                    def webappPaths = [
                        'phishmagnus/', 'productsuite/', 'commons/', 'config/',
                        'logger/', 'locales/', 'middleware/', 'routes/', 'views/',
                        'public/', 'utility/', 'server.js', 'package.json', 'Jenkinsfile'
                    ]

                    env.DEPLOY_WEBAPP      = webappPaths.any { allChanged.contains(it) } ? 'true' : 'false'
                    env.DEPLOY_AWAREMAGNUS = allChanged.contains('awaremagnus/') ? 'true' : 'false'

                    if (env.DEPLOY_WEBAPP == 'false' && env.DEPLOY_AWAREMAGNUS == 'false') {
                        currentBuild.result = 'NOT_BUILT'
                        error("No relevant files changed — pipeline skipped")
                    }

                    echo "Deploy suite_webapp  : ${env.DEPLOY_WEBAPP}"
                    echo "Deploy awaremagnus   : ${env.DEPLOY_AWAREMAGNUS}"
                }
            }
        }
        

        // ─────────────────────────────────────────────────────────────────────
        // Verify Branch
        // ─────────────────────────────────────────────────────────────────────
        stage('Verify Branch') {
            steps {
                script {
                    echo "Branch  : ${env.REF}"
                    echo "Commit  : ${env.COMMIT_SHA}"
                    echo "Message : ${env.COMMIT_MESSAGE}"
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // Checkout Code
        // ─────────────────────────────────────────────────────────────────────
        stage('Checkout Code') {
            steps {
                git branch: "${GIT_BRANCH_NAME}",
                    credentialsId: 'github-securemagnus-token',
                    url: "${GIT_REPO_URL}"
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // Log Deployment Info
        // ─────────────────────────────────────────────────────────────────────
        stage('Log Deployment Info') {
            steps {
                echo "=========================================="
                echo "Deploying from : ${env.REF}"
                echo "Commit SHA     : ${env.COMMIT_SHA}"
                echo "Message        : ${env.COMMIT_MESSAGE}"
                echo "Build number   : #${env.BUILD_NUMBER}"
                echo "=========================================="
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // Create Package — suite_webapp
        // ─────────────────────────────────────────────────────────────────────
        stage('Create Package — suite_webapp') {
            when { expression { env.DEPLOY_WEBAPP == 'true' } }
            steps {
                sh """
                    mkdir -p deployment/suite_webapp
                    rsync -av ./ deployment/suite_webapp/ \
                        --exclude 'node_modules' \
                        --exclude '.next' \
                        --exclude '.git' \
                        --exclude '.github' \
                        --exclude '.claude' \
                        --exclude '.env' \
                        --exclude '*.md' \
                        --exclude '*.txt' \
                        --exclude 'deployment' \
                        --exclude 'docs'
                    tar -czf suite_webapp_deployment.tar.gz deployment/
                    echo "suite_webapp package created"
                """
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // Create Package — awaremagnus
        // ─────────────────────────────────────────────────────────────────────
        stage('Create Package — awaremagnus') {
            when { expression { env.DEPLOY_AWAREMAGNUS == 'true' } }
            steps {
                sh """
                    mkdir -p deployment/awaremagnus
                    rsync -av ./awaremagnus/. deployment/awaremagnus/ \
                        --exclude 'node_modules' \
                        --exclude '.next' \
                        --exclude '.env'
                    tar -czf awaremagnus_deployment.tar.gz deployment/
                    echo "awaremagnus package created"
                """
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // Check Required Secrets
        // ─────────────────────────────────────────────────────────────────────
        stage('Check Required Secrets') {
            steps {
                script {
                    if (!env.OCI_HOST)                     { error("OCI_HOST not configured") }
                    if (!env.OCI_USER)                     { error("OCI_USER not configured") }
                    if (!env.REDIS_URL)                    { error("REDIS_URL not configured") }
                    if (!env.REDIS_SERVER_IP)              { error("REDIS_SERVER_IP not configured") }
                    if (!env.REDIS_SERVER_PORT)            { error("REDIS_SERVER_PORT not configured") }
                    if (!env.REDIS_SESSION_SECRET_KEY)     { error("REDIS_SESSION_SECRET_KEY not configured") }
                    if (!env.AWAREMAGNUS_API_URL)          { error("AWAREMAGNUS_API_URL not configured") }
                    if (!env.AWAREMAGNUS_PORT)             { error("AWAREMAGNUS_PORT not configured") }
                    if (!env.NEXT_PUBLIC_SERVICE_AWM_URL)  { error("NEXT_PUBLIC_SERVICE_AWM_URL not configured") }
                    if (!env.NEXT_PUBLIC_SERVICE_SUITE_URL){ error("NEXT_PUBLIC_SERVICE_SUITE_URL not configured") }
                    if (!env.NEXT_PUBLIC_SUITE_WEBAPP_URL) { error("NEXT_PUBLIC_SUITE_WEBAPP_URL not configured") }
                    echo "All required secrets are configured"
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // Transfer Files — suite_webapp
        // ─────────────────────────────────────────────────────────────────────
        stage('Transfer Files — suite_webapp') {
            // when { expression { env.DEPLOY_WEBAPP == 'true' } }
            steps {
                sshagent(['OCI_SSH_KEY']) {
                    sh """
                        mkdir -p ~/.ssh
                        ssh-keyscan -H ${OCI_HOST} >> ~/.ssh/known_hosts
                        scp suite_webapp_deployment.tar.gz ${OCI_USER}@${OCI_HOST}:/tmp/
                        scp jenkins/scripts/suite_webapp_deply.sh ${OCI_USER}@${OCI_HOST}:/tmp/
                        echo "suite_webapp files transferred successfully"
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // Transfer Files — awaremagnus
        // ─────────────────────────────────────────────────────────────────────
        stage('Transfer Files — awaremagnus') {
            // when { expression { env.DEPLOY_AWAREMAGNUS == 'true' } }
            steps {
                sshagent(['OCI_SSH_KEY']) {
                    sh """
                        mkdir -p ~/.ssh
                        ssh-keyscan -H ${OCI_HOST} >> ~/.ssh/known_hosts
                        scp awaremagnus_deployment.tar.gz ${OCI_USER}@${OCI_HOST}:/tmp/
                        scp jenkins/scripts/awaremagnus_deply.sh ${OCI_USER}@${OCI_HOST}:/tmp/
                        echo "awaremagnus files transferred successfully"
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // Setup OCI Server — Install Node.js and PM2
        // ─────────────────────────────────────────────────────────────────────
        stage('Setup OCI Server') {
            steps {
                sshagent(['OCI_SSH_KEY']) {
                    sh """
                        ssh ${OCI_USER}@${OCI_HOST} "
                            set -e

                            if [ ! -d \\\$HOME/.nvm ]; then
                                curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash
                            fi

                            export NVM_DIR=\\\$HOME/.nvm
                            . \\\$NVM_DIR/nvm.sh

                            if ! node --version 2>/dev/null | grep -q ${NODE_VERSION}; then
                                nvm install ${NODE_VERSION}
                                nvm alias default ${NODE_VERSION}
                            fi

                            if ! command -v pm2 &>/dev/null; then
                                npm install -g pm2
                            fi

                            echo 'Node: '\\\$(node --version)
                            echo 'PM2 : '\\\$(pm2 --version)
                        "
                    """
                }
            }
        }

        // ═════════════════════════════════════════════════════════════════════
        // suite_webapp deployment
        // ═════════════════════════════════════════════════════════════════════
        stage('Deploy suite_webapp') {
            // when { expression { env.DEPLOY_WEBAPP == 'true' } }
            steps {
                sshagent(['OCI_SSH_KEY']) {
                    sh """
                        ssh ${OCI_USER}@${OCI_HOST} "
                            chmod +x /tmp/suite_webapp_deply.sh
                            REDIS_URL='${REDIS_URL}' \
                            REDIS_SERVER_IP='${REDIS_SERVER_IP}' \
                            REDIS_SERVER_PORT='${REDIS_SERVER_PORT}' \
                            REDIS_SESSION_SECRET_KEY='${REDIS_SESSION_SECRET_KEY}' \
                            /tmp/suite_webapp_deply.sh
                        "
                    """
                }
            }
        }

        // ═════════════════════════════════════════════════════════════════════
        // awaremagnus deployment
        // ═════════════════════════════════════════════════════════════════════
        stage('Deploy awaremagnus') {
            // when { expression { env.DEPLOY_AWAREMAGNUS == 'true' } }
            steps {
                sshagent(['OCI_SSH_KEY']) {
                    sh """
                        ssh ${OCI_USER}@${OCI_HOST} "
                            chmod +x /tmp/awaremagnus_deply.sh
                            AWAREMAGNUS_API_URL='${AWAREMAGNUS_API_URL}' \
                            AWAREMAGNUS_PORT='${AWAREMAGNUS_PORT}' \
                            NEXT_PUBLIC_SERVICE_AWM_URL='${NEXT_PUBLIC_SERVICE_AWM_URL}' \
                            NEXT_PUBLIC_SERVICE_SUITE_URL='${NEXT_PUBLIC_SERVICE_SUITE_URL}' \
                            NEXT_PUBLIC_SUITE_WEBAPP_URL='${NEXT_PUBLIC_SUITE_WEBAPP_URL}' \
                            /tmp/awaremagnus_deply.sh
                        "
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // Health Check
        // ─────────────────────────────────────────────────────────────────────
        stage('Health Check') {
            steps {
                sshagent(['OCI_SSH_KEY']) {
                    script {
                        echo "Waiting for services to start..."
                        sh 'sleep 30'

                        def webappPassed = false
                        for (int i = 1; i <= 5; i++) {
                            def status = sh(
                                script: "ssh ${OCI_USER}@${OCI_HOST} 'curl -sf http://localhost:8000/health'",
                                returnStatus: true
                            )
                            if (status == 0) { webappPassed = true; echo "suite_webapp passed on attempt ${i}"; break }
                            echo "suite_webapp attempt ${i}/5 failed — retrying in 10s..."
                            sh 'sleep 10'
                        }

                        def awmPassed = false
                        for (int i = 1; i <= 6; i++) {
                            def status = sh(
                                script: "ssh ${OCI_USER}@${OCI_HOST} 'curl -sf http://localhost:8001/awm'",
                                returnStatus: true
                            )
                            if (status == 0) { awmPassed = true; echo "awaremagnus passed on attempt ${i}"; break }
                            echo "awaremagnus attempt ${i}/6 failed — retrying in 15s..."
                            sh 'sleep 15'
                        }

                        if (!webappPassed) {
                            sh "ssh ${OCI_USER}@${OCI_HOST} 'pm2 logs suite_webapp --nostream --lines 50' || true"
                            error("suite_webapp health check failed")
                        }
                        if (!awmPassed) {
                            sh "ssh ${OCI_USER}@${OCI_HOST} 'pm2 logs awaremagnus --nostream --lines 50' || true"
                            error("awaremagnus health check failed")
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo """
            ==========================================
            Deployment completed successfully!
            Build   : #${env.BUILD_NUMBER}
            Commit  : ${env.COMMIT_SHA}
            Message : ${env.COMMIT_MESSAGE}
            ==========================================
            """
        }
        failure {
            echo "Deployment failed!"
            sshagent(['OCI_SSH_KEY']) {
                sh """
                    ssh ${OCI_USER}@${OCI_HOST} '
                        pm2 list || true
                        pm2 logs suite_webapp --nostream --lines 30 || true
                        pm2 logs awaremagnus --nostream --lines 30 || true
                    ' || true
                """
            }
        }
        always {
            echo "Pipeline finished: ${currentBuild.currentResult}"
            cleanWs()
        }
    }
}