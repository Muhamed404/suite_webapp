<!-- Delete Confirmation Modal -->
<div id="deleteDomainModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/40 backdrop-blur-sm">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 overflow-hidden">
    <div class="flex items-center gap-3 px-6 py-5 border-b border-gray-100">
      <div class="flex items-center justify-center w-10 h-10 rounded-full bg-red-100 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m2 0H7m4-3h2a1 1 0 011 1v1H9V5a1 1 0 011-1h2z"/>
        </svg>
      </div>
      <div>
        <h3 class="text-base font-semibold text-gray-800"><%= __('org_domain.delete_modal_title') %></h3>
        <p class="text-xs text-gray-400 mt-0.5"><%= __('org_domain.delete_modal_subtitle') %></p>
      </div>
    </div>
    <div class="px-6 py-5">
      <p class="text-sm text-gray-600"><%= __('org_domain.confirm_delete') %></p>
      <p class="text-sm font-semibold text-gray-800 mt-1" id="deleteDomainName"></p>
    </div>
    <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-100">
      <button type="button" id="cancelDomainDelete"
        class="px-5 py-2 rounded-lg text-sm font-medium text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors">
        <%= __('generic_label.cancel') %>
      </button>
      <a id="confirmDomainDelete" href="#"
        class="px-5 py-2 rounded-lg text-sm font-semibold text-white bg-red-500 hover:bg-red-600 transition-colors">
        <%= __('generic_label.delete') %>
      </a>
    </div>
  </div>
</div>
