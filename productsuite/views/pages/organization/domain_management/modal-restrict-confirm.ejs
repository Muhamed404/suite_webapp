<!-- Domain Restriction Confirmation Modal -->
<div id="restrictConfirmModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/40 backdrop-blur-sm">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4 overflow-hidden">
    <div class="flex items-center gap-3 px-6 py-5 border-b border-gray-100">
      <div id="restrictConfirmIcon" class="flex items-center justify-center w-10 h-10 rounded-full shrink-0">
        <!-- icon injected by JS -->
      </div>
      <div>
        <h3 id="restrictConfirmTitle" class="text-base font-semibold text-gray-800"></h3>
        <p id="restrictConfirmSubtitle" class="text-xs text-gray-400 mt-0.5"></p>
      </div>
    </div>
    <div class="px-6 py-5">
      <p id="restrictConfirmBody" class="text-sm text-gray-600"></p>
    </div>
    <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-100">
      <button type="button" onclick="closeRestrictConfirm()"
        class="px-5 py-2 rounded-lg text-sm font-medium text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors">
        <%= __('generic_label.cancel') %>
      </button>
      <a id="restrictConfirmAction" href="#"
        class="px-5 py-2 rounded-lg text-sm font-semibold text-white transition-colors">
        <%= __('generic_label.confirm') %>
      </a>
    </div>
  </div>
</div>

<script>
  var i18nRestrict = {
    enableTitle:    "<%= __('org_domain.restrict_confirm_enable_title') %>",
    enableSubtitle: "<%= __('org_domain.restrict_confirm_enable_subtitle') %>",
    enableBody:     "<%= __('org_domain.restrict_confirm_enable_body') %>",
    disableTitle:    "<%= __('org_domain.restrict_confirm_disable_title') %>",
    disableSubtitle: "<%= __('org_domain.restrict_confirm_disable_subtitle') %>",
    disableBody:     "<%= __('org_domain.restrict_confirm_disable_body') %>"
  };

  function openRestrictConfirm(url, enabling) {
    document.getElementById('restrictConfirmAction').href = url;

    var icon   = document.getElementById('restrictConfirmIcon');
    var title  = document.getElementById('restrictConfirmTitle');
    var sub    = document.getElementById('restrictConfirmSubtitle');
    var body   = document.getElementById('restrictConfirmBody');
    var btn    = document.getElementById('restrictConfirmAction');

    if (enabling) {
      icon.className  = 'flex items-center justify-center w-10 h-10 rounded-full shrink-0 bg-teal-100';
      icon.innerHTML  = '<svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
      title.textContent = i18nRestrict.enableTitle;
      sub.textContent   = i18nRestrict.enableSubtitle;
      body.textContent  = i18nRestrict.enableBody;
      btn.className     = 'px-5 py-2 rounded-lg text-sm font-semibold text-white bg-teal-600 hover:bg-teal-700 transition-colors';
    } else {
      icon.className  = 'flex items-center justify-center w-10 h-10 rounded-full shrink-0 bg-amber-100';
      icon.innerHTML  = '<svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>';
      title.textContent = i18nRestrict.disableTitle;
      sub.textContent   = i18nRestrict.disableSubtitle;
      body.textContent  = i18nRestrict.disableBody;
      btn.className     = 'px-5 py-2 rounded-lg text-sm font-semibold text-white bg-amber-500 hover:bg-amber-600 transition-colors';
    }

    document.getElementById('restrictConfirmModal').classList.remove('hidden');
  }

  function closeRestrictConfirm() {
    document.getElementById('restrictConfirmModal').classList.add('hidden');
  }

  document.getElementById('restrictConfirmModal').addEventListener('click', function (e) {
    if (e.target === this) closeRestrictConfirm();
  });
</script>
