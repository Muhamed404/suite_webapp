<div class="flex flex-col p-6 pb-4">
  <div class="flex flex-col gap-2 mb-4 border-b border-gray-100 pb-4">
    <nav class="flex items-center text-[1rem] text-gray-500 gap-2" aria-label="Breadcrumb">
      <a href="/home" class="hover:text-gray-700 transition"><%= __('breadcrumbs.home') %></a>
      <span class="text-gray-400">›</span>
      <a href="/organization/" class="hover:text-gray-700 transition"><%= __('breadcrumbs.organization') %></a>
      <span class="text-gray-400">›</span>
      <a href="/organization/profile/<%= orgId %>" class="hover:text-gray-700 transition"><%= orgName %></a>
      <span class="text-gray-400">›</span>
      <span class="font-semibold text-gray-900"><%= __('org_domain.breadcrumb') %></span>
    </nav>
    <h3 class="text-3xl font-medium text-gray-900"><%= __('org_domain.title') %></h3>
    <p class="text-sm text-gray-500"><%= __('org_domain.subtitle') %></p>
  </div>
</div>

<div class="flex flex-col px-6 pb-6 gap-4">

  <!-- Configuration Card -->
  <div class="rounded-2xl bg-white border border-gray-100 shadow-sm overflow-hidden">
    <div class="flex items-center gap-2 px-6 py-3 border-b border-gray-100 bg-gray-50">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= __('org_domain.config_section') %></span>
    </div>
    <div class="flex items-center justify-between px-6 py-4">
      <div class="flex items-center gap-4">
        <div class="flex items-center justify-center w-10 h-10 rounded-xl <%= domainRestriction ? 'bg-teal-50' : 'bg-gray-100' %> shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 <%= domainRestriction ? 'text-teal-600' : 'text-gray-400' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-800"><%= __('org_domain.label_domain_restrict') %></p>
          <p class="text-xs text-gray-400 mt-0.5"><%= __('org_domain.desc_domain_restrict') %></p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <% if (domainRestriction) { %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-teal-100 text-teal-700">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-500 inline-block"></span>
            <%= __('generic_label.active') %>
          </span>
          <button type="button"
            onclick="openRestrictConfirm('/dms/restrict/<%= orgId %>/0?On=<%= encodeURIComponent(orgName) %>', false)"
            class="px-4 py-1.5 rounded-lg text-xs font-semibold border border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-gray-300 transition-colors">
            <%= __('org_domain.btn_disable_restrict') %>
          </button>
        <% } else { %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-500">
            <span class="w-1.5 h-1.5 rounded-full bg-gray-400 inline-block"></span>
            <%= __('generic_label.inactive') %>
          </span>
          <button type="button"
            onclick="openRestrictConfirm('/dms/restrict/<%= orgId %>/1?On=<%= encodeURIComponent(orgName) %>', true)"
            class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-teal-600 text-white hover:bg-teal-700 transition-colors">
            <%= __('org_domain.btn_enable_restrict') %>
          </button>
          <% } %>
      </div>
    </div>
  </div>

  <!-- Domains Table Card -->
  <div class="flex flex-col rounded-3xl bg-white border border-gray-100 shadow-sm">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
      <span class="text-sm px-3 py-1 rounded-full font-medium" style="background:#eff6ff;color:#2563eb">
        <%= pagination.count %> <%= __('org_domain.total') %>
      </span>
      <button type="button" onclick="openAddModal()"
        class="flex items-center justify-center gap-2 px-4 py-2 rounded-full bg-teal-600 text-white text-sm font-semibold shadow hover:bg-teal-700 transition-all duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="12" cy="12" r="10" stroke-width="2" fill="none"/>
          <path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 8v8m-4-4h8"/>
        </svg>
        <span><%= __('org_domain.btn_add') %></span>
      </button>
    </div>
    <div class="p-6">
      <table class="min-w-full border-none text-sm text-left text-gray-700">
        <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
          <tr>
            <th class="px-4 py-3 font-medium">#</th>
            <th class="px-4 py-3 font-medium"><%= __('org_domain.col_domain_name') %></th>
            <th class="px-4 py-3 font-medium"><%= __('org_domain.col_status') %></th>
            <th class="px-4 py-3 font-medium"><%= __('org_domain.col_created_at') %></th>
            <th class="px-4 py-3 font-medium"><%= __('generic_label.action') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% if (domains && domains.length > 0) { domains.forEach(function(domain, index) { %>
            <tr class="bg-white hover:bg-gray-50 transition-colors duration-150">
              <td class="px-4 py-3 text-gray-400 font-medium"><%= index + 1 %></td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                  </svg>
                  <span class="font-medium text-gray-800"><%= domain.domain_name %></span>
                </div>
              </td>
              <td class="px-4 py-3">
                <% if (domain.is_active) { %>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-teal-100 text-teal-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-teal-500 inline-block"></span>
                    <%= __('generic_label.active') %>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-500">
                    <span class="w-1.5 h-1.5 rounded-full bg-gray-400 inline-block"></span>
                    <%= __('generic_label.inactive') %>
                  </span>
                <% } %>
              </td>
              <td class="px-4 py-3 text-gray-500 whitespace-nowrap">
                <%= domain.creation_time
                    ? new Date(domain.creation_time).toLocaleDateString([], { year: 'numeric', month: 'short', day: '2-digit' })
                    : '—' %>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <button type="button"
                    class="edit-domain-btn text-teal-600 hover:text-teal-800 font-medium transition-colors duration-150 text-sm"
                    data-id="<%= domain.id %>"
                    data-domain-name="<%= domain.domain_name %>"
                    data-is-active="<%= domain.is_active %>">
                    <%= __('generic_label.edit') %>
                  </button>
                  <span class="text-gray-300">|</span>
                  <button type="button"
                    class="delete-domain-btn text-red-500 hover:text-red-700 font-medium transition-colors duration-150 text-sm"
                    data-delete-url="/dms/delete/<%=orgId%>/organization/<%= domain.id %>/domain"
                    data-domain-name="<%= domain.domain_name %>">
                    <%= __('generic_label.delete') %>
                  </button>
                </div>
              </td>
            </tr>
          <% }); } else { %>
            <tr>
              <td colspan="5" class="px-4 py-10 text-center text-gray-400">
                <svg class="w-10 h-10 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
                <p class="text-sm font-medium"><%= __('org_domain.no_records') %></p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (pagination.totalPages > 1) { %>
      <div class="flex items-center justify-between px-6 py-3 border-t border-gray-100">
        <span class="text-xs text-gray-500">
          <%= __('generic_label.page') %> <%= pagination.currentPage %> <%= __('generic_label.of') %> <%= pagination.totalPages %>
        </span>
        <div class="flex gap-2">
          <% if (pagination.currentPage > 1) { %>
            <a href="?page=<%= pagination.currentPage - 1 %>&pageSize=<%= pagination.pageSize %>"
               class="px-3 py-1.5 text-xs rounded-lg font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
              <%= __('generic_label.previous') %>
            </a>
          <% } %>
          <% if (pagination.currentPage < pagination.totalPages) { %>
            <a href="?page=<%= pagination.currentPage + 1 %>&pageSize=<%= pagination.pageSize %>"
               class="px-3 py-1.5 text-xs rounded-lg font-medium text-white transition-colors" style="background:#2563eb">
              <%= __('generic_label.next') %>
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('./modal-add-domain.ejs') %>

<%- include('./modal-edit-domain.ejs') %>

<%- include('./modal-delete-domain.ejs') %>

<%- include('./modal-restrict-confirm.ejs') %>

<script
  data-domain-list
  data-i18n-active="<%= __('generic_label.active') %>"
  data-i18n-inactive="<%= __('generic_label.inactive') %>"
  src="/securemagnus_2025/js/custom_script/domain-management-list.js">
</script>
