<% const isArabic = (locals.locale || (typeof locale !== 'undefined' ? locale : 'en')) === 'ar'; %>
<section>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                        <%= __("organization.edit.labelAdminEmail") %> <span class="text-red-500">*</span>
      </label>
      <input
        id="email"
        name="email"
        type="email"
        value="<%=organizationDetails.email%>"
        class="block w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-teal-500"
        required
      />
    </div>
    <div>
      <label for="firstName" class="block text-sm font-medium text-gray-700 mb-2">
        <%= __("organization.edit.labelAdminFirstName") %> <span class="text-red-500">*</span>
      </label>
      <input
        id="firstName"
        name="firstName"
        type="text"
        value="<%=organizationDetails.first_name%>"
        class="block w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-teal-500"
        required
      />
    </div>
    <div>
      <label for="lastName" class="block text-sm font-medium text-gray-700 mb-2">
        <%= __("organization.edit.labelAdminLastName") %> <span class="text-red-500">*</span>
      </label>
      <input
        id="lastName"
        name="lastName"
        type="text"
        value="<%=organizationDetails.last_name%>"
        class="block w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-teal-500"
        required
      />
    </div>
    <div>
      <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
        <%= __("organization.edit.labelAdminPassword") %>
      </label>
      <div class="relative">
        <input
          id="password"
          name="password"
          type="password"
          value=""
          minlength="8"
          class="block w-full rounded-lg border border-gray-300 <%= isArabic ? 'pl-10' : 'pr-10' %> px-4 py-2 focus:outline-none focus:ring-2 focus:ring-teal-500"
        />
        <button
          type="button"
          id="toggleEditOrganizationPassword"
          class="absolute inset-y-0 <%= isArabic ? 'left-3' : 'right-3' %> flex items-center text-gray-500 hover:text-[var(--teal)] transition-colors duration-200"
          aria-label="Show password"
          aria-pressed="false"
        >
          <svg id="toggleEditOrganizationPasswordIconEye" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          <svg id="toggleEditOrganizationPasswordIconEyeOff" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20C5 20 1 12 1 12a21.77 21.77 0 0 1 5.06-6.94"></path>
            <path d="M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.9 21.9 0 0 1-3.17 4.83"></path>
            <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
            <line x1="1" y1="1" x2="23" y2="23"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div class="mt-4">
    <label class="block text-xs text-gray-500">
      <%= __("organization.edit.mandatory") %>
    </label>
  </div>
</section>

<script>
  (function () {
    var toggleBtn = document.getElementById('toggleEditOrganizationPassword');
    var passwordInput = document.getElementById('password');
    var eyeIcon = document.getElementById('toggleEditOrganizationPasswordIconEye');
    var eyeOffIcon = document.getElementById('toggleEditOrganizationPasswordIconEyeOff');
    if (!toggleBtn || !passwordInput || !eyeIcon || !eyeOffIcon) return;

    toggleBtn.addEventListener('click', function () {
      var isHidden = passwordInput.type === 'password';
      passwordInput.type = isHidden ? 'text' : 'password';
      eyeIcon.classList.toggle('hidden', isHidden);
      eyeOffIcon.classList.toggle('hidden', !isHidden);
      toggleBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
      toggleBtn.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
    });
  })();
</script>