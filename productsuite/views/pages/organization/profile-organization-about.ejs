<div class="bg-white rounded-3xl max-w-2xl w-full mt-3 p-8 relative">
  <!-- Header with Edit Profile Button on the right -->
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-2xl font-semibold text-[var(--mainblue)]">
      <%= __("organization.profile.tabInfo.labelAdminInformation") %>
    </h2>
    <a href="/organization/edit/<%= profile.id %>"
       class="px-4 py-2 rounded-full bg-teal-600 text-white font-semibold shadow hover:bg-teal-700 transition flex items-center"
       title="<%= __('organization.profile.tabInfo.btnEditProfile') %>">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M15.232 5.232l3.536 3.536M9 13l6.536-6.536a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-2.828 0L9 13z" />
      </svg>
    </a>
  </div>

  <!-- Admin Information -->
  <div class="border-b border-black/5 pb-4 mb-6">
    <div class="flex flex-col md:flex-row gap-10">
      <div>
        <span class="block text-xs text-gray-500 mb-2"><%= __("organization.profile.tabInfo.labelAdminFullName") %></span>
        <span class="text-base text-[var(--mainblue)]">
          <%= profile.UserProfile[0].first_name %>
          <%= profile.UserProfile[0].last_name %>
        </span>
      </div>
      <div>
        <span class="block text-xs text-gray-500 mb-2">
         <%= __("organization.profile.tabInfo.labelAdminEmail") %>
        </span>
        <span class="text-base text-[var(--mainblue)]">
          <%= profile.UserProfile[0].email %>
        </span>
      </div>
      <div>
        <span class="block text-xs text-gray-500 mb-2">
          <%= __("organization.profile.tabInfo.labelAdminContact") %>
        </span>
        <span class="text-base text-[var(--mainblue)]"><%= profile.UserProfile[0].contact %></span>
      </div>
    </div>
  </div>
  <!-- Organization Information -->
  <div>
    <h2 class="text-2xl font-semibold text-[var(--mainblue)] mb-8"><%= __("organization.profile.tabInfo.labelOrganizationInformation") %></h2>
    <div class="flex flex-col md:flex-row gap-10">
      <div>
        <span class="block text-xs text-gray-500 mb-2"><%= __("organization.profile.tabInfo.labelName") %></span>
        <span class="text-base text-[var(--mainblue)]">
          <%=profile.name%>
        </span>
      </div>
      <div>
        <span class="block text-xs text-gray-500 mb-2">
          <%= __("organization.profile.tabInfo.labelCountry") %>
        </span>
        <span class="text-base text-[var(--mainblue)]">
          <%=profile.Country.name%>
        </span>
      </div>
      <div>
        <span class="block text-xs text-gray-500 mb-2">
         <%= __("organization.profile.tabInfo.labelState") %>
        </span>
        <span class="text-base text-[var(--mainblue)]">
          <%=profile.State.name%>
        </span>
      </div>
      <div>
        <span class="block text-xs text-gray-500 mb-2">
          <%= __("organization.profile.tabInfo.labelCity") %>
        </span>
        <span class="text-base text-[var(--mainblue)]">
          <%=profile.City.name%>
        </span>
      </div>
    </div>
  </div>
</div>

