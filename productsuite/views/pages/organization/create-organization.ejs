<% const isArabic = (locals.locale || (typeof locale !== 'undefined' ? locale : 'en')) === 'ar'; %>
<div class="flex flex-col  p-6">
  <div class="flex flex-col gap-2 mb-4 border-b border-gray-100 pb-4">
    <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0" aria-label="Breadcrumb">
      <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
      <span class="text-gray-400">›</span>
      <a href="/organization/" class="hover:text-gray-700 transition"><%= __("breadcrumbs.organization") %></a>
      <span class="text-gray-400">›</span>
      <span class="font-semibold text-gray-900"><%= __("breadcrumbs.organizationCreate") %></span>
    </nav>
    <h3 class="text-3xl font-medium text-gray-900">
      <%= __("breadcrumbs.organizationCreate") %>
    </h3>
  </div>

  <!-- first section  -->

  <div class="flex flex-col h-[75vh] gap-4 mt-3 rounded-3xl bg-white">

    <div class="bg-white  w-full mt-3 p-8">

      <!-- Stepper Navigation -->
      <div id="stepper" class="flex items-center justify-between mb-10">
        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-teal-500 text-white font-bold text-xs">
            1</div>
          <span class="font-medium step-label text-teal-700 text-sm"><%= __("organization.create.stepper1") %></span>
        </div>
        <div class="flex-1 h-0.5 bg-teal-100 mx-2"></div>
        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-white border-2 border-teal-300 text-teal-400 font-bold text-xs">
            2</div>
          <span class="font-medium step-label text-gray-400 text-sm"><%= __("organization.create.stepper2") %></span>
        </div>
      </div>

      <div id="steps">
        <div class="step fade-enter-active">
          
          <!-- Main Form -->
          <form name="createOrganization" id="createOrganization" class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start" 
          action="/organization/" method="post">
            <!-- Left Side: App/License/Duration -->
            <div class="flex flex-col gap-6">
              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("organization.create.labelOrgName") %> *</label>
                <input placeholder="<%= __('organization.create.placeholderOrgName') %>" type="text" value="" id="name" name="name"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
              </div>
              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("organization.create.labelOrgAddress") %> *</label>
                <input placeholder="<%= __('organization.create.placeholderOrgAddress') %>" type="text" value="" id="address" name="address"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
              </div>

              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("organization.create.labelOrgPostalCode") %> *</label>
                <input placeholder="<%= __('organization.create.placeholderOrgPostalCode') %>" type="text" value=""
                  oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value.startsWith('-')) this.value = this.value.substr(1);"
                  min="1" id="postalCode" name="postalCode"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
              </div>

              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("organization.create.labelOrgContactNumber") %> *</label>
                <input placeholder="<%= __('organization.create.placeholderOrgContactNumber') %>"
                  oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value.startsWith('-')) this.value = this.value.substr(1);"
                  min="1" id="contact" name="contact" type="text" value=""
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
              </div>
            </div>

            <!-- Right Side: Package/Start Date -->
            <div class="flex flex-col gap-6">
              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("organization.create.labelOrgCountry") %> *</label>
                <select name="country" id="country"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-white">
                  <option value="">
                    <%= __("organization.create.optionOrgSelectCountry") %>
                  </option>
                  <% countries.forEach(c=> { %>
                    <option value="<%= c.id %>">
                      <%= c.name %>
                    </option>
                    <% }); %>
                </select>
              </div>
              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("organization.create.labelOrgState") %> *</label>
                <select name="state" id="state"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-white">

                  <option value="" selected disabled>
                    <%= __("organization.create.optionOrgSelectState") %>
                  </option>
                </select>
              </div>

              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("organization.create.labelOrgCity") %> *</label>
                <select name="city" id="city"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-white">
                  <option value="" selected disabled>
                    <%= __("organization.create.optionOrgSelectCity") %>
                  </option>
                </select>
              </div>
            </div>
          <!-- </form> -->
        </div>





        <!-- 2nd -->

        <div class="step hidden">
             <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
            <div class="flex flex-col gap-6">
              <div>
                <label class="block text-gray-700 font-medium mb-3">
                  <%= __("organization.create.labelAdminFirstName") %> *
                </label>
                <input type="text" value="" id="firstName" name="firstName"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
              </div>
              <div>
                <label class="block text-gray-700 font-medium mb-3">
                  <%= __("organization.create.labelAdminEmail") %> *
                </label>
                <input type="email" value="" id="email" name="email"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
              </div>
              <div>
                <label class="block text-gray-700 font-medium mb-3">
                  <%= __("organization.create.labelDomainRestrict") %>
                </label>
                <div class="flex items-center gap-3">
                  <input type="hidden" name="domain_restrict" id="domain_restrict" value="1" />
                  <button type="button" id="domainRestrictToggle"
                    onclick="toggleDomainRestrict()"
                    class="relative inline-flex items-center w-12 h-6 rounded-full transition-colors duration-200 focus:outline-none bg-teal-500">
                    <span id="domainRestrictThumb"
                      class="inline-block w-5 h-5 bg-white rounded-full shadow transform transition-transform duration-200 translate-x-6"></span>
                  </button>
                  <span id="domainRestrictLabel" class="text-sm font-medium text-teal-600">
                    <%= __("generic_label.active") %>
                  </span>
                </div>
              </div>


            </div>

            <!-- Right Side: Package/Start Date -->
            <div class="flex flex-col gap-6">
              <div>
                <label class="block text-gray-700 font-medium mb-3">
                  <%= __("organization.create.labelAdminLastName") %> *
                </label>
                <input type="text" value="" id="lastName" name="lastName"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
              </div>

              <div>
                <label class="block text-gray-700 font-medium mb-3">
                  <%= __("organization.create.labelAdminPassword") %> *
                </label>
                <div class="relative h-10">
                  <input type="password" value="" id="password" name="password"
                    class="w-full <%= isArabic ? 'pl-10' : 'pr-10' %> px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
                  <button type="button" id="toggleOrganizationPassword"
                    class="absolute inset-y-0 <%= isArabic ? 'left-3' : 'right-3' %> flex items-center text-gray-500 hover:text-[var(--teal)] transition-colors duration-200"
                    aria-label="Show password"
                    aria-pressed="false">
                    <svg id="toggleOrganizationPasswordIconEye" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg id="toggleOrganizationPasswordIconEyeOff" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20C5 20 1 12 1 12a21.77 21.77 0 0 1 5.06-6.94"></path>
                      <path d="M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.9 21.9 0 0 1-3.17 4.83"></path>
                      <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                      <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
            </div>

          </form>
        </div>
      </div>
      <!-- Buttons -->
      <div class="flex justify-end gap-4 mt-10">
        <button id="backBtn" type="button"
          class="px-8 py-2 rounded-lg bg-gray-100 text-gray-600 font-medium border hover:border-gray-300 transition"><%= __("organization.create.btnBack") %></button>
        <button id="nextBtn" type="submit"
          class="px-8 py-2 rounded-lg bg-[var(--teal)] text-white font-semibold hover:bg-teal-500 transition"><%= __("organization.create.btnNext") %></button>
      </div>

    </div>

  </div>

</div>
<script src="/securemagnus_2025/js/form_stepper.js"></script>
<script>
  window.i18n = {
    labels: {
      next: "<%= __('organization.create.btnNext') %>",
      finish: "<%= __('organization.create.btnFinish') %>"
    }
  };

  function toggleDomainRestrict() {
    var input   = document.getElementById('domain_restrict');
    var toggle  = document.getElementById('domainRestrictToggle');
    var thumb   = document.getElementById('domainRestrictThumb');
    var label   = document.getElementById('domainRestrictLabel');
    var active  = input.value === '1';

    if (active) {
      input.value = '0';
      toggle.classList.replace('bg-teal-500', 'bg-gray-300');
      thumb.classList.replace('translate-x-6', 'translate-x-1');
      label.textContent = "<%= __('generic_label.inactive') %>";
      label.classList.replace('text-teal-600', 'text-gray-400');
    } else {
      input.value = '1';
      toggle.classList.replace('bg-gray-300', 'bg-teal-500');
      thumb.classList.replace('translate-x-1', 'translate-x-6');
      label.textContent = "<%= __('generic_label.active') %>";
      label.classList.replace('text-gray-400', 'text-teal-600');
    }
  }

  (function () {
    var toggleBtn = document.getElementById('toggleOrganizationPassword');
    var passwordInput = document.getElementById('password');
    var eyeIcon = document.getElementById('toggleOrganizationPasswordIconEye');
    var eyeOffIcon = document.getElementById('toggleOrganizationPasswordIconEyeOff');
    if (!toggleBtn || !passwordInput || !eyeIcon || !eyeOffIcon) return;

    toggleBtn.addEventListener('click', function () {
      var isHidden = passwordInput.type === 'password';
      passwordInput.type = isHidden ? 'text' : 'password';
      eyeIcon.classList.toggle('hidden', isHidden);
      eyeOffIcon.classList.toggle('hidden', !isHidden);
      toggleBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
      toggleBtn.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
    });
  })();

  window.organizationValidationMessages = {
    name: "<%= __('organization.create.validationOrgNameRequired') %>",
    address: "<%= __('organization.create.validationOrgAddressRequired') %>",
    postalCode: "<%= __('organization.create.validationOrgPostalCodeRequired') %>",
    contact: "<%= __('organization.create.validationOrgContactRequired') %>",
    country: "<%= __('organization.create.validationOrgCountryRequired') %>",
    state: "<%= __('organization.create.validationOrgStateRequired') %>",
    city: "<%= __('organization.create.validationOrgCityRequired') %>",
    firstName: "<%= __('organization.create.validationAdminFirstNameRequired') %>",
    lastName: "<%= __('organization.create.validationAdminLastNameRequired') %>",
    email: "<%= __('organization.create.validationAdminEmailRequired') %>",
    password: "<%= __('organization.create.validationAdminPasswordRequired') %>",
    nameTaken: "<%= __('organization.create.validationOrgNameTaken') %>",
    emailTaken: "<%= __('organization.create.validationEmailTaken') %>",
  };
</script>
<script src="/securemagnus_2025/js/custom_script/create-organization-validation.js"></script>
