<div class="flex flex-col h-[75vh] gap-4 mt-3 rounded-3xl bg-white">

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 rounded-3xl p-6 bg-white">
    <!-- Departments -->
    <%if(magnusAdmin===false) {%>
    <a href="/department/list/<%= profile.id %>?On=<%- encodeURIComponent(profile.name || '') %>"
      class="flex items-center justify-between bg-[#F1F5F8] rounded-full px-4 py-3 cursor-pointer hover:bg-gray-200 transition">
      <div class="flex items-center gap-3">
        <div><img src="/securemagnus_2025/images/departments.svg" alt="Departments"></div>
        <span class="text-gray-800 font-medium"><%= __("organization.profile.tabSettings.btnDepartment") %></span>
      </div>
      <span><img src="/securemagnus_2025/images/next.svg" alt="Next"></span>
    </a>
    <%}%>

    <!-- Group -->
    <%if(magnusAdmin===false) {%>
    <a href="/group/list/<%=profile.id%>?On=<%- encodeURIComponent(profile.name || '') %>"
      class="flex items-center justify-between bg-[#F1F5F8] rounded-full px-4 py-3 cursor-pointer hover:bg-gray-200 transition">
      <div class="flex items-center gap-3">
        <div><img src="/securemagnus_2025/images/group.svg" alt="Group"></div>
        <span class="text-gray-800 font-medium"><%= __("organization.profile.tabSettings.btnGroup") %></span>
      </div>
      <span><img src="/securemagnus_2025/images/next.svg" alt="Next"></span>
    </a>
    <%}%>
    <!-- Enroll User / View Users -->
    <a href="/user/suite-users/<%=profile.id%>"
      class="flex items-center justify-between bg-[#F1F5F8] rounded-full px-4 py-3 cursor-pointer hover:bg-gray-200 transition">
      <div class="flex items-center gap-3">
        <div><img src="/securemagnus_2025/images/enrollUser.svg" alt="<%= magnusAdmin ? 'View Users' : 'Enroll User' %>"></div>
        <span class="text-gray-800 font-medium">
          <%= __("organization.profile.tabSettings.btnUser") %>
        </span>
      </div>
      <span><img src="/securemagnus_2025/images/next.svg" alt="Next"></span>
    </a>
    <!-- SMTP Settings -->
    <a href="/settings/smtp/<%=profile.id%>?On=<%- encodeURIComponent(profile.name || '') %>"
      class="flex items-center justify-between bg-[#F1F5F8] rounded-full px-4 py-3 cursor-pointer hover:bg-gray-200 transition">
      <div class="flex items-center gap-3">
        <div><img src="/securemagnus_2025/images/SMTPSettings.svg" alt="SMTP Settings"></div>
        <span class="text-gray-800 font-medium"><%= __("organization.profile.tabSettings.btnSMTP") %></span>
      </div>
      <span><img src="/securemagnus_2025/images/next.svg" alt="Next"></span>
    </a>

    <!-- LDAP Settings -->
    <a href="/settings/ldap/<%=profile.id%>?On=<%- encodeURIComponent(profile.name || '') %>"
      class="flex items-center justify-between bg-[#F1F5F8] rounded-full px-4 py-3 cursor-pointer hover:bg-gray-200 transition">
      <div class="flex items-center gap-3">
        <div><img src="/securemagnus_2025/images/SMTPSettings.svg" alt="LDAP Settings"></div>
        <span class="text-gray-800 font-medium">LDAP Settings</span>
      </div>
      <span><img src="/securemagnus_2025/images/next.svg" alt="Next"></span>
    </a>
<%if(magnusAdmin===false) {%>

    <!-- Dashboard -->
    <a href="/suite/management/<%= profile.id %>"
      class="flex items-center justify-between bg-[#F1F5F8] rounded-full px-4 py-3 cursor-pointer hover:bg-gray-200 transition">
      <div class="flex items-center gap-3">
        <div><img src="/securemagnus_2025/images/dashboard.svg" alt="Dashboard"></div>
        <span class="text-gray-800 font-medium"><%= __("organization.profile.tabSettings.btnSuiteDashboard") %></span>
      </div>
      <span><img src="/securemagnus_2025/images/next.svg" alt="Next"></span>
    </a>
<%}%>
    
    <!-- Audit Log -->
    <a href="/audit/<%= profile.id %>?On=<%- encodeURIComponent(profile.name || '') %>"
      class="flex items-center justify-between bg-[#F1F5F8] rounded-full px-4 py-3 cursor-pointer hover:bg-gray-200 transition">
      <div class="flex items-center gap-3">
        <div><img src="/securemagnus_2025/images/champaignLog.svg" alt="Campaign Log"></div>
        <span class="text-gray-800 font-medium"> <%= __("organization.profile.tabSettings.btnAuditLog") %></span>
      </div>
      <span><img src="/securemagnus_2025/images/next.svg" alt="Next"></span>
    </a>

        <!-- Domain Management -->
    <a href="/dms/<%= profile.id %>/organization?On=<%= encodeURIComponent(profile.name || '') %>&dr=<%= profile.domain_restrict ? '1' : '0' %>"
      class="flex items-center justify-between bg-[#F1F5F8] rounded-full px-4 py-3 cursor-pointer hover:bg-gray-200 transition">
      <div class="flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
        </svg>
        <span class="text-gray-800 font-medium"><%= __("organization.profile.tabSettings.btnDomainManagement") %></span>
      </div>
      <span><img src="/securemagnus_2025/images/next.svg" alt="Next"></span>
    </a>

    <!-- SMS Settings -->
    <a href="/sms/settings/<%=profile.id%>?On=<%- encodeURIComponent(profile.name || '') %>"
      class="flex items-center justify-between bg-[#F1F5F8] rounded-full px-4 py-3 cursor-pointer hover:bg-gray-200 transition">
      <div class="flex items-center gap-3">
        <div><img src="/securemagnus_2025/images/SMTPSettings.svg" alt="SMS Settings"></div>
        <span class="text-gray-800 font-medium"><%= __("organization.profile.tabSettings.btnSMS") %></span>
      </div>
      <span><img src="/securemagnus_2025/images/next.svg" alt="Next"></span>
    </a>
    
  </div>  
</div>