<div class="flex flex-col p-6 gap">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div class="flex-1">
      <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0 mb-2" aria-label="Breadcrumb">
        <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
        <span class="text-gray-400">›</span>
        <span class="font-semibold text-gray-900"><%= __("breadcrumbs.organization") %></span>
      </nav>
      <h3 class="text-3xl font-medium">
        <%= __("organization.homescreen.title") %>
      </h3>
    </div>
    <div class="p-0 text-sm lg:order-3">
      <ul class="flex items-center gap-2">
        <!-- You can add tab/filter items here if needed -->
      </ul>
    </div>
    <% if(typeof hasCreateAccess !=='undefined' && hasCreateAccess){ %>
      <a href="/organization/create"
        class="flex items-center justify-center gap-2 px-5 py-2 rounded-full bg-teal-600 text-white font-semibold shadow hover:bg-teal-700 transition-all duration-200 border border-teal-600 hover:border-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-400 lg:order-2"
        title="<%= __('organization.homescreen.btnCreateOrganization') %>">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none" />
          <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            d="M12 8v8m-4-4h8" />
        </svg>
      </a>
    <%}%>
  </div>
</div>

<div class="flex flex-col  p-6 pt-0">
  <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white">
    <!-- Search & Filter -->
    <div class="flex flex-wrap items-center justify-between gap-3 px-5 pt-5">


      <table id="filter-table" class="min-w-full border-none  text-sm text-left text-gray-700">
        <thead class="bg-gray-50 text-gray-600  text-xs">
          <tr>

            <th class="px-6 py-5 text-sm font-medium">
              <img src="/securemagnus_2025/images/package_management/suitcase-work-job-document.svg" alt="Organization" class=" inline">&nbsp;
              <%= __("organization.homescreen.name") %>
                <img src="/securemagnus_2025/images/package_management/sort.svg" alt="License Cost"
                  class="size-3.5 ml-3 inline">
            </th>
            <th class="px-6 py-5 text-sm font-medium">
              <img src="/securemagnus_2025/images/Icon_Mail.svg" alt="Admin" class=" inline size-4 opacity-50">&nbsp;
              <%= __("organization.homescreen.adminName") %><img src="/securemagnus_2025/images/package_management/sort.svg"
                  alt="License Cost" class="size-3.5 ml-3 inline">
            </th>
            <th class="px-6 py-5 text-sm font-medium">
              <img src="/securemagnus_2025/images/package_management/Package_Management_Type.svg" alt="Type"
                class=" inline mr-2">
              <%= __("organization.homescreen.adminEmail") %>
                <span></span><img src="/securemagnus_2025/images/package_management/sort.svg" alt="License Cost"
                  class="size-3.5 ml-3 inline">
            </th>
            <th class="px-6 py-5 text-sm font-medium">
              <img src="/securemagnus_2025/images/package_management/package_management_per_license_cost.svg"
                alt="License Cost" class=" inline mr-2">
              <%= __("organization.homescreen.activeSubscription") %>
                <span class="text-sm font-normal"></span>
            </th>
            <th class="px-6 py-5 text-sm font-medium">
              <img src="/securemagnus_2025/images/package_management/package_management_user_range_form.svg"
                alt="User From" class=" inline mr-2">
              <%= __("organization.homescreen.pendingInvoice") %>

                <span class="text-sm font-normal"></span>
            </th>
            <th class="px-6 py-5 text-sm font-medium">
              <img src="/securemagnus_2025/images/package_management/package_management_user_range_to.svg" alt="User To"
                class=" inline mr-2">
              <%= __("organization.homescreen.cancelledInvoice") %>

                <span class="text-sm font-normal"></span>
            </th>
            <th class="px-6 py-5 text-sm font-medium">
              <img src="/securemagnus_2025/images/package_management/package_management_subscription_duration.svg"
                alt="Subscription" class=" inline mr-2">
              <%= __("organization.homescreen.subscriptionCancelled") %>

                <span class="text-sm font-normal"></span>
            </th>

            <th class="px-6 py-5 text-sm font-medium">
              <img src="/securemagnus_2025/images/package_management/package_management_subscription_duration.svg"
                alt="Subscription" class=" inline mr-2">
              <%= __("organization.homescreen.action") %>

                <span class="text-sm font-normal"></span>
            </th>


          </tr>
        </thead>
        <tbody>
          <% if (typeof organization !=='undefined' ){ organization.forEach(org=> { %>
            <tr class="bg-white border-b hover:bg-gray-50">
              <td class="px-6 py-6 whitespace-nowrap">
                <%= org.name %>

              </td>
              <% org.UserProfile.forEach(profile=> {
                if(profile.User.role_id == enums.OrgSuperAdmin || profile.User.role_id ==
                enums.MagSuperAdmin){
                %>

                <td class="px-6 py-6 whitespace-nowrap  ">
                  <%= profile.first_name %>
                    <%= profile.last_name %>
                </td>
                <td class="px-6 py-6 whitespace-nowrap  ">
                  <%= profile.email %>
                </td>
                <%}})%>
                  <td class="px-6 py-6 whitespace-nowrap  ">
                    <%= org.Subscriptions.Active %>
                  </td>
                  <td class="px-6 py-6 whitespace-nowrap  ">
                    <%= org.Subscriptions.PendingInvoice %>

                  </td>
                  <td class="px-6 py-6 whitespace-nowrap  ">
                    <%= org.Subscriptions.CancelledInvoice %>

                  </td>
                  <td class="px-6 py-6 whitespace-nowrap  ">
                    <%= org.Subscriptions.SubscriptionCancelled %>
                  </td>
                  <td class="px-6 py-6 whitespace-nowrap  ">
                    <a class="pill-btn blue" href="/organization/profile/<%= org.id%>"><%= __("organization.homescreen.btnViewDetails") %></a>

                  </td>


            </tr>
            <% }); }%>

        </tbody>
      </table>

    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (!document.getElementById('filter-table') || typeof simpleDatatables === 'undefined' || typeof simpleDatatables.DataTable === 'undefined') {
      console.warn('simple-datatables not found or table missing');
      return;
    }

    const dataTable = new simpleDatatables.DataTable('#filter-table', {
      sortable: true
    });
  });
</script>