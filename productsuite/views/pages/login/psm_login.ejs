<!DOCTYPE html>
<html lang="<%= locals.locale || 'en' %>" dir="<%= (locals.locale || 'en') === 'ar' ? 'rtl' : 'ltr' %>" translate="no" class="notranslate">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google" content="notranslate">
  <meta name="googlebot" content="notranslate">
  <title>Secure Magnus</title>


  <link rel="stylesheet" href="/securemagnus_2025/css/fonts.css">


  <script src="/securemagnus_2025/js/tailwind_3.js"></script>

  <style>
    .goog-te-banner-frame,
    iframe.goog-te-banner-frame,
    .goog-te-menu-frame,
    iframe.goog-te-menu-frame,
    .VIpgJd-ZVi9od-ORHb-OEVmcd,
    .VIpgJd-ZVi9od-l4eHX-hSRGPd,
    .VIpgJd-yAWNEb-L7lbkb,
    .VIpgJd-ZVi9od-aZ2wEe-wOHMyf,
    .VIpgJd-ZVi9od-aZ2wEe-OiiCO,
    .goog-te-balloon-frame,
    iframe.goog-te-balloon-frame,
    #goog-gt-tt,
    .goog-tooltip,
    .goog-text-highlight {
      display: none !important;
      visibility: hidden !important;
    }

    html,
    body {
      top: 0 !important;
      margin-top: 0 !important;
    }
  </style>

  <script>
    (function () {
      function hideTranslateUi() {
        var selectors = [
          '.goog-te-banner-frame',
          'iframe.goog-te-banner-frame',
          '.goog-te-menu-frame',
          'iframe.goog-te-menu-frame',
          '.VIpgJd-ZVi9od-ORHb-OEVmcd',
          '.VIpgJd-ZVi9od-l4eHX-hSRGPd',
          '.VIpgJd-yAWNEb-L7lbkb',
          '.VIpgJd-ZVi9od-aZ2wEe-wOHMyf',
          '.VIpgJd-ZVi9od-aZ2wEe-OiiCO',
          '.goog-te-balloon-frame',
          'iframe.goog-te-balloon-frame',
          '#goog-gt-tt',
          '.goog-tooltip',
          '.goog-text-highlight'
        ];

        selectors.forEach(function (selector) {
          document.querySelectorAll(selector).forEach(function (node) {
            node.style.setProperty('display', 'none', 'important');
            node.style.setProperty('visibility', 'hidden', 'important');
          });
        });

        document.documentElement.setAttribute('translate', 'no');
        document.documentElement.classList.add('notranslate');
        document.documentElement.style.setProperty('top', '0px', 'important');

        if (document.body) {
          document.body.setAttribute('translate', 'no');
          document.body.classList.add('notranslate');
          document.body.style.setProperty('top', '0px', 'important');
        }
      }

      hideTranslateUi();
      document.addEventListener('DOMContentLoaded', hideTranslateUi);
      window.addEventListener('load', hideTranslateUi);
      if (typeof MutationObserver !== 'undefined' && document.documentElement) {
        var observer = new MutationObserver(hideTranslateUi);
        observer.observe(document.documentElement, { childList: true, subtree: true });
      }
      setTimeout(hideTranslateUi, 500);
      setTimeout(hideTranslateUi, 1500);
      setInterval(hideTranslateUi, 3000);
    })();
  </script>

  <link rel="stylesheet" href="/securemagnus_2025/css/style.css">


</head>

<body class="bg-white notranslate" translate="no">


  <div class="grid grid-cols-12 min-h-screen">

    <!-- Login (Always Visible) -->
    <div class="flex flex-col justify-between  col-span-12 sm:col-span-6 h-screen lg:p-10 p-4">

      <!-- Header -->
      <div class="flex items-center justify-between ">
        <a href="">
          <img src="/securemagnus_2025/images/logo.svg" alt="">
        </a>


        <a href="?lang=en"
          class="rounded-full text-sm py-1.5 px-4 border border-[var(--teal)] hover:bg-[var(--teal)] hover:text-white transform duration-300">
          English
        </a> |
        <a href="?lang=ar"
          class="rounded-full text-sm py-1.5 px-4 border border-[var(--teal)] hover:bg-[var(--teal)] hover:text-white transform duration-300">
          العربية
        </a>

      </div>


      <!-- Login Form -->
      <form id="loginForm" action="/login<%= locals.locale ? ('?lang=' + locals.locale) : '' %>" method="POST">
        <input type="hidden" name="userTimezone" id="userTimezone">

        <div class="flex items-center justify-center">
          <div class="flex flex-col max-w-2xl items-stretch ">

            <h3 class="text-center text-4xl font-semibold md:mt-12 lg:mt-24"><%= __('generic_label.welcomeToSecureMagnus') %></h3>

            <!-- Alert Message -->
            <% if (locals.message) { %>
              <div class="mt-6 p-4 rounded-lg <%= locals.alertType === 'error' ? 'bg-red-50 border border-red-200' : 'bg-green-50 border border-green-200' %>">
                <p class="text-sm <%= locals.alertType === 'error' ? 'text-red-700' : 'text-green-700' %>">
                  <%= locals.message %>
                </p>
              </div>
            <% } %>

            <div class="mt-6 md:mt-10">
              <fieldset class="fieldset">

                <label
                  class="flex items-center w-full p-5 rounded-full bg-[var(--gray)] border border-[var(--strokeGray)] focus-within:border-[var(--teal)] transition-colors duration-300">
                  <input type="email" placeholder="<%= __('generic_label.emailAddress') %>" name="email"
                    class="bg-transparent border-none outline-none text-[14px] w-full" />
                </label>
              </fieldset>
              <fieldset class="fieldset">

                <label
                  class="flex items-center w-full p-5 mt-3 rounded-full bg-[var(--gray)] border border-[var(--strokeGray)] focus-within:border-[var(--teal)] transition-colors duration-300">
                  <input class="bg-transparent border-none outline-none text-[14px] grow" placeholder="<%= __('generic_label.password') %>" name="password"
                    id="password" type="password" />
                  <button type="button" id="togglePassword"
                    class="text-gray-500 hover:text-[var(--teal)] transition-colors duration-200 <%= (locals.locale || 'en') === 'ar' ? 'ml-2' : 'mr-2' %>"
                    aria-label="Show password"
                    aria-pressed="false">
                    <svg id="togglePasswordIconEye" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg id="togglePasswordIconEyeOff" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20C5 20 1 12 1 12a21.77 21.77 0 0 1 5.06-6.94"></path>
                      <path d="M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.9 21.9 0 0 1-3.17 4.83"></path>
                      <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                      <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                  </button>

                </label>

              </fieldset>
              <div class="flex justify-between mt-3">
                <div class="flex items-center gap-3 ">
                  <!--
                  <input type="checkbox" class="accent-[var(--teal)] text-white w-5 h-5 rounded"
                    aria-label="Custom checkbox" />
                  -->

                  <!--
                  <label for="agreement" class="text-sm ">
                    <%= __('generic_label.rememberMe') %>
                  </label>
                  -->
                </div>

                <div class="">
                  <!--
                  <a class="label-text text-[var(--teal)] text-base-content/80 text-xs" href="">
                    <%= __('generic_label.forgotPassword') %>
                  </a>
                  -->
                </div>

              </div>


              <button type="submit"
                class="w-full flex items-center justify-center gap-3 mt-8 px-6 py-3 rounded-full bg-[var(--teal)] text-white border border-transparent transition-all duration-300 hover:bg-transparent hover:border-[var(--teal)] hover:text-[var(--teal)]">
                <!-- <span class="iconify lucide--log-in size-4"></span> -->
                <%= __('generic_label.login') %>
              </button>

              <!--
              <p class="text-base-content/80 mt-4 text-center text-sm md:mt-6">
                <%= __('generic_label.dontHaveAccount') %>
                <a class="text-[var(--teal)] ms-1 hover:underline" href="./onboarding1-eng.html">
                  <%= __('generic_label.signup') %>
                </a>
              </p>
              -->
            </div>
          </div>
        </div>

      </form>
      <div>
        <p class="text-sm text-gray-600 mt-4">
          © 2025 Securemagnus
        </p>
      </div>



    </div>




    <!-- Hero (Hidden on Small Screens) -->
    <div class="hidden sm:block col-span-6  lg:p-5 p-4">
      <div class="w-full h-full relative rounded-3xl bg-[#020C1E] overflow-hidden">
        <!-- Background Image -->
        <img src="/securemagnus_2025/images/img/magnus-bg.png"
          class="absolute bottom-0 right-0 max-h-full max-w-full object-contain" alt="Background" />

        <!-- Text Overlay -->
        <div class="relative z-10 p-16">
          <h5 class="text-white text-5xl font-semibold leading-snug <%= locals.locale === 'ar' ? 'text-right' : '' %>">
            <%- __('generic_label.heroText') %>
          </h5>
        </div>
      </div>




    </div>
  </div>



  <script>
    document.getElementById('loginForm').addEventListener('submit', function () {
      document.getElementById('userTimezone').value = Intl.DateTimeFormat().resolvedOptions().timeZone;
    });

    (function () {
      var toggleBtn = document.getElementById('togglePassword');
      var passwordInput = document.getElementById('password');
      var eyeIcon = document.getElementById('togglePasswordIconEye');
      var eyeOffIcon = document.getElementById('togglePasswordIconEyeOff');
      if (!toggleBtn || !passwordInput || !eyeIcon || !eyeOffIcon) return;

      toggleBtn.addEventListener('click', function () {
        var isHidden = passwordInput.type === 'password';
        passwordInput.type = isHidden ? 'text' : 'password';
        eyeIcon.classList.toggle('hidden', isHidden);
        eyeOffIcon.classList.toggle('hidden', !isHidden);
        toggleBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
        toggleBtn.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
      });
    })();
  </script>

</body>

</html>
