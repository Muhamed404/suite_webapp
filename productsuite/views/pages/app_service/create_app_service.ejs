<div class="flex flex-col p-6">
  <div class="flex flex-col gap-2 mb-4 border-b border-gray-100 pb-4">
    <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0" aria-label="Breadcrumb">
      <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
      <span class="text-gray-400">›</span>
      <a href="/app_service/list" class="hover:text-gray-700 transition"><%= __("breadcrumbs.appService") %></a>
      <span class="text-gray-400">›</span>
      <span class="font-semibold text-gray-900"><%= __("breadcrumbs.appServiceCreate") %></span>
    </nav>
    <h3 class="text-3xl font-medium text-gray-900">
      <%= __("appservice.create.title") %>
    </h3>
    <% if (typeof message !== 'undefined' && message && message !== 'undefined') { %>
      <div class="bg-red-100 text-red-700 px-4 py-2 rounded mb-4">
        <%= message %>
      </div>
    <% } %>
  </div>

  <!-- Main Form Card -->
  <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white border border-gray-100 shadow-sm">
    <form action="/app_service/create" method="post" class="w-full p-8">
      
      <!-- Form Fields -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Left Column -->
        <div class="flex flex-col gap-6">
          <div>
            <label for="application" class="block text-gray-700 font-medium mb-3">
              <%= __("appservice.create.optionSelectProduct") %>
            </label>
            <select name="application" id="application" required
              class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-white">
              <option value="" selected disabled><%= __("appservice.create.optionSelectProduct") %></option>
              <% applications.forEach(app=> { %>
                <option value="<%= app.id %>">
                  <%= app.name %>
                </option>
              <% }); %>
            </select>
          </div>

          <div>
            <label for="service_name" class="block text-gray-700 font-medium mb-3">
              <%= __("appservice.create.labelServiceName") %>
            </label>
            <input type="text" id="service_name" name="service_name" required
              placeholder="Enter service name"
              class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
          </div>

          <div>
            <label for="per_service_cost" class="block text-gray-700 font-medium mb-3">
              <%= __("appservice.create.labelServiceCost") %>
            </label>
            <input type="number" id="per_service_cost" name="per_service_cost" min="1"
              placeholder="Enter service cost"
              oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value.startsWith('-')) this.value = this.value.substr(1);"
              class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
          </div>
        </div>

        <!-- Right Column -->
        <div class="flex flex-col gap-6">
          <div>
            <label for="service_type" class="block text-gray-700 font-medium mb-3">
              <%= __("appservice.create.optionSelectServiceType") %>
            </label>
            <select name="service_type" id="service_type" required
              class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-white">
              <option value="" selected disabled><%= __("appservice.create.optionSelectServiceType") %></option>
              <option value="Fixed"><%= __("appservice.create.optionSelectServiceTypeFixed") %></option>
              <option value="Annual"><%= __("appservice.create.optionSelectServiceTypeAnnual") %></option>
            </select>
          </div>

          <div>
            <label for="service_detail" class="block text-gray-700 font-medium mb-3">
              <%= __("appservice.create.labelDescription") %>
            </label>
            <input type="text" id="service_detail" name="service_detail" required
              placeholder="Enter description"
              class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
          </div>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="flex justify-end gap-4 mt-10 pt-6 border-t border-gray-100">
        <button type="submit"
          class="px-8 py-2 rounded-lg bg-[var(--teal)] text-white font-semibold hover:bg-teal-500 transition">
          <%= __("appservice.create.btnSubmit") %>
        </button>
      </div>
    </form>
  </div>
  </div>

  <!-- jQuery and jQuery Validation Plugin (CDN) -->
<script src="/securemagnus_2025/js/custom_script/create-app-service-validator.js"></script>

</div>
