<div class="step fade-enter-active" id="step-1">
    <!--  Title -->
    <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10"></h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Left Side: App/License/Duration -->
        <div class="flex flex-col gap-6">
            <div>
                <label class="block text-gray-700 font-medium mb-3">
                    <%= __("settings.serviceRegistry.create.optionSelectServiceType") %>
                </label>

                <select name="service_type" id="service_type"
                    class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50">
                    <option value="" disabled selected><%= __("settings.serviceRegistry.create.optionSelectServiceType") %></option>
                    <option value="BACKEND"><%= __("settings.serviceRegistry.create.optionSelectBackend") %></option>
                    <option value="INTERNAL"><%= __("settings.serviceRegistry.create.optionSelectInternal") %></option>
                    <option value="EXTERNAL"><%= __("settings.serviceRegistry.create.optionSelectExternal") %></option>
                    <option value="N/A"><%= __("settings.serviceRegistry.create.optionSelectNA") %></option>
                </select>
            </div>
            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("settings.serviceRegistry.create.labelServiceName") %></label>
                <input placeholder="Enter service name" type="text" value="" name="service_name" id="service_name"
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
            </div>

             
        </div>

        <!-- Right Side: Package/Start Date -->
        <div class="flex flex-col gap-6">
            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("settings.serviceRegistry.create.labelServiceId") %></label>
                <input placeholder="Enter Service ID" type="text" value="" id="service_id" name="service_id"
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
            </div>
        
 
        </div>
    </div>
</div>