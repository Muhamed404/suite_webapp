<div class="flex flex-col p-6 gap">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div class="flex-1">
      <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0 mb-2" aria-label="Breadcrumb">
        <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
        <span class="text-gray-400">›</span>
        <span class="font-semibold text-gray-900">Service Registry</span>
      </nav>
      <h3 class="text-3xl font-medium"><%= __("settings.serviceRegistry.homescreen.title") %></h3>
    </div>
    <div class="p-0 text-sm lg:order-3">
      <ul class="flex items-center gap-2">
        <!-- You can add tab/filter items here if needed -->
      </ul>
    </div>
    <a href="/service-registry/create"
      class="flex items-center justify-center gap-2 px-5 py-2 rounded-full bg-teal-600 text-white font-semibold shadow hover:bg-teal-700 transition-all duration-200 border border-teal-600 hover:border-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-400 lg:order-2"
      title="Create New Service">
      <!-- Heroicons Plus Circle SVG -->
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"/>
        <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 8v8m-4-4h8"/>
      </svg>
    </a>
  </div>
</div>


<div class="flex flex-col p-6 pt-0">
    <div class="">
        <div class="flex flex-row justify-between w-full gap-6 mb-6">
            <!-- Tabs with counts -->
            <div id="statusTabs"
                class="flex items-center justify-start gap-4 p-1 text-sm font-medium bg-white rounded-full w-fit">
            </div>
            <!-- Search + Filter -->
            <div class="flex items-center justify-between">
                <div class="relative">
                    <input id="searchInput" type="text" placeholder="Search here..."
                        class="pl-14 pr-10 py-3 w-[345px] rounded-full bg-white text-sm border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[var(--teal)]">
                    <img src="/securemagnus_2025/images/img/search.svg"
                        class="absolute w-5 h-5 text-gray-400 transform -translate-y-1/2 left-7 top-1/2" alt="">
                </div>
            </div>


        </div>

        <!-- Table -->

        <div class="overflow-x-auto bg-white hide-scrollbar rounded-2xl">
            <table class="min-w-full text-sm text-left">
                <thead class="bg-[#FAFBFC]">
                    <tr>
                        <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap" data-sort="name">
                            <span class="inline-flex items-center gap-2">

                               <%= __("settings.serviceRegistry.homescreen.serviceId") %>
                            </span>
                        </th>
                        <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap" data-sort="purchase_Date">
                            <span class="inline-flex items-center gap-2">
                                <img src="/securemagnus_2025/images/subscription_history/subscription_history_purchase_date.svg"
                                    alt="">
                                <%= __("settings.serviceRegistry.homescreen.serviceName") %>
                            </span>
                        </th>

                        <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap" data-sort="start_Date">
                            <span class="inline-flex items-center gap-2">
                                <img src="/securemagnus_2025/images/subscription_history/subscription_history_start_date.svg"
                                    alt="">
                                <%= __("settings.serviceRegistry.homescreen.serviceType") %>
                            </span>
                        </th>
                        <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap" data-sort="start_Date">
                            <span class="inline-flex items-center gap-2">
                                <img src="/securemagnus_2025/images/subscription_history/subscription_history_start_date.svg"
                                    alt="">
                                <%= __("settings.serviceRegistry.homescreen.registeredAt") %>
                            </span>
                        </th>
                        <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap" data-sort="status">
                            <span class="inline-flex items-center gap-2">

                                <%= __("settings.serviceRegistry.homescreen.serviceStatus") %>
                            </span>
                        </th>

                        <th class="px-6 py-6 font-semibold text-gray-700 whitespace-nowrap" data-sort="action">
                            <span class="inline-flex items-center gap-2">

                                <%= __("settings.serviceRegistry.homescreen.serviceActions") %>
                            </span>
                        </th>
                    </tr>
                </thead>
                <tbody id="tableBody">

                </tbody>
            </table>
        </div>




        <!-- Pagination -->
        <div class="flex items-center justify-between mt-4">
            <select id="rowsPerPage" class="px-2 py-1 border rounded">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
            </select>
            <div id="pagination" class="space-x-2"></div>
        </div>
    </div>




</div>
  <div id="deleteConfirmModal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-40 hidden">
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-sm">
      <h2 class="text-lg font-semibold mb-4">Confirm License Assignment</h2>
      <p class="mb-6">Are you sure you want to set this user as <span class="font-bold text-green-600">Licensed</span>?
      </p>
      <div class="flex justify-end gap-3">
        <button id="cancelLicenseConfirm" class="px-4 py-2 rounded bg-gray-200 hover:bg-gray-300">Cancel</button>
        <button id="confirmLicenseBtn"
          class="px-4 py-2 rounded bg-green-600 text-white hover:bg-green-700">Confirm</button>
      </div>
    </div>
  </div>

<!-- Pass data to JavaScript -->
<script>
    // Pass server data to JavaScript
    window.registryData = {
        serviceRegistry: <%- JSON.stringify(services) %>,
        pagination: <%- JSON.stringify(pagination) %>,
    };
</script>

<script src="/securemagnus_2025/js/service_registry_list_jquery.js"></script>