<div id="licenseStatsData"
  data-phm-purchased="<%= phmPurchasedLicense || 0 %>"
  data-phm-consumed="<%= phmConsumeLicense || 0 %>"
  data-awm-purchased="<%= awmPurchasedLicense || 0 %>"
  data-awm-consumed="<%= awmConsumeLicense || 0 %>"
  data-locale="<%= locals.locale || 'en' %>"></div>

<script>
  function toArabicNum(num) {
    return num.toString().replace(/\d/g, d => '٠١٢٣٤٥٦٧٨٩'[d]);
  }

  document.addEventListener("DOMContentLoaded", function () {
    const statsEl = document.getElementById("licenseStatsData");
    if (!statsEl || typeof setProgress !== "function") return;

    const locale = statsEl.dataset.locale;
    const convertNum = (num) => {
      return locale === 'ar' ? toArabicNum(num) : num.toString();
    };

    const phmPurchasedLicense = Number(statsEl.dataset.phmPurchased || 0);
    const phmConsumeLicense = Number(statsEl.dataset.phmConsumed || 0);
    const awmPurchasedLicense = Number(statsEl.dataset.awmPurchased || 0);
    const awmConsumeLicense = Number(statsEl.dataset.awmConsumed || 0);

    const originalSetProgress = window.setProgress;
    window.setProgress = function(circleId, textId, ...args) {
      let percent, textValue;
      if (args.length === 1) {
        percent = args[0];
        textValue = percent;
      } else if (args.length === 2) {
        const consumed = args[0];
        const purchased = args[1];
        percent = purchased > 0 ? (consumed / purchased) * 100 : 0;
        textValue = consumed;
      }
      const circle = document.getElementById(circleId);
      const text = document.getElementById(textId);
      if (!circle || !text) return;
      const radius = 70;
      const circumference = 2 * Math.PI * radius;
      const offset = circumference - (percent / 100) * circumference;
      circle.style.strokeDasharray = circumference;
      circle.style.strokeDashoffset = offset;
      text.textContent = convertNum(textValue);
    };

    setProgress("progressCircle1", "progressText1", phmConsumeLicense, phmPurchasedLicense);
    setProgress("progressCircle2", "progressText2", awmConsumeLicense, awmPurchasedLicense);

    const phmTotalEl = document.getElementById("phm-total-license");
    if (phmTotalEl) phmTotalEl.textContent = convertNum(phmPurchasedLicense);

    const awmTotalEl = document.getElementById("awm-total-license");
    if (awmTotalEl) awmTotalEl.textContent = convertNum(awmPurchasedLicense);

    const phmExpiryEl = document.getElementById("phm-expiry-date");
    if (phmExpiryEl) phmExpiryEl.textContent = convertNum(phmExpiryEl.textContent);

    const awmExpiryEl = document.getElementById("awm-expiry-date");
    if (awmExpiryEl) awmExpiryEl.textContent = convertNum(awmExpiryEl.textContent);
  });
</script>