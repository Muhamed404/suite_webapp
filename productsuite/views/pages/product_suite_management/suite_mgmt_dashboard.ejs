  window.campaignChartData = {
    emailCount: <%= emailStats?.total_campaign_initiaged || 0 %>,
    smsCount: <%= smsStats?.total_campaign_initiaged || 0 %>,
      usbCount: <%= usbStats?.total_campaign_initiaged || 0 %>,
        nfcCount: <%= nfcStats?.total_campaign_initiaged || 0 %>,
          qrCount: <%= qrStats?.total_campaign_initiaged || 0 %>,
            whatsappCount: <%= whatsappStats?.total_campaign_initiaged || 0 %>
  };

  document.addEventListener("DOMContentLoaded", function () {

    const phmPurchasedLicense = <%= phmPurchasedLicense %>;
    const phmConsumeLicense = <%= phmConsumeLicense %>
    const awmPurchasedLicense = <%= awmPurchasedLicense %>;
    const awmConsumeLicense = <%= awmConsumeLicense %>


    setProgress("progressCircle1", "progressText1", phmConsumeLicense);
    setProgress("progressCircle2", "progressText2", awmConsumeLicense);

  });
 
  </script>