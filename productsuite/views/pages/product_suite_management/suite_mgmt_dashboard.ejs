                      <span class="iconify" data-icon="lucide:plus" data-width="18" data-height="18"></span>

                    </a>
                  </div>
                </div>
              </div>

              <!-- Consumed Licenses -->
              <div class="col-span-3 row-span-2 max-md:col-span-1">
                <div class="flex flex-col gap-3">
                  <div class="rounded-3xl bg-white md:h-[306px] p-6 flex flex-col items-center justify-center">
