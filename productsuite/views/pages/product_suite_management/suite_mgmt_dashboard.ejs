                      View Subscription
                    </a>
                  </div>
                </div>
              </div>

              <!-- Awareness Campaigns -->
              <div
                class="col-span-6 row-span-2 max-sm:col-span-2 bg-white rounded-3xl p-6 flex flex-col justify-between">
                <div class="flex justify-between items-start gap-2 mb-3 flex-wrap">
                  <div>
                    <h2 class="font-semibold lg:text-2xl text-xl mb-2">Awareness Campaigns</h2>
                    <p class="text-base text-gray-500">Last Campaign Date : 1/23/05</p>
                  </div>
                  <a href="#"
                    class="flex items-center justify-center gap-3 lg:px-6 text-sm lg:py-3 rounded-full bg-white text-[var(--teal)] lg:text-[var(--darkblue)] lg:border border-[var(--strokeGray)] transition-all duration-300 lg:hover:bg-transparent lg:hover:border-[var(--teal)] lg:hover:text-[var(--teal)]">
                    View Campaign
                  </a>
                </div>
                <div class="p-0">
                  <div id="chart2" class="flex justify-center"></div>
                </div>
              </div>
            </div>


          </div>


        </div>

  <!-- Toggle Script -->
