<div class="flex flex-col p-6 gap">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div class="flex-1">
      <nav class="flex items-center text-[1rem] text-gray-500 gap-2 pb-0 mb-2" aria-label="Breadcrumb">
        <a href="/home" class="hover:text-gray-700 transition">Home</a>
        <span class="text-gray-400">›</span>
        <span class="font-semibold text-gray-900">Notification Mail Log</span>
      </nav>
      <h3 class="text-3xl font-medium">Notification Mail Log</h3>
      <p class="text-sm text-gray-500 mt-1">View the dispatch status of every outbound notification email.</p>
    </div>
  </div>
</div>

<div class="flex flex-col p-6 pt-0">

  <!-- Filters -->
  <form method="GET" action="/notification-mail" class="flex flex-wrap items-end gap-3 mb-6">
    <!-- Status filter -->
    <div class="flex flex-col gap-1">
      <label class="text-xs font-medium text-gray-500">Status</label>
      <select name="status"
        class="px-4 py-2.5 rounded-full text-sm border border-gray-300 bg-white focus:outline-none focus:ring-2 focus:ring-[var(--teal)]">
        <option value="">All</option>
        <% ['PENDING','PROCESSING','SENT','REJECTED','FAILED'].forEach(function(s) { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>
    </div>

    <!-- Notification type filter -->
    <div class="flex flex-col gap-1">
      <label class="text-xs font-medium text-gray-500">Notification Type</label>
      <input type="text" name="notification_type" value="<%= filters.notificationType %>"
        placeholder="e.g. USER_WELCOME"
        class="px-4 py-2.5 rounded-full text-sm border border-gray-300 bg-white focus:outline-none focus:ring-2 focus:ring-[var(--teal)] w-52">
    </div>

    <input type="hidden" name="pageSize" value="<%= pagination.pageSize %>">

    <button type="submit"
      class="px-5 py-2.5 rounded-full text-sm font-semibold bg-[var(--teal)] text-white hover:opacity-90 transition">
      Apply
    </button>
    <a href="/notification-mail"
      class="px-5 py-2.5 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition">
      Clear
    </a>
  </form>

  <!-- Table -->
  <div class="overflow-x-auto bg-white hide-scrollbar rounded-2xl">
    <table class="min-w-full text-sm text-left">
      <thead class="bg-[#FAFBFC]">
        <tr>
          <th class="px-6 py-5 font-semibold text-gray-700 whitespace-nowrap">#</th>
          <th class="px-6 py-5 font-semibold text-gray-700 whitespace-nowrap">To</th>
          <th class="px-6 py-5 font-semibold text-gray-700 whitespace-nowrap">Type</th>
          <th class="px-6 py-5 font-semibold text-gray-700 whitespace-nowrap">Priority</th>
          <th class="px-6 py-5 font-semibold text-gray-700 whitespace-nowrap">Status</th>
          <th class="px-6 py-5 font-semibold text-gray-700 whitespace-nowrap">Retries</th>
          <th class="px-6 py-5 font-semibold text-gray-700 whitespace-nowrap">Queued At</th>
          <th class="px-6 py-5 font-semibold text-gray-700 whitespace-nowrap">Sent At</th>
        </tr>
      </thead>
      <tbody>
        <% if (!mails || mails.length === 0) { %>
          <tr>
            <td colspan="8" class="px-6 py-12 text-center text-gray-400">No notification mails found.</td>
          </tr>
        <% } else { %>
          <% mails.forEach(function(mail, index) { %>
            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">

              <td class="px-6 py-4 text-gray-500 whitespace-nowrap">
                <%= ((pagination.currentPage - 1) * pagination.pageSize) + index + 1 %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap">
                <div class="font-medium text-gray-800"><%= mail.to_email %></div>
                <% if (mail.to_name) { %>
                  <div class="text-xs text-gray-400"><%= mail.to_name %></div>
                <% } %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
                  <%= mail.notification_type %>
                </span>
              </td>

              <td class="px-6 py-4 whitespace-nowrap">
                <% if (mail.priority === 'HIGH') { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-600 border border-red-200">HIGH</span>
                <% } else if (mail.priority === 'LOW') { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-500 border border-gray-200">LOW</span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-yellow-50 text-yellow-600 border border-yellow-200">NORMAL</span>
                <% } %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap">
                <% if (mail.status === 'SENT') { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-600 border border-green-200">SENT</span>
                <% } else if (mail.status === 'PENDING') { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-yellow-50 text-yellow-600 border border-yellow-200">PENDING</span>
                <% } else if (mail.status === 'PROCESSING') { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-600 border border-blue-200">PROCESSING</span>
                <% } else if (mail.status === 'REJECTED') { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-600 border border-red-200">REJECTED</span>
                <% } else { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-500 border border-gray-200"><%= mail.status %></span>
                <% } %>
              </td>

              <td class="px-6 py-4 text-center text-gray-600 whitespace-nowrap">
                <%= mail.retry_count %> / 3
              </td>

              <td class="px-6 py-4 text-gray-500 whitespace-nowrap text-xs">
                <%= mail.created_at ? new Date(mail.created_at).toLocaleString() : '—' %>
              </td>

              <td class="px-6 py-4 text-gray-500 whitespace-nowrap text-xs">
                <%= mail.sent_at ? new Date(mail.sent_at).toLocaleString() : '—' %>
              </td>

            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (pagination.totalPages > 1) { %>
    <div class="flex items-center justify-between px-2 py-4 mt-2">
      <span class="text-sm text-gray-500">
        Page <%= pagination.currentPage %> of <%= pagination.totalPages %>
        &nbsp;·&nbsp; <%= pagination.totalCount %> total
      </span>
      <div class="flex gap-2">
        <% if (pagination.hasPreviousPage) { %>
          <a href="?page=<%= pagination.previousPage %>&pageSize=<%= pagination.pageSize %>&status=<%= filters.status %>&notification_type=<%= filters.notificationType %>"
            class="px-4 py-2 text-sm rounded-full font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition">
            Previous
          </a>
        <% } %>
        <% if (pagination.hasNextPage) { %>
          <a href="?page=<%= pagination.nextPage %>&pageSize=<%= pagination.pageSize %>&status=<%= filters.status %>&notification_type=<%= filters.notificationType %>"
            class="px-4 py-2 text-sm rounded-full font-medium bg-[var(--teal)] text-white hover:opacity-90 transition">
            Next
          </a>
        <% } %>
      </div>
    </div>
  <% } %>

</div>
