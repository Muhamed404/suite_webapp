<div class="step hidden" id="step-2">


    <!-- Main Form -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Left Side: App/License/Duration -->
        <div class="flex flex-col gap-6">
            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("package.create.labelPackageName") %> </label>
                <input placeholder="Enter last name" type="text" value="" id="name" name="name" required
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
            </div>
            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("package.create.labelLicenseCost") %></label>
                <input placeholder="Enter license cost" type="number" required
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
                    id="per_license_cost" name="per_license_cost" min="1"
                    oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value.startsWith('-')) this.value = this.value.substr(1);" />
            </div>
<div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("package.create.labelUserRangeFrom") %></label>
                <input id="license_range_from" name="license_range_from" min="1" type="number" required
                    oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value.startsWith('-')) this.value = this.value.substr(1);"
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
            </div>
            
        </div>

        <!-- Right Side: Package/Start Date -->
        <div class="flex flex-col gap-6">
            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("package.create.labelDescription") %></label>
                <input placeholder="Enter description" type="text" value="" id="description" name="description" required
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
            </div>
            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("package.create.labelLicenseDuration") %></label>
                <input type="number" id="duration_days" name="duration_days" min="1" required
                    oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value.startsWith('-')) this.value = this.value.substr(1);"
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
            </div>
            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("package.create.labelUserRangeTo") %></label>
                <input type="number" id="license_range_to" name="license_range_to" min="1" required
                    oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value.startsWith('-')) this.value = this.value.substr(1);"
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
            </div>

             
        </div>
    </div>
</div>