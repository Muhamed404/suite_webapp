<div class="flex flex-col  p-6 pt-0">
<div class="flex flex-col p-4 gap">
  <div class="flex flex-col gap-2">
    <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0 mb-2" aria-label="Breadcrumb">
      <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
      <span class="text-gray-400">›</span>
      <a href="/package/list" class="hover:text-gray-700 transition"><%= __("breadcrumbs.package") %></a>
      <span class="text-gray-400">›</span>
      <span class="font-semibold text-gray-900"><%= __("breadcrumbs.packageCreate") %></span>
    </nav>
    <h3 class="text-3xl font-medium">
      <%= __("breadcrumbs.packageCreate") %>
    </h3>
  </div>
</div>
  <!-- first section  -->

  <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white">

    <form id="packageCreationForm" novalidate action="/package/create" method="post" class="bg-white  w-full mt-3 p-8">
      <!-- Stepper Navigation -->
      <div id="stepper" class="flex items-center justify-between mb-10">
        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-teal-500 text-white font-bold text-xs">
            1</div>
          <span class="font-medium step-label text-teal-700 text-sm">
                  <%= __("package.create.stepper1") %>

          </span>
        </div>
        <div class="flex-1 h-0.5 bg-teal-100 mx-2"></div>
        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-white border-2 border-teal-300 text-teal-400 font-bold text-xs">
            2</div>
          <span class="font-medium step-label text-gray-400 text-sm">
  
                  <%= __("package.create.stepper2") %>

          </span>
        </div>

      </div>

      <div id="steps">
        <!-- Step 1: Product Details -->
        <%- include('./choose_product_package.ejs') %>

          <!-- Step 2: Package Details -->

          <%- include('./choose_package_details.ejs') %>

      </div>


    </form>

    <!-- Buttons -->
    <div class="flex justify-end gap-4 mt-10 p-8">
      <button id="backBtn" type="button"
        class="px-8 py-2 rounded-lg bg-gray-100 text-gray-600 font-medium border hover:border-gray-300 transition">                  
        <%= __("package.create.btnBack") %>
</button>
      <button id="nextBtn" type="submit"
        class="px-8 py-2 rounded-lg bg-[var(--teal)] text-white font-semibold hover:bg-teal-500 transition">
        <%= __("package.create.btnNext") %>
      
      </button>
    </div>


  </div>

</div>

<!-- expose server-side arrays for client JS -->
<script src="/securemagnus_2025/js/form_stepper.js"></script>
<script src="/securemagnus_2025/js/custom_script/validate_create_package.js"></script>
