<div class="step fade-enter-active" id="step-1">
  <!-- Section Title -->
  <!-- <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10">Trial & Subscription</h1> -->

  <!-- Main Form -->
  <form class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
    <!-- Left Side: App/License/Duration -->
    <div class="flex flex-col gap-6">
      <div>
        <label class="block text-gray-700 font-medium mb-3"><%= __("subscription.create.optionSelectProduct") %></label>
        <select
          class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-white"
          name="selectedApplication" id="selectedApplication" >
          <option value="" selected disabled>
            <%= __("subscription.create.optionSelectProduct") %>
          </option>
          <% applications.forEach(function(app) { %>
            <option value="<%= app.id %>">
              <%= app.name %>
            </option>
            <% }); %>
        </select>
      </div>
      <div>
        <label class="block text-gray-700 font-medium mb-3"><%= __("subscription.create.labelTotalUserLicenses") %></label>
        <input class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
            oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value.startsWith('-')) this.value = this.value.substr(1);"
            min="1" id="totaluserlicense" name="totaluserlicense" type="text"  />
        
      </div>

      <div>
        <label class="block text-gray-700 font-medium mb-3"> <%= __("subscription.create.labelLicenseStartDate") %></label>
        <div class="relative group">
          <input type="date" name="licenseStartDate" placeholder="yyyy-mm-dd"
            class="date-input w-full h-11 px-3 pr-11 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-white cursor-pointer" />

          <!-- Calendar icon on the right -->
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-400 group-focus-within:text-teal-500"
              viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M8 7V3m8 4V3M5 11h14M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Side: Package/Start Date -->
    <div class="flex flex-col gap-6">
      <div>
        <label class="block text-gray-700 font-medium mb-3"><%= __("subscription.create.optionSelectPackage") %></label>
        <select  name="selectedPackage" id="selectedPackage"
          class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-white">
          <option value="0" selected>
              <%= __("subscription.create.optionSelectPackage") %>
            </option>
        </select>
      </div>
      <div>
        <label class="block text-gray-700 font-medium mb-3"><%= __("subscription.create.labelLicenseDuration") %></label>
	 <input type="number" min="1" class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-gray-100 cursor-not-allowed"
          id="durationDays" name="durationDays"
            oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value.startsWith('-')) this.value = this.value.substr(1);" />
        
      </div>
    </div>
  </form>
</div>


