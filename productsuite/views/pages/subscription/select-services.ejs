                <div>
                    <img src="/securemagnus_2025/images/browser-web-checkmark.svg" alt="">
                </div>

                <h3 class="font-medium text-[var(--mainblue)] text-lg mb-4">
                    <%= __("subscription.create.labelFixedServices") %>
