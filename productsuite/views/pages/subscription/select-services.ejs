                <h3 class="font-medium text-[var(--mainblue)] text-lg mb-4">
                    <%= __("subscription.create.labelAnnualServices") %>
                </h3>

            </div>

            <div class="flex flex-col" id="servicesAnnualContainer">

            </div>

        </div>
        <!-- Fixed Service -->
        <div class=" flex flex-row gap-12">
