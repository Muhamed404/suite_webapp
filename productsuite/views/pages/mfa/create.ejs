<%- include('../../layout/layout-starting.ejs') %>

  <!-- Page Content Start -->
  <!-- ================== -->

  <div class="wraper container-fluid">

    <div class="row">
      <!-- Basic example -->
      <div class="col-md-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title">
              <%= __("SMTP.Create") %>
            </h3>
          </div>
          <div class="panel-body">
            <form role="form" action="/mfa/create" method="post">
              <div class="form-group">
                <label for="smtp_host">
                  SMTP Connection Name
                </label>

                <input type="text" class="form-control" id="name" name="name" required
                  value="<%= smtpData ? smtpData.name : ''  %>" placeholder="Enter Connection Name" />
              </div>

              <div class="form-group">
                <label for="smtp_host">
                  <%= __("SMTP.Host.Name") %>
                </label>

                <input type="text" class="form-control" id="smtp_host" name="smtp_host" required
                  value="<%= smtpData ? smtpData.smtp_host : ''  %>" placeholder="Enter Host Name" />
              </div>
              <div class="form-group">
                <label for="smtp_port">
                  <%= __("SMTP.Port") %>
                </label>
                <input type="number" id="smtp_port" name="smtp_port" min="1" class="form-control" max="65535" required
                  value="<%= smtpData ? smtpData.smtp_port : ''  %>" placeholder="Enter Port #" />
              </div>
              <div class="form-group">
                <label for="smtp_user">
                  <%= __("SMTP.Service.Account") %>
                </label>
                <input type="text" id="smtp_user" class="form-control" name="smtp_user" required
                  value="<%= smtpData ? smtpData.smtp_user : ''  %>" placeholder="Enter Domain Service Account" />
              </div>
              <div class="form-group">
                <label for="smtp_pass">
                  <%= __("SMTP.Password") %>
                </label>
                <input type="smtp_pass" id="smtp_pass" placeholder="Enter Domain Account Password"
                  value="<%= smtpData ? smtpData.smtp_pass : ''  %>" class="form-control" name="smtp_pass" required />
              </div>
          
              <div class="form-group">
                <label class="cr-styled">
                  <input type="checkbox" name="smtp_secure" id="smtp_secure" value="true" <% if (smtpData && smtpData.smtp_secure) { %>checked<% } %> >
                  <i class="fa"></i>
                   Use Secure Connection
                </label>
              </div>
              <div class="form-group">
                <label class="cr-styled">
                  <input type="checkbox" name="mfa" id="mfa" value="true" <% if (smtpData && smtpData.enable_mfa) { %>checked<% } %>>
                  <i class="fa"></i>
                  Enable MFA
                </label>
              </div>
              <button type="submit" class="btn btn-info">
                <%= __("btn.SMTP.Create") %>
              </button>
            </form>


          </div>
          <!-- panel-body -->
        </div>
        <!-- panel -->
      </div>
      <!-- col-->
    </div>
  </div>

  <!-- Page Content Ends -->
  <!-- ================== -->

  <%- include('../../layout/footer.js') %> <%- include('../../layout/layout-ending.ejs') %>