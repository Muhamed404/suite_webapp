<!DOCTYPE html>
<html lang="<%= locals.locale || 'en' %>" dir="<%= (locals.locale || 'en') === 'ar' ? 'rtl' : 'ltr' %>" translate="no" class="notranslate">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google" content="notranslate">
  <title><%= __('generic_label.welcomeToSecureMagnus') %></title>

  <link rel="stylesheet" href="/securemagnus_2025/css/fonts.css">

  <script src="/securemagnus_2025/js/tailwind_3.js"></script>
  <link rel="stylesheet" href="/securemagnus_2025/css/style.css">
</head>

<body class="bg-white notranslate" translate="no">

  <div class="grid grid-cols-12 min-h-screen">

    <!-- Left: MFA Form -->
    <div class="flex flex-col justify-between col-span-12 sm:col-span-6 h-screen lg:p-10 p-4">

      <!-- Header -->
      <div class="flex items-center justify-between">
        <a href="">
          <img src="/securemagnus_2025/images/logo.svg" alt="Secure Magnus">
        </a>
        <div class="flex items-center gap-2">
          <a href="?lang=en"
            class="rounded-full text-sm py-1.5 px-4 border border-[var(--teal)] hover:bg-[var(--teal)] hover:text-white transform duration-300">
            English
          </a> |
          <a href="?lang=ar"
            class="rounded-full text-sm py-1.5 px-4 border border-[var(--teal)] hover:bg-[var(--teal)] hover:text-white transform duration-300">
            العربية
          </a>
        </div>
      </div>

      <!-- MFA Form -->
      <div class="flex items-center justify-center">
        <div class="flex flex-col w-full max-w-sm items-stretch">

          <!-- Shield Icon -->
          <div class="flex justify-center mb-6">
            <div class="flex items-center justify-center w-16 h-16 rounded-2xl bg-teal-50">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
              </svg>
            </div>
          </div>

          <h3 class="text-center text-3xl font-semibold"><%= __('mfa.loginTitle') %></h3>
          <p class="text-center text-sm text-gray-500 mt-2 mb-8"><%= __('mfa.loginSubtitle') %></p>

          <!-- Error Message -->
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="mb-5 p-4 rounded-xl bg-red-50 border border-red-200">
              <p class="text-sm text-red-700"><%= error %></p>
            </div>
          <% } %>

          <form id="mfaForm" action="/mfa/verify" method="POST">

            <label class="block text-sm font-medium text-gray-700 mb-2">
              <%= __('mfa.loginLabel') %>
            </label>
            <label class="flex items-center w-full px-5 py-3.5 rounded-full bg-[var(--gray)] border border-[var(--strokeGray)] focus-within:border-[var(--teal)] transition-colors duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 mr-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
              </svg>
              <input
                type="text"
                id="otp"
                name="otp"
                required
                maxlength="6"
                autocomplete="one-time-code"
                inputmode="numeric"
                placeholder="<%= __('mfa.loginPlaceholder') %>"
                class="bg-transparent border-none outline-none text-sm w-full tracking-widest"
              />
            </label>

            <button type="submit"
              class="w-full flex items-center justify-center mt-6 px-6 py-3 rounded-full bg-[var(--teal)] text-white border border-transparent transition-all duration-300 hover:bg-transparent hover:border-[var(--teal)] hover:text-[var(--teal)]">
              <%= __('mfa.loginBtn') %>
            </button>

            <a href="/login"
              class="w-full flex items-center justify-center gap-2 mt-3 px-6 py-3 rounded-full text-sm text-gray-500 hover:text-gray-700 transition-colors duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              <%= __('mfa.loginBack') %>
            </a>

          </form>

        </div>
      </div>

      <!-- Footer -->
      <div>
        <p class="text-sm text-gray-600 mt-4">© 2025 Securemagnus</p>
      </div>

    </div>

    <!-- Right: Hero (Hidden on small screens) -->
    <div class="hidden sm:block col-span-6 lg:p-5 p-4">
      <div class="w-full h-full relative rounded-3xl bg-[#020C1E] overflow-hidden">
        <img src="/securemagnus_2025/images/img/magnus-bg.png"
          class="absolute bottom-0 right-0 max-h-full max-w-full object-contain" alt="Background" />
        <div class="relative z-10 p-16">
          <h5 class="text-white text-5xl font-semibold leading-snug <%= locals.locale === 'ar' ? 'text-right' : '' %>">
            <%- __('generic_label.heroText') %>
          </h5>
        </div>
      </div>
    </div>

  </div>

</body>

</html>
