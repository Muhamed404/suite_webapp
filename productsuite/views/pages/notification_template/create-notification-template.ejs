<div class="flex flex-col p-6 gap">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div class="flex-1">
      <nav class="flex items-center text-[1rem] text-gray-500 gap-2 pb-0 mb-2" aria-label="Breadcrumb">
        <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
        <span class="text-gray-400">›</span>
        <a href="/notification-template" class="hover:text-gray-700 transition"><%= __("breadcrumbs.notificationTemplates") %></a>
        <span class="text-gray-400">›</span>
        <span class="font-semibold text-gray-900"><%= __("settings.notificationTemplate.create.title") %></span>
      </nav>
      <h3 class="text-3xl font-medium"><%= __("settings.notificationTemplate.create.title") %></h3>
      <p class="text-sm text-gray-500 mt-1"><%= __("settings.notificationTemplate.create.subtitle") %></p>
    </div>
  </div>
</div>

<div class="flex flex-col p-6 pt-0">

  <div class="bg-white rounded-2xl p-8">
    <form id="createTemplateForm" action="/notification-template/create" method="POST">

      <!-- Shared Fields -->

      <!-- Template Name (shared) -->
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          <%= __("settings.notificationTemplate.create.fields.name") %> <span class="text-red-500">*</span>
        </label>
        <input type="text" name="name" id="name"
          placeholder="<%= __('settings.notificationTemplate.create.fields.namePlaceholder') %>"
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[var(--teal)]">
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">

        <!-- Notification Type -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            <%= __("settings.notificationTemplate.create.fields.notificationType") %> <span class="text-red-500">*</span>
          </label>
          <select name="notification_type" id="notification_type"
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[var(--teal)] bg-white">
            <option value="" disabled selected><%= __("settings.notificationTemplate.create.fields.notificationTypePlaceholder") %></option>
            <% notificationTypes.forEach(function(type) { %>
            <option value="<%= type %>"><%= type %></option>
            <% }); %>
          </select>
        </div>

        <!-- Is Active -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            <%= __("settings.notificationTemplate.create.fields.isActive") %>
          </label>
          <select name="is_active"
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[var(--teal)] bg-white">
            <option value="true" selected>Yes</option>
            <option value="false">No</option>
          </select>
        </div>

        <!-- Is System -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            <%= __("settings.notificationTemplate.create.fields.isSystem") %>
          </label>
          <select name="is_system"
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[var(--teal)] bg-white">
            <option value="false" selected>No</option>
            <option value="true">Yes</option>
          </select>
        </div>
      </div>

      <!-- Divider -->
      <hr class="border-gray-100 mb-6">

      <!-- Language Tabs -->
      <div class="mb-6">
        <div class="flex gap-1 p-1 bg-gray-100 rounded-xl w-fit mb-6">
          <button type="button" id="tabEnBtn"
            onclick="switchTab('en')"
            class="tab-btn px-6 py-2 rounded-lg text-sm font-medium transition-all bg-white text-gray-900 shadow-sm">
            🇬🇧 <%= __("settings.notificationTemplate.create.tabs.english") %>
          </button>
          <button type="button" id="tabArBtn"
            onclick="switchTab('ar')"
            class="tab-btn px-6 py-2 rounded-lg text-sm font-medium transition-all text-gray-500 hover:text-gray-700">
            🇸🇦 <%= __("settings.notificationTemplate.create.tabs.arabic") %>
          </button>
        </div>

        <!-- English Tab -->
        <div id="tabEn" class="lang-tab">
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">
              <%= __("settings.notificationTemplate.create.fields.subject") %>
            </label>
            <input type="text" name="subject_en" id="subject_en"
              placeholder="<%= __('settings.notificationTemplate.create.fields.subjectPlaceholder') %>"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[var(--teal)]">
          </div>
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="block text-sm font-medium text-gray-700">
                <%= __("settings.notificationTemplate.create.fields.body") %>
              </label>
              <button type="button" onclick="openPreview('en')"
                class="flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
                <%= __("generic_label.preview") %>
              </button>
            </div>
            <textarea name="body_en" id="body_en" rows="10"
              placeholder="<%= __('settings.notificationTemplate.create.fields.bodyPlaceholder') %>"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[var(--teal)] resize-y font-mono"></textarea>
          </div>
        </div>

        <!-- Arabic Tab -->
        <div id="tabAr" class="lang-tab hidden" dir="rtl">
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">
              <%= __("settings.notificationTemplate.create.fields.subject") %>
            </label>
            <input type="text" name="subject_ar" id="subject_ar"
              placeholder="<%= __('settings.notificationTemplate.create.fields.subjectPlaceholder') %>"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[var(--teal)]">
          </div>
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="block text-sm font-medium text-gray-700">
                <%= __("settings.notificationTemplate.create.fields.body") %>
              </label>
              <button type="button" onclick="openPreview('ar')"
                class="flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
                <%= __("generic_label.preview") %>
              </button>
            </div>
            <textarea name="body_ar" id="body_ar" rows="10"
              placeholder="<%= __('settings.notificationTemplate.create.fields.bodyPlaceholder') %>"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[var(--teal)] resize-y font-mono"></textarea>
          </div>
        </div>
      </div>

      <!-- Preview Modal -->
<div id="previewModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/50" onclick="closePreview()"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-3xl max-h-[85vh] flex flex-col">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
      <h3 id="previewModalTitle" class="text-base font-semibold text-gray-900"><%= __('generic_label.body_preview_english') %></h3>
      <button type="button" onclick="closePreview()" class="text-gray-400 hover:text-gray-600 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="overflow-y-auto flex-1 p-6">
      <iframe id="previewFrame" class="w-full border-0 rounded-lg" style="min-height:400px;"></iframe>
    </div>
  </div>
</div>

<!-- Validation error -->
      <div id="validationError" class="hidden mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700"></div>

      <!-- Actions -->
      <div class="flex justify-end gap-3 mt-6 pt-6 border-t border-gray-100">
        <a href="/notification-template"
          class="px-6 py-2.5 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition">
          <%= __("settings.notificationTemplate.create.btnCancel") %>
        </a>
        <button type="submit"
          class="px-6 py-2.5 rounded-full text-sm font-semibold bg-[var(--teal)] text-white hover:opacity-90 transition shadow">
          <%= __("settings.notificationTemplate.create.btnSubmit") %>
        </button>
      </div>

    </form>
  </div>
</div>

<script>
  const validationMessages = {
    typeRequired:  "<%= __('settings.notificationTemplate.create.validation.typeRequired') %>",
    atLeastOne:    "<%= __('settings.notificationTemplate.create.validation.atLeastOne') %>",
    nameRequired:  "<%= __('settings.notificationTemplate.create.validation.nameRequired') %>",
    bodyRequired:  "<%= __('settings.notificationTemplate.create.validation.bodyRequired') %>",
  };

  function switchTab(lang) {
    document.getElementById('tabEn').classList.toggle('hidden', lang !== 'en');
    document.getElementById('tabAr').classList.toggle('hidden', lang !== 'ar');
    document.getElementById('tabEnBtn').className = lang === 'en'
      ? 'tab-btn px-6 py-2 rounded-lg text-sm font-medium transition-all bg-white text-gray-900 shadow-sm'
      : 'tab-btn px-6 py-2 rounded-lg text-sm font-medium transition-all text-gray-500 hover:text-gray-700';
    document.getElementById('tabArBtn').className = lang === 'ar'
      ? 'tab-btn px-6 py-2 rounded-lg text-sm font-medium transition-all bg-white text-gray-900 shadow-sm'
      : 'tab-btn px-6 py-2 rounded-lg text-sm font-medium transition-all text-gray-500 hover:text-gray-700';
  }

  function openPreview(lang) {
    const body = document.getElementById('body_' + lang).value;
    const frame = document.getElementById('previewFrame');
    const title = document.getElementById('previewModalTitle');
    title.textContent = lang === 'ar' ? '<%= __("generic_label.body_preview_arabic") %>' : '<%= __("generic_label.body_preview_english") %>';
    frame.setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr');
    const doc = frame.contentDocument || frame.contentWindow.document;
    doc.open();
    doc.write(body || '<p style="color:#9ca3af;font-family:sans-serif;padding:1rem;"><%= __("generic_label.no_content_to_preview") %></p>');
    doc.close();
    // Resize iframe to content height after load
    frame.onload = function () {
      try { frame.style.height = frame.contentDocument.body.scrollHeight + 'px'; } catch (_) {}
    };
    try { frame.style.height = (doc.body ? doc.body.scrollHeight : 400) + 'px'; } catch (_) { frame.style.height = '400px'; }
    document.getElementById('previewModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closePreview() {
    document.getElementById('previewModal').classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closePreview();
  });

  document.getElementById('createTemplateForm').addEventListener('submit', function (e) {
    const errEl = document.getElementById('validationError');
    errEl.classList.add('hidden');
    errEl.textContent = '';

    const type = document.getElementById('notification_type').value;
    if (!type) {
      e.preventDefault();
      errEl.textContent = validationMessages.typeRequired;
      errEl.classList.remove('hidden');
      return;
    }

    const name = document.getElementById('name').value.trim();
    const bodyEn = document.getElementById('body_en').value.trim();
    const bodyAr = document.getElementById('body_ar').value.trim();

    if (!name) {
      e.preventDefault();
      errEl.textContent = validationMessages.nameRequired;
      errEl.classList.remove('hidden');
      return;
    }

    if (!bodyEn && !bodyAr) {
      e.preventDefault();
      errEl.textContent = validationMessages.atLeastOne;
      errEl.classList.remove('hidden');
      return;
    }
  });
</script>
