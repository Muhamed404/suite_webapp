<!-- first section  -->

<div class="flex flex-col h-[75vh] gap-4 mt-3 rounded-3xl bg-white">

  <div class="bg-white  w-full mt-3 p-8">



    <!--  Title -->
    <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10">
      Create SecureMagnus Admin User
    </h1>

    <!-- Main Form -->
    <form id="securemagnusUserForm" class="grid grid-cols-1 md:grid-cols-2 gap-8" action="<%=methodUrl %>"
      method="post">
      <!-- Organization name -->
      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">Select Role</label>
        <select name="role" id="role"
          class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50">
          <option value="" disabled selected>Select User Role</option>
          <% if (typeof roles !=='undefined' && roles) { %>
            <% roles.forEach(role=> { %>
              <option value="<%= role.id %>">
                <%= role.role_name %>
              </option>
              <% }); %>
                <% } %>
        </select>
      </div>


      <!-- Host name -->
      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">
          Contact Number
        </label>
        <input placeholder="Enter contact number" type="tel" value="" id="contact" name="contact" minlength="10"
          maxlength="15" pattern="\d{10,15}" required oninput="this.value = this.value.replace(/[^0-9]/g, '');"
          class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
      </div>

      <!-- Post -->
      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">
          First Name
        </label>
        <input placeholder="Enter first name" type="text" value="" id="first_name" name="first_name"
          class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
      </div>

      <!-- Service Account -->
      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">
          Last Name
        </label>
        <input placeholder="Enter last name" type="text" value="" id="last_name" name="last_name"
          class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
      </div>


      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">
          Email Address
        </label>
        <input placeholder="Enter email" type="email" value="" id="email" name="email"
          class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
      </div>
      <!-- Password -->
      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">
          Password
        </label>
        <input placeholder="Enter password" type="password" value="" id="password" name="password" min="4"
          class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
      </div>



      <!-- Buttons -->
      <div class="flex justify-left gap-4 mt-10">
        <button type="submit"
          class="px-8 py-2 rounded-lg bg-teal-500 text-white font-semibold hover:bg-teal-600 transition">
          Submit
        </button>
         
      </div>
    </form>
  </div>
</div>
<script src="/securemagnus_2025/js/custom_script/create-user-magnus-validation.js"></script>
