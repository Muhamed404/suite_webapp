<!-- first section  -->

<div class="flex flex-col h-[75vh] gap-4 mt-3 rounded-3xl bg-white">

  <div class="bg-white  w-full mt-3 p-8">



    <!--  Title -->
    <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10">
      <%= __("user.labelCreateSecureMagnusUser") %>
    </h1>

    <!-- Main Form -->
    <form id="securemagnusUserForm" class="grid grid-cols-1 md:grid-cols-2 gap-8" action="<%=methodUrl %>"
      method="post">
      <!-- Organization name -->
      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3"><%= __("user.labelSelectRole") %></label>
        <select name="role" id="role"
          class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50">
          <option value="" disabled selected><%= __("user.optionSelectUserRole") %></option>
          <% if (typeof roles !=='undefined' && roles) { %>
            <% roles.forEach(role=> { %>
              <option value="<%= role.id %>">
                <%= role.role_name %>
              </option>
              <% }); %>
                <% } %>
        </select>
      </div>


      <!-- Host name -->
      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">
          <%= __("user.labelContactNumber") %>
        </label>
        <input placeholder="<%= __("user.placeholderContactNumber") %>" type="tel" value="" id="contact" name="contact" minlength="10"
          maxlength="15" pattern="\d{10,15}" required oninput="this.value = this.value.replace(/[^0-9]/g, '');"
          class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
      </div>

      <!-- Post -->
      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">
          <%= __("user.labelFirstName") %>
        </label>
        <input placeholder="<%= __("user.placeholderFirstName") %>" type="text" value="" id="first_name" name="first_name"
          class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
      </div>

      <!-- Service Account -->
      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">
          <%= __("user.labelLastName") %>
        </label>
        <input placeholder="<%= __("user.placeholderLastName") %>" type="text" value="" id="last_name" name="last_name"
          class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
      </div>


      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">
          <%= __("user.labelEmailAddress") %>
        </label>
        <input placeholder="<%= __("user.placeholderEmail") %>" type="email" value="" id="email" name="email"
          class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
      </div>
      <!-- Password -->
      <div class="md:col-span-1">
        <label class="block text-gray-700 font-medium mb-3">
          <%= __("user.labelPassword") %>
        </label>
        <input placeholder="<%= __("user.placeholderPassword") %>" type="password" value="" id="password" name="password" min="4"
          class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
      </div>



      <!-- Buttons -->
      <div class="flex justify-left gap-4 mt-10">
        <button type="submit"
          class="px-8 py-2 rounded-lg bg-teal-500 text-white font-semibold hover:bg-teal-600 transition">
          <%= __("user.btnSubmit") %>
        </button>
         
      </div>
    </form>
  </div>
</div>
<script>
  window.userValidationMessages = {
    role: { required: "<%= __('user.validationSelectRole') %>" },
    contact: {
      required: "<%= __('user.validationContactRequired') %>",
      digits: "<%= __('user.validationContactDigits') %>",
      minlength: "<%= __('user.validationContactMinLength') %>",
      maxlength: "<%= __('user.validationContactMaxLength') %>"
    },
    first_name: {
      required: "<%= __('user.validationFirstNameRequired') %>",
      minlength: "<%= __('user.validationFirstNameMinLength') %>"
    },
    last_name: {
      required: "<%= __('user.validationLastNameRequired') %>",
      minlength: "<%= __('user.validationLastNameMinLength') %>"
    },
    email: "<%= __('user.validationEmailRequired') %>",
    password: "<%= __('user.validationPasswordRequired') %>"
  };
</script>
<script src="/securemagnus_2025/js/custom_script/create-user-magnus-validation.js"></script>
