<div class="step hidden" id="step-2">

    <!--  Title -->
    <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10"><%= __("user.labelEnterUserDetails") %></h1>

    <!-- Main Form -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Left Side: App/License/Duration -->
        <div class="flex flex-col gap-6">
            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("user.labelSelectRole") %></label>

                <select name="role" id="role" required
                    class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50"
                    tabindex="1">
                    <option value="" disabled selected><%= __("user.optionSelectUserRole") %></option>
                   <% if (typeof roles !=='undefined' && roles) { %>
                        <% 
                        const roleDisplayMap = {
                          'Org User': 'End-user',
                          'Sub Org User': 'Organization Sub-Admin',
                          'Super Org User': 'Organization Superadmin'
                        };
                        %>
                        <% roles.forEach(role=> { %>
                            <option value="<%= role.id %>">
                                <%= roleDisplayMap[role.role_name] || role.role_name %>
                            </option>
                            <% }); %>
                                <% } %>
                </select>
            </div>
            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("user.labelLastName") %></label>
                <input placeholder="<%= __("user.placeholderLastName") %>" type="text" value="" id="last_name" name="last_name" required
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
                    tabindex="3" />
            </div>

            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("user.labelEmailAddress") %></label>
                <input placeholder="<%= __("user.placeholderEmail") %>" type="email" value="" id="email" name="email" required
                    pattern="^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"
                    title="Enter a valid email address with full domain (e.g., user@example.com)"
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
                    tabindex="5" />
            </div>
        </div>

        <!-- Right Side: Package/Start Date -->
        <div class="flex flex-col gap-6">
            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("user.labelFirstName") %></label>
                <input placeholder="<%= __("user.placeholderFirstName") %>" type="text" value="" id="first_name" name="first_name" required
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
                    tabindex="2" />
            </div>
            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("user.labelContactNumber") %></label>
                <input placeholder="<%= __("user.placeholderContactNumber") %>" type="tel" value="" id="contact" name="contact" minlength="10"
                  maxlength="15" pattern="\d{10,15}" required oninput="this.value = this.value.replace(/[^0-9]/g, '');"
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
                    tabindex="4" />
            </div>

            <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __("user.labelPassword") %></label>
                <input placeholder="<%= __("user.placeholderPassword") %>" type="password" value="" id="password" name="password" required
                    pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$"
                    title="Password must be at least 8 characters and include uppercase, lowercase, number, and special character"
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
                    tabindex="6" />
            </div>
        </div>
    </div>
</div>