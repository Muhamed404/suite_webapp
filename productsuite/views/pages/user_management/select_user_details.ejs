<div class="step hidden" id="step-2">

    <!--  Title -->
    <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10">User Details</h1>

    <!-- Main Form -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Left Side: App/License/Duration -->
        <div class="flex flex-col gap-6">
            <div>
                <label class="block text-gray-700 font-medium mb-3">Select Role </label>

                <select name="role" id="role" required
                    class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50">
                    <option value="" disabled selected>Select User Role</option>
                    <% if (typeof roles !=='undefined' && roles) { %>
                        <% roles.forEach(role=> { %>
                            <option value="<%= role.id %>">
                                <%= role.role_name %>
                            </option>
                            <% }); %>
                                <% } %>
                </select>
            </div>
            <div>
                <label class="block text-gray-700 font-medium mb-3">Last Name</label>
                <input placeholder="Enter last name" type="text" value="" id="last_name" name="last_name" required
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
            </div>

            <div>
                <label class="block text-gray-700 font-medium mb-3">Email Address</label>
                <input placeholder="Enter email" type="email" value="" id="email" name="email" required
                    pattern="^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"
                    title="Enter a valid email address with full domain (e.g., user@example.com)"
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
            </div>
        </div>

        <!-- Right Side: Package/Start Date -->
        <div class="flex flex-col gap-6">
            <div>
                <label class="block text-gray-700 font-medium mb-3">First Name</label>
                <input placeholder="Enter first name" type="text" value="" id="first_name" name="first_name" required
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
            </div>
            <div>
                <label class="block text-gray-700 font-medium mb-3">Contact number</label>
                <input placeholder="Enter contact number"  type="tel" value="" id="contact" name="contact" minlength="10"
                  maxlength="15" pattern="\d{10,15}" required oninput="this.value = this.value.replace(/[^0-9]/g, '');"
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
            </div>

            <div>
                <label class="block text-gray-700 font-medium mb-3">Password</label>
                <input placeholder="Enter password" type="password" value="" id="password" name="password" required
                    pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$"
                    title="Password must be at least 8 characters and include uppercase, lowercase, number, and special character"
                    class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent" />
            </div>
        </div>
    </div>
</div>