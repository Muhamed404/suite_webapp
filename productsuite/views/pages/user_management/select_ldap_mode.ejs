<div class="step hidden" id="step-2">
    <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10"><%= __("user.stepSelectLdapMode") || 'Select LDAP Import Mode' %></h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="md:col-span-1">
            <label class="block text-gray-700 font-medium mb-3">
                <%= __("user.labelSelectMode") || 'Import Mode' %>
            </label>

            <select id="import_mode" name="import_mode"
                class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50"
                tabindex="2">
                <option value="" disabled selected><%= __("user.labelSelectMode") || 'Select Mode' %></option>
                <option value="ONLY_IMPORT"><%= __("user.labelOnlyImport") || 'Only Import' %></option>
                <option value="IMPORT_AND_LOGIN"><%= __("user.labelImportAndLogin") || 'Import and Login' %></option>
            </select>
        </div>
    </div>
</div>
