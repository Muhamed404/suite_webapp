<div class="flex flex-col p-6 gap pb-0">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div class="flex-1">
      <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0 mb-2" aria-label="Breadcrumb">
        <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
        <span class="text-gray-400">›</span>
        <span class="font-semibold text-gray-900"><%= __("user.labelSecureMagnusUsers") %></span>
      </nav>
      <h3 class="text-3xl font-medium">
        <%= __("user.labelTitleSecmagnusUserManagement") %>
      </h3>
    </div>
    <div class="flex flex-row gap-4 lg:order-2">
      <% if (typeof hasCreatePermission !== 'undefined' && hasCreatePermission) { %>
        <!-- Create User -->
        <a href="/user/securemagnus-users/create"
          class="flex items-center gap-2 px-5 py-2 rounded-lg bg-blue-600 text-white font-semibold border border-blue-600 shadow hover:bg-blue-700 transition"
          title="Create User">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="8" r="4" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 20v-2a6 6 0 0112 0v2" />
          </svg>
          <span class="hidden sm:inline"><%= __("user.btnAddUser") %></span>
        </a>
      <% } %>
    </div>
  </div>
</div>


<div class="flex flex-col  p-6 pt-0">
  <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white">
    <!-- Search & Filter -->
    <div class="flex flex-wrap items-center justify-between gap-3 px-5 pt-5">


      <table id="filter-table" class="min-w-full border-none  text-sm text-left text-gray-700" data-placeholder="<%= __('generic_label.search_here') %>" data-per-page="<%= __('entries per page') %>" data-info="<%= __('generic_label.showing') %> {start} to {end} <%= __('generic_label.of') %> {rows} <%= __('entries') %>" data-no-rows="<%= __('generic_label.no_entries_found') %>">
        <thead class="bg-gray-50 text-gray-600  text-xs">
          <tr>

            <th class="px-4 py-5 text-sm font-normal">
              <%= __("user.labelFullName") %>
                <img src="/securemagnus_2025/images/package_management/sort.svg" 
                  class="size-3.5 ml-3 inline">
            </th>
            <th class="px-4 py-5">
              <img src="/securemagnus_2025/images/package_management/Package_Management_Type.svg" alt="Type"
                class=" inline">
              <%= __("user.labelEmail") %>

                <span></span><img src="/securemagnus_2025/images/package_management/sort.svg" 
                  class="size-3.5 ml-3 inline">
            </th>

            <th class="px-4 py-5">
              <img src="/securemagnus_2025/images/package_management/package_management_user_range_form.svg"
                alt="User From" class=" inline">
              <%= __("user.labelRoleAssigned") %>


                <span class="text-sm font-normal"></span><img
                  src="/securemagnus_2025/images/package_management/sort.svg" 
                  class="size-3.5 ml-3 inline">
            </th>
          
            <th class="px-4 py-5">
              <img src="/securemagnus_2025/images/package_management/package_management_user_range_to.svg" alt="User To"
                class=" inline">
              <%= __("user.labelUserStatus") %>


                <span class="text-sm font-normal"></span><img
                  src="/securemagnus_2025/images/package_management/sort.svg" 
                  class="size-3.5 ml-3 inline">
            </th>
            <th class="px-4 py-5">
              <img src="/securemagnus_2025/images/package_management/package_management_subscription_duration.svg"
                alt="Subscription" class=" inline">
              <%= __("user.labelAction") %>


                <span class="text-sm font-normal"></span><img
                  src="/securemagnus_2025/images/package_management/sort.svg" 
                  class="size-3.5 ml-3 inline">
            </th>



          </tr>
        </thead>
        <tbody>
          <% if (Array.isArray(users)) { users.forEach(u=> { %>

            <tr class="bg-white border-b hover:bg-gray-50">

              <td class="px-6 py-6 whitespace-nowrap">
                <%= u?.first_name %>
                  <%= u?.last_name %>
              </td>
              <td class="px-6 py-6 whitespace-nowrap">
                <%= u?.email %>
              </td>

              <td class="px-6 py-6 whitespace-nowrap">
                <%= u.User?.UserRole.role_name || '' %>
              </td>
 
              <td class="px-6 py-6 whitespace-nowrap">
                <% const isActive = u.User?.status ? true : false; %>
                <span class="inline-flex items-center px-3 py-1 text-sm border rounded-full
                  <%= isActive ? 'text-green-500 border-green-500 bg-green-50' : 'text-red-500 border-red-500 bg-red-50' %>">
                  <%= isActive ? __("generic_label.active") : __("generic_label.inactive") %>
                </span>
              </td>

              <td class="px-4 py-5 text-sm font-normal relative">
                <div class="relative inline-block text-left">
                  <button type="button" onclick="toggleDropdown(this)"
                    class="p-2 rounded hover:bg-gray-100 transition" aria-haspopup="true" aria-expanded="false">
                    <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2"
                      viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="1.5" />
                      <circle cx="19" cy="12" r="1.5" />
                      <circle cx="5" cy="12" r="1.5" />
                    </svg>
                  </button>
                  <ul class="absolute right-0 mt-2 w-40 bg-white border border-gray-200 rounded shadow-lg z-10 hidden">
                    <li>
                      <a href="/user/delete/<%= u.id || "" %>"
                        class="flex items-center px-4 py-2 text-sm text-red-600 hover:bg-gray-100 rounded transition">
                        <i class="ion-android-trash mr-2"></i>
                        <%= __("generic_label.delete") %>
                      </a>
                    </li>
                    <li>
                      <a href="/user/show/<%= u.id || "" %>"
                        class="flex items-center px-4 py-2 text-sm text-blue-600 hover:bg-gray-100 rounded transition">
                        <i class="ion-edit mr-2"></i>
                        <%= __("generic_label.edit") %>
                      </a>
                    </li>
                  </ul>
                </div>
              </td>


            </tr>
            <% }) } %>

        </tbody>
      </table>

    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  if (!document.getElementById('filter-table') || typeof simpleDatatables === 'undefined' || typeof simpleDatatables.DataTable === 'undefined') {
    console.warn('simple-datatables not found or table missing');
    return;
  }

  const table = document.getElementById('filter-table');
  const placeholder = table.dataset.placeholder || 'Search...';
  const perPageLabel = table.dataset.perPage || 'entries per page';
  const infoLabel = table.dataset.info || 'Showing {start} to {end} of {rows} entries';
  const noRowsLabel = table.dataset.noRows || 'No entries found';

  const dataTable = new simpleDatatables.DataTable('#filter-table', {
    sortable: true,
    perPageSelect: [10, 20, 25, 50, 100],
    labels: {
      placeholder: placeholder,
      perPage: perPageLabel,
      info: infoLabel,
      noRows: noRowsLabel
    }
  });
});

function toggleDropdown(button) {
  const allDropdowns = document.querySelectorAll('.relative.inline-block.text-left ul');
  allDropdowns.forEach(dropdown => {
    if (dropdown !== button.nextElementSibling) {
      dropdown.classList.add('hidden');
    }
  });
  
  button.nextElementSibling.classList.toggle('hidden');
}

document.addEventListener('click', function(event) {
  const dropdowns = document.querySelectorAll('.relative.inline-block.text-left ul');
  const buttons = document.querySelectorAll('.relative.inline-block.text-left button');
  
  let isOutside = true;
  buttons.forEach(button => {
    if (button.contains(event.target)) {
      isOutside = false;
    }
  });
  dropdowns.forEach(dropdown => {
    if (dropdown.contains(event.target)) {
      isOutside = false;
    }
  });
  
  if (isOutside) {
    dropdowns.forEach(dropdown => {
      dropdown.classList.add('hidden');
    });
  }
});
</script>


