<div class="flex flex-col  p-6 pt-0">



  <!-- first section  -->

  <div class="flex flex-col h-[75vh] gap-4 mt-3 rounded-3xl bg-white">

    <div class="bg-white  w-full mt-3 p-8">

      <div id="steps">
        <div class="step fade-enter-active">
          <!-- Section Title -->
          <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10"><%= __('user_management.edit_user.edit_user_details') %></h1>
          <!-- Main Form -->
          <form class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start" action="/user/update/<%= user.id %>" method="post" autocomplete="off">
            <!-- Left Side: App/License/Duration -->
            <div class="flex flex-col gap-6">
              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __('user_management.edit_user.first_name') %></label>
                <input placeholder="<%= __('user_management.edit_user.enter_first_name') %>" type="text" id="firstName" name="firstName"
                  value="<%= user.UserProfile?.first_name || '' %>"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
                  tabindex="-1" readonly />
              </div>
              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __('user_management.edit_user.email') %></label>
                <input placeholder="<%= __('user_management.edit_user.enter_email') %>" type="text" value="<%= user.UserProfile?.email || '' %>" id="email"
                  name="email"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
                  tabindex="-1" readonly />
              </div>

              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __('user_management.edit_user.new_password') %></label>
                <div class="relative password-input-wrap">
                  <input placeholder="<%= __('user_management.edit_user.enter_new_password') %>" type="password" id="newPassword" name="newPassword" value=""
                    autocomplete="off"
                    class="w-full px-4 py-2 <%= (locals.locale || 'en') === 'ar' ? 'pl-10' : 'pr-10' %> rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
                    tabindex="1" />
                  <button type="button" id="toggleNewPassword"
                    class="absolute inset-y-0 <%= (locals.locale || 'en') === 'ar' ? 'left-3' : 'right-3' %> flex items-center text-gray-500 hover:text-[var(--teal)] transition-colors duration-200"
                    aria-label="Show password"
                    aria-pressed="false">
                    <svg id="toggleNewPasswordIconEye" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg id="toggleNewPasswordIconEyeOff" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20C5 20 1 12 1 12a21.77 21.77 0 0 1 5.06-6.94"></path>
                      <path d="M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.9 21.9 0 0 1-3.17 4.83"></path>
                      <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                      <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                  </button>
                </div>
              </div>

              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __('user_management.edit_user.status') %></label>
                <select name="status"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)]
                  bg-transparent"
                  tabindex="3">
                  <option value="true" <%=user.status ? 'selected' : '' %>><%= __('generic_label.active') %></option>
                  <option value="false" <%=!user.status ? 'selected' : '' %>><%= __('generic_label.inactive') %></option>
                </select>
              </div>
              <!-- Buttons -->
              <div>
                <a href="/user/suite-users"
                  class="px-8 py-2 rounded-lg bg-gray-100 text-gray-600 font-medium border hover:border-gray-300 transition"
                  tabindex="4"><%= __('generic_label.cancel') %></a>
                <button type="submit"
                  class="px-8 py-2 rounded-lg bg-[var(--teal)] text-white font-semibold hover:bg-teal-500 transition"
                  tabindex="5"><%= __('user_management.edit_user.save') %></button>
              </div>
            </div>

            <!-- Right Side: Package/Start Date -->
            <div class="flex flex-col gap-6">
              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __('user_management.edit_user.last_name') %></label>
                <input placeholder="<%= __('user_management.edit_user.enter_last_name') %>" type="text" id="lastName" name="lastName"
                  value="<%= user.UserProfile?.last_name || '' %>"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
                  tabindex="-1" readonly />
              </div>
              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __('user_management.edit_user.role_assigned') %></label>
                <input placeholder="<%= __('user_management.edit_user.enter_role_assigned') %>" type="text" value="<%= user.UserRole?.role_name || '' %>"
                  class="w-full px-4 py-2 rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
                  tabindex="-1" readonly />
              </div>

              <div>
                <label class="block text-gray-700 font-medium mb-3"><%= __('user_management.edit_user.confirm_password') %></label>
                <div class="relative password-input-wrap">
                  <input placeholder="<%= __('user_management.edit_user.enter_confirm_password') %>" type="password" id="confirmPassword" name="confirmPassword"
                    autocomplete="off"
                    value=""
                    class="w-full px-4 py-2 <%= (locals.locale || 'en') === 'ar' ? 'pl-10' : 'pr-10' %> rounded-lg border focus:border-teal-400 focus:ring-2 focus:ring-teal-200 text-[var(--mainblue)] bg-transparent"
                    tabindex="2" />
                  <button type="button" id="toggleConfirmPassword"
                    class="absolute inset-y-0 <%= (locals.locale || 'en') === 'ar' ? 'left-3' : 'right-3' %> flex items-center text-gray-500 hover:text-[var(--teal)] transition-colors duration-200"
                    aria-label="Show password"
                    aria-pressed="false">
                    <svg id="toggleConfirmPasswordIconEye" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg id="toggleConfirmPasswordIconEyeOff" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20C5 20 1 12 1 12a21.77 21.77 0 0 1 5.06-6.94"></path>
                      <path d="M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.9 21.9 0 0 1-3.17 4.83"></path>
                      <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                      <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
            <!-- </form> -->
        </div>
      </div>


    </div>

  </div>

</div>

<!-- jQuery Validation -->
<script>
  // Localized validation messages
  window.validationMessages = {
    passwordComplexity: '<%= __('user_management.edit_user.password_complexity_error') %>',
    confirmPasswordRequired: '<%= __('user_management.edit_user.confirm_password_required') %>',
    newPasswordRequired: '<%= __('user_management.edit_user.new_password_required') %>',
    passwordsMustMatch: '<%= __('user_management.edit_user.passwords_must_match') %>'
  };
</script>
<script>
$(document).ready(function() {
    // Check if jQuery Validate plugin is available
    if (typeof $.fn.validate === 'undefined') {
        console.warn('jQuery Validate plugin not found. Loading fallback validation.');
        initFallbackValidation();
        return;
    }

    // Add custom validation method: password required only if confirmPassword is filled
    $.validator.addMethod('requiredIfConfirmFilled', function(value, element) {
        var confirmPassword = $('#confirmPassword').val();
        // If confirm password has value, new password is required
        if (confirmPassword && confirmPassword.trim() !== '') {
            return value && value.trim() !== '';
        }
        return true; // Not required if confirm is empty
    }, window.validationMessages.newPasswordRequired);

    // Add custom validation method: confirmPassword required only if newPassword is filled
    $.validator.addMethod('requiredIfNewFilled', function(value, element) {
        var newPassword = $('#newPassword').val();
        // If new password has value, confirm password is required
        if (newPassword && newPassword.trim() !== '') {
            return value && value.trim() !== '';
        }
        return true; // Not required if new password is empty
    }, window.validationMessages.confirmPasswordRequired);

    // Add custom validation method: passwords must match if both are filled
    $.validator.addMethod('passwordMatch', function(value, element) {
        var newPassword = $('#newPassword').val();
        var confirmPassword = $('#confirmPassword').val();

        // Only validate if both fields have values
        if ((newPassword && newPassword.trim() !== '') || (confirmPassword && confirmPassword.trim() !== '')) {
            return newPassword === confirmPassword;
        }
        return true; // Valid if both are empty
    }, window.validationMessages.passwordsMustMatch);

    // Add custom validation method: password complexity (only when password is provided)
    $.validator.addMethod('strongPassword', function(value, element) {
        // If password is provided, check complexity
        if (value && value.trim() !== '') {
            // At least 8 characters, one uppercase, one lowercase, one number, one special character
            return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/.test(value);
        }
        return true; // Valid if empty
    }, window.validationMessages.passwordComplexity);

    // Initialize jQuery Validation Plugin
    var validator = $('form').validate({
        // Validate on blur/change for better UX
        onfocusout: function(element) {
            $(element).valid();
        },
        onkeyup: function(element) {
            // Re-validate both password fields when either changes
            if ($(element).attr('id') === 'newPassword' || $(element).attr('id') === 'confirmPassword') {
                $('#newPassword').valid();
                $('#confirmPassword').valid();
            } else {
                $(element).valid();
            }
        },

        // Custom error placement for better UI
        errorElement: 'span',
        errorClass: 'error-message',
        errorPlacement: function(error, element) {
            error.addClass('text-red-500 text-sm mt-1 block');
            if (element.attr('id') === 'newPassword' || element.attr('id') === 'confirmPassword') {
                error.insertAfter(element.closest('.password-input-wrap'));
                return;
            }
            error.insertAfter(element);
        },

        // Highlight invalid fields
        highlight: function(element) {
            $(element).addClass('border-red-500 focus:ring-red-200 focus:border-red-500');
            $(element).removeClass('border-gray-300 focus:border-teal-400 focus:ring-teal-200');
        },

        // Remove highlight when valid
        unhighlight: function(element) {
            $(element).removeClass('border-red-500 focus:ring-red-200 focus:border-red-500');
            $(element).addClass('focus:border-teal-400 focus:ring-teal-200');
        },

        // Validation rules for all fields
        rules: {
            newPassword: {
                requiredIfConfirmFilled: true,
                strongPassword: true,
                passwordMatch: true
            },
            confirmPassword: {
                requiredIfNewFilled: true,
                passwordMatch: true
            },
        },

        // Custom messages (if needed)
        messages: {
            // Add any additional custom messages here if needed
        }
    });
});
</script>
<script>
(function () {
    function bindToggle(buttonId, inputId, eyeId, eyeOffId) {
        var toggleBtn = document.getElementById(buttonId);
        var passwordInput = document.getElementById(inputId);
        var eyeIcon = document.getElementById(eyeId);
        var eyeOffIcon = document.getElementById(eyeOffId);
        if (!toggleBtn || !passwordInput || !eyeIcon || !eyeOffIcon) return;

        toggleBtn.addEventListener('click', function () {
            var isHidden = passwordInput.type === 'password';
            passwordInput.type = isHidden ? 'text' : 'password';
            eyeIcon.classList.toggle('hidden', isHidden);
            eyeOffIcon.classList.toggle('hidden', !isHidden);
            toggleBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
            toggleBtn.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
        });
    }

    bindToggle('toggleNewPassword', 'newPassword', 'toggleNewPasswordIconEye', 'toggleNewPasswordIconEyeOff');
    bindToggle('toggleConfirmPassword', 'confirmPassword', 'toggleConfirmPasswordIconEye', 'toggleConfirmPasswordIconEyeOff');
})();
</script>
