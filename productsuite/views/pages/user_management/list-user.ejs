<%- include('./user-enrollment.ejs') %>


  <div id="licenseConfirmModal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-40 hidden">
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-sm ml-20 -mt-10">
      <h2 class="text-lg font-semibold mb-4"><%= __("user.modalConfirmLicenseAssignment") %></h2>
      <p class="mb-6"><%= __("user.modalConfirmSetAsLicensed") %>
        <span class="font-bold" id="licenseActionText">Licensed</span>
      </p>
      <div class="flex justify-end gap-3">
        <button id="cancelLicenseConfirm" class="px-4 py-2 rounded bg-gray-200 hover:bg-gray-300"><%= __("generic_label.cancel") %></button>
        <button id="confirmLicenseBtn"
          class="px-4 py-2 rounded bg-green-600 text-white hover:bg-green-700"><%= __("generic_label.confirm") %></button>
      </div>
    </div>
  </div>


  <script src="/securemagnus_2025/js/user-license-multiselect-enrollment-jquery.js"></script>

  <script src="/securemagnus_2025/js/custom_script/user-license-multiselect-enrollment.js"></script>




<style>
.datatable-search {
  flex: 1;
}
.datatable-input {
  width: 100%;
}
.datatable-length select {
  padding: 0.5rem 0.75rem;
  border: 1px solid #d1d5db;
  border-radius: 0.25rem;
  font-size: 0.875rem;
}
</style>

  <script>
if (!document.getElementById('filter-table') || typeof simpleDatatables === 'undefined' || typeof simpleDatatables.DataTable === 'undefined') {
  console.warn('simple-datatables not found or table missing');
} else {
  const dataTable = new simpleDatatables.DataTable('#filter-table', {
    searchable: true,
    fixedHeight: true,
  });
}

    let pendingLicenseUserId = null;
    let pendingLicenseStatus = null;
    let actionProduct = null;
    let saveUserAllocationLicense = `/user/update-license-status/false`;


    document.addEventListener('click', function (e) {
      // Handle action dropdown toggle
      const actionBtn = e.target.closest('div.relative.inline-block.text-left button');
      if (actionBtn && !actionBtn.classList.contains('licenseStatusBtn') && !actionBtn.classList.contains('AwareMagnuslicenseStatusBtn')) {
        e.preventDefault();
        e.stopPropagation();
        
        const menu = actionBtn.closest('div.relative.inline-block.text-left')?.querySelector('.actionDropdownMenu');
        if (menu) {
          // Close other menus
          document.querySelectorAll('.actionDropdownMenu').forEach(m => m !== menu && m.classList.add('hidden'));
          
          const wasHidden = menu.classList.contains('hidden');
          menu.classList.toggle('hidden');
          
          if (wasHidden) {
            const btnRect = actionBtn.getBoundingClientRect();
            const menuWidth = 160, menuHeight = menu.scrollHeight || 100, gap = 8;
            const vw = window.innerWidth, vh = window.innerHeight;
            
            const left = Math.max(gap, Math.min(btnRect.right - menuWidth, vw - menuWidth - gap));
            
            const top = btnRect.bottom + menuHeight + gap > vh 
              ? Math.max(gap, btnRect.top - menuHeight - gap)
              : btnRect.bottom + gap;
            
            menu.style.left = `${left}px`;
            menu.style.top = `${top}px`;
          }
        }
        return;
      }

      const licenseBtn = e.target.closest('button.licenseStatusBtn') || e.target.closest('button.AwareMagnuslicenseStatusBtn');
      if (licenseBtn) {
        e.preventDefault();
        e.stopPropagation();
        
        const isPhishMagnus = licenseBtn.classList.contains('licenseStatusBtn');
        actionProduct = isPhishMagnus ? 'phm' : 'awm';
        
        // Find the parent div with relative positioning
        const parentDiv = licenseBtn.closest('div.relative.inline-block.text-left');
        if (parentDiv) {
          const menu = parentDiv.querySelector('.licenseDropdownMenu');
          if (menu) {
            document.querySelectorAll('.licenseDropdownMenu').forEach(other => {
              if (other !== menu) other.classList.add('hidden');
            });
            menu.classList.toggle('hidden');
          }
        }
        return; // Prevent further handling for dropdown button clicks
      }

      // Handle status change click
      const link = e.target.closest('.change-status');
      if (link) {
        e.preventDefault();
        const userId = link.getAttribute('data-user-id');
        const newStatus = link.getAttribute('data-status');
        if (newStatus === 'licensed' || newStatus === 'unlicensed') {
          pendingLicenseUserId = userId;
          pendingLicenseStatus = newStatus;
          // Update modal text
          let actionText = newStatus.charAt(0).toUpperCase() + newStatus.slice(1);
          const actionTextSpan = document.getElementById('licenseActionText');
          if (actionTextSpan) {
            actionTextSpan.textContent = actionText;
          }
          document.getElementById('licenseConfirmModal').classList.remove('hidden');
        }
        return;
      }

      // Close dropdowns when clicking outside
      const licenseDropdowns = document.querySelectorAll('.licenseDropdownMenu');
      const actionDropdowns = document.querySelectorAll('.actionDropdownMenu');
      
      licenseDropdowns.forEach(menu => {
        const parentDiv = menu.closest('div.relative.inline-block.text-left');
        if (parentDiv && !parentDiv.contains(e.target)) {
          menu.classList.add('hidden');
        }
      });
      
      actionDropdowns.forEach(menu => {
        const parentDiv = menu.closest('div.relative.inline-block.text-left');
        if (parentDiv && !parentDiv.contains(e.target)) {
          menu.classList.add('hidden');
        }
      });
    });

    // Modal button handlers
    document.getElementById('cancelLicenseConfirm').addEventListener('click', function () {
      document.getElementById('licenseConfirmModal').classList.add('hidden');
      pendingLicenseUserId = null;
      pendingLicenseStatus = null;
    });

    document.getElementById('confirmLicenseBtn').addEventListener('click', function () {
      if (pendingLicenseUserId && pendingLicenseStatus) {
        // AJAX call to update license status
        if (pendingLicenseStatus === 'unlicensed') {
          saveUserAllocationLicense = `/user/update-license-status/true?actionProduct=${actionProduct}`;
        } else {
          saveUserAllocationLicense = `/user/update-license-status/false?actionProduct=${actionProduct}`;
        }
        fetch(saveUserAllocationLicense, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            selectedUsers: [pendingLicenseUserId],
            status: pendingLicenseStatus
          })
        })
          .then(response => response.json())
          .then(data => {
            // Handle success (show toast, reload, etc.)
            if (data.success) {
              showCustomToast('success', 'Status updated successfully!');
              setTimeout(() => window.location.reload(), 1200);
            } else {
              showCustomToast('error', data.message || 'Unknown error');
            }
          })
          .catch(err => {
            showCustomToast('error', 'Error updating status');
          })
          .finally(() => {
            document.getElementById('licenseConfirmModal').classList.add('hidden');
            pendingLicenseUserId = null;
            pendingLicenseStatus = null;
          });
      }
    });

    // Unenroll confirmation
    let unenrollUserIds = [];
    document.getElementById('unenrollConfirmYes').addEventListener('click', function () {
      // Get selected user IDs
      unenrollUserIds = Array.from(document.querySelectorAll('input[name="user-select"]:checked')).map(el => el.value);
      if (unenrollUserIds.length > 0) {
        // AJAX call to unenroll users
        fetch('/user/unenroll', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            userIds: unenrollUserIds
          })
        })
          .then(response => response.json())
          .then(data => {
            // Handle success (show toast, reload, etc.)
            if (data.success) {
              showCustomToast('success', 'Users unenrolled successfully!');
              setTimeout(() => window.location.reload(), 1200);
            } else {
              showCustomToast('error', 'Failed to unenroll users: ' + (data.message || 'Unknown error'));
            }
          })
          .catch(err => {
            showCustomToast('error', 'Error unenrolling users');
          })
          .finally(() => {
            document.getElementById('unenrollConfirmModal').classList.add('hidden');
            unenrollUserIds = [];
          });
      } else {
        document.getElementById('unenrollConfirmModal').classList.add('hidden');
      }
    });

    document.getElementById('unenrollConfirmNo').addEventListener('click', function () {
      document.getElementById('unenrollConfirmModal').classList.add('hidden');
    });
  </script>