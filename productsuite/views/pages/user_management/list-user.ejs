<script src="/securemagnus_2025/js/user-license-multiselect-enrollment-jquery.js"></script>
<script src="/securemagnus_2025/js/custom_script/user-license-multiselect-enrollment.js"></script>

<script>
  let pendingLicenseUserId = null;
  let pendingLicenseStatus = null;
  let actionProduct = null;
  let saveUserAllocationLicense = `/user/update-license-status/false`;
  const userSelectionMode = document.getElementById('userSelectionMode');
  const selectAllVisibleUsers = document.getElementById('selectAllVisibleUsers');
  const suiteUserPageSize = document.getElementById('suiteUserPageSize');
  const suiteUserSearchInput = document.getElementById('suiteUserSearch');
  const suiteUsersFilterForm = document.getElementById('suiteUsersFilterForm');
  const suiteUsersTableBody = document.getElementById('suiteUsersTableBody');
  let suiteUsersFooter = document.getElementById('suiteUsersFooter');
  let suiteUsersPagination = document.getElementById('suiteUsersPagination');
  const suiteUsersClearSearchSlot = document.getElementById('suiteUsersClearSearchSlot');
  const bulkInviteSubmitBtn = document.getElementById('bulkInviteSubmitBtn');
  const defaultPageSize = <%= Number(sp.pageSize) || 25 %>;
  let searchDebounceTimer = null;
  let activeSuiteUsersRequest = 0;

  function getUserSelectionCheckboxes() {
    return Array.from(document.querySelectorAll('.user-select-checkbox'));
  }

  function buildSuiteUsersUrl(page) {
    const formAction = suiteUsersFilterForm ? suiteUsersFilterForm.getAttribute('action') : '<%= sp.basePath %>';
    const url = new URL(formAction, window.location.origin);
    const params = new URLSearchParams();
    params.set('page', String(page || 1));
    params.set('pageSize', suiteUserPageSize ? suiteUserPageSize.value : String(defaultPageSize));
    params.set('search', suiteUserSearchInput ? suiteUserSearchInput.value.trim() : '');
    url.search = params.toString();
    return url;
  }

  function syncSuiteUsersStateFromDocument(doc) {
    const nextFooter = doc.getElementById('suiteUsersFooter');
    if (suiteUsersFooter && nextFooter) {
      suiteUsersFooter.className = nextFooter.className;
      suiteUsersFooter.innerHTML = nextFooter.innerHTML;
      suiteUsersPagination = document.getElementById('suiteUsersPagination');
    }

    if (suiteUsersClearSearchSlot) {
      const nextClearSearchSlot = doc.getElementById('suiteUsersClearSearchSlot');
      suiteUsersClearSearchSlot.innerHTML = nextClearSearchSlot ? nextClearSearchSlot.innerHTML : '';
    }
  }

  async function loadSuiteUsers(page, options) {
    const state = options || {};
    const targetPage = Number(page || 1);
    const requestId = ++activeSuiteUsersRequest;
    const url = buildSuiteUsersUrl(targetPage);
    url.searchParams.set('page', String(targetPage));

    if (state.search !== undefined && suiteUserSearchInput) {
      suiteUserSearchInput.value = state.search;
      url.searchParams.set('search', state.search);
    }

    if (state.pageSize !== undefined && suiteUserPageSize) {
      suiteUserPageSize.value = String(state.pageSize);
      url.searchParams.set('pageSize', String(state.pageSize));
    }

    try {
      const response = await fetch(url.toString(), {
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
      });

      if (!response.ok) {
        throw new Error('Failed to fetch suite users');
      }

      const html = await response.text();
      if (requestId !== activeSuiteUsersRequest) return;

      const doc = new DOMParser().parseFromString(html, 'text/html');
      const nextTableBody = doc.getElementById('suiteUsersTableBody');
      if (suiteUsersTableBody && nextTableBody) {
        suiteUsersTableBody.innerHTML = nextTableBody.innerHTML;
      }

      syncSuiteUsersStateFromDocument(doc);

      const nextUrl = `${url.pathname}?${url.searchParams.toString()}`;
      window.history.replaceState({}, '', nextUrl);
      syncHeaderSelectionState();
    } catch (error) {
      showCustomToast('error', '<%= __("user.suiteUsersClearSearch") %>');
    }
  }

  function scheduleSuiteUsersSearch() {
    window.clearTimeout(searchDebounceTimer);
    searchDebounceTimer = window.setTimeout(function () {
      loadSuiteUsers(1);
    }, 300);
  }

  function setAllUserCheckboxes(checked) {
    getUserSelectionCheckboxes().forEach((checkbox) => { checkbox.checked = checked; });
    if (selectAllVisibleUsers) {
      selectAllVisibleUsers.checked = checked;
      selectAllVisibleUsers.indeterminate = false;
    }
  }

  function syncHeaderSelectionState() {
    if (!selectAllVisibleUsers) return;
    const checkboxes = getUserSelectionCheckboxes();
    const checkedCount = checkboxes.filter(cb => cb.checked).length;
    selectAllVisibleUsers.checked = checkboxes.length > 0 && checkedCount === checkboxes.length;
    selectAllVisibleUsers.indeterminate = checkedCount > 0 && checkedCount < checkboxes.length;
  }

  if (userSelectionMode) {
    userSelectionMode.addEventListener('change', function () {
      this.value === 'all' ? setAllUserCheckboxes(true) : setAllUserCheckboxes(false);
    });
  }

  if (selectAllVisibleUsers) {
    selectAllVisibleUsers.addEventListener('change', function () {
      setAllUserCheckboxes(this.checked);
      if (userSelectionMode) userSelectionMode.value = this.checked ? 'all' : 'individual';
    });
  }

  document.addEventListener('change', function (e) {
    if (e.target.classList.contains('user-select-checkbox')) {
      syncHeaderSelectionState();
      if (userSelectionMode)
        userSelectionMode.value = selectAllVisibleUsers && selectAllVisibleUsers.checked ? 'all' : 'individual';
    }
  });

  if (suiteUsersFilterForm) {
    suiteUsersFilterForm.addEventListener('submit', function (e) {
      e.preventDefault();
      loadSuiteUsers(1);
    });
  }

  if (suiteUserSearchInput) {
    suiteUserSearchInput.addEventListener('input', function () {
      scheduleSuiteUsersSearch();
    });
  }

  if (suiteUsersClearSearchSlot) {
    document.addEventListener('click', function (e) {
      const clearButton = e.target.closest('#suiteUsersClearSearch');
      if (!clearButton) return;
      e.preventDefault();
      if (suiteUserSearchInput) {
        suiteUserSearchInput.value = '';
      }
      loadSuiteUsers(1, { search: '' });
    });
  }

  if (suiteUserPageSize) {
    suiteUserPageSize.addEventListener('change', function () {
      loadSuiteUsers(1, { pageSize: this.value });
    });
  }

  if (suiteUsersPagination) {
    document.addEventListener('click', function (e) {
      const paginationLink = e.target.closest('#suiteUsersPagination a[href]');
      if (!paginationLink) return;
      e.preventDefault();
      try {
        const linkUrl = new URL(paginationLink.getAttribute('href'), window.location.origin);
        const nextPage = parseInt(linkUrl.searchParams.get('page'), 10) || 1;
        loadSuiteUsers(nextPage);
      } catch (error) {
      }
    });
  }

  if (bulkInviteSubmitBtn) {
    bulkInviteSubmitBtn.addEventListener('click', async function () {
      const selectedIds = getUserSelectionCheckboxes()
        .filter((checkbox) => checkbox.checked)
        .map((checkbox) => Number(checkbox.value))
        .filter((id) => Number.isInteger(id) && id > 0);

      const inviteModeSelect = document.getElementById('inviteModeSelect');
      const selectedInviteMode = inviteModeSelect ? inviteModeSelect.value : '';

      if (!selectedInviteMode) { showCustomToast('error', '<%= __("user.inviteModeRequiredError") %>'); return; }
      if (selectedIds.length === 0) { showCustomToast('error', '<%= __("user.inviteUsersRequiredError") %>'); return; }

      const isInviteWithCredentials = selectedInviteMode === 'invite_with_credentials';
      bulkInviteSubmitBtn.disabled = true;
      bulkInviteSubmitBtn.classList.add('opacity-70', 'cursor-not-allowed');

      try {
        const response = await fetch('/user/invite/bulk/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ user_ids: selectedIds, send_credentials: isInviteWithCredentials, reset_password: isInviteWithCredentials, invitation: !isInviteWithCredentials })
        });
        const data = await response.json();
        if (!response.ok || !data.success) { showCustomToast('error', data.message || '<%= __("user.inviteSubmitFailed") %>'); return; }
        showCustomToast('success', data.message || '<%= __("user.inviteSubmitSuccess") %>');
        setTimeout(() => { window.location.href = '/notification-mail'; }, 700);
      } catch (error) {
        showCustomToast('error', '<%= __("user.inviteSubmitFailed") %>');
      } finally {
        bulkInviteSubmitBtn.disabled = false;
        bulkInviteSubmitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
      }
    });
  }

  document.addEventListener('click', function (e) {
    const actionBtn = e.target.closest('div.relative.inline-block.text-left button');
    if (actionBtn && !actionBtn.classList.contains('licenseStatusBtn') && !actionBtn.classList.contains('AwareMagnuslicenseStatusBtn')) {
      e.preventDefault();
      e.stopPropagation();
      const menu = actionBtn.closest('div.relative.inline-block.text-left')?.querySelector('.actionDropdownMenu');
      if (menu) {
        document.querySelectorAll('.actionDropdownMenu').forEach(m => m !== menu && m.classList.add('hidden'));
        const wasHidden = menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        if (wasHidden) {
          const btnRect = actionBtn.getBoundingClientRect();
          const menuWidth = 160, menuHeight = menu.scrollHeight || 100, gap = 8;
          const vw = window.innerWidth, vh = window.innerHeight;
          const left = Math.max(gap, Math.min(btnRect.right - menuWidth, vw - menuWidth - gap));
          const top = btnRect.bottom + menuHeight + gap > vh ? Math.max(gap, btnRect.top - menuHeight - gap) : btnRect.bottom + gap;
          menu.style.left = `${left}px`;
          menu.style.top = `${top}px`;
        }
      }
      return;
    }

    const licenseBtn = e.target.closest('button.licenseStatusBtn') || e.target.closest('button.AwareMagnuslicenseStatusBtn');
    if (licenseBtn) {
      e.preventDefault();
      e.stopPropagation();
      actionProduct = licenseBtn.classList.contains('licenseStatusBtn') ? 'phm' : 'awm';
      const parentDiv = licenseBtn.closest('div.relative.inline-block.text-left');
      if (parentDiv) {
        const menu = parentDiv.querySelector('.licenseDropdownMenu');
        if (menu) {
          document.querySelectorAll('.licenseDropdownMenu').forEach(other => { if (other !== menu) other.classList.add('hidden'); });
          menu.classList.toggle('hidden');
        }
      }
      return;
    }

    const link = e.target.closest('.change-status');
    if (link) {
      e.preventDefault();
      const userId = link.getAttribute('data-user-id');
      const newStatus = link.getAttribute('data-status');
      if (newStatus === 'licensed' || newStatus === 'unlicensed') {
        pendingLicenseUserId = userId;
        pendingLicenseStatus = newStatus;
        const actionTextSpan = document.getElementById('licenseActionText');
        if (actionTextSpan) actionTextSpan.textContent = newStatus.charAt(0).toUpperCase() + newStatus.slice(1);
        document.getElementById('licenseConfirmModal').classList.remove('hidden');
      }
      return;
    }

    document.querySelectorAll('.licenseDropdownMenu').forEach(menu => {
      const parentDiv = menu.closest('div.relative.inline-block.text-left');
      if (parentDiv && !parentDiv.contains(e.target)) menu.classList.add('hidden');
    });
    document.querySelectorAll('.actionDropdownMenu').forEach(menu => {
      const parentDiv = menu.closest('div.relative.inline-block.text-left');
      if (parentDiv && !parentDiv.contains(e.target)) menu.classList.add('hidden');
    });
  });

  document.getElementById('cancelLicenseConfirm').addEventListener('click', function () {
    document.getElementById('licenseConfirmModal').classList.add('hidden');
    pendingLicenseUserId = null;
    pendingLicenseStatus = null;
  });

  document.getElementById('confirmLicenseBtn').addEventListener('click', function () {
    if (pendingLicenseUserId && pendingLicenseStatus) {
      saveUserAllocationLicense = pendingLicenseStatus === 'unlicensed'
        ? `/user/update-license-status/true?actionProduct=${actionProduct}`
        : `/user/update-license-status/false?actionProduct=${actionProduct}`;
      fetch(saveUserAllocationLicense, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ selectedUsers: [pendingLicenseUserId], status: pendingLicenseStatus })
      })
        .then(r => r.json())
        .then(data => {
          if (data.success) { showCustomToast('success', 'Status updated successfully!'); setTimeout(() => window.location.reload(), 1200); }
          else showCustomToast('error', data.message || 'Unknown error');
        })
        .catch(() => showCustomToast('error', 'Error updating status'))
        .finally(() => {
          document.getElementById('licenseConfirmModal').classList.add('hidden');
          pendingLicenseUserId = null;
          pendingLicenseStatus = null;
        });
    }
  });

  let unenrollUserIds = [];
  document.getElementById('unenrollConfirmYes').addEventListener('click', function () {
    unenrollUserIds = Array.from(document.querySelectorAll('input[name="user-select"]:checked')).map(el => el.value);
    if (unenrollUserIds.length > 0) {
      fetch('/user/unenroll', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ userIds: unenrollUserIds })
      })
        .then(r => r.json())
        .then(data => {
          if (data.success) { showCustomToast('success', 'Users unenrolled successfully!'); setTimeout(() => window.location.reload(), 1200); }
          else showCustomToast('error', 'Failed to unenroll users: ' + (data.message || 'Unknown error'));
        })
        .catch(() => showCustomToast('error', 'Error unenrolling users'))
        .finally(() => { document.getElementById('unenrollConfirmModal').classList.add('hidden'); unenrollUserIds = []; });
    } else {
      document.getElementById('unenrollConfirmModal').classList.add('hidden');
    }
  });

  document.getElementById('unenrollConfirmNo').addEventListener('click', function () {
    document.getElementById('unenrollConfirmModal').classList.add('hidden');
  });

</script>
