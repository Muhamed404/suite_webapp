<div class="flex flex-col p-6 gap pb-0">
  <div class="flex items-center justify-between">
    <h3 class="text-3xl font-medium">
      <%= __("user.labelTitleUserManagement") %>
    </h3>
    <div class="flex flex-row gap-4">
      <% if (typeof hasCreatePermission !== 'undefined' && hasCreatePermission) { %>
        <!-- Bulk License Assignment -->
        <button id="userEnrollmentBtn"
          class="flex items-center gap-2 px-5 py-2 rounded-lg bg-yellow-100 text-yellow-800 font-semibold border border-yellow-300 shadow hover:bg-yellow-200 transition open-modal"
          title="Bulk License Assignment">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="4" y="8" width="16" height="8" rx="2" />
            <path d="M12 4v4m0 8v4m-4-4h8" />
          </svg>
          <span class="hidden sm:inline">Bulk Assign</span>
        </button>

        <!-- Import Users -->
        <a href="/user/create/bulk"
          class="flex items-center gap-2 px-5 py-2 rounded-lg bg-teal-600 text-white font-semibold border border-teal-600 shadow hover:bg-teal-700 transition"
          title="Import Users">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 20h16" />
          </svg>
          <span class="hidden sm:inline">Import</span>
        </a>

        <!-- Create User -->
        <a href="/user/create"
          class="flex items-center gap-2 px-5 py-2 rounded-lg bg-blue-600 text-white font-semibold border border-blue-600 shadow hover:bg-blue-700 transition"
          title="Create User">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="8" r="4" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 20v-2a6 6 0 0112 0v2" />
          </svg>
          <span class="hidden sm:inline">Add User</span>
        </a>
      <% } %>
    </div>
  </div>
</div>


