<%- include('./user-enrollment.ejs') %>


  <div id="licenseConfirmModal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-40 hidden">
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-sm">
      <h2 class="text-lg font-semibold mb-4">Confirm License Assignment</h2>
      <p class="mb-6">Are you sure you want to set this user as <span class="font-bold text-green-600">Licensed</span>?
      </p>
      <div class="flex justify-end gap-3">
        <button id="cancelLicenseConfirm" class="px-4 py-2 rounded bg-gray-200 hover:bg-gray-300">Cancel</button>
        <button id="confirmLicenseBtn"
          class="px-4 py-2 rounded bg-green-600 text-white hover:bg-green-700">Confirm</button>
      </div>
    </div>
  </div>


  <script src="/securemagnus_2025/js/user-license-multiselect-enrollment-jquery.js"></script>

  <script src="/securemagnus_2025/js/custom_script/user-license-multiselect-enrollment.js"></script>




  <script>
    let pendingLicenseUserId = null;
    let pendingLicenseStatus = null;
    let actionProduct = null;
    let saveUserAllocationLicense = `/user/update-license-status/false`;


    document.addEventListener('click', function (e) {
      // Handle dropdown toggle
      if (e.target.closest('.licenseStatusBtn') || e.target.closest('.AwareMagnuslicenseStatusBtn')) {
        e.preventDefault();
        const PhishMagnusBtn = e.target.closest('.licenseStatusBtn');
        const AwareMagnusBtn = e.target.closest('.AwareMagnuslicenseStatusBtn');
        actionProduct = PhishMagnusBtn ? 'phm' : 'awm';
        const btn = PhishMagnusBtn || AwareMagnusBtn;
        const menu = btn.parentElement.querySelector('.licenseDropdownMenu');
        if (menu) {
          menu.classList.toggle('hidden');
          // Close other dropdowns
          document.querySelectorAll('.licenseDropdownMenu').forEach(other => {
            if (other !== menu) other.classList.add('hidden');
          });
        }
        return; // Prevent further handling for dropdown button clicks
      }

      // Handle status change click
      const link = e.target.closest('.change-status');
      if (link) {
        e.preventDefault();
        const userId = link.getAttribute('data-user-id');
        const newStatus = link.getAttribute('data-status');
        if (newStatus === 'licensed' || newStatus === 'unlicensed') {
          pendingLicenseUserId = userId;
          pendingLicenseStatus = newStatus;
          // Update modal text
          let actionText = newStatus.charAt(0).toUpperCase() + newStatus.slice(1);
          document.querySelector('#licenseConfirmModal span.font-bold').textContent = actionText;
          document.getElementById('licenseConfirmModal').classList.remove('hidden');
        }
        return;
      }

      // Close dropdowns when clicking outside
      document.querySelectorAll('.licenseDropdownMenu').forEach(menu => {
        if (!menu.parentElement.contains(e.target)) menu.classList.add('hidden');
      });
    });

    // Modal button handlers
    document.getElementById('cancelLicenseConfirm').addEventListener('click', function () {
      document.getElementById('licenseConfirmModal').classList.add('hidden');
      pendingLicenseUserId = null;
      pendingLicenseStatus = null;
    });

    document.getElementById('confirmLicenseBtn').addEventListener('click', function () {
      if (pendingLicenseUserId && pendingLicenseStatus) {
        // AJAX call to update license status
        if (pendingLicenseStatus === 'unlicensed') {
          saveUserAllocationLicense = `/user/update-license-status/true?actionProduct=${actionProduct}`;
        } else {
          saveUserAllocationLicense = `/user/update-license-status/false?actionProduct=${actionProduct}`;
        }
        fetch(saveUserAllocationLicense, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            selectedUsers: [pendingLicenseUserId],
            status: pendingLicenseStatus
          })
        })
          .then(response => response.json())
          .then(data => {
            // Handle success (show toast, reload, etc.)
            if (data.success) {
              showCustomToast('success', 'Status updated successfully!');
              setTimeout(() => window.location.reload(), 1200);
            } else {
              showCustomToast('error', data.message || 'Unknown error');
            }
          })
          .catch(err => {
            showCustomToast('error', 'Error updating status');
          })
          .finally(() => {
            document.getElementById('licenseConfirmModal').classList.add('hidden');
            pendingLicenseUserId = null;
            pendingLicenseStatus = null;
          });
      }
    });

    // Unenroll confirmation
    let unenrollUserIds = [];
    document.getElementById('unenrollConfirmYes').addEventListener('click', function () {
      // Get selected user IDs
      unenrollUserIds = Array.from(document.querySelectorAll('input[name="user-select"]:checked')).map(el => el.value);
      if (unenrollUserIds.length > 0) {
        // AJAX call to unenroll users
        fetch('/user/unenroll', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            userIds: unenrollUserIds
          })
        })
          .then(response => response.json())
          .then(data => {
            // Handle success (show toast, reload, etc.)
            if (data.success) {
              showCustomToast('success', 'Users unenrolled successfully!');
              setTimeout(() => window.location.reload(), 1200);
            } else {
              showCustomToast('error', 'Failed to unenroll users: ' + (data.message || 'Unknown error'));
            }
          })
          .catch(err => {
            showCustomToast('error', 'Error unenrolling users');
          })
          .finally(() => {
            document.getElementById('unenrollConfirmModal').classList.add('hidden');
            unenrollUserIds = [];
          });
      } else {
        document.getElementById('unenrollConfirmModal').classList.add('hidden');
      }
    });

    document.getElementById('unenrollConfirmNo').addEventListener('click', function () {
      document.getElementById('unenrollConfirmModal').classList.add('hidden');
    });
  </script>