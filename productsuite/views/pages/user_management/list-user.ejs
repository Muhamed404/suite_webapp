<%
  const sp = typeof suitePagination !== 'undefined' && suitePagination
    ? suitePagination
    : { page: 1, pageSize: 25, total: 0, totalPages: 0, search: '', basePath: '/user/suite-users' };
  const isRtl = typeof locale === 'string' && locale.toLowerCase().startsWith('ar');
%>

<div class="flex flex-col p-6 pt-4 gap-5">

  <!-- Header -->
  <div class="flex flex-col gap-1">
    <nav class="flex items-center text-sm text-gray-400 gap-1.5" aria-label="Breadcrumb">
      <a href="/home" class="hover:text-gray-600 transition"><%= __("breadcrumbs.home") %></a>
      <span>›</span>
      <a href="/organization/" class="hover:text-gray-600 transition"><%= __("breadcrumbs.organization") %></a>
      <span>›</span>
      <span class="text-gray-700 font-medium"><%= __("breadcrumbs.userManagement") %></span>
    </nav>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mt-1">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900"><%= __("user.labelTitleUserManagement") %></h1>
        <% if (sp.total > 0) { %>
          <p class="text-sm text-gray-400 mt-0.5"><%= __("user.suiteUsersTotal").replace("{total}", sp.total) %></p>
        <% } %>
      </div>

      <% if (typeof hasCreatePermission !== 'undefined' && hasCreatePermission) { %>
        <div class="flex items-center gap-2 flex-wrap">

          <% if (typeof showBulkImportJobsNav !== 'undefined' && showBulkImportJobsNav) { %>
            <a href="<%= typeof suiteListOrganizationId !== 'undefined' && suiteListOrganizationId && !isNaN(parseInt(suiteListOrganizationId, 10)) && parseInt(suiteListOrganizationId, 10) > 0 ? '/user/bulk-import/jobs/' + parseInt(suiteListOrganizationId, 10) : '/user/bulk-import/jobs' %>"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 transition shadow-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <span class="hidden sm:inline"><%= __("user.btnBulkImportJobs") %></span>
            </a>
          <% } %>

          <button id="userEnrollmentBtn"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-amber-700 bg-amber-50 border border-amber-200 hover:bg-amber-100 transition shadow-sm open-modal">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
            </svg>
            <span class="hidden sm:inline"><%= __("user.btnBulkAssign") %></span>
          </button>

          <a href="/user/create/bulk"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-teal-700 bg-teal-50 border border-teal-200 hover:bg-teal-100 transition shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
            </svg>
            <span class="hidden sm:inline"><%= __("user.btnImport") %></span>
          </a>

          <a href="<%= typeof suiteListOrganizationId !== 'undefined' && suiteListOrganizationId && !isNaN(parseInt(suiteListOrganizationId, 10)) && parseInt(suiteListOrganizationId, 10) > 0 ? '/user/ldap/import/' + parseInt(suiteListOrganizationId, 10) : '/user/ldap/import' %>"
            id="ldapImportButton"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-blue-700 bg-blue-50 border border-blue-200 hover:bg-blue-100 transition shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h10"/>
            </svg>
            <span class="hidden sm:inline"><%= __("user.btnImportLdap") %></span>
          </a>

          <a href="/user/create"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            <span class="hidden sm:inline"><%= __("user.btnAddUser") %></span>
          </a>

        </div>
      <% } %>
    </div>
  </div>

  <!-- Main card -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">

    <!-- Toolbar -->
    <div class="px-5 py-3 border-b border-gray-100">
      <form id="suiteUsersFilterForm" method="get" action="<%= sp.basePath %>" class="flex items-center gap-2 flex-wrap">
        <input type="hidden" name="page" value="1"/>

        <!-- Search -->
        <div class="relative">
          <span class="absolute inset-y-0 left-3 flex items-center h-full pointer-events-none text-gray-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35"/>
            </svg>
          </span>
          <input id="suiteUserSearch" type="search" name="search" value="<%= sp.search || '' %>"
            placeholder="<%= __('generic_label.search_here') %>"
            autocomplete="off"
            class="w-48 pl-10 pr-3 py-2 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"/>
        </div>

        <!-- Divider -->
        <span class="hidden sm:block w-px h-6 bg-gray-200"></span>

        <!-- User selection -->
        <select id="userSelectionMode"
          class="rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-600 focus:ring-2 focus:ring-blue-500 outline-none bg-white min-w-[220px]">
          <option value="individual" selected><%= __("user.inviteUserSelectionIndividual") %></option>
          <option value="all"><%= __("user.inviteUserSelectionAll") %></option>
        </select>

        <!-- Invite mode -->
        <select id="inviteModeSelect"
          class="rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-600 focus:ring-2 focus:ring-blue-500 outline-none bg-white">
          <option value="" selected><%= __("user.inviteModePlaceholder") %></option>
          <option value="invite_only"><%= __("user.inviteModeInviteOnly") %></option>
          <option value="invite_with_credentials"><%= __("user.inviteModeInviteWithCredentials") %></option>
        </select>

        <!-- Hint tooltip -->
        <div class="relative group flex-shrink-0">
          <svg class="w-4 h-4 text-gray-400 hover:text-gray-600 cursor-pointer" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-4m0-4h.01"/>
          </svg>
          <div class="absolute left-1/2 -translate-x-1/2 bottom-full mb-2 w-64 rounded-lg bg-gray-800 text-white text-xs px-3 py-2.5 shadow-xl opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-50">
            <%= __("user.inviteModeEligibilityHint") %>
            <div class="absolute left-1/2 -translate-x-1/2 top-full w-0 h-0 border-x-4 border-x-transparent border-t-4 border-t-gray-800"></div>
          </div>
        </div>

        <!-- Send -->
        <button id="bulkInviteSubmitBtn" type="button"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white bg-teal-600 hover:bg-teal-700 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <%= __("user.inviteSubmitButton") %>
        </button>

        <!-- Divider -->
        <span class="hidden sm:block w-px h-6 bg-gray-200 ml-auto"></span>

        <!-- Page size -->
        <select id="suiteUserPageSize" name="pageSize"
          class="rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-600 focus:ring-2 focus:ring-blue-500 outline-none bg-white min-w-[140px]">
          <% [10, 25, 50, 100].forEach(function(ps) { %>
            <option value="<%= ps %>" <%= Number(sp.pageSize) === ps ? 'selected' : '' %>><%= ps %> <%= __("user.suiteUsersPerPage") %></option>
          <% }); %>
        </select>

        <div id="suiteUsersClearSearchSlot">
          <% if (sp.search) { %>
            <button id="suiteUsersClearSearch" type="button"
              class="inline-flex items-center gap-1 px-3 py-2 rounded-lg border border-gray-200 text-sm text-gray-500 hover:bg-gray-50 transition">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
              </svg>
              <%= __("user.suiteUsersClearSearch") %>
            </button>
          <% } %>
        </div>

      </form>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table id="suite-users-table" class="min-w-full text-sm text-left">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-100">
            <th class="px-5 py-3.5 w-10">
              <input id="selectAllVisibleUsers" type="checkbox"
                class="h-5 w-5 rounded-md border-2 border-gray-300 text-teal-600 focus:ring-2 focus:ring-teal-500 cursor-pointer accent-teal-600"
                title="<%= __('user.inviteSelectAllVisibleTitle') %>"/>
            </th>
            <th class="px-5 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">
              <%= __("Users.FullName") %>
            </th>
            <th class="px-5 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">
              <%= __("Users.Email") %>
            </th>
            <th class="px-5 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">
              <%= __("Users.RoleAssigned") %>
            </th>
            <th class="px-5 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">
              <%= __("user.labelPhishMagnusLicenseStatus") %>
            </th>
            <th class="px-5 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">
              <%= __("user.labelAwarenessLicenseStatus") %>
            </th>
            <th class="px-5 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">
              <%= __("Users.UserStatus") %>
            </th>
            <th class="px-5 py-3.5 text-xs font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">
              <%= __("Users.Action") %>
            </th>
          </tr>
        </thead>
        <tbody id="suiteUsersTableBody" class="divide-y divide-gray-50">
          <% if (Array.isArray(users)) { users.forEach(u => { %>
            <tr class="hover:bg-gray-50 transition-colors">

              <!-- Checkbox -->
              <td class="px-5 py-4">
                <input type="checkbox"
                  class="user-select-checkbox h-5 w-5 rounded-md border-2 border-gray-300 text-teal-600 focus:ring-2 focus:ring-teal-500 cursor-pointer accent-teal-600"
                  name="user-select"
                  value="<%= u?.user_id || '' %>"
                  aria-label="<%= __('user.inviteSelectUserAriaPrefix') %> <%= (u?.first_name || '') + ' ' + (u?.last_name || '') %>"/>
              </td>

              <!-- Name + avatar -->
              <td class="px-5 py-4 whitespace-nowrap">
                <div class="flex items-center gap-3">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-xs font-semibold uppercase">
                    <%= (u?.first_name || '?')[0] %><%= (u?.last_name || '')[0] %>
                  </div>
                  <span class="font-medium text-gray-900"><%= u?.first_name %> <%= u?.last_name %></span>
                </div>
              </td>

              <!-- Email -->
              <td class="px-5 py-4 whitespace-nowrap text-gray-600">
                <%= u?.email %>
              </td>

              <!-- Role -->
              <td class="px-5 py-4 whitespace-nowrap text-gray-600">
                <%= u.user?.UserRoles || '—' %>
              </td>

              <!-- PhishMagnus License -->
              <td class="px-5 py-4 whitespace-nowrap">
                <% if (typeof isReadOnly !== 'undefined' && isReadOnly) { %>
                  <% if (Array.isArray(u.productNames) && u.productNames.includes('PhishMagnus')) { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-200"><%= __("user.statusLicensed") %></span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-50 text-red-600 border border-red-200"><%= __("user.statusUnlicensed") %></span>
                  <% } %>
                <% } else { %>
                  <div class="relative inline-block text-left">
                    <% if (Array.isArray(u.productNames) && u.productNames.includes('PhishMagnus')) { %>
                      <button type="button"
                        class="licenseStatusBtn inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-200 hover:bg-green-100 transition"
                        aria-haspopup="true" aria-expanded="false">
                        <%= __("user.statusLicensed") %>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </button>
                    <% } else { %>
                      <button type="button"
                        class="licenseStatusBtn inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-red-50 text-red-600 border border-red-200 hover:bg-red-100 transition"
                        aria-haspopup="true" aria-expanded="false">
                        <%= __("user.statusUnlicensed") %>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </button>
                    <% } %>
                    <ul class="licenseDropdownMenu hidden absolute left-0 mt-1 w-44 bg-white border border-gray-200 rounded-lg shadow-lg z-10 py-1">
                      <% if (Array.isArray(u.productNames) && u.productNames.includes('PhishMagnus')) { %>
                        <li>
                          <a href="#" class="flex items-center gap-2 px-4 py-2 text-xs text-red-600 hover:bg-gray-50 change-status"
                            data-user-id="<%= u?.user_id || '' %>" data-status="unlicensed">
                            <%= __("user.btnSetAsUnlicensed") %>
                          </a>
                        </li>
                      <% } else { %>
                        <li>
                          <a href="#" class="flex items-center gap-2 px-4 py-2 text-xs text-green-600 hover:bg-gray-50 change-status"
                            data-user-id="<%= u?.user_id || '' %>" data-status="licensed">
                            <%= __("user.btnSetAsLicensed") %>
                          </a>
                        </li>
                      <% } %>
                    </ul>
                  </div>
                <% } %>
              </td>

              <!-- AwareMagnus License -->
              <td class="px-5 py-4 whitespace-nowrap">
                <% if (typeof isReadOnly !== 'undefined' && isReadOnly) { %>
                  <% if (Array.isArray(u.productNames) && u.productNames.includes('AwareMagnus')) { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-200"><%= __("user.statusLicensed") %></span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-50 text-red-600 border border-red-200"><%= __("user.statusUnlicensed") %></span>
                  <% } %>
                <% } else { %>
                  <div class="relative inline-block text-left">
                    <% if (Array.isArray(u.productNames) && u.productNames.length > 0 && u.productNames.includes('AwareMagnus')) { %>
                      <button type="button"
                        class="AwareMagnuslicenseStatusBtn inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-200 hover:bg-green-100 transition"
                        aria-haspopup="true" aria-expanded="false">
                        <%= __("user.statusLicensed") %>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </button>
                    <% } else { %>
                      <button type="button"
                        class="AwareMagnuslicenseStatusBtn inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-red-50 text-red-600 border border-red-200 hover:bg-red-100 transition"
                        aria-haspopup="true" aria-expanded="false">
                        <%= __("user.statusUnlicensed") %>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </button>
                    <% } %>
                    <ul class="licenseDropdownMenu hidden absolute left-0 mt-1 w-44 bg-white border border-gray-200 rounded-lg shadow-lg z-10 py-1">
                      <% if (Array.isArray(u.productNames) && u.productNames.length > 0 && u.productNames.includes('AwareMagnus')) { %>
                        <li>
                          <a href="#" class="flex items-center gap-2 px-4 py-2 text-xs text-red-600 hover:bg-gray-50 change-status"
                            data-user-id="<%= u?.user_id || '' %>" data-status="unlicensed">
                            <%= __("user.btnSetAsUnlicensed") %>
                          </a>
                        </li>
                      <% } else { %>
                        <li>
                          <a href="#" class="flex items-center gap-2 px-4 py-2 text-xs text-green-600 hover:bg-gray-50 change-status"
                            data-user-id="<%= u?.user_id || '' %>" data-status="licensed">
                            <%= __("user.btnSetAsLicensed") %>
                          </a>
                        </li>
                      <% } %>
                    </ul>
                  </div>
                <% } %>
              </td>

              <!-- Status -->
              <td class="px-5 py-4 whitespace-nowrap">
                <% if (u.user.status === true || u.user.status === 'true') { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                    <%= __("user.statusActive") %>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-500 border border-gray-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                    <%= __("user.statusInactive") %>
                  </span>
                <% } %>
              </td>

              <!-- Actions -->
              <td class="px-5 py-4 whitespace-nowrap">
                <% if (typeof isReadOnly !== 'undefined' && !isReadOnly) { %>
                  <div class="relative inline-block text-left">
                    <button type="button"
                      class="p-1.5 rounded-lg hover:bg-gray-100 text-gray-400 hover:text-gray-600 transition"
                      aria-haspopup="true" aria-expanded="false">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/>
                      </svg>
                    </button>
                    <ul class="fixed w-40 bg-white border border-gray-200 rounded-lg shadow-lg z-[9999] hidden actionDropdownMenu py-1">
                      <li>
                        <a href="/user/show/<%= u.user_id || '' %>"
                          class="flex items-center gap-2.5 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition">
                          <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                          <%= __("user.btnEdit") %>
                        </a>
                      </li>
                      <li>
                        <a href="/user/delete/<%= u.user_id || '' %>"
                          class="flex items-center gap-2.5 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                          </svg>
                          <%= __("user.btnDelete") %>
                        </a>
                      </li>
                    </ul>
                  </div>
                <% } else { %>
                  <span class="text-xs text-gray-400">Read Only</span>
                <% } %>
              </td>

            </tr>
          <% }) } %>
        </tbody>
      </table>
    </div>

    <!-- Footer: count + pagination -->
    <div id="suiteUsersFooter" class="flex flex-col sm:flex-row items-center justify-between gap-3 px-5 py-4 border-t border-gray-100 <%= sp.totalPages >= 1 ? '' : 'hidden' %>">

        <p class="text-sm text-gray-400">
          <% if (sp.total > 0) { %>
            <%
              var startIndex = ((sp.page - 1) * sp.pageSize) + 1;
              var endIndex = Math.min(sp.page * sp.pageSize, sp.total);
              var showingText = __("user.suiteUsersShowing")
                .replace("{start}", startIndex)
                .replace("{end}", endIndex)
                .replace("{total}", sp.total);
            %>
            <span id="suiteUsersShowingText" class="font-medium text-gray-700"><%= showingText %></span>
          <% } %>
        </p>

        <nav id="suiteUsersPagination" class="flex items-center gap-1 <%= sp.totalPages > 1 ? '' : 'hidden' %>" aria-label="Pagination">
          <% if (sp.totalPages > 1) { %>
            <% if (sp.page > 1) { %>
              <a href="<%= sp.basePath %>?page=<%= sp.page - 1 %>&amp;pageSize=<%= sp.pageSize %>&amp;search=<%= encodeURIComponent(sp.search || '') %>"
                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-gray-200 text-sm text-gray-600 hover:bg-gray-50 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="<%= isRtl ? 'M9 5l7 7-7 7' : 'M15 19l-7-7 7-7' %>"/></svg>
                <%= __("user.suiteUsersPrev") %>
              </a>
            <% } %>

            <%
              var win = 5;
              var startP = Math.max(1, sp.page - 2);
              var endP = Math.min(sp.totalPages, startP + win - 1);
              startP = Math.max(1, endP - win + 1);
              for (var p = startP; p <= endP; p++) {
            %>
              <a href="<%= sp.basePath %>?page=<%= p %>&amp;pageSize=<%= sp.pageSize %>&amp;search=<%= encodeURIComponent(sp.search || '') %>"
                class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-sm <%= p === sp.page ? 'bg-blue-600 text-white font-semibold' : 'border border-gray-200 text-gray-600 hover:bg-gray-50' %> transition">
                <%= p %>
              </a>
            <% } %>

            <% if (sp.page < sp.totalPages) { %>
              <a href="<%= sp.basePath %>?page=<%= sp.page + 1 %>&amp;pageSize=<%= sp.pageSize %>&amp;search=<%= encodeURIComponent(sp.search || '') %>"
                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-gray-200 text-sm text-gray-600 hover:bg-gray-50 transition">
                <%= __("user.suiteUsersNext") %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="<%= isRtl ? 'M15 19l-7-7 7-7' : 'M9 5l7 7-7 7' %>"/></svg>
              </a>
            <% } %>
          <% } %>
        </nav>

    </div>

  </div>
</div>


