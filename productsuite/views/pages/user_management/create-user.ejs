<div class="flex flex-col p-6 gap pb-0">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div class="flex-1">
      <nav class="flex items-center text-[1rem] text-gray-500 gap-2 p-0 pb-0 mb-2" aria-label="Breadcrumb">
        <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
        <span class="text-gray-400">›</span>
        <a href="/user/securemagnus-users" class="hover:text-gray-700 transition"><%= __("user.labelSecureMagnusUsers") %></a>
        <span class="text-gray-400">›</span>
        <span class="font-semibold text-gray-900"><%= __("user.labelCreateUser") %></span>
      </nav>
      <h3 class="text-3xl font-medium">
        <%= __("user.labelCreateSecureMagnusUser") %>
      </h3>
    </div>
  </div>
</div>

<div class="flex flex-col  p-6 pt-0">

  <!-- first section  -->

  <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white">

    <form action="/user/create" method="post" name="addUserForm" id="addUserForm" class="bg-white  w-full mt-3 p-8" data-select-role-error="<%= __('user.validationSelectRoleProceed') %>">
      <!-- Stepper Navigation -->
      <div id="stepper" class="flex items-center justify-between mb-10">
        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-teal-500 text-white font-bold text-xs">
            1</div>
          <span class="font-medium step-label text-teal-700 text-sm">
            <%= __("user.stepChooseProduct") %>
          </span>
        </div>
        <div class="flex-1 h-0.5 bg-teal-100 mx-2"></div>
        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-white border-2 border-teal-300 text-teal-400 font-bold text-xs">
            2</div>
          <span class="font-medium step-label text-gray-400 text-sm">
            <%= __("user.labelEnterUserDetails") %>
          </span>
        </div>

      </div>

      <div id="steps">
        <!-- Step 1: Trial and Subscription Details -->
        <%- include('./select_product.ejs') %>

          <!-- Step 2: Select Department & Group -->

          <%- include('./select_user_details.ejs') %>


      </div>

      <!-- Buttons -->
      <div class="flex justify-end gap-4 mt-10">
        <button id="backBtn" type="button"
          class="px-8 py-2 rounded-lg bg-gray-100 text-gray-600 font-medium border hover:border-gray-300 transition"><%= __("generic_label.back") %></button>
        <button id="nextBtn" type="button"
          class="px-8 py-2 rounded-lg bg-[var(--teal)] text-white font-semibold hover:bg-teal-500 transition"><%= __("generic_label.next") %></button>
      </div>

    </form>


  </div>

</div>

<!-- expose server-side arrays for client JS -->

<script src="/securemagnus_2025/js/form_stepper.js"></script>
<script src="/securemagnus_2025/js/custom_script/create-user-validation.js"></script>
<script>
window.i18n = window.i18n || {};
window.i18n.labels = window.i18n.labels || {};
window.i18n.labels.finish = '<%= __("generic_label.Finish") %>';
window.i18n.labels.next = '<%= __("generic_label.next") %>';
</script>
<script>
  (function () {
    var toggleBtn = document.getElementById('toggleCreateUserPassword');
    var passwordInput = document.getElementById('password');
    var eyeIcon = document.getElementById('toggleCreateUserPasswordIconEye');
    var eyeOffIcon = document.getElementById('toggleCreateUserPasswordIconEyeOff');
    if (!toggleBtn || !passwordInput || !eyeIcon || !eyeOffIcon) return;

    toggleBtn.addEventListener('click', function () {
      var isHidden = passwordInput.type === 'password';
      passwordInput.type = isHidden ? 'text' : 'password';
      eyeIcon.classList.toggle('hidden', isHidden);
      eyeOffIcon.classList.toggle('hidden', !isHidden);
      toggleBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
      toggleBtn.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
    });
  })();
</script>

