<div class="step fade-enter-active" id="step-1">
    <!--  Title -->
    <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10"><%= __("user.labelBulkUploadUsers") %></h1>

    <!-- Main Form -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="md:col-span-1">
            <label class="block text-gray-700 font-medium mb-3">
                <%= __("user.labelChooseTheProduct") %>
            </label>

                <select id="application" name="application"
                    class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50"
                    tabindex="1">
                    <option value="" disabled selected><%= __("user.labelSelectProduct") %></option>
                    <% Object.entries(Applications).forEach(([key, value]) => { %>
                        <option value="<%= value %>"><%= key %></option>
                    <% }) %>
                </select>
        </div>


        <div class="md:col-span-1">
            <label class="block text-gray-700 font-medium mb-3">
                <%= __("user.labelAvailableLicenseQuantity") %>
            </label>
            <input type="text" readonly placeholder="<%= __("user.labelAvailableLicenseQuantity") %>"
            id="alertLicenseAvailability" name="alertLicenseAvailability"
            class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900
            bg-gray-50"
            tabindex="-1" />
        </div>


    </div>
</div>
