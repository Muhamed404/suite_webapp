<div class="flex flex-col p-6 pb-4">
  <div class="flex flex-col gap-2 mb-4 border-b border-gray-100 pb-4">
    <nav class="flex items-center text-[1rem] text-gray-500 gap-2" aria-label="Breadcrumb">
      <a href="/home" class="hover:text-gray-700 transition"><%= __("breadcrumbs.home") %></a>
      <span class="text-gray-400">›</span>
      <a href="/organization/profile/<%= organizationId %>" class="hover:text-gray-700 transition">
        <%= organizationName || __("breadcrumbs.organization") %>
      </a>
      <span class="text-gray-400">›</span>
      <span class="font-semibold text-gray-900"><%= __("breadcrumbs.audit") %></span>
    </nav>
    <h3 class="text-3xl font-medium text-gray-900"><%= __("breadcrumbs.audit") %></h3>
    <p class="text-sm text-gray-500"><%= __("Audit.subtitle") %></p>
  </div>
</div>

<div class="flex flex-col px-6 pb-6">
  <div class="flex flex-col rounded-3xl bg-white border border-gray-100 shadow-sm">

    <!-- Card header: tabs left, search right -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 gap-4 flex-wrap">
      <div id="statusTabs"
        class="flex items-center gap-2 flex-wrap"
        data-tab-all="<%- __('Audit.tabAll') %>">
      </div>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 105 11a6 6 0 0012 0z"/>
          </svg>
        </div>
        <input id="searchInput" type="text"
          placeholder="<%= __('Audit.searchPlaceholder') %>"
          class="pl-9 pr-4 py-2 w-72 rounded-lg border border-gray-200 bg-gray-50 text-sm focus:outline-none focus:ring-2 focus:ring-teal-100 focus:border-teal-400 transition">
      </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm text-left">
        <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider border-b border-gray-100">
          <tr>
            <th class="px-6 py-3 font-medium" data-sort="created_at"><%= __("Audit.CreationDate") %></th>
            <th class="px-6 py-3 font-medium" data-sort="user"><%= __("Audit.User") %></th>
            <th class="px-6 py-3 font-medium" data-sort="action"><%= __("Audit.ActionType") %></th>
            <th class="px-6 py-3 font-medium" data-sort="module"><%= __("Audit.Module") %></th>
            <th class="px-6 py-3 font-medium"><%= __("Audit.Description") %></th>
            <th class="px-6 py-3 font-medium" data-sort="ip_address"><%= __("Audit.IPAddress") %></th>
            <th class="px-6 py-3 font-medium"><%= __("Audit.UrlPath") %></th>
          </tr>
        </thead>
        <tbody id="tableBody" class="divide-y divide-gray-100">
        </tbody>
      </table>
    </div>

    <!-- Pagination footer -->
    <div class="flex items-center justify-between px-6 py-3 border-t border-gray-100 flex-wrap gap-3">
      <div class="inline-flex items-center gap-2">
        <label for="rowsPerPage" class="text-sm text-gray-700 font-medium select-none"><%= __("Audit.rowsPerPage") || "Rows per page" %>:</label>
        <div>
          <select id="rowsPerPage" class="h-9 min-w-[64px] text-sm text-gray-800 border border-gray-300 rounded-lg pl-3 pr-3 leading-tight focus:outline-none focus:ring-2 focus:ring-teal-100 bg-white shadow-sm">
            <option value="5">5</option>
            <option value="10" selected>10</option>
            <option value="20">20</option>
          </select>
        </div>
      </div>
      <div id="pagination" class="flex items-center gap-2"></div>
    </div>

  </div>
</div>

<!-- Pass data to JavaScript -->
<script>
  window.auditData = {
    report: <%- JSON.stringify(report) %>,
    pagination: <%- JSON.stringify(pagination) %>
  };
  window.i18n = {
    Audit: {
      tabAll:         "<%- __('Audit.tabAll') %>",
      tabActive:      "<%- __('Audit.tabActive') %>",
      tabInprogress:  "<%- __('Audit.tabInprogress') %>",
      tabCompleted:   "<%- __('Audit.tabCompleted') %>",
      noLogs:         "<%- __('Audit.noLogs') %>"
    }
  };
</script>

<script src="/securemagnus_2025/js/audit_log_table_jquery.js"></script>
