<div class="flex flex-col  p-6 pt-0">

  <!-- first section  -->

  <div class="flex flex-col gap-4 mt-3 rounded-3xl bg-white">

    <form action="/sms/settings/create/<%=organization%>" method="post" name="smsSettingsForm" id="smsSettingsForm"
      class="bg-white  w-full mt-3 p-8">
      <!-- Stepper Navigation -->
      <div id="stepper" class="flex items-center justify-between mb-10">
        <div class="flex items-center gap-2">
          <div
            class="step-circle w-6 h-6 flex items-center justify-center rounded-full bg-teal-500 text-white font-bold text-xs">
            1</div>
          <span class="font-medium step-label text-teal-700 text-sm">
            <%= __("sms.settings.provider_details") %>
          </span>
        </div>
        <div class="flex-1 h-0.5 bg-teal-100 mx-2"></div>
      </div>

      <div id="steps">
        <!-- Step 1: SMS Server Details -->
        <div class="step fade-enter-active" id="step-1">
          <!--  Title -->
          <h1 class="text-2xl font-semibold text-[var(--mainblue)] mb-10"></h1>

          <!-- Main Form -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-1">
              <label for="provider_name" class="block text-gray-700 font-medium mb-3">
                <%= __("sms.settings.provider") %> <span class="text-red-500">*</span>
              </label>

              <input type="text" value="<%= sms?.provider_name %>" name="provider_name" id="provider_name" required data-msg-required="<%= __('sms.settings.provider_required') %>" data-msg-minlength="<%= __('sms.settings.provider_minlength') %>" class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900
            bg-gray-50" />
            </div>

            <div class="md:col-span-1">
              <label class="block text-gray-700 font-medium mb-3">
                <%= __("sms.settings.sender_id") %> <span class="text-red-500">*</span>

              </label>
              <input type="text" value="<%= sms?.sender_id %>" name="sender_id" id="sender_id" required data-msg-required="<%= __('sms.settings.sender_id_required') %>" data-msg-minlength="<%= __('sms.settings.sender_id_minlength') %>" class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900
            bg-gray-50" />
            </div>

            <div class="md:col-span-1">
              <label class="block text-gray-700 font-medium mb-3">
                <%= __("generic_label.status") %>
                  <span class="text-red-500">*</span>

              </label>
              <select name="status" id="status" required data-msg-required="<%= __('sms.settings.status_required') %>" class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900 bg-gray-50">
                <option value="active" <%= sms?.is_active === "active" ? "selected" : "" %>><%= __("sms.settings.active") %></option>
                <option value="inactive" <%= !sms?.is_active || sms?.is_active === "inactive" ? "selected" : "" %>><%= __("sms.settings.inactive") %></option>
              </select>
            </div>

            <div class="md:col-span-1">
              <label class="block text-gray-700 font-medium mb-3">
                <%= __("sms.settings.api_key") %> <span class="text-red-500">*</span>
              </label>
              <textarea name="api_key" id="api_key" required data-msg-required="<%= __('sms.settings.api_key_required') %>" data-msg-minlength="<%= __('sms.settings.api_key_minlength') %>" class="w-full px-4 py-2 border rounded-lg outline-none focus:ring-2 focus:ring-teal-400 text-gray-900
            bg-gray-50"><%= sms?.api_key %></textarea>
            </div>
          </div>
        </div>

      </div>

      <!-- Buttons -->
      <div class="flex justify-end gap-4 mt-10">
        <button type="reset"
          class="px-8 py-2 rounded-lg bg-gray-100 text-gray-600 font-medium border hover:border-gray-300 transition">
          <%= __("generic_label.cancel") %>

        </button>
        <button type="submit"
          class="px-8 py-2 rounded-lg bg-[var(--teal)] text-white font-semibold hover:bg-teal-500 transition">
          <%= __("generic_label.submit") %>
        </button>
      </div>

    </form>


  </div>

</div>

<script>
window.smsValidationMessages = {
  provider_required: "<%= __('sms.settings.provider_required') %>",
  provider_minlength: "<%= __('sms.settings.provider_minlength') %>",
  sender_id_required: "<%= __('sms.settings.sender_id_required') %>",
  sender_id_minlength: "<%= __('sms.settings.sender_id_minlength') %>",
  api_key_required: "<%= __('sms.settings.api_key_required') %>",
  api_key_minlength: "<%= __('sms.settings.api_key_minlength') %>",
  status_required: "<%= __('sms.settings.status_required') %>"
};
</script>

<script src="/securemagnus_2025/js/custom_script/create-sms-validation.js"></script>