<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>500 - Internal Server Error</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/securemagnus_2025/css/tailwind.css" rel="stylesheet">
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
  <div class="bg-white rounded-xl shadow-lg p-8 max-w-md w-full text-center">
    <h1 class="text-5xl font-bold text-red-600 mb-4">500</h1>
    <h2 class="text-2xl font-semibold text-gray-800 mb-2">Internal Server Error</h2>
    <p class="text-gray-600 mb-6"><%= typeof message === 'string' ? message : (message && message[0]) || 'Something went wrong. Please try again later.' %></p>
  </div>
</body>
</html>