<!-- Header -->
                <!-- shadow-[0_2px_2px_rgba(5,18,38,0.1)] -->
                <header class="bg-[#FAFBFC]  px-6 py-3 flex items-center justify-between sticky top-0 z-30">
                    <h1 class="text-2xl text-[var(--mainblue)]"><%= __('topnavbar.welcome') %>                   <%=username%>
</h1>

          <!-- Right Section for lg and up -->
          <div class="hidden lg:flex items-center gap-2 mr-4">
            <!-- Search Bar -->
            <div class="relative flex items-center w-48 bg-white rounded-full border border-gray-300 focus-within:ring-2 focus-within:ring-[var(--teal)]">
              <img src="/securemagnus_2025/images/img/search.svg" class="w-4 h-4 <%= locals.locale === 'ar' ? 'mr-3' : 'ml-3' %> text-gray-400" alt="">
              <input id="nav-search-input" type="text" placeholder="<%= __('generic_label.search_here') %>" autocomplete="off" class="flex-1 py-2 <%= locals.locale === 'ar' ? 'pr-2 pl-12' : 'pl-2 pr-12' %> bg-transparent text-sm focus:outline-none <%= locals.locale === 'ar' ? 'text-right' : '' %>" />
              <span class="pointer-events-none absolute z-10 <%= locals.locale === 'ar' ? 'left-4' : 'right-4' %> top-3/4 -translate-y-1/2 text-gray-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>

              <div id="nav-search-dropdown" class="hidden absolute top-full mt-2 <%= locals.locale === 'ar' ? 'right-0' : 'left-0' %> w-full min-w-[220px] bg-white border border-gray-200 rounded-lg shadow-lg z-40 max-h-56 overflow-y-auto">
                <ul id="nav-search-list" class="py-1"></ul>
              </div>
            </div>

            <!-- Two Circle Buttons -->
            <!--
            <button class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-200 transition">
              <img src="/securemagnus_2025/images/img/mail.svg" alt="">
            </button>
            <button class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-200 transition">
              <img src="/securemagnus_2025/images/img/bell.svg" alt="">
            </button>
            -->
            <!-- Language Switcher -->
              <div class="flex items-center">
                <div class="relative">
                  <select name="lang" id="langSwitcher" onchange="handleLanguageChange(this.value)"
                    class="appearance-none w-36 pl-4 pr-10 py-2 rounded-lg border border-gray-300 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-[var(--teal)] shadow-sm transition-all duration-200"
                    style="background-image: none;">
                    <option value="en" <%= locale === 'en' ? 'selected' : '' %>>English</option>
                    <option value="ar" <%= locale === 'ar' ? 'selected' : '' %>>العربية</option>
                  </select>
                  <span class="pointer-events-none absolute inset-y-0 <%= locals.locale === 'ar' ? 'left-3' : 'right-3' %> flex items-center text-gray-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </div>
              </div>

            <!-- User Profile -->
            <div class="flex gap-3">
              <img src="/securemagnus_2025/images/img/profile.png" class="rounded-full w-12 h-12" alt="">
              <div class="flex flex-col gap-0.5">
                <h4 class="text-base">
                  <%=username%>
                </h4>
                <p class="text-sm text-gray-500 truncate max-w-32" title="<%= email %>">
                  <%=email%>
                </p>
              </div>
            </div>
          </div>

          <!-- Hamburger Button for small screens -->
          <button id="hamburger" class="block lg:hidden" onclick="toggleMobileMenu()">
            <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </header>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden lg:hidden bg-[#FAFBFC] px-6 py-4 border-t border-gray-200">
          <!-- Search Bar -->
          <div class="flex items-center w-full bg-white rounded-full border border-gray-300 focus-within:ring-2 focus-within:ring-[var(--teal)] mb-4">
            <img src="/securemagnus_2025/images/img/search.svg" class="w-4 h-4 <%= locals.locale === 'ar' ? 'mr-3' : 'ml-3' %> text-gray-400" alt="">
            <input type="text" placeholder="<%= __('generic_label.search_here') %>" class="flex-1 py-2 <%= locals.locale === 'ar' ? 'pr-2 pl-10' : 'pl-2 pr-10' %> bg-transparent text-sm focus:outline-none <%= locals.locale === 'ar' ? 'text-right' : '' %>" />
          </div>

          <!-- Buttons -->
          <!--
          <div class="flex gap-2 mb-4">
            <button class="flex-1 w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-200 transition">
              <img src="/securemagnus_2025/images/img/mail.svg" alt="">
            </button>
            <button class="flex-1 w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-200 transition">
              <img src="/securemagnus_2025/images/img/bell.svg" alt="">
            </button>
          </div>
          -->
          <!-- Language Switcher -->
          <div class="mb-4">
            <select name="lang" id="langSwitcherMobile" onchange="handleLanguageChange(this.value)"
              class="appearance-none w-full pl-4 pr-10 py-2 rounded-lg border border-gray-300 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-[var(--teal)] shadow-sm transition-all duration-200">
              <option value="en" <%= locale === 'en' ? 'selected' : '' %>>English</option>
              <option value="ar" <%= locale === 'ar' ? 'selected' : '' %>>العربية</option>
            </select>
          </div>

          <!-- User Profile -->
          <div class="flex gap-3 items-center">
            <img src="/securemagnus_2025/images/img/profile.png" class="rounded-full w-12 h-12" alt="">
            <div class="flex flex-col gap-0.5">
              <h4 class="text-base">
                <%=username%>
              </h4>
              <p class="text-sm text-gray-500 truncate max-w-32" title="<%= email %>">
                <%=email%>
              </p>
            </div>
          </div>
        </div>

        <script>
          const navMap = {
            <% if (locals.magnusAdmin) { %>
              "<%= __('topnavbar.organizations') %>": "/organization",
              <% if (!locals.isSubAdmin) { %>
                "<%= __('topnavbar.createPackage') %>": "/package",
              <% } %>
              "<%= __('topnavbar.addUser') %>": "/user/securemagnus-users/create",
              "<%= __('topnavbar.dashboard') %>": "/suite_management_dashboard",
              "<%= __('topnavbar.systemTemplate') %>": "/template/list",
              "<%= __('topnavbar.simulatorEmails') %>": "/phm/phishing-smtp/list",
              "<%= __('topnavbar.smtpNotifications') %>": "/settings/smtp/",
              "<%= __('topnavbar.notificationTemplates') %>": "/notification-template/",
              "<%= __('topnavbar.createNotificationTemplate') %>": "/notification-template/create"
            <% } else { %>
              "<%= __('topnavbar.organizationSettings') %>": "/organization/profile",
              "<%= __('topnavbar.addUser') %>": "/user/create",
              "<%= __('topnavbar.importUser') %>": "/user/create/bulk",
              "<%= __('topnavbar.dashboard') %>": "/phm/index",
              "<%= __('topnavbar.campaigns') %>": "/phm/campaign/all-campaigns",
              "<%= __('topnavbar.subscriptionHistory') %>": "/organization/subscription-history",
              "<%= __('topnavbar.groups') %>": "/group/list",
              "<%= __('topnavbar.department') %>": "/department/list",
              "<%= __('topnavbar.bulkImportUsers') %>": "/user/create/bulk"
            <% } %>
          };

          function redirectToPage(value) {
            if (navMap[value]) {
              window.location.href = navMap[value];
            }
          }

          const navSearchInput = document.getElementById('nav-search-input');
          const navSearchDropdown = document.getElementById('nav-search-dropdown');
          const navSearchList = document.getElementById('nav-search-list');
          const navOptions = Object.keys(navMap);
          const noModulesFoundLabel = "<%= __('topnavbar.noModulesFound') %>";

          function renderNavSearchDropdown(searchText) {
            const query = (searchText || '').trim().toLowerCase();
            const filteredOptions = navOptions.filter((option) => option.toLowerCase().includes(query));

            navSearchList.innerHTML = '';

            if (!filteredOptions.length) {
              const emptyItem = document.createElement('li');
              emptyItem.className = 'px-3 py-2 text-sm text-gray-500';
              emptyItem.textContent = noModulesFoundLabel;
              navSearchList.appendChild(emptyItem);
              navSearchDropdown.classList.remove('hidden');
              return;
            }

            filteredOptions.forEach((option) => {
              const item = document.createElement('li');
              const button = document.createElement('button');
              button.type = 'button';
              button.className = 'w-full text-left px-3 py-2 text-sm hover:bg-gray-100';
              button.textContent = option;
              button.addEventListener('click', () => redirectToPage(option));
              item.appendChild(button);
              navSearchList.appendChild(item);
            });

            navSearchDropdown.classList.remove('hidden');
          }

          if (navSearchInput && navSearchDropdown && navSearchList) {
            navSearchInput.addEventListener('focus', () => renderNavSearchDropdown(navSearchInput.value));
            navSearchInput.addEventListener('input', () => renderNavSearchDropdown(navSearchInput.value));
            navSearchInput.addEventListener('keydown', (event) => {
              if (event.key === 'Enter') {
                event.preventDefault();
                redirectToPage(navSearchInput.value);
              }
            });

            document.addEventListener('click', (event) => {
              const clickedInsideSearch = navSearchInput.contains(event.target) || navSearchDropdown.contains(event.target);
              if (!clickedInsideSearch) {
                navSearchDropdown.classList.add('hidden');
              }
            });
          }

          function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
          }
        </script>

