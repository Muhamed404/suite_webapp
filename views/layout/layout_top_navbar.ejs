<!-- Header -->
                <!-- shadow-[0_2px_2px_rgba(5,18,38,0.1)] -->
                <header class="bg-[#FAFBFC]  px-6 py-3 flex items-center justify-between sticky top-0 z-30">
                    <h1 class="text-2xl text-[var(--mainblue)]"><%= __('topnavbar.welcome') %>                   <%=username%>
</h1>

          <!-- Right Section for lg and up -->
          <div class="hidden lg:flex items-center gap-4">
            <!-- Search Bar -->
            <div class="relative">
              <input type="text" placeholder="Search here..."
                class="pl-14 pr-10 py-3 rounded-full bg-white text-sm border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[var(--teal)]" />
              <img src="/securemagnus_2025/images/img/search.svg"
                class="w-5 h-5 text-gray-400 absolute left-7 top-1/2 transform -translate-y-1/2" alt="">
            </div>

            <!-- Two Circle Buttons -->
            <button class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-200 transition">
              <img src="/securemagnus_2025/images/img/mail.svg" alt="">
            </button>
            <button class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-200 transition">
              <img src="/securemagnus_2025/images/img/bell.svg" alt="">
            </button>

            <!-- Language Switcher -->
              <div class="flex items-center">
                <div class="relative">
                  <select name="lang" id="langSwitcher" onchange="handleLanguageChange(this.value)"
                    class="appearance-none w-36 pl-4 pr-10 py-2 rounded-lg border border-gray-300 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-[var(--teal)] shadow-sm transition-all duration-200">
                    <option value="en" <%= locale === 'en' ? 'selected' : '' %>>English</option>
                    <option value="ar" <%= locale === 'ar' ? 'selected' : '' %>>العربية</option>
                  </select>
                  <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-gray-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </div>
              </div>

            <!-- User Profile -->
            <div class="flex gap-3">
              <img src="/securemagnus_2025/images/img/profile.png" class="rounded-full w-12 h-12" alt="">
              <div class="flex flex-col gap-0.5">
                <h4 class="flex gap-0.5 text-base">
                  <%=username%>
                  <img src="/securemagnus_2025/images/img/arrow.svg" alt="">
                </h4>
                <p class="text-sm text-gray-500">
                  <%=email%>
                </p>
              </div>
            </div>
          </div>

          <!-- Hamburger Button for small screens -->
          <button id="hamburger" class="block lg:hidden">
            <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </header>

