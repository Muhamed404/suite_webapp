<!-- Sidebar Backdrop -->
<div id="sidebar-backdrop" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden"></div>

<!-- Layout Wrapper -->
<div class="flex h-screen relative">
  <!-- Sidebar -->
  <div class="flex h-screen">
    <!-- Primary Menu -->
    <div id="primaryMenu" class="w-60 bg-black text-white transition-all duration-300">
      <a href="#" class="absolute flex items-center gap-3 px-4 py-4 font-bold transition mt-3.5  group">
        <img src="/securemagnus_2025/images/menu-logo.svg" alt="">
        <span class="menu-text"><img src="/securemagnus_2025/images/menu-logo-name.svg" alt=""></span>
      </a>

      <div class="relative">
        <button onclick="toggleMainMenu()"
          class="absolute right-0 top-7 font-bold py-1 h-14 px-1 bg-[#00CCC440] rounded-l-2xl z-20">
          <span class="text-2xl font-light scale-x-[-1] inline-block" id="flip">›</span>
        </button>
      </div>

      <div class="relative grow overflow-hidden custom-scroll">
        <div data-simplebar class="h-[95vh] mt-[88px] flex-1 overflow-y-auto overflow-x-hidden">
          <div class="flex flex-col gap-3.5 h-[90%] justify-between">

            <!-- Navigation Links -->
            <div>
              <% if (menu && menu.suite) { %>
                <% menu.suite.forEach((item,index)=> { %>
                  <% if (item.children && item.children.length> 0) { %>
                    <div class="menu-group">

                      <button onclick="toggleMenu('menuA', this)"
                        class="w-full flex items-center justify-between gap-3 px-4 py-4 font-bold hover:bg-white/10 rounded group">
                        <div class="flex items-center gap-3">
                          <img src="<%= item.img_path %>" class="size-5">
                          <span class="text-base font-medium menu-text">
                            <%= item.label %>
                          </span>
                        </div>
                        <span
                          class="transition-transform duration-300 group-[.open]:rotate-90 text-2xl menu-text">›</span>
                      </button>
                      <%item.children.forEach((child) => { %>
                        <div id="menuA" class="mt-2 hidden flex-col space-y-2 pl-4">
                          <a href="<%= child.link %>" class="block px-4 py-2 rounded hover:bg-white/10 text-base font-medium menu-text">
                            <%= child.label %>
                          </a>
                        </div>
                      <% }) %>
                    </div>
                    <% } else { %>
                      <a href="<%= item.link %>"
                        class="relative flex items-center gap-3 px-4 py-4 font-bold transition hover:bg-white/10 group">
                        <!-- <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-8 rounded-r-full bg-[var(--teal)]"></div> -->
                        <img src="<%= item.img_path %>" class="size-6" alt="">
                        <span class="text-base font-medium menu-text">
                          <%= item.label %>
                        </span>
                      </a>

                      <% }}) %>
                        <% } %>

            </div>

            <!-- Bottom Links -->
            <div>

              <a href="/logout" class="flex items-center gap-3 px-4 py-4 font-bold transition hover:bg-white/10 group">
                <img src="/securemagnus_2025/images/icons/logout.svg" class="size-6" alt="">
                <span class="text-base font-normal menu-text">Logout</span>
              </a>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Backdrop -->
  <div id="sidebar-backdrop" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden"></div>