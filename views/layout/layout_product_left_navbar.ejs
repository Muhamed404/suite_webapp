<% 
  // ensure `menu` is always defined to avoid ReferenceError in views
  var menu = (typeof menu !== 'undefined' && menu) ? menu : { suite: [], productMenu: [] }; 
%>
<!-- Sidebar Backdrop -->
<div id="sidebar-backdrop" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden"></div>

<!-- Layout Wrapper -->
<div class="flex h-screen relative">
  <!-- Sidebar -->
  <div class="flex h-screen">
    <!-- productMenu Menu -->
    <div id="primaryMenu" class="w-16 bg-black text-white transition-all duration-300">
      <a href="#" class="absolute flex items-center gap-3 px-4 py-4 font-bold transition mt-3.5 group">

        <img src="/securemagnus_2025/images/menu-logo.svg" class="size-5" alt="">
        <span class="menu-text hidden"><img src="/securemagnus_2025/images/menu-logo-name.svg" class="h-4" alt=""></span>
      </a>
      <div class="relative  "> <!-- Set height (h-12) as needed for your layout -->
        <button onclick="toggleMenus()"
          class="absolute right-0 top-7 font-bold py-1 h-14 px-1 bg-[#00CCC440] rounded-l-2xl" style="z-index:20;">

          <span class="text-2xl font-light scale-x-[-1]  inline-block" id="flip">›</span>
        </button>
      </div>


      <div class="relative grow overflow-hidden custom-scroll">
        <div data-simplebar class="h-[95vh] mt-[88px] flex-1 overflow-y-auto  overflow-x-hidden">
          <div class=" flex flex-col gap-3.5 h-[90%] justify-between">
            <!-- Navigation Links -->

            <div>
              <% if (menu?.suite?.length) { %>
                <% menu.suite.forEach(item=> { %>

                  <a href="<%= item.link %>"
                    class="relative flex items-center gap-3 px-4 py-4 font-bold transition hover:bg-white/10 group">
                    <!-- <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-8 rounded-r-full bg-[var(--teal)]"></div> -->
                    <img src="<%= item.img_path %>" class="size-5" alt="">
                    <span class="text-sm font-medium menu-text hidden">
                      <%= item.module %>
                    </span>
                  </a>
                  <% }) %>
                    <% } %>

            </div>


            <!-- Divider -->

            <div>
              <a href="#"
                class="relative flex items-center gap-3 px-4 py-4 font-bold transition hover:bg-white/10 group">
                <img src="/securemagnus_2025/images/icons/Settings.svg" class="size-6" alt="">
                <span class="text-base font-normal menu-text hidden">Settings</span>
              </a>

              <a href="/logout"
                class="relative flex items-center gap-3 px-4 py-4 font-bold transition hover:bg-white/10 group">
                <img src="/securemagnus_2025/images/icons/logout.svg" class="size-6" alt="">
                <span class="text-base font-normal menu-text hidden">Logout</span>
              </a>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- secondry Menu -->
    <div id="subMenu"
      class="w-48 bg-[var(--bg)] text-gray-800 transition-all duration-300 overflow-hidden mt-2 mb-1.5 rounded-l-3xl">
      <div class="flex py-8 px-5 gap-3">
        <img src="/securemagnus_2025/images/phys-logo-menu.svg" alt=""> <img
          src="/securemagnus_2025/images/phys-name-menu.svg" class="svg-color menu-text text-[var(--mainblue)]"
          alt="">
      </div>
      <ul class="text-white">
        <% if (menu && menu.productMenu) { %>
          <% menu.productMenu.forEach((item, index)=> { %>
            <a href="<%= item.link %>">
              <li class="px-4 py-4 flex items-center gap-3 bg-[#00999310] cursor-pointer">
                <span><img src="<%= item.img_path %>" class="size-5" alt=""></span>
                <span class="menu-text text-[var(--mainblue)] text-sm">
                  <%= item.module %>
                </span>
              </li>
            </a>


            <% })} %>
      </ul>
    </div>


  </div>
  <!-- Backdrop -->
  <div id="sidebar-backdrop" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden"></div>